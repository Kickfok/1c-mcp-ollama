
#Область ПрограммныйИнтерфейс

&НаКлиенте
Процедура ВыполнитьМетод(Команда)
	
	Если Не ЗначениеЗаполнено(ТекстЗапросMCP) Тогда
		ПоказатьПредупреждение(,"Заполните текст запроса и повторите попытку",,"Предупреждение");
		Возврат;
	КонецЕсли;
	
	СтруктураОтвета = ЗапросКLLM();
	Если Не СтруктураОтвета.Ответ Тогда
		ТекстОшибки = "";
		Если СтруктураОтвета.Свойство("ОписаниеОшибки") Тогда
			ТекстОшибки = СтруктураОтвета.ОписаниеОшибки;
		ИначеЕсли СтруктураОтвета.Свойство("Текст") Тогда
			ТекстОшибки = СтруктураОтвета.Текст;
		Иначе
			ТекстОшибки = "Неизвестная ошибка при обращении к LLM";
		КонецЕсли;
		ПоказатьПредупреждение(, "Ошибка: " + Символы.ПС + ТекстОшибки,,"Предупреждение");
		Возврат;
	КонецЕсли;
	
	ТекстОтветMCP = "=== " + СтруктураОтвета.Текст + " ===" + Символы.ПС + Символы.ПС;
	
	РезультатLLM = СтруктураОтвета.Результат;
	
	// Структура объекта метаданных выводится своим форматом, остальные результаты
	// (строки, списки, зависимости) - общим форматированием
	Если ТипЗнч(РезультатLLM) = Тип("Структура")
		И ЭтоСтруктураОбъектаМетаданных(РезультатLLM) Тогда
		ТекстОтветMCP = ТекстОтветMCP + СформироватьТекстСтруктурыОбъекта(РезультатLLM);
	Иначе
		ТекстОтветMCP = ТекстОтветMCP + ФорматироватьПроизвольныйРезультат(РезультатLLM, 0);
	КонецЕсли;
	
КонецПроцедуры 

#КонецОбласти  
   
#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗначениеВРеквизитФормы(mcp_КонтейнерыПовтИсп.Инструменты(), "ТаблицаИнструментов"); 
	
	// Дерево: контейнер, под ним его инструменты
	ДеревоРек = РеквизитФормыВЗначение("ТаблицаИнструментовДерево");
	
	СоставПодсистемыКонтейнеры = Метаданные.Подсистемы.mcp_MCPСервер.Подсистемы.mcp_КонтейнерыИнструментов.Состав;
	
	Для Каждого ТекКонтейнер Из СоставПодсистемыКонтейнеры Цикл
		
		НоваяГруппа = ДеревоРек.Строки.Добавить();
		НоваяГруппа.ИмяОбработкиКонтейнера = ТекКонтейнер.Имя;
		
		МассивИнструментов = ТаблицаИнструментов.НайтиСтроки(Новый Структура("ИмяОбработкиКонтейнера", ТекКонтейнер.Имя)); 
		
		Для Каждого ТекИнструмент Из МассивИнструментов Цикл
			НовыйЭлемент = НоваяГруппа.Строки.Добавить();   	
			НовыйЭлемент.Имя = ТекИнструмент.Имя;
			НовыйЭлемент.Описание = ТекИнструмент.Описание;
			НовыйЭлемент.СхемаПараметров = ТекИнструмент.СхемаПараметров; 
		КонецЦикла;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоРек, "ТаблицаИнструментовДерево");

КонецПроцедуры

&НаСервере
Функция ЗапросКLLM() Экспорт
	
	СтруктураОтвета = Новый Структура;
	
	ТелоСтруктура = Новый Структура;
	ТелоСтруктура.Вставить("text", ТекстЗапросMCP);  
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	
	HTTPЗапрос = Новый HTTPЗапрос("/", Заголовки);
    HTTPЗапрос.УстановитьТелоИзСтроки(mcp_ОбщегоНазначения.СтруктураВJSON(ТелоСтруктура), КодировкаТекста.UTF8);
		
	// Сначала запрос к уже запущенному оркестратору: так форма работает и в безопасном режиме расширения.
	// Таймаут равен таймауту LLM в оркестраторе (LLM_TIMEOUT).
	Соединение = Новый HTTPСоединение("localhost", 9000, , , , 1800);
	Попытка
		Ответ = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
		ТекстОшибкиСоединения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		СтруктураОтвета.Вставить("Ответ", Ложь);
		СтруктураОтвета.Вставить("ОписаниеОшибки", ЗапуститьLLMПослеОшибкиСоединения(ТекстОшибкиСоединения));
		Возврат СтруктураОтвета;
	КонецПопытки;
	
	Данные = mcp_ОбщегоНазначения.JSONВСтруктуру(Ответ.ПолучитьТелоКакСтроку());

	Если Ответ.КодСостояния <> 200 Тогда
		СтруктураОтвета.Вставить("Ответ", Ложь);
		СтруктураОтвета.Вставить(
			"ОписаниеОшибки",
			"Ошибка LLM. Код HTTP: " + Ответ.КодСостояния + Символы.ПС + Ответ.ПолучитьТелоКакСтроку()
		);
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	Если Данные = Неопределено Тогда
		СтруктураОтвета.Вставить("Ответ", Ложь);
		СтруктураОтвета.Вставить("ОписаниеОшибки", "Пустой или некорректный JSON в ответе LLM");
		Возврат СтруктураОтвета;
	КонецЕсли;
		
	Если НЕ Данные.Свойство("Result") Тогда
		СтруктураОтвета.Вставить("Ответ", Ложь);
		СтруктураОтвета.Вставить(
			"ОписаниеОшибки",
			"Некорректный ответ от LLM"
		);
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	СтруктураОтвета.Вставить("Ответ", Данные.Success);
	СтруктураОтвета.Вставить("Текст", Данные.Text);
	СтруктураОтвета.Вставить("Результат", Данные.Result);
	
	Возврат СтруктураОтвета;
	
КонецФункции  

// Запускает Ollama и LLM-оркестратор, когда оркестратор не ответил на запрос.
// Запущенному оркестратору нужно время, чтобы опросить MCP-сервер и загрузить модель,
// поэтому текущий запрос не повторяется: пользователь получает просьбу повторить его.
// Запуск процессов недоступен в безопасном режиме расширения - тогда возвращается подсказка.
//
// Параметры:
//  ТекстОшибкиСоединения - Строка - описание ошибки соединения с оркестратором
//
// Возвращаемое значение:
//  Строка - сообщение пользователю
//
&НаСервере
Функция ЗапуститьLLMПослеОшибкиСоединения(ТекстОшибкиСоединения)

	ПричинаНедоступности = "LLM-оркестратор не отвечает на localhost:9000 (" + ТекстОшибкиСоединения + ").";

	Попытка
		Если Не ПроверитьЗапускOllama() Тогда
			ЗапускOllamaLLM();
		КонецЕсли;
		Если Не ПроверитьЗапускOrchestrator() Тогда
			Если РежимИсполнения Тогда
				Если Не ЗапускOrchestratorServer() Тогда
					Возврат ПричинаНедоступности
						+ " Запуск в серверном режиме не реализован: запустите LLM_Orchestrator.py вручную.";
				КонецЕсли;
			Иначе
				ЗапускOrchestratorLocal();
			КонецЕсли;
		КонецЕсли;
	Исключение
		Возврат ПричинаНедоступности
			+ " Автоматический запуск недоступен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ ". Запустите Ollama и LLM_Orchestrator.py вручную или выключите безопасный режим расширения.";
	КонецПопытки;

	Возврат "Ollama и LLM-оркестратор запускаются. Повторите запрос через 1-2 минуты.";

КонецФункции

&НаСервере
Функция ЗапускOrchestratorServer()
	
	// Для клиент-серверного варианта запуск пока не сделан.
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ЗапускOrchestratorLocal() 
		
	Если Не ПроверитьЗапускOrchestrator() Тогда
		
		ИмяКаталога = "C:\llm_orchestrator";
		СоздатьКаталог(ИмяКаталога);                          
		
		// Оркестратор хранится в макете обработки
		Обработка = РеквизитФормыВЗначение("Объект");
		ДанныеOrchestrator = Обработка.ПолучитьМакет("LLM_Orchestrator"); 
		ПутьКФайлу = ИмяКаталога + "\" + "LLM_Orchestrator.py";
		ДанныеOrchestrator.Записать(ПутьКФайлу); 
		
		ЗапуститьПриложение(СтрШаблон("cmd.exe /c cd /d %1 && pip install requests", ИмяКаталога));
		ЗапуститьПриложение("cmd.exe /k python C:\llm_orchestrator\LLM_Orchestrator.py");
		
	Иначе
		Сообщить("LLM-Orchestrator уже запущен");
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции  

&НаСервере
Функция ЗапускOllamaLLM() 
	
    Если Не ПроверитьЗапускOllama() Тогда
		
        ЗапуститьПриложение("cmd.exe /c """"C:\Users\%USERNAME%\AppData\Local\Programs\Ollama\ollama.exe"" serve""");
    Иначе
        Сообщить("Ollama уже запущена");
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Признак результата get_metadata_structure: есть хотя бы один из его ключей.
&НаКлиенте
Функция ЭтоСтруктураОбъектаМетаданных(Знач РезультатLLM)
	
	Возврат РезультатLLM.Свойство("Синоним")
		Или РезультатLLM.Свойство("СтандартныеРеквизиты")
		Или РезультатLLM.Свойство("Реквизиты")
		Или РезультатLLM.Свойство("ТабличныеЧасти");
	
КонецФункции

// Текст структуры объекта метаданных: синоним, реквизиты, табличные части.
&НаКлиенте
Функция СформироватьТекстСтруктурыОбъекта(Знач РезультатLLM)
	
	Текст = "";
	
	Если РезультатLLM.Свойство("Синоним") Тогда
		Текст = Текст + "Синоним: " + РезультатLLM.Синоним + Символы.ПС + Символы.ПС;
	КонецЕсли;
	
	Если РезультатLLM.Свойство("СтандартныеРеквизиты") Тогда
		Текст = Текст + "СТАНДАРТНЫЕ РЕКВИЗИТЫ:" + Символы.ПС;
		СтандартныеРеквизиты = РезультатLLM.СтандартныеРеквизиты;
		Если ТипЗнч(СтандартныеРеквизиты) = Тип("Структура") Тогда
			Для Каждого КлючЗначение Из СтандартныеРеквизиты Цикл
				Текст = Текст + "  - " + КлючЗначение.Ключ + ": " + Строка(КлючЗначение.Значение) + Символы.ПС;
			КонецЦикла;
		КонецЕсли;
		Текст = Текст + Символы.ПС;
	КонецЕсли;
	
	Если РезультатLLM.Свойство("Реквизиты") Тогда
		Текст = Текст + "РЕКВИЗИТЫ:" + Символы.ПС;
		Реквизиты = РезультатLLM.Реквизиты;
		Если ТипЗнч(Реквизиты) = Тип("Структура") Тогда
			Для Каждого КлючЗначение Из Реквизиты Цикл
				Текст = Текст + "  - " + КлючЗначение.Ключ + ": " + Строка(КлючЗначение.Значение) + Символы.ПС;
			КонецЦикла;
		КонецЕсли;
		Текст = Текст + Символы.ПС;
	КонецЕсли;
	
	Если РезультатLLM.Свойство("ТабличныеЧасти") Тогда
		Текст = Текст + "ТАБЛИЧНЫЕ ЧАСТИ:" + Символы.ПС;
		ТабличныеЧасти = РезультатLLM.ТабличныеЧасти;
		Если ТипЗнч(ТабличныеЧасти) = Тип("Структура") Тогда
			Для Каждого ТЧ Из ТабличныеЧасти Цикл
				Текст = Текст + "  " + ТЧ.Ключ + ":" + Символы.ПС;
				Если ТипЗнч(ТЧ.Значение) = Тип("Структура") Тогда
					Для Каждого РеквизитТЧ Из ТЧ.Значение Цикл
						Текст = Текст + "    - " + РеквизитТЧ.Ключ + ": " + Строка(РеквизитТЧ.Значение) + Символы.ПС;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

// Текстовое представление результата любого инструмента:
// строки, числа, структуры, соответствия и массивы с любой вложенностью.
&НаКлиенте
Функция ФорматироватьПроизвольныйРезультат(Знач Значение, Знач Уровень)
	
	Отступ = "";
	Для Сч = 1 По Уровень Цикл
		Отступ = Отступ + "  ";
	КонецЦикла;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если Значение = Неопределено Тогда
		Возврат Отступ + "(нет данных)" + Символы.ПС;
		
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		Текст = "";
		Для Каждого КлючЗначение Из Значение Цикл
			Ключ = Строка(КлючЗначение.Ключ);
			ЗначениеЭлемента = КлючЗначение.Значение;
			ТипЭлемента = ТипЗнч(ЗначениеЭлемента);
			
			Если ТипЭлемента = Тип("Структура") Или ТипЭлемента = Тип("Соответствие")
				Или ТипЭлемента = Тип("Массив") Тогда
				// Вложенная коллекция: ключ отдельной строкой, содержимое с отступом
				Текст = Текст + Отступ + Ключ + ":" + Символы.ПС;
				Текст = Текст + ФорматироватьПроизвольныйРезультат(ЗначениеЭлемента, Уровень + 1);
			Иначе
				Текст = Текст + Отступ + Ключ + ": " + Строка(ЗначениеЭлемента) + Символы.ПС;
			КонецЕсли;
		КонецЦикла;
		Возврат Текст;
		
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Текст = "";
		Номер = 0;
		Для Каждого Элемент Из Значение Цикл
			Номер = Номер + 1;
			ТипЭлемента = ТипЗнч(Элемент);
			Если ТипЭлемента = Тип("Структура") Или ТипЭлемента = Тип("Соответствие")
				Или ТипЭлемента = Тип("Массив") Тогда
				Текст = Текст + Отступ + Строка(Номер) + "." + Символы.ПС;
				Текст = Текст + ФорматироватьПроизвольныйРезультат(Элемент, Уровень + 1);
			Иначе
				Текст = Текст + Отступ + Строка(Номер) + ". " + Строка(Элемент) + Символы.ПС;
			КонецЕсли;
		КонецЦикла;
		Возврат Текст;
		
	Иначе
		Возврат Отступ + Строка(Значение) + Символы.ПС;
	КонецЕсли;
	
КонецФункции

#КонецОбласти 

#Область Проверки

&НаСервере
Функция ПроверитьЗапускOllama()
	
	КоличествоПроцессов = 0;
	
	Попытка
		Локатор = Новый COMОбъект("wbemscripting.swbemlocator");
		Сервис = Локатор.ConnectServer();
		Запрос = Сервис.ExecQuery("SELECT * FROM Win32_Process WHERE Name = 'ollama.exe'");
		КоличествоПроцессов = Запрос.Count;
	Исключение
		Сообщить("Ошибка при проверке процесса ollama.exe: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;  
	
	Возврат КоличествоПроцессов > 0;   
	
КонецФункции 

&НаСервере
Функция ПроверитьЗапускOrchestrator()
	
	КоличествоПроцессов = 0;
	
	Попытка
		Локатор = Новый COMОбъект("wbemscripting.swbemlocator");
        Сервис = Локатор.ConnectServer();
		Запрос = Сервис.ExecQuery("SELECT * FROM Win32_Process WHERE (Name = 'python.exe' OR Name = 'pythonw.exe') AND CommandLine LIKE '%LLM_Orchestrator.py%'");
		КоличествоПроцессов = Запрос.Count;
	Исключение
		Сообщить("Ошибка при проверке процесса LLM_Orchestrator.py: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;  
	
	Возврат КоличествоПроцессов > 0;   
	
КонецФункции

#КонецОбласти

#Область ФормированиеОтчета

// Формирует отчет конфигурации на форме. ПараметрыЗначения - структура "имя параметра - значение".
&НаКлиенте
Процедура СформироватьОтчётНаФорме(ИмяОтчета, ПараметрыЗначения = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ИмяОтчета) Тогда
		ПоказатьПредупреждение(, "Не указано имя отчёта для формирования",, "Предупреждение");
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = СформироватьОтчётНаСервере(ИмяОтчета, ПараметрыЗначения);
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки,, "Не удалось сформировать отчёт");
	КонецЕсли;
	
КонецПроцедуры

// Формирует отчет в реквизит ТабличныйДокументОтчет.
// Возвращает текст ошибки или пустую строку.
&НаСервере
Функция СформироватьОтчётНаСервере(ИмяОтчета, ПараметрыЗначения)
	
	Если Метаданные.Отчеты.Найти(ИмяОтчета) = Неопределено Тогда
		Возврат "Отчёт не найден в конфигурации: " + ИмяОтчета
			+ ". (Внешние отчёты на форме пока не формируются.)";
	КонецЕсли;
	
	Попытка
		ОтчетОбъект = Отчеты[ИмяОтчета].Создать();
		СхемаКД = ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Исключение
		Возврат "Не удалось получить схему компоновки отчёта " + ИмяОтчета
			+ ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Если СхемаКД = Неопределено Тогда
		Возврат "Отчёт " + ИмяОтчета + " не на СКД (нет ОсновнаяСхемаКомпоновкиДанных)";
	КонецЕсли;
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКД));
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКД.НастройкиПоУмолчанию);
	
	Если ПараметрыЗначения <> Неопределено И ТипЗнч(ПараметрыЗначения) = Тип("Структура") Тогда
		ПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных;
		Для Каждого КлючЗначение Из ПараметрыЗначения Цикл
			Попытка
				ПараметрыДанных.УстановитьЗначениеПараметра(КлючЗначение.Ключ, КлючЗначение.Значение);
			Исключение
				// Такого параметра в отчете нет, формируем без него
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	Попытка
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКД, КомпоновщикНастроек.ПолучитьНастройки());
		
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
		
		ТабДок = Новый ТабличныйДокумент;
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
		ПроцессорВывода.УстановитьДокумент(ТабДок);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	Исключение
		Возврат "Ошибка формирования отчёта " + ИмяОтчета
			+ ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	ТабличныйДокументОтчет = ТабДок;
	
	Возврат "";
	
КонецФункции

#КонецОбласти

