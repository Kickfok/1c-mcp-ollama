#Область ОписаниеПеременных

&НаКлиенте
Перем ЗапросВыполняется; // Булево - вопрос отправлен, ответ еще не получен

&НаКлиенте
Перем ИдентификаторЗапроса; // Строка - идентификатор запроса в журнале оркестратора

&НаКлиенте
Перем ПоследнийНомерСобытия; // Число - номер последнего полученного события журнала

&НаКлиенте
Перем СобытияЗапроса; // Массив из Структура - события журнала оркестратора по текущему запросу

&НаКлиенте
Перем ВопросЗапроса; // Строка - вопрос, на который отвечает модель

&НаКлиенте
Перем ВремяНачала; // Дата - момент отправки вопроса

&НаКлиенте
Перем ОтветЗапроса; // Структура, Неопределено - итоговый ответ, см. mcp_ОркестраторLLM.ОтправитьВопрос

&НаКлиенте
Перем ОпросовБезСвязи; // Число - сколько опросов подряд оркестратор не ответил

&НаКлиенте
Перем ЛокальныйВопрос; // Структура, Неопределено - неотправленный вопрос, см. mcp_ОркестраторLLM.НачатьЛокальныйВопрос

&НаКлиенте
Перем ПодключениеЛокальное; // Структура, Неопределено - соединение с локальным оркестратором текущего вопроса

&НаКлиенте
Перем ИдетЗапускОркестратора; // Булево - форма ждет, пока запущенный оркестратор начнет отвечать

&НаКлиенте
Перем СрокЗапуска; // Дата - до какого момента ждать запуска локального оркестратора

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Заполняет дерево инструментов и состояние подключения к LLM для текущего пользователя.
//
// Параметры:
//  Отказ                - Булево
//  СтандартнаяОбработка - Булево
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗначениеВРеквизитФормы(mcp_КонтейнерыПовтИсп.Инструменты(), "ТаблицаИнструментов");

	// Дерево: контейнер, под ним его инструменты
	ДеревоРек = РеквизитФормыВЗначение("ТаблицаИнструментовДерево");

	СоставПодсистемыКонтейнеры = Метаданные.Подсистемы.mcp_MCPСервер.Подсистемы.mcp_КонтейнерыИнструментов.Состав;

	Для Каждого ТекКонтейнер Из СоставПодсистемыКонтейнеры Цикл

		НоваяГруппа = ДеревоРек.Строки.Добавить();
		НоваяГруппа.ИмяОбработкиКонтейнера = ТекКонтейнер.Имя;

		МассивИнструментов = ТаблицаИнструментов.НайтиСтроки(Новый Структура("ИмяОбработкиКонтейнера", ТекКонтейнер.Имя));

		Для Каждого ТекИнструмент Из МассивИнструментов Цикл
			НовыйЭлемент = НоваяГруппа.Строки.Добавить();
			НовыйЭлемент.Имя = ТекИнструмент.Имя;
			НовыйЭлемент.Описание = ТекИнструмент.Описание;
			НовыйЭлемент.СхемаПараметров = ТекИнструмент.СхемаПараметров;
		КонецЦикла;

	КонецЦикла;

	ЗначениеВРеквизитФормы(ДеревоРек, "ТаблицаИнструментовДерево");

	ЗагрузитьОформлениеОтвета();
	ПрочитатьГотовность();
	ПоказыватьХодВыполнения  = Истина;
	КоличествоИнструментов   = ТаблицаИнструментов.Количество();

КонецПроцедуры

// Показывает стартовый экран. Если подключение не настроено и пользователь может его настроить,
// сразу открывает нужную форму настроек.
//
// Параметры:
//  Отказ - Булево
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ЗапросВыполняется      = Ложь;
	ИдетЗапускОркестратора = Ложь;
	СобытияЗапроса         = Новый Массив;
	ПроверитьДоступностьЛокальногоРежима();
	ОбновитьФорму();

	Если Не ГотовКРаботе И ЗначениеЗаполнено(ФормаНастройки) Тогда
		ОткрытьФормуНастройки(ФормаНастройки);
	КонецЕсли;

КонецПроцедуры

// Останавливает запрос, на который модель еще отвечает: токен вопроса отзывается, оркестратор
// прекращает работу после текущего шага.
//
// Параметры:
//  ЗавершениеРаботы - Булево - при завершении работы системы серверные вызовы запрещены
//
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	Если Не ЗавершениеРаботы И ЗапросВыполняется Тогда
		ПрерватьНезавершенныйЗапрос();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Показывает или скрывает ход выполнения в поле ответа.
//
// Параметры:
//  Элемент - ПолеФормы
//
&НаКлиенте
Процедура ПоказыватьХодВыполненияПриИзменении(Элемент)

	ОбновитьОтвет();

КонецПроцедуры

// Нажатие на пример вопроса на стартовом экране: ссылка вида #ask:N подставляет пример N и отправляет его.
//
// Параметры:
//  Элемент              - ПолеФормы
//  ДанныеСобытия        - ФиксированнаяСтруктура - Href нажатой ссылки
//  СтандартнаяОбработка - Булево
//
&НаКлиенте
Процедура ОтветHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Ссылка = "";
	Если ДанныеСобытия.Свойство("Href") И ДанныеСобытия.Href <> Неопределено Тогда
		Ссылка = Строка(ДанныеСобытия.Href);
	КонецЕсли;

	Позиция = СтрНайти(Ссылка, "#ask:");
	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	НомерПримера = Число(Сред(Ссылка, Позиция + СтрДлина("#ask:")));
	Примеры = ПримерыВопросов();
	Если НомерПримера < Примеры.Количество() Тогда
		ТекстЗапросMCP = Примеры[НомерПримера];
		ВыполнитьМетод(Неопределено);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Отправляет вопрос оркестратору действующего режима и начинает опрашивать ход выполнения.
//
// Параметры:
//  Команда - КомандаФормы, Неопределено - Неопределено при нажатии на пример вопроса
//
&НаКлиенте
Процедура ВыполнитьМетод(Команда)

	// При отправке по Ctrl+Enter или кликом сразу после ввода поле вопроса еще в режиме редактирования:
	// введенный текст еще не перенесен в реквизит формы. Пример вопроса уже записан в реквизит, текст поля его
	// затер бы
	Если Команда <> Неопределено И ТекущийЭлемент = Элементы.ТекстЗапросMCP Тогда
		ТекстЗапросMCP = Элементы.ТекстЗапросMCP.ТекстРедактирования;
	КонецЕсли;

	Причина = ПричинаНевозможностиВопроса();
	Если ЗначениеЗаполнено(Причина) Тогда
		ПоказатьПредупреждение(, Причина, , "Вопрос к модели");
		Возврат;
	КонецЕсли;

	ВопросЗапроса         = СокрЛП(ТекстЗапросMCP);
	СобытияЗапроса        = Новый Массив;
	ПоследнийНомерСобытия = 0;
	ОпросовБезСвязи       = 0;
	ОтветЗапроса          = Неопределено;
	ИдентификаторЗапроса  = "";
	ПодключениеЛокальное  = Неопределено;
	ВремяНачала           = ОбщегоНазначенияКлиент.ДатаСеанса();
	ЗапросВыполняется     = Истина;
	ОбновитьФорму();

	Если ЛокальныйРежим Тогда
		ЛокальныйВопрос = НачатьЛокальныйВопросНаСервере(ВопросЗапроса);
		Если ЗначениеЗаполнено(ЛокальныйВопрос.ИдентификаторЗапроса) Тогда
			ОтправитьЛокальныйВопрос(Автозапуск);
		Иначе
			ЗавершитьЗапрос(ОтветСОшибкой(ЛокальныйВопрос.ОписаниеОшибки));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Запуск = НачатьВопросНаСервере(ВопросЗапроса);
	Если ЗначениеЗаполнено(Запуск.ИдентификаторЗапроса) Тогда
		ИдентификаторЗапроса = Запуск.ИдентификаторЗапроса;
		ПодключитьОбработчикОжидания("ПроверитьХодЗапроса", 1, Истина);
	Иначе
		ЗавершитьЗапрос(ОтветСОшибкой(Запуск.ОписаниеОшибки, Запуск.ОшибкаСоединения));
	КонецЕсли;

КонецПроцедуры

// Останавливает запрос, на который модель еще отвечает.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ОстановитьЗапрос(Команда)

	Если Не ЗапросВыполняется Тогда
		Возврат;
	КонецЕсли;

	ОтключитьОбработчикОжидания("ПроверитьХодЗапроса");
	ОтключитьОбработчикОжидания("ПроверитьЗапускОркестратора");
	ПрерватьНезавершенныйЗапрос();
	ЗавершитьЗапрос(ОтветСОшибкой("Запрос остановлен"));

КонецПроцедуры

// Открывает монитор оркестратора действующего режима: журнал запросов с шагами модели.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ОткрытьМонитор(Команда)

	Если ЗначениеЗаполнено(АдресМонитора) Тогда
		ПерейтиПоНавигационнойСсылке(АдресМонитора);
	Иначе
		ПоказатьПредупреждение(, "Адрес оркестратора не задан", , "Монитор оркестратора");
	КонецЕсли;

КонецПроцедуры

// Открывает настройки подключения к LLM для администратора.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ОткрытьНастройки(Команда)

	ОткрытьФормуНастройки("ФормаНастроек");

КонецПроцедуры

// Открывает личные настройки: локальный режим и проверку подключения.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ОткрытьЛичныеНастройки(Команда)

	ОткрытьФормуНастройки("ФормаЛичныхНастроек");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Готовность

// Читает режим работы и готовность подключения текущего пользователя в реквизиты формы.
&НаСервере
Процедура ПрочитатьГотовность()

	Готовность = mcp_ОркестраторLLM.ГотовностьКВопросу();
	ЛокальныйРежим       = Готовность.ЛокальныйРежим;
	АдресОркестратора    = Готовность.АдресОркестратора;
	АдресМонитора        = Готовность.АдресМонитора;
	ГотовКРаботе         = Готовность.Готов;
	ПричинаНедоступности = Готовность.Причина;
	ФормаНастройки       = Готовность.ФормаНастройки;
	ЭтоАдминистратор     = Готовность.ЭтоАдминистратор;
	Автозапуск           = Готовность.Автозапуск;
	ТаймаутОтвета        = Готовность.ТаймаутОтвета;

	Элементы.ОткрытьНастройки.Видимость = ЭтоАдминистратор;

КонецПроцедуры

// В веб-клиенте нет исходящих HTTP-соединений, поэтому локальный режим там не работает.
&НаКлиенте
Процедура ПроверитьДоступностьЛокальногоРежима()

	Если ЛокальныйРежим И ГотовКРаботе И Не mcp_ОркестраторLLMКлиент.ДоступенЛокальныйРежим() Тогда
		ГотовКРаботе = Ложь;
		ПричинаНедоступности = "Локальный режим работает только в тонком клиенте: из браузера нет доступа "
			+ "к оркестратору на компьютере пользователя. Откройте базу в тонком клиенте или выключите "
			+ "локальный режим в личных настройках.";
		ФормаНастройки = "ФормаЛичныхНастроек";
	КонецЕсли;

КонецПроцедуры

// Открывает форму настроек обработки; после ее закрытия форма заново читает готовность.
//
// Параметры:
//  ИмяФормы - Строка - ФормаНастроек или ФормаЛичныхНастроек
//
&НаКлиенте
Процедура ОткрытьФормуНастройки(ИмяФормы)

	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияНастроек", ЭтотОбъект);
	ОткрытьФорму("Обработка.АнализКонфигурацииMCP.Форма." + ИмяФормы, , ЭтотОбъект, , , , Оповещение);

КонецПроцедуры

// Перечитывает готовность после закрытия формы настроек.
//
// Параметры:
//  Результат               - Произвольный - результат закрытия формы настроек
//  ДополнительныеПараметры - Неопределено
//
&НаКлиенте
Процедура ПослеЗакрытияНастроек(Результат, ДополнительныеПараметры) Экспорт

	Если ЗапросВыполняется Тогда
		Возврат;
	КонецЕсли;

	ПрочитатьГотовность();
	ПроверитьДоступностьЛокальногоРежима();
	ОбновитьФорму();

КонецПроцедуры

#КонецОбласти

#Область СерверныйРежим

// Начинает вопрос серверному оркестратору.
//
// Параметры:
//  Вопрос - Строка
//
// Возвращаемое значение:
//  Структура - см. mcp_ОркестраторLLM.НачатьВопрос
//
&НаСервереБезКонтекста
Функция НачатьВопросНаСервере(Знач Вопрос)

	Возврат mcp_ОркестраторLLM.НачатьВопрос(Вопрос);

КонецФункции

// Состояние вопроса серверному оркестратору.
//
// Параметры:
//  Идентификатор  - Строка - идентификатор запроса
//  ПоследнийНомер - Число - номер последнего полученного события
//
// Возвращаемое значение:
//  Структура - см. mcp_ОркестраторLLM.СостояниеВопроса
//
&НаСервереБезКонтекста
Функция СостояниеВопросаНаСервере(Знач Идентификатор, Знач ПоследнийНомер)

	Возврат mcp_ОркестраторLLM.СостояниеВопроса(Идентификатор, ПоследнийНомер);

КонецФункции

// Останавливает вопрос серверному оркестратору.
//
// Параметры:
//  Идентификатор - Строка - идентификатор запроса
//
&НаСервереБезКонтекста
Процедура ОтменитьВопросНаСервере(Знач Идентификатор)

	mcp_ОркестраторLLM.ОтменитьВопрос(Идентификатор);

КонецПроцедуры

#КонецОбласти

#Область ЛокальныйРежим

// Готовит вопрос локальному оркестратору: токен и тело запроса.
//
// Параметры:
//  Вопрос - Строка
//
// Возвращаемое значение:
//  Структура - см. mcp_ОркестраторLLM.НачатьЛокальныйВопрос
//
&НаСервереБезКонтекста
Функция НачатьЛокальныйВопросНаСервере(Знач Вопрос)

	Возврат mcp_ОркестраторLLM.НачатьЛокальныйВопрос(Вопрос);

КонецФункции

// Отзывает токен вопроса, который не удалось отправить, и возвращает причину.
//
// Параметры:
//  Идентификатор     - Строка - идентификатор запроса
//  ОтветОркестратора - Структура - см. mcp_ОркестраторLLMКлиент.ВыполнитьЗапрос
//
// Возвращаемое значение:
//  Строка
//
&НаСервереБезКонтекста
Функция ОтказЛокальногоВопросаНаСервере(Знач Идентификатор, Знач ОтветОркестратора)

	Возврат mcp_ОркестраторLLM.ОтказЛокальногоВопроса(Идентификатор, ОтветОркестратора);

КонецФункции

// Разбирает ответы локального оркестратора, полученные клиентом.
//
// Параметры:
//  Идентификатор  - Строка - идентификатор запроса
//  ПоследнийНомер - Число - номер последнего полученного события
//  ОтветСостояния - Структура - ответ на GET /requests/<идентификатор>
//  ОтветСобытий   - Структура - ответ на GET /events
//
// Возвращаемое значение:
//  Структура - см. mcp_ОркестраторLLM.СостояниеВопроса
//
&НаСервереБезКонтекста
Функция СостояниеЛокальногоВопросаНаСервере(Знач Идентификатор, Знач ПоследнийНомер, Знач ОтветСостояния,
	Знач ОтветСобытий)

	Возврат mcp_ОркестраторLLM.СостояниеЛокальногоВопроса(Идентификатор, ПоследнийНомер, ОтветСостояния,
		ОтветСобытий);

КонецФункции

// Отзывает токены вопроса текущего пользователя.
//
// Параметры:
//  Идентификатор - Строка - идентификатор запроса
//
&НаСервереБезКонтекста
Процедура ОтозватьТокеныНаСервере(Знач Идентификатор)

	mcp_ДоступПользователей.ОтозватьТокеныЗапроса(Идентификатор);

КонецПроцедуры

// Файлы для запуска локального оркестратора, см. mcp_ОркестраторLLM.ФайлыЛокальногоОркестратора.
//
// Параметры:
//  ИдентификаторФормы - УникальныйИдентификатор
//
// Возвращаемое значение:
//  Структура
//
&НаСервереБезКонтекста
Функция ФайлыЛокальногоОркестратораНаСервере(Знач ИдентификаторФормы)

	Возврат mcp_ОркестраторLLM.ФайлыЛокальногоОркестратора(ИдентификаторФормы);

КонецФункции

// Отправляет подготовленный вопрос локальному оркестратору с этого компьютера. Если оркестратор не
// отвечает и разрешен запуск, предлагает пользователю запустить Ollama и оркестратор.
//
// Параметры:
//  ПредлагатьЗапуск - Булево - Ложь после запуска: второй раз запуск не предлагается
//
&НаКлиенте
Процедура ОтправитьЛокальныйВопрос(ПредлагатьЗапуск)

	ТаймаутОтправки = 30;
	Ответ = mcp_ОркестраторLLMКлиент.ВыполнитьЗапрос(ЛокальныйВопрос.Подключение, "POST", "/requests",
		ЛокальныйВопрос.Тело, ТаймаутОтправки);

	КодПринято = 202;
	Если Ответ.КодСостояния = КодПринято Тогда
		ИдентификаторЗапроса = ЛокальныйВопрос.ИдентификаторЗапроса;
		ПодключениеЛокальное = ЛокальныйВопрос.Подключение;
		ЛокальныйВопрос      = Неопределено;
		ПодключитьОбработчикОжидания("ПроверитьХодЗапроса", 1, Истина);
	ИначеЕсли Ответ.ОшибкаСоединения И ПредлагатьЗапуск Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаОЗапуске", ЭтотОбъект);
		ТекстВопроса = СтрШаблон("Оркестратор не отвечает на %1. Запустить Ollama и оркестратор на этом компьютере?",
			АдресОркестратора);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, "Локальный режим");
	Иначе
		ОписаниеОшибки = ОтказЛокальногоВопросаНаСервере(ЛокальныйВопрос.ИдентификаторЗапроса, Ответ);
		ЛокальныйВопрос = Неопределено;
		Если Ответ.ОшибкаСоединения Тогда
			ОписаниеОшибки = СтрШаблон("Оркестратор не отвечает на %1 (%2). Запустите Ollama и LLM_Orchestrator.py "
				+ "или включите автозапуск в личных настройках.", АдресОркестратора, ОписаниеОшибки);
		КонецЕсли;
		ЗавершитьЗапрос(ОтветСОшибкой(ОписаниеОшибки));
	КонецЕсли;

КонецПроцедуры

// Продолжение после вопроса о запуске: выгружает оркестратор в каталог и запускает программы.
//
// Параметры:
//  Ответ                   - КодВозвратаДиалога
//  ДополнительныеПараметры - Неопределено
//
&НаКлиенте
Процедура ПослеВопросаОЗапуске(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		ОтказатьсяОтЛокальногоВопроса("Оркестратор не запущен: вопрос не отправлен");
		Возврат;
	КонецЕсли;

	Файлы = ФайлыЛокальногоОркестратораНаСервере(УникальныйИдентификатор);
	Если ЗначениеЗаполнено(Файлы.ОписаниеОшибки) Тогда
		ОтказатьсяОтЛокальногоВопроса(Файлы.ОписаниеОшибки);
		Возврат;
	КонецЕсли;

	ИдетЗапускОркестратора = Истина;
	ОбновитьФорму();

	Оповещение = Новый ОписаниеОповещения("ПослеПодготовкиКаталога", ЭтотОбъект, Файлы);
	Если ЗначениеЗаполнено(Файлы.КаталогОркестратора) Тогда
		НачатьСозданиеКаталога(Оповещение, Файлы.КаталогОркестратора);
	Иначе
		ФайловаяСистемаКлиент.СоздатьВременныйКаталог(Оповещение, "mcp");
	КонецЕсли;

КонецПроцедуры

// Записывает скрипт и файл конфигурации оркестратора в каталог без диалога выбора файлов.
//
// Параметры:
//  ИмяКаталога - Строка - каталог оркестратора
//  Файлы       - Структура - см. mcp_ОркестраторLLM.ФайлыЛокальногоОркестратора
//
&НаКлиенте
Процедура ПослеПодготовкиКаталога(ИмяКаталога, Файлы) Экспорт

	Если Не ЗначениеЗаполнено(ИмяКаталога) Тогда
		ОтказатьсяОтЛокальногоВопроса("Не удалось подготовить каталог оркестратора");
		Возврат;
	КонецЕсли;
	Файлы.Вставить("Каталог", ИмяКаталога);

	СохраняемыеФайлы = Новый Массив;
	СохраняемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(Файлы.ИмяСкрипта, Файлы.АдресСкрипта));
	СохраняемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(Файлы.ИмяКонфигурации, Файлы.АдресКонфигурации));

	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайлов();
	ПараметрыСохранения.Интерактивно = Ложь;
	ПараметрыСохранения.Диалог.Каталог = ИмяКаталога;

	Оповещение = Новый ОписаниеОповещения("ПослеВыгрузкиОркестратора", ЭтотОбъект, Файлы);
	ФайловаяСистемаКлиент.СохранитьФайлы(Оповещение, СохраняемыеФайлы, ПараметрыСохранения);

КонецПроцедуры

// Продолжение после записи файлов оркестратора: проверяет, что у Python есть пакет requests.
//
// Параметры:
//  ПолученныеФайлы - Массив из ОписаниеПереданногоФайла, Неопределено - записанные файлы
//  Файлы           - Структура - см. mcp_ОркестраторLLM.ФайлыЛокальногоОркестратора
//
&НаКлиенте
Процедура ПослеВыгрузкиОркестратора(ПолученныеФайлы, Файлы) Экспорт

	ЧислоФайлов = 2;
	Если ТипЗнч(ПолученныеФайлы) <> Тип("Массив") Или ПолученныеФайлы.Количество() < ЧислоФайлов Тогда
		ОтказатьсяОтЛокальногоВопроса("Не удалось записать файлы оркестратора в каталог " + Файлы.Каталог);
		Возврат;
	КонецЕсли;

	Разделитель = ПолучитьРазделительПутиКлиента();
	Каталог = Файлы.Каталог;
	Если Не СтрЗаканчиваетсяНа(Каталог, Разделитель) Тогда
		Каталог = Каталог + Разделитель;
	КонецЕсли;
	Файлы.Вставить("ПутьКСкрипту",      Каталог + Файлы.ИмяСкрипта);
	Файлы.Вставить("ПутьККонфигурации", Каталог + Файлы.ИмяКонфигурации);

	// Оркестратору нужен пакет requests: без него процесс завершается сразу после запуска. Отсутствие пакета
	// проверка сообщает своим кодом возврата: программа запускается через командную строку, и ненулевой код
	// приходит и тогда, когда не найден сам python
	Команда = Новый Массив;
	Команда.Добавить(Файлы.ПутьКPython);
	Команда.Добавить("-c");
	Команда.Добавить(СтрШаблон("import importlib.util, sys; sys.exit(0 if importlib.util.find_spec('requests') else %1)",
		Формат(КодНетПакетаRequests(), "ЧГ=")));
	ЗапуститьИДождаться(Команда, Новый ОписаниеОповещения("ПослеПроверкиЗависимостей", ЭтотОбъект, Файлы));

КонецПроцедуры

// Продолжение после проверки пакета requests: запуск либо предложение установить пакет.
//
// Параметры:
//  Результат - Структура - см. ФайловаяСистемаКлиент.ПараметрыЗапускаПрограммы, поле Оповещение
//  Файлы     - Структура - см. mcp_ОркестраторLLM.ФайлыЛокальногоОркестратора
//
&НаКлиенте
Процедура ПослеПроверкиЗависимостей(Результат, Файлы) Экспорт

	Если Не Результат.ПриложениеЗапущено Тогда
		ТекстОшибки = СтрШаблон("Не удалось запустить Python (%1): %2. Укажите путь к python.exe "
			+ "в личных настройках.", Файлы.ПутьКPython, Результат.ОписаниеОшибки);
		ОтказатьсяОтЛокальногоВопроса(ТекстОшибки);
	ИначеЕсли Результат.КодВозврата = 0 Тогда
		ЗапуститьOllamaИОркестратор(Файлы);
	ИначеЕсли Результат.КодВозврата = КодНетПакетаRequests() Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбУстановке", ЭтотОбъект, Файлы);
		ПоказатьВопрос(Оповещение, "Оркестратору нужен пакет Python requests, а он не установлен. Установить его "
			+ "командой ""python -m pip install --user requests""?", РежимДиалогаВопрос.ДаНет, ,
			КодВозвратаДиалога.Да, "Локальный режим");
	Иначе
		ТекстОшибки = СтрШаблон("Python не запустился (%1), код возврата %2. Укажите путь к python.exe "
			+ "в личных настройках.", Файлы.ПутьКPython, Формат(Результат.КодВозврата, "ЧН=0; ЧГ="));
		ОтказатьсяОтЛокальногоВопроса(ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

// Код возврата проверки зависимостей, которым Python сообщает, что пакета requests нет.
//
// Возвращаемое значение:
//  Число
//
&НаКлиенте
Функция КодНетПакетаRequests()

	Возврат 3;

КонецФункции

// Устанавливает пакет requests, если пользователь согласился.
//
// Параметры:
//  Ответ - КодВозвратаДиалога
//  Файлы - Структура - см. mcp_ОркестраторLLM.ФайлыЛокальногоОркестратора
//
&НаКлиенте
Процедура ПослеВопросаОбУстановке(Ответ, Файлы) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		ОтказатьсяОтЛокальногоВопроса("Оркестратор не запущен: не установлен пакет Python requests");
		Возврат;
	КонецЕсли;

	Команда = Новый Массив;
	Команда.Добавить(Файлы.ПутьКPython);
	Команда.Добавить("-m");
	Команда.Добавить("pip");
	Команда.Добавить("install");
	Команда.Добавить("--user");
	Команда.Добавить("requests");
	ЗапуститьИДождаться(Команда, Новый ОписаниеОповещения("ПослеУстановкиЗависимостей", ЭтотОбъект, Файлы));

КонецПроцедуры

// Запускает оркестратор после установки пакета requests.
//
// Параметры:
//  Результат - Структура - результат запуска pip
//  Файлы     - Структура - см. mcp_ОркестраторLLM.ФайлыЛокальногоОркестратора
//
&НаКлиенте
Процедура ПослеУстановкиЗависимостей(Результат, Файлы) Экспорт

	Если Результат.ПриложениеЗапущено И Результат.КодВозврата = 0 Тогда
		ЗапуститьOllamaИОркестратор(Файлы);
	Иначе
		ОтказатьсяОтЛокальногоВопроса("pip не установил пакет requests. Выполните вручную: "
			+ Файлы.ПутьКPython + " -m pip install requests");
	КонецЕсли;

КонецПроцедуры

// Запускает Ollama, если она не отвечает, и оркестратор с выгруженным файлом конфигурации, затем
// ждет, пока оркестратор начнет отвечать.
//
// Параметры:
//  Файлы - Структура - см. mcp_ОркестраторLLM.ФайлыЛокальногоОркестратора
//
&НаКлиенте
Процедура ЗапуститьOllamaИОркестратор(Файлы)

	Если Не ОтвечаетOllama(Файлы.Хост) Тогда
		КомандаOllama = Новый Массив;
		Если ЗначениеЗаполнено(Файлы.ПутьКOllama) Тогда
			КомандаOllama.Добавить(Файлы.ПутьКOllama);
		Иначе
			КомандаOllama.Добавить("ollama");
		КонецЕсли;
		КомандаOllama.Добавить("serve");
		ЗапуститьФоновуюПрограмму(КомандаOllama, "");
	КонецЕсли;

	КомандаОркестратора = Новый Массив;
	КомандаОркестратора.Добавить(Файлы.ПутьКPython);
	КомандаОркестратора.Добавить(Файлы.ПутьКСкрипту);
	КомандаОркестратора.Добавить("--config");
	КомандаОркестратора.Добавить(Файлы.ПутьККонфигурации);
	ЗапуститьФоновуюПрограмму(КомандаОркестратора, Файлы.Каталог);

	СекундОжиданияЗапуска = 120;
	ИнтервалПроверки = 2;
	СрокЗапуска = ОбщегоНазначенияКлиент.ДатаСеанса() + СекундОжиданияЗапуска;
	ПодключитьОбработчикОжидания("ПроверитьЗапускОркестратора", ИнтервалПроверки, Истина);

КонецПроцедуры

// Запускает программу и вызывает оповещение после ее завершения.
//
// Параметры:
//  Команда    - Массив из Строка - программа и ее аргументы
//  Оповещение - ОписаниеОповещения - получает результат, см. ФайловаяСистемаКлиент.ПараметрыЗапускаПрограммы
//
&НаКлиенте
Процедура ЗапуститьИДождаться(Команда, Оповещение)

	ПараметрыЗапуска = ФайловаяСистемаКлиент.ПараметрыЗапускаПрограммы();
	ПараметрыЗапуска.ДождатьсяЗавершения = Истина;
	ПараметрыЗапуска.Оповещение = Оповещение;
	ФайловаяСистемаКлиент.ЗапуститьПрограмму(Команда, ПараметрыЗапуска);

КонецПроцедуры

// Запускает программу без ожидания ее завершения: Ollama и оркестратор работают, пока их не закроют.
//
// Параметры:
//  Команда        - Массив из Строка - программа и ее аргументы
//  ТекущийКаталог - Строка
//
&НаКлиенте
Процедура ЗапуститьФоновуюПрограмму(Команда, ТекущийКаталог)

	ПараметрыЗапуска = ФайловаяСистемаКлиент.ПараметрыЗапускаПрограммы();
	ПараметрыЗапуска.ДождатьсяЗавершения = Ложь;
	ПараметрыЗапуска.ТекущийКаталог = ТекущийКаталог;
	ФайловаяСистемаКлиент.ЗапуститьПрограмму(Команда, ПараметрыЗапуска);

КонецПроцедуры

// Истина, если Ollama на этом компьютере отвечает на стандартном порту.
//
// Параметры:
//  Хост - Строка - адрес, на котором слушает локальный оркестратор
//
// Возвращаемое значение:
//  Булево
//
&НаКлиенте
Функция ОтвечаетOllama(Хост)

	ПортOllama = 11434;
	Подключение = Новый Структура("Хост, Порт, Путь, Защищенное, ПроверятьСертификат, Ключ",
		Хост, ПортOllama, "", Ложь, Ложь, "");
	ТаймаутПроверки = 3;
	Ответ = mcp_ОркестраторLLMКлиент.ВыполнитьЗапрос(Подключение, "GET", "/api/version", Неопределено,
		ТаймаутПроверки);
	КодУспеха = 200;
	Возврат Ответ.КодСостояния = КодУспеха;

КонецФункции

// Раз в две секунды проверяет, отвечает ли запущенный оркестратор, и отправляет ему вопрос.
&НаКлиенте
Процедура ПроверитьЗапускОркестратора()

	Если Не ЗапросВыполняется Или ЛокальныйВопрос = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Без ключа оркестратор отвечает на /health сразу, не опрашивая Ollama
	ПодключениеБезКлюча = Новый Структура("Хост, Порт, Путь, Защищенное, ПроверятьСертификат, Ключ");
	ЗаполнитьЗначенияСвойств(ПодключениеБезКлюча, ЛокальныйВопрос.Подключение, , "Ключ");
	ПодключениеБезКлюча.Ключ = "";
	ТаймаутПроверки = 5;
	Ответ = mcp_ОркестраторLLMКлиент.ВыполнитьЗапрос(ПодключениеБезКлюча, "GET", "/health", Неопределено,
		ТаймаутПроверки);
	КодУспеха = 200;
	ИнтервалПроверки = 2;
	Если Ответ.КодСостояния = КодУспеха Тогда
		ИдетЗапускОркестратора = Ложь;
		ОтправитьЛокальныйВопрос(Ложь);
	ИначеЕсли ОбщегоНазначенияКлиент.ДатаСеанса() > СрокЗапуска Тогда
		ОтказатьсяОтЛокальногоВопроса("Оркестратор не начал отвечать за 2 минуты после запуска. Причина "
			+ "обычно видна в его окне: не найдена модель Ollama, недоступна публикация MCP или занят порт.");
	Иначе
		ОбновитьНадписьСостояния();
		ПодключитьОбработчикОжидания("ПроверитьЗапускОркестратора", ИнтервалПроверки, Истина);
	КонецЕсли;

КонецПроцедуры

// Отзывает токен неотправленного вопроса и показывает причину.
//
// Параметры:
//  Причина - Строка
//
&НаКлиенте
Процедура ОтказатьсяОтЛокальногоВопроса(Причина)

	Если ЛокальныйВопрос <> Неопределено Тогда
		ОтозватьТокеныНаСервере(ЛокальныйВопрос.ИдентификаторЗапроса);
		ЛокальныйВопрос = Неопределено;
	КонецЕсли;
	ЗавершитьЗапрос(ОтветСОшибкой(Причина));

КонецПроцедуры

// Состояние вопроса локальному оркестратору: запросы выполняет клиент, разбирает ответы сервер.
//
// Возвращаемое значение:
//  Структура - см. mcp_ОркестраторLLM.СостояниеВопроса
//
&НаКлиенте
Функция СостояниеЛокальногоВопроса()

	ТаймаутОпроса = 5;
	// Состояние читается раньше событий: если запрос уже завершен, в журнале есть все его события
	ОтветСостояния = mcp_ОркестраторLLMКлиент.ВыполнитьЗапрос(ПодключениеЛокальное, "GET",
		"/requests/" + ИдентификаторЗапроса, Неопределено, ТаймаутОпроса);
	ОтветСобытий = mcp_ОркестраторLLMКлиент.ВыполнитьЗапрос(ПодключениеЛокальное, "GET",
		СтрШаблон("/events?request=%1&since=%2", ИдентификаторЗапроса, Формат(ПоследнийНомерСобытия, "ЧН=0; ЧГ=")),
		Неопределено, ТаймаутОпроса);

	Возврат СостояниеЛокальногоВопросаНаСервере(ИдентификаторЗапроса, ПоследнийНомерСобытия, ОтветСостояния,
		ОтветСобытий);

КонецФункции

#КонецОбласти

#Область ВыполнениеЗапроса

// Раз в секунду забирает состояние запроса и новые события журнала оркестратора. Останавливает
// запрос, если оркестратор долго не отвечает или модель не уложилась в срок ответа.
&НаКлиенте
Процедура ПроверитьХодЗапроса()

	Если Не ЗапросВыполняется Тогда
		Возврат;
	КонецЕсли;

	Если ЛокальныйРежим Тогда
		Состояние = СостояниеЛокальногоВопроса();
	Иначе
		Состояние = СостояниеВопросаНаСервере(ИдентификаторЗапроса, ПоследнийНомерСобытия);
	КонецЕсли;

	ПоследнийНомерСобытия = Состояние.Номер;
	Для Каждого Событие Из Состояние.События Цикл
		СобытияЗапроса.Добавить(Событие);
	КонецЦикла;

	Если Состояние.Завершен Тогда
		ЗавершитьЗапрос(Состояние.Ответ);
		Возврат;
	КонецЕсли;

	Если Состояние.Связь Тогда
		ОпросовБезСвязи = 0;
	Иначе
		ОпросовБезСвязи = ОпросовБезСвязи + 1;
	КонецЕсли;

	МаксимумОпросовБезСвязи = 60;
	Если ОпросовБезСвязи >= МаксимумОпросовБезСвязи Тогда
		ОстановитьЗапросСОшибкой("Оркестратор не отвечает больше минуты: запрос остановлен", Истина);
	ИначеЕсли ТаймаутОтвета > 0 И ОбщегоНазначенияКлиент.ДатаСеанса() - ВремяНачала > ТаймаутОтвета Тогда
		ТекстОшибки = "Модель не ответила за " + ПредставлениеСекунд(ТаймаутОтвета) + ": запрос остановлен";
		ОстановитьЗапросСОшибкой(ТекстОшибки, Ложь);
	Иначе
		ОбновитьНадписьСостояния(Состояние.Связь);
		Если ЗначениеЗаполнено(Состояние.События) Тогда
			ОбновитьОтвет();
		КонецЕсли;
		ПодключитьОбработчикОжидания("ПроверитьХодЗапроса", 1, Истина);
	КонецЕсли;

КонецПроцедуры

// Просит оркестратор остановить текущий запрос и отзывает токен вопроса.
&НаКлиенте
Процедура ОтменитьЗапросОркестратора()

	Если Не ЛокальныйРежим Тогда
		ОтменитьВопросНаСервере(ИдентификаторЗапроса);
		Возврат;
	КонецЕсли;

	ТаймаутОтмены = 5;
	mcp_ОркестраторLLMКлиент.ВыполнитьЗапрос(ПодключениеЛокальное, "POST", "/requests/" + ИдентификаторЗапроса
		+ "/cancel", Неопределено, ТаймаутОтмены);
	ОтозватьТокеныНаСервере(ИдентификаторЗапроса);

КонецПроцедуры

// Останавливает запрос у оркестратора и показывает причину.
//
// Параметры:
//  ТекстОшибки      - Строка
//  ОшибкаСоединения - Булево - оркестратор перестал отвечать
//
&НаКлиенте
Процедура ОстановитьЗапросСОшибкой(ТекстОшибки, ОшибкаСоединения)

	ОтменитьЗапросОркестратора();
	Ответ = ОтветСОшибкой(ТекстОшибки, ОшибкаСоединения);
	ЗавершитьЗапрос(Ответ);

КонецПроцедуры

// Отменяет отправленный вопрос или отзывает токен вопроса, который еще ждет запуска оркестратора.
&НаКлиенте
Процедура ПрерватьНезавершенныйЗапрос()

	Если ЛокальныйВопрос <> Неопределено Тогда
		ОтозватьТокеныНаСервере(ЛокальныйВопрос.ИдентификаторЗапроса);
		ЛокальныйВопрос = Неопределено;
	КонецЕсли;
	Если ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		ОтменитьЗапросОркестратора();
	КонецЕсли;

КонецПроцедуры

// Почему вопрос сейчас отправить нельзя.
//
// Возвращаемое значение:
//  Строка - пусто, если можно
//
&НаКлиенте
Функция ПричинаНевозможностиВопроса()

	Если Не ГотовКРаботе Тогда
		Возврат ПричинаНедоступности;
	ИначеЕсли ЗапросВыполняется Тогда
		Возврат "Модель еще отвечает на предыдущий вопрос. Дождитесь ответа.";
	ИначеЕсли Не ЗначениеЗаполнено(СокрЛП(ТекстЗапросMCP)) Тогда
		Возврат "Заполните текст запроса и повторите попытку";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Показывает итоговый ответ. Если оркестратор вернул полный ход выполнения, он заменяет события,
// полученные формой между проверками.
//
// Параметры:
//  Ответ - Структура - ответ, см. mcp_ОркестраторLLM.ОтправитьВопрос
//
&НаКлиенте
Процедура ЗавершитьЗапрос(Ответ)

	ЗапросВыполняется      = Ложь;
	ИдетЗапускОркестратора = Ложь;
	ИдентификаторЗапроса   = "";

	Если ЗначениеЗаполнено(Ответ.ХодВыполнения) Тогда
		СобытияЗапроса = Ответ.ХодВыполнения;
	КонецЕсли;

	Если Ответ.ОшибкаСоединения И Не ЛокальныйРежим Тогда
		Ответ.ОписаниеОшибки = "Серверный оркестратор не отвечает (" + Ответ.ОписаниеОшибки + "). "
			+ "Проверьте подключение кнопкой ""Проверить"" в личных настройках или обратитесь к администратору.";
	КонецЕсли;

	ОтветЗапроса = Ответ;
	ОбновитьФорму();

КонецПроцедуры

// Ответ с ошибкой в составе ответа оркестратора.
//
// Параметры:
//  ОписаниеОшибки   - Строка
//  ОшибкаСоединения - Булево - оркестратор не ответил
//
// Возвращаемое значение:
//  Структура - см. mcp_ОркестраторLLM.ОтправитьВопрос
//
&НаКлиенте
Функция ОтветСОшибкой(ОписаниеОшибки, ОшибкаСоединения = Ложь)

	Ответ = Новый Структура;
	Ответ.Вставить("Ответ",            Ложь);
	Ответ.Вставить("Текст",            "");
	Ответ.Вставить("Результат",        Неопределено);
	Ответ.Вставить("ОписаниеОшибки",   ОписаниеОшибки);
	Ответ.Вставить("ОшибкаСоединения", ОшибкаСоединения);
	Ответ.Вставить("ХодВыполнения",    Новый Массив);
	Возврат Ответ;

КонецФункции

// Обновляет доступность команд, надпись состояния и поле ответа.
&НаКлиенте
Процедура ОбновитьФорму()

	// Кнопка остановки встает на место кнопки вопроса, чтобы ряд кнопок не менял ширину колонки
	Элементы.ВыполнитьЗапрос.Доступность        = ГотовКРаботе;
	Элементы.ВыполнитьЗапрос.Видимость          = Не ЗапросВыполняется;
	Элементы.ОстановитьЗапрос.Видимость         = ЗапросВыполняется;
	Элементы.ОткрытьНастройки.Доступность       = Не ЗапросВыполняется;
	Элементы.ОткрытьЛичныеНастройки.Доступность = Не ЗапросВыполняется;
	ОбновитьНадписьСостояния();
	ОбновитьОтвет();

КонецПроцедуры

// Текст над полем ответа: режим работы, время выполнения, номер шага и связь с оркестратором.
//
// Параметры:
//  Связь - Булево - оркестратор ответил на последний опрос
//
&НаКлиенте
Процедура ОбновитьНадписьСостояния(Связь = Истина)

	Если ИдетЗапускОркестратора Тогда
		ТекстСостояния = "Запускаются Ollama и оркестратор на этом компьютере, вопрос уйдет, когда они ответят";
	ИначеЕсли ЗапросВыполняется Тогда
		СекундВМинуте = 60;
		Секунд = ОбщегоНазначенияКлиент.ДатаСеанса() - ВремяНачала;
		ТекстСостояния = СтрШаблон("Модель работает %1:%2, шаг %3",
			Формат(Цел(Секунд / СекундВМинуте), "ЧН=0; ЧГ="), Формат(Секунд % СекундВМинуте, "ЧЦ=2; ЧВН=; ЧН=00"),
			ТекущийШаг());
		Если Не Связь Тогда
			ТекстСостояния = ТекстСостояния + ". Оркестратор не ответил на опрос, повторяю";
		КонецЕсли;
	ИначеЕсли Не ГотовКРаботе Тогда
		ТекстСостояния = "Подключение к LLM не готово";
	ИначеЕсли ОтветЗапроса = Неопределено Тогда
		ТекстСостояния = СтрШаблон("%1. Инструментов MCP: %2. Задайте вопрос и нажмите ""Спросить""",
			ПредставлениеРежима(), КоличествоИнструментов);
	ИначеЕсли ОтветЗапроса.Ответ Тогда
		ТекстСостояния = "Ответ получен за " + ПредставлениеСекунд(ОбщегоНазначенияКлиент.ДатаСеанса() - ВремяНачала);
	Иначе
		ТекстСостояния = "Запрос завершился ошибкой";
	КонецЕсли;

	Элементы.ДекорацияСостояние.Заголовок = ТекстСостояния;

КонецПроцедуры

// Режим работы для надписи состояния.
//
// Возвращаемое значение:
//  Строка - например "Серверный режим, оркестратор https://llm:9000"
//
&НаКлиенте
Функция ПредставлениеРежима()

	Если ЛокальныйРежим Тогда
		Возврат "Локальный режим, оркестратор на этом компьютере";
	КонецЕсли;
	Возврат "Серверный режим, оркестратор " + АдресОркестратора;

КонецФункции

// Номер шага модели, который выполняется сейчас: по последнему событию llm_start.
//
// Возвращаемое значение:
//  Число
//
&НаКлиенте
Функция ТекущийШаг()

	Шаг = 1;
	Для Каждого Событие Из СобытияЗапроса Цикл
		Если Событие.kind = "llm_start" Тогда
			Шаг = Макс(Шаг, ЗначениеПоля(Событие.data, "step", 1));
		КонецЕсли;
	КонецЦикла;

	Возврат Шаг;

КонецФункции

#КонецОбласти

#Область ОформлениеОтвета

// Читает HTML-шаблон ответа из макета ОформлениеОтвета: страницу со стилями и логотип,
// который записан в конце макета после метки <!--LOGOIMAGE-->. Логотип - PNG в base64, а не SVG:
// поле HTML тонкого клиента на Windows рисует встроенный SVG без градиентов и текста.
&НаСервере
Процедура ЗагрузитьОформлениеОтвета()

	Обработка = РеквизитФормыВЗначение("Объект");
	ТекстМакета = ПолучитьСтрокуИзДвоичныхДанных(Обработка.ПолучитьМакет("ОформлениеОтвета"), КодировкаТекста.UTF8);

	Метка = "<!--LOGOIMAGE-->";
	Позиция = СтрНайти(ТекстМакета, Метка);
	ШаблонHTML  = Лев(ТекстМакета, Позиция - 1);
	ЛоготипHTML = СокрЛП(Сред(ТекстМакета, Позиция + СтрДлина(Метка)));
	ШаблонHTML  = СтрЗаменить(ШаблонHTML, "<!--LOGO-->", ЛоготипHTML);

КонецПроцедуры

// Собирает HTML поля ответа по текущему состоянию: приветствие, вопрос, ход выполнения, ответ.
&НаКлиенте
Процедура ОбновитьОтвет()

	Если ВопросЗапроса = Неопределено Тогда
		Если ГотовКРаботе Тогда
			Содержимое = HTMLПриветствия();
		Иначе
			Содержимое = HTMLНедоступности();
		КонецЕсли;
		ОтветHTML = СтраницаHTML(HTMLСостояния(), Содержимое, "");
		Возврат;
	КонецЕсли;

	Содержимое = "<div class=""card question""><div class=""label"">Вопрос</div><div class=""text"">"
		+ Экранировать(ВопросЗапроса) + "</div></div>";

	Если ПоказыватьХодВыполнения И ЗначениеЗаполнено(СобытияЗапроса) Тогда
		Содержимое = Содержимое + HTMLХодаВыполнения();
	КонецЕсли;

	Если ИдетЗапускОркестратора Тогда
		Содержимое = Содержимое + "<div class=""card waiting""><span class=""spin""></span>"
			+ "<div class=""big"">Запускаются Ollama и оркестратор</div>"
			+ "<div>Вопрос уйдет модели, когда оркестратор начнет отвечать: обычно через 10-30 секунд.</div></div>";
		Скрипт = "";
	ИначеЕсли ЗапросВыполняется Тогда
		Содержимое = Содержимое + "<div class=""card waiting""><span class=""spin""></span>"
			+ "<div class=""big"">Модель работает: шаг " + ТекущийШаг() + "</div>"
			+ "<div>Модель читает ответы инструментов 1С. Обычно ответ занимает от 30 секунд до нескольких минут."
			+ "</div></div>";
		Скрипт = "window.onload = function () { window.scrollTo(0, document.body.scrollHeight); };";
	Иначе
		Содержимое = Содержимое + HTMLИтоговогоОтвета();
		// scrollIntoView прокрутил бы и форму, в которой стоит поле HTML, поэтому прокручивается только документ поля
		Скрипт = "window.onload = function () { var a = document.getElementById(""answer""); if (a) { window.scrollTo(0, Math.max(0, a.offsetTop - 12)); } };";
	КонецЕсли;

	ОтветHTML = СтраницаHTML(HTMLСостояния(), Содержимое, Скрипт);

КонецПроцедуры

// Подставляет в шаблон статус, содержимое и скрипт страницы.
//
// Параметры:
//  Статус     - Строка - HTML значка состояния в шапке
//  Содержимое - Строка - HTML основной части страницы
//  Скрипт     - Строка - JavaScript, который выполняется при загрузке
//
// Возвращаемое значение:
//  Строка - HTML-документ
//
&НаКлиенте
Функция СтраницаHTML(Статус, Содержимое, Скрипт)

	Текст = СтрЗаменить(ШаблонHTML, "<!--STATUS-->", Статус);
	Текст = СтрЗаменить(Текст, "<!--CONTENT-->", Содержимое);
	Возврат СтрЗаменить(Текст, "<!--SCRIPT-->", Скрипт);

КонецФункции

// Значок состояния в шапке: ожидание, работа модели, ответ или ошибка.
&НаКлиенте
Функция HTMLСостояния()

	Если ЗапросВыполняется Тогда
		Возврат "<span class=""pill busy""><span class=""dot""></span>Модель работает</span>";
	ИначеЕсли ОтветЗапроса = Неопределено И Не ГотовКРаботе Тогда
		Возврат "<span class=""pill err""><span class=""dot""></span>Не настроено</span>";
	ИначеЕсли ОтветЗапроса = Неопределено Тогда
		Возврат "<span class=""pill""><span class=""dot""></span>Готов к вопросу</span>";
	ИначеЕсли ОтветЗапроса.Ответ Тогда
		Возврат "<span class=""pill ok""><span class=""dot""></span>Ответ получен</span>";
	Иначе
		Возврат "<span class=""pill err""><span class=""dot""></span>Ошибка</span>";
	КонецЕсли;

КонецФункции

// Стартовый экран: логотип, где работает модель, и примеры вопросов к инструментам конфигурации.
//
// Возвращаемое значение:
//  Строка - HTML
//
&НаКлиенте
Функция HTMLПриветствия()

	ТекстПримеров = "";
	Номер = 0;
	Для Каждого Пример Из ПримерыВопросов() Цикл
		ТекстПримеров = ТекстПримеров + "<a href=""#ask:" + Формат(Номер, "ЧН=0; ЧГ=") + """><b>?</b>"
			+ Экранировать(Пример) + "</a>";
		Номер = Номер + 1;
	КонецЦикла;

	Если ЛокальныйРежим Тогда
		ГдеМодель = "Модель работает на этом компьютере через Ollama";
	Иначе
		ГдеМодель = "Модель работает на сервере LLM вашей организации через Ollama";
	КонецЕсли;

	Возврат "<div class=""welcome"">" + ЛоготипHTML
		+ "<h2>Спросите базу обычным языком</h2>"
		+ "<p>" + ГдеМодель + " и вызывает инструменты 1С по протоколу MCP с вашими правами.<br>"
		+ "Данные базы не уходят во внешние сервисы.</p>"
		+ "<div class=""examples"">" + ТекстПримеров + "</div>"
		+ "<p class=""tiny"">Нажмите на пример, чтобы задать этот вопрос</p></div>";

КонецФункции

// Стартовый экран, когда вопрос задать нельзя: причина и где ее исправить.
//
// Возвращаемое значение:
//  Строка - HTML
//
&НаКлиенте
Функция HTMLНедоступности()

	Если ФормаНастройки = "ФормаНастроек" Тогда
		Подсказка = "Настройки открываются кнопкой ""Настройки"". После записи нажмите ""Проверить"": "
			+ "проверка покажет, что еще не готово.";
	ИначеЕсли ЗначениеЗаполнено(ФормаНастройки) Тогда
		Подсказка = "Личные настройки открываются кнопкой ""Мои настройки"".";
	Иначе
		Подсказка = "Проверить подключение можно кнопкой ""Проверить"" в личных настройках.";
	КонецЕсли;

	Возврат "<div class=""welcome"">" + ЛоготипHTML + "<h2>Подключение к LLM не готово</h2></div>"
		+ "<div class=""card answer error""><div class=""label"">Что случилось</div>"
		+ "<div class=""summary"">" + Экранировать(ПричинаНедоступности) + "</div>"
		+ "<div class=""hint"">" + Экранировать(Подсказка) + "</div></div>";

КонецФункции

// Примеры вопросов на стартовом экране: по одному на основные инструменты конфигурации.
&НаКлиенте
Функция ПримерыВопросов()

	Примеры = Новый Массив;
	Примеры.Добавить("Какая версия платформы и конфигурации?");
	Примеры.Добавить("Какие реквизиты у документа ""Перемещение товаров""?");
	Примеры.Добавить("Какие документы делают движения по регистру ТоварыНаСкладах?");
	Примеры.Добавить("Какие есть отчеты по продажам и какие у них параметры?");
	Возврат Примеры;

КонецФункции

// Ход выполнения в виде светлого терминала: шаги модели, вызовы инструментов, время и контекст.
&НаКлиенте
Функция HTMLХодаВыполнения()

	ЗавершенныеШаги = Новый Соответствие;
	Для Каждого Событие Из СобытияЗапроса Цикл
		Если Событие.kind = "llm_done" Тогда
			ЗавершенныеШаги.Вставить(ЗначениеПоля(Событие.data, "step", 0), Истина);
		КонецЕсли;
	КонецЦикла;

	Строки = "";
	Номер = 0;
	Для Каждого Событие Из СобытияЗапроса Цикл
		Номер = Номер + 1;
		Строки = Строки + HTMLСобытия(Событие, Номер, ЗавершенныеШаги);
	КонецЦикла;

	Возврат "<div class=""term""><div class=""termbar mono"">"
		+ "<i style=""background:#FF6B6B""></i><i style=""background:#FFC94D""></i><i style=""background:#6EE7A8""></i>"
		+ "<span class=""t"">Ход выполнения  ·  журнал LLM-оркестратора</span></div>"
		+ "<div class=""lines mono"">" + Строки + "</div></div>";

КонецФункции

// Строка хода выполнения для одного события журнала оркестратора.
//
// Параметры:
//  Событие         - Структура - событие журнала: time, kind, level, text, data
//  Номер           - Число - порядковый номер события, из него строится id раскрываемого блока
//  ЗавершенныеШаги - Соответствие - номера шагов модели, на которые уже получен ответ
//
// Возвращаемое значение:
//  Строка - HTML строки; пустая строка для служебных событий
//
&НаКлиенте
Функция HTMLСобытия(Событие, Номер, ЗавершенныеШаги)

	Данные = Событие.data;
	Вид = Событие.kind;
	Время = "<span class=""tm"">" + Экранировать(Событие.time) + "</span>";

	Если Вид = "llm_start" Тогда
		Шаг = ЗначениеПоля(Данные, "step", 0);
		Признак = "";
		Если ЗапросВыполняется И ЗавершенныеШаги.Получить(Шаг) = Неопределено Тогда
			Признак = "<span class=""spin""></span>";
		КонецЕсли;
		Возврат "<div class=""ln"">" + Время + "<span class=""k llm"">LLM</span>Шаг " + Шаг
			+ ": модель формирует ответ" + Признак + "</div>";

	ИначеЕсли Вид = "llm_done" Тогда
		Возврат "<div class=""ln"">" + Время + "<span class=""k llm"">LLM</span>" + HTMLШагаМодели(Данные) + "</div>";

	ИначеЕсли Вид = "tool_call" Тогда
		Возврат "<div class=""ln"">" + Время + "<span class=""k mcp"">MCP CALL</span>"
			+ Экранировать(ЗначениеПоля(Данные, "tool", "")) + " <span class=""c"">"
			+ Экранировать(ЗначениеПоля(Данные, "arguments_text", "")) + "</span></div>";

	ИначеЕсли Вид = "tool_result" Тогда
		ИдБлока = "p" + Формат(Номер, "ЧГ=");
		ОписаниеОтвета = ПредставлениеЧисла(ЗначениеПоля(Данные, "chars", 0)) + " симв.  ·  "
			+ ПредставлениеСекунд(ЗначениеПоля(Данные, "seconds", 0));
		Если ЗначениеПоля(Данные, "truncated", Ложь) = Истина Тогда
			ОписаниеОтвета = ОписаниеОтвета + "  ·  обрезано для контекста модели";
		КонецЕсли;
		КлассИнструмента = "";
		Если ЗначениеПоля(Данные, "is_error", Ложь) = Истина Тогда
			КлассИнструмента = " class=""err""";
		КонецЕсли;
		Возврат "<div class=""ln"">" + Время + "<span class=""k mcp"">MCP RESPONSE</span><span" + КлассИнструмента + ">"
			+ Экранировать(ЗначениеПоля(Данные, "tool", "")) + "</span>  <span class=""dim"">" + ОписаниеОтвета + "</span>  "
			+ "<span class=""more"" onclick=""return mcpToggle('" + ИдБлока + "')"">показать ответ</span></div>"
			+ "<div class=""preview"" id=""" + ИдБлока + """>" + Экранировать(ЗначениеПоля(Данные, "preview", "")) + "</div>";

	ИначеЕсли Вид = "final" Тогда
		Возврат "<div class=""ln"">" + Время + "<span class=""k ok"">ГОТОВО</span>"
			+ "<span class=""dim"">шагов: " + ЗначениеПоля(Данные, "steps", 0) + "  ·  "
			+ ПредставлениеСекунд(ЗначениеПоля(Данные, "seconds", 0)) + "</span></div>";

	ИначеЕсли Вид = "error" Тогда
		Возврат "<div class=""ln"">" + Время + "<span class=""k err"">ОШИБКА</span>"
			+ Экранировать(Событие.text) + "</div>";

	ИначеЕсли Вид = "warning" Или (Вид = "log" И Событие.level <> "INFO") Тогда
		Возврат "<div class=""ln"">" + Время + "<span class=""k warn"">ВНИМАНИЕ</span><span class=""warn"">"
			+ Экранировать(Событие.text) + "</span></div>";

	Иначе
		// Начало запроса (вопрос показан отдельной карточкой) и информационные записи лога
		Возврат "";
	КонецЕсли;

КонецФункции

// Описание завершенного шага модели: время, заполнение контекста, число токенов ответа и решение модели.
//
// Параметры:
//  Данные - Структура - данные события llm_done
//
// Возвращаемое значение:
//  Строка - HTML
//
&НаКлиенте
Функция HTMLШагаМодели(Данные)

	Текст = "Шаг " + ЗначениеПоля(Данные, "step", 0) + ": " + ПредставлениеСекунд(ЗначениеПоля(Данные, "seconds", 0)) + "  ";

	ТокеновПромпта = ЗначениеПоля(Данные, "prompt_tokens", 0);
	РазмерКонтекста = ЗначениеПоля(Данные, "num_ctx", 0);
	Если ЗначениеЗаполнено(ТокеновПромпта) И ЗначениеЗаполнено(РазмерКонтекста) Тогда
		Доля = Мин(1, ТокеновПромпта / РазмерКонтекста);
		Заполнен = Доля >= 0.98;
		КлассПолосы = "bar";
		Пометка = "";
		Если Заполнен Тогда
			КлассПолосы = "bar full";
			Пометка = " (заполнен)";
		КонецЕсли;
		Текст = Текст + "<span class=""" + КлассПолосы + """><i style=""width:" + Формат(Окр(Доля * 100), "ЧН=0; ЧГ=")
			+ "%""></i></span> <span class=""dim"">контекст " + ПредставлениеЧисла(ТокеновПромпта) + " / "
			+ ПредставлениеЧисла(РазмерКонтекста) + " ток." + Пометка + "  ·  ответ "
			+ ПредставлениеЧисла(ЗначениеПоля(Данные, "output_tokens", 0)) + " ток.</span>";
	КонецЕсли;

	Действие = ЗначениеПоля(Данные, "action", "");
	Если Действие = "call_tool" Тогда
		Текст = Текст + "  →  <span class=""v"">вызов " + Экранировать(ЗначениеПоля(Данные, "tool", "")) + "</span>";
	ИначеЕсли Действие = "final" Тогда
		Текст = Текст + "  →  <span class=""ok"">итоговый ответ</span>";
	Иначе
		Текст = Текст + "  →  <span class=""warn"">" + Экранировать(Строка(Действие)) + "</span>";
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Карточка итогового ответа: краткий текст модели, сводка по шагам и данные из Result.
&НаКлиенте
Функция HTMLИтоговогоОтвета()

	Если ОтветЗапроса = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ИспользованныеИнструменты = Новый Массив;
	Сводка = "";
	Для Каждого Событие Из СобытияЗапроса Цикл
		Если Событие.kind = "tool_call" Тогда
			ИмяИнструмента = ЗначениеПоля(Событие.data, "tool", "");
			Если ИспользованныеИнструменты.Найти(ИмяИнструмента) = Неопределено Тогда
				ИспользованныеИнструменты.Добавить(ИмяИнструмента);
			КонецЕсли;
		ИначеЕсли Событие.kind = "final" Или Событие.kind = "error" Тогда
			Сводка = "Ответ за " + ПредставлениеСекунд(ЗначениеПоля(Событие.data, "seconds", 0))
				+ "  ·  шагов модели: " + ЗначениеПоля(Событие.data, "steps", 0);
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(ИспользованныеИнструменты) И ЗначениеЗаполнено(Сводка) Тогда
		Сводка = Сводка + "  ·  ";
	КонецЕсли;
	Если ЗначениеЗаполнено(ИспользованныеИнструменты) Тогда
		Сводка = Сводка + "инструменты 1С: " + Экранировать(СтрСоединить(ИспользованныеИнструменты, ", "));
	КонецЕсли;

	Если Не ОтветЗапроса.Ответ Тогда
		Подсказка = "";
		Если ЭтоКоллекцияКлючей(ОтветЗапроса.Результат) Тогда
			Подсказка = ЗначениеПоля(ОтветЗапроса.Результат, "suggestion", "");
		КонецЕсли;
		ТекстОшибки = ОтветЗапроса.ОписаниеОшибки;
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = ОтветЗапроса.Текст;
		КонецЕсли;
		HTML = "<div class=""card answer error"" id=""answer""><div class=""label"">Ошибка</div>"
			+ "<div class=""summary"">" + Экранировать(ТекстОшибки) + "</div>";
		Если ЗначениеЗаполнено(Сводка) Тогда
			HTML = HTML + "<div class=""meta"">" + Сводка + "</div>";
		КонецЕсли;
		Если ЗначениеЗаполнено(Подсказка) Тогда
			HTML = HTML + "<div class=""hint"">" + Экранировать(Подсказка) + "</div>";
		КонецЕсли;
		Возврат HTML + "</div>";
	КонецЕсли;

	HTML = "<div class=""card answer"" id=""answer""><div class=""label"">Ответ модели</div>"
		+ "<div class=""summary"">" + Экранировать(ОтветЗапроса.Текст) + "</div>";
	Если ЗначениеЗаполнено(Сводка) Тогда
		HTML = HTML + "<div class=""meta"">" + Сводка + "</div>";
	КонецЕсли;

	Возврат HTML + HTMLЗначения(ОтветЗапроса.Результат, 0) + "</div>";

КонецФункции

// HTML для данных из Result ответа модели любой вложенности: простые поля - таблицей
// "имя - значение", списки строк - маркированным списком, списки объектов - таблицей с колонками.
//
// Параметры:
//  Значение - Произвольный - значение из Result
//  Уровень  - Число - глубина вложенности, ограничивает рекурсию
//
// Возвращаемое значение:
//  Строка - HTML
//
&НаКлиенте
Функция HTMLЗначения(Значение, Уровень)

	МаксимумСтрок = 300;

	Если Значение = Неопределено Тогда
		Возврат "<span class=""dim"">нет данных</span>";
	ИначеЕсли Уровень > 6 Тогда
		Возврат "<span class=""dim"">...</span>";
	КонецЕсли;

	Если ЭтоКоллекцияКлючей(Значение) Тогда
		Если Значение.Количество() = 0 Тогда
			Возврат "<span class=""dim"">нет данных</span>";
		КонецЕсли;

		СтрокиТаблицы = "";
		Разделы = "";
		Для Каждого КлючЗначение Из Значение Цикл
			Если ЭтоКоллекция(КлючЗначение.Значение) Тогда
				Разделы = Разделы + "<h3>" + Экранировать(Строка(КлючЗначение.Ключ))
					+ "<span class=""cnt"">" + КлючЗначение.Значение.Количество() + "</span></h3>"
					+ HTMLЗначения(КлючЗначение.Значение, Уровень + 1);
			Иначе
				СтрокиТаблицы = СтрокиТаблицы + "<tr><td class=""key"">" + Экранировать(Строка(КлючЗначение.Ключ))
					+ "</td><td>" + HTMLПростогоЗначения(КлючЗначение.Значение) + "</td></tr>";
			КонецЕсли;
		КонецЦикла;

		Если ЗначениеЗаполнено(СтрокиТаблицы) Тогда
			СтрокиТаблицы = "<table class=""data"">" + СтрокиТаблицы + "</table>";
		КонецЕсли;
		Возврат СтрокиТаблицы + Разделы;

	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Если Значение.Количество() = 0 Тогда
			Возврат "<span class=""dim"">пусто</span>";
		КонецЕсли;

		Колонки = КолонкиТаблицы(Значение);
		Если Колонки <> Неопределено Тогда
			Возврат HTMLТаблицыОбъектов(Значение, Колонки, МаксимумСтрок);
		КонецЕсли;

		HTML = "";
		ВсеПростые = Истина;
		Для Каждого Элемент Из Значение Цикл
			Если ЭтоКоллекция(Элемент) Тогда
				ВсеПростые = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Номер = 0;
		Для Каждого Элемент Из Значение Цикл
			Номер = Номер + 1;
			Если Номер > МаксимумСтрок Тогда
				HTML = HTML + "<li class=""dim"">и еще " + (Значение.Количество() - МаксимумСтрок) + "</li>";
				Прервать;
			КонецЕсли;
			Если ВсеПростые Тогда
				HTML = HTML + "<li>" + HTMLПростогоЗначения(Элемент) + "</li>";
			Иначе
				HTML = HTML + "<li>" + HTMLЗначения(Элемент, Уровень + 1) + "</li>";
			КонецЕсли;
		КонецЦикла;
		Возврат "<ul class=""list"">" + HTML + "</ul>";
	КонецЕсли;

	Возврат HTMLПростогоЗначения(Значение);

КонецФункции

// Колонки для вывода массива таблицей: объединение ключей, если каждый элемент массива - коллекция
// ключей только с простыми значениями.
//
// Параметры:
//  Значение - Массив - элементы из Result
//
// Возвращаемое значение:
//  Массив из Строка, Неопределено - имена колонок; Неопределено, если таблицей массив не выводится
//
&НаКлиенте
Функция КолонкиТаблицы(Значение)

	Колонки = Новый Массив;
	Для Каждого Элемент Из Значение Цикл
		Если Не ЭтоКоллекцияКлючей(Элемент) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Для Каждого КлючЗначение Из Элемент Цикл
			Если ЭтоКоллекция(КлючЗначение.Значение) Тогда
				Возврат Неопределено;
			КонецЕсли;
			Если Колонки.Найти(КлючЗначение.Ключ) = Неопределено Тогда
				Колонки.Добавить(КлючЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Колонки;

КонецФункции

// Таблица из массива коллекций ключей с простыми значениями.
//
// Параметры:
//  Значение      - Массив - элементы из Result
//  Колонки       - Массив из Строка - имена колонок, см. КолонкиТаблицы
//  МаксимумСтрок - Число - сколько строк выводить
//
// Возвращаемое значение:
//  Строка - HTML
//
&НаКлиенте
Функция HTMLТаблицыОбъектов(Значение, Колонки, МаксимумСтрок)

	HTML = "<table class=""data""><tr>";
	Для Каждого Колонка Из Колонки Цикл
		HTML = HTML + "<th>" + Экранировать(Строка(Колонка)) + "</th>";
	КонецЦикла;
	HTML = HTML + "</tr>";

	Номер = 0;
	Для Каждого Элемент Из Значение Цикл
		Номер = Номер + 1;
		Если Номер > МаксимумСтрок Тогда
			HTML = HTML + "<tr><td class=""dim"" colspan=""" + Колонки.Количество() + """>и еще "
				+ (Значение.Количество() - МаксимумСтрок) + "</td></tr>";
			Прервать;
		КонецЕсли;
		HTML = HTML + "<tr>";
		Для Каждого Колонка Из Колонки Цикл
			HTML = HTML + "<td>" + HTMLПростогоЗначения(ЗначениеПоля(Элемент, Колонка, "")) + "</td>";
		КонецЦикла;
		HTML = HTML + "</tr>";
	КонецЦикла;

	Возврат HTML + "</table>";

КонецФункции

// Простое значение для HTML: строка, число, булево или дата.
//
// Параметры:
//  Значение - Строка, Число, Булево, Дата, Неопределено - значение поля
//
// Возвращаемое значение:
//  Строка - HTML
//
&НаКлиенте
Функция HTMLПростогоЗначения(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Тогда
		Возврат "<span class=""dim"">-</span>";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Если Значение Тогда
			Возврат "<span class=""tag"">да</span>";
		КонецЕсли;
		Возврат "<span class=""tag"">нет</span>";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат ПредставлениеЧисла(Значение);
	Иначе
		Возврат Экранировать(Строка(Значение));
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область ВспомогательныеФункции

// Заменяет символы разметки, чтобы текст из ответа модели и данных базы выводился как текст.
//
// Параметры:
//  Текст - Произвольный - значение, которое выводится в HTML
//
// Возвращаемое значение:
//  Строка - текст без активной разметки
//
&НаКлиенте
Функция Экранировать(Текст)

	Результат = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Возврат СтрЗаменить(Результат, "'", "&#39;");

КонецФункции

// Значение поля структуры или соответствия, прочитанных из JSON.
//
// Параметры:
//  Коллекция    - Структура, Соответствие, Произвольный - объект JSON
//  ИмяПоля      - Строка - имя поля
//  ПоУмолчанию  - Произвольный - значение, если поля нет или оно равно null
//
// Возвращаемое значение:
//  Произвольный - значение поля
//
&НаКлиенте
Функция ЗначениеПоля(Коллекция, ИмяПоля, ПоУмолчанию)

	Значение = Неопределено;
	Если ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Коллекция.Свойство(ИмяПоля, Значение);
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Значение = Коллекция.Получить(ИмяПоля);
	КонецЕсли;

	Если Значение = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Истина для структуры и соответствия: объект JSON с именованными полями.
&НаКлиенте
Функция ЭтоКоллекцияКлючей(Значение)

	Возврат ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("Соответствие");

КонецФункции

// Истина для объекта или массива JSON.
&НаКлиенте
Функция ЭтоКоллекция(Значение)

	Возврат ЭтоКоллекцияКлючей(Значение) Или ТипЗнч(Значение) = Тип("Массив");

КонецФункции

// Число с разделением разрядов пробелом: 1 772.
&НаКлиенте
Функция ПредставлениеЧисла(Число)

	Возврат Формат(Число, "ЧРГ=' '; ЧН=0");

КонецФункции

// Длительность: до 10 секунд с десятыми, до минуты в секундах, дальше в минутах и секундах.
//
// Параметры:
//  Секунд - Число - длительность в секундах
//
// Возвращаемое значение:
//  Строка - например "1,4 с", "38 с", "2 мин 21 с"
//
&НаКлиенте
Функция ПредставлениеСекунд(Секунд)

	Если Секунд < 10 Тогда
		Возврат Формат(Секунд, "ЧДЦ=1; ЧН=0") + " с";
	ИначеЕсли Секунд < 60 Тогда
		Возврат Формат(Окр(Секунд), "ЧГ=") + " с";
	КонецЕсли;
	ВсегоСекунд = Окр(Секунд);
	Возврат Формат(Цел(ВсегоСекунд / 60), "ЧГ=") + " мин " + Формат(ВсегоСекунд % 60, "ЧН=0; ЧГ=") + " с";

КонецФункции

