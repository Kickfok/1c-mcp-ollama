
&НаКлиенте
Перем ЗапросВыполняется; // Булево - вопрос отправлен, ответ еще не получен

&НаКлиенте
Перем ИдентификаторЗадания; // УникальныйИдентификатор - фоновое задание, которое ждет ответа оркестратора

&НаКлиенте
Перем АдресРезультата; // Строка - временное хранилище, куда фоновое задание помещает ответ

&НаКлиенте
Перем ИдентификаторЗапроса; // Строка - идентификатор запроса в журнале оркестратора

&НаКлиенте
Перем ПоследнийНомерСобытия; // Число - номер последнего полученного события журнала

&НаКлиенте
Перем СобытияЗапроса; // Массив из Структура - события журнала оркестратора по текущему запросу

&НаКлиенте
Перем ВопросЗапроса; // Строка - вопрос, на который отвечает модель

&НаКлиенте
Перем ВремяНачала; // Дата - момент отправки вопроса

&НаКлиенте
Перем ОтветЗапроса; // Структура, Неопределено - итоговый ответ, см. mcp_ОркестраторLLM.ОтправитьВопрос

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗначениеВРеквизитФормы(mcp_КонтейнерыПовтИсп.Инструменты(), "ТаблицаИнструментов");

	// Дерево: контейнер, под ним его инструменты
	ДеревоРек = РеквизитФормыВЗначение("ТаблицаИнструментовДерево");

	СоставПодсистемыКонтейнеры = Метаданные.Подсистемы.mcp_MCPСервер.Подсистемы.mcp_КонтейнерыИнструментов.Состав;

	Для Каждого ТекКонтейнер Из СоставПодсистемыКонтейнеры Цикл

		НоваяГруппа = ДеревоРек.Строки.Добавить();
		НоваяГруппа.ИмяОбработкиКонтейнера = ТекКонтейнер.Имя;

		МассивИнструментов = ТаблицаИнструментов.НайтиСтроки(Новый Структура("ИмяОбработкиКонтейнера", ТекКонтейнер.Имя));

		Для Каждого ТекИнструмент Из МассивИнструментов Цикл
			НовыйЭлемент = НоваяГруппа.Строки.Добавить();
			НовыйЭлемент.Имя = ТекИнструмент.Имя;
			НовыйЭлемент.Описание = ТекИнструмент.Описание;
			НовыйЭлемент.СхемаПараметров = ТекИнструмент.СхемаПараметров;
		КонецЦикла;

	КонецЦикла;

	ЗначениеВРеквизитФормы(ДеревоРек, "ТаблицаИнструментовДерево");

	ЗагрузитьОформлениеОтвета();
	АдресМонитора            = mcp_ОркестраторLLM.АдресМонитора();
	Элементы.ОткрытьНастройки.Видимость = mcp_НастройкиLLM.ЭтоАдминистратор();
	ПоказыватьХодВыполнения  = Истина;
	КоличествоИнструментов   = ТаблицаИнструментов.Количество();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ЗапросВыполняется = Ложь;
	СобытияЗапроса    = Новый Массив;
	ОбновитьНадписьСостояния();
	ОбновитьОтвет();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоказыватьХодВыполненияПриИзменении(Элемент)

	ОбновитьОтвет();

КонецПроцедуры

// Нажатие на пример вопроса на стартовом экране: ссылка вида #ask:N подставляет пример N и отправляет его.
&НаКлиенте
Процедура ОтветHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Ссылка = "";
	Если ДанныеСобытия.Свойство("Href") И ДанныеСобытия.Href <> Неопределено Тогда
		Ссылка = Строка(ДанныеСобытия.Href);
	КонецЕсли;

	Позиция = СтрНайти(Ссылка, "#ask:");
	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	НомерПримера = Число(Сред(Ссылка, Позиция + СтрДлина("#ask:")));
	Примеры = ПримерыВопросов();
	Если НомерПримера < Примеры.Количество() Тогда
		ТекстЗапросMCP = Примеры[НомерПримера];
		ВыполнитьМетод(Неопределено);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьМетод(Команда)

	// При отправке по Ctrl+Enter или кликом сразу после ввода поле вопроса еще в режиме редактирования:
	// введенный текст еще не перенесен в реквизит формы
	Если ТекущийЭлемент = Элементы.ТекстЗапросMCP Тогда
		ТекстЗапросMCP = Элементы.ТекстЗапросMCP.ТекстРедактирования;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СокрЛП(ТекстЗапросMCP)) Тогда
		ПоказатьПредупреждение(, "Заполните текст запроса и повторите попытку", , "Предупреждение");
		Возврат;
	КонецЕсли;

	Если ЗапросВыполняется Тогда
		ПоказатьПредупреждение(, "Модель еще отвечает на предыдущий вопрос. Дождитесь ответа.", , "Предупреждение");
		Возврат;
	КонецЕсли;

	ВопросЗапроса         = СокрЛП(ТекстЗапросMCP);
	СобытияЗапроса        = Новый Массив;
	ПоследнийНомерСобытия = 0;
	ОтветЗапроса          = Неопределено;
	ВремяНачала           = ТекущаяДата();

	Запуск = ЗапуститьЗапрос(ВопросЗапроса, УникальныйИдентификатор);
	ИдентификаторЗапроса = Запуск.ИдентификаторЗапроса;

	Если Запуск.ИдентификаторЗадания = Неопределено Тогда
		ЗавершитьЗапрос(Запуск.Ответ);
		Возврат;
	КонецЕсли;

	ИдентификаторЗадания = Запуск.ИдентификаторЗадания;
	АдресРезультата      = Запуск.АдресРезультата;
	ЗапросВыполняется    = Истина;

	Элементы.ВыполнитьЗапрос.Доступность = Ложь;
	ОбновитьНадписьСостояния();
	ОбновитьОтвет();

	ПодключитьОбработчикОжидания("ПроверитьХодЗапроса", 1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьМонитор(Команда)

	ПерейтиПоНавигационнойСсылке(АдресМонитора);

КонецПроцедуры

// Открывает настройки подключения к LLM для администратора.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ОткрытьНастройки(Команда)

	ОткрытьФорму("Обработка.АнализКонфигурацииMCP.Форма.ФормаНастроек", , ЭтотОбъект);

КонецПроцедуры

// Открывает личные настройки: локальный режим и проверку подключения.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ОткрытьЛичныеНастройки(Команда)

	ОткрытьФорму("Обработка.АнализКонфигурацииMCP.Форма.ФормаЛичныхНастроек", , ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ВыполнениеЗапроса

// Запускает фоновое задание, которое отправляет вопрос оркестратору. Если фоновое задание
// запустить нельзя (например, в безопасном режиме расширения), ответ ждется в этом вызове.
//
// Параметры:
//  Вопрос             - Строка - текст вопроса пользователя
//  ИдентификаторФормы - УникальныйИдентификатор - владелец временного хранилища с ответом
//
// Возвращаемое значение:
//  Структура:
//   * ИдентификаторЗапроса - Строка - идентификатор запроса в журнале оркестратора
//   * ИдентификаторЗадания - УникальныйИдентификатор, Неопределено - фоновое задание; Неопределено,
//                            если ответ уже получен синхронно
//   * АдресРезультата      - Строка - временное хранилище, куда задание поместит ответ
//   * Ответ                - Структура, Неопределено - ответ при синхронном выполнении
//
&НаСервереБезКонтекста
Функция ЗапуститьЗапрос(Вопрос, ИдентификаторФормы)

	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗапроса", Строка(Новый УникальныйИдентификатор));
	Результат.Вставить("ИдентификаторЗадания", Неопределено);
	Результат.Вставить("АдресРезультата",      ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторФормы));
	Результат.Вставить("Ответ",                Неопределено);

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(Вопрос);
	ПараметрыЗадания.Добавить(Результат.ИдентификаторЗапроса);
	ПараметрыЗадания.Добавить(Результат.АдресРезультата);

	Попытка
		Задание = ФоновыеЗадания.Выполнить("mcp_ОркестраторLLM.ОтправитьВопросВФоне", ПараметрыЗадания, ,
			"Вопрос к LLM-оркестратору");
		Результат.ИдентификаторЗадания = Задание.УникальныйИдентификатор;
	Исключение
		ЗаписьЖурналаРегистрации("MCP.ВопросКLLM", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Фоновое задание не запущено, ответ ожидается без показа хода выполнения: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат.Ответ = mcp_ОркестраторLLM.ОтправитьВопрос(Вопрос, Результат.ИдентификаторЗапроса);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Раз в секунду забирает новые события журнала оркестратора и проверяет, завершилось ли фоновое задание.
&НаКлиенте
Процедура ПроверитьХодЗапроса()

	Состояние = СостояниеЗапроса(ИдентификаторЗадания, АдресРезультата, ИдентификаторЗапроса, ПоследнийНомерСобытия);

	ПоследнийНомерСобытия = Состояние.Номер;
	Для Каждого Событие Из Состояние.События Цикл
		СобытияЗапроса.Добавить(Событие);
	КонецЦикла;

	Если Состояние.Завершено Тогда
		ЗавершитьЗапрос(Состояние.Ответ);
		Возврат;
	КонецЕсли;

	ОбновитьНадписьСостояния(Состояние.Связь);
	Если ЗначениеЗаполнено(Состояние.События) Тогда
		ОбновитьОтвет();
	КонецЕсли;

	ПодключитьОбработчикОжидания("ПроверитьХодЗапроса", 1, Истина);

КонецПроцедуры

// Состояние запроса за один вызов сервера: новые события журнала и, если задание завершилось, ответ.
//
// Параметры:
//  ИдентификаторЗадания - УникальныйИдентификатор - фоновое задание запроса
//  АдресРезультата      - Строка - временное хранилище с ответом
//  ИдентификаторЗапроса - Строка - идентификатор запроса в журнале оркестратора
//  ПоследнийНомер       - Число - номер последнего полученного события
//
// Возвращаемое значение:
//  Структура:
//   * Связь      - Булево - оркестратор ответил на запрос журнала
//   * Номер      - Число - номер последнего полученного события
//   * События    - Массив из Структура - новые события журнала
//   * Завершено  - Булево - фоновое задание завершилось
//   * Ответ      - Структура, Неопределено - ответ, см. mcp_ОркестраторLLM.ОтправитьВопрос
//
&НаСервереБезКонтекста
Функция СостояниеЗапроса(ИдентификаторЗадания, АдресРезультата, ИдентификаторЗапроса, ПоследнийНомер)

	Результат = mcp_ОркестраторLLM.СобытияЗапроса(ИдентификаторЗапроса, ПоследнийНомер);
	Результат.Вставить("Завершено", Ложь);
	Результат.Вставить("Ответ",     Неопределено);

	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Завершено = Истина;
	Результат.Ответ     = ПолучитьИзВременногоХранилища(АдресРезультата);

	Если Результат.Ответ = Неопределено Тогда
		ОписаниеОшибки = "Фоновое задание завершилось без ответа";
		Если Задание <> Неопределено И Задание.ИнформацияОбОшибке <> Неопределено Тогда
			ОписаниеОшибки = ОписаниеОшибки + ": " + КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		КонецЕсли;
		Результат.Ответ = Новый Структура("Ответ, Текст, Результат, ОписаниеОшибки, ОшибкаСоединения, ХодВыполнения",
			Ложь, "", Неопределено, ОписаниеОшибки, Ложь, Новый Массив);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Показывает итоговый ответ. Полный ход выполнения берется из ответа оркестратора: в нем есть и
// события, которые форма не успела получить между проверками.
//
// Параметры:
//  Ответ - Структура - ответ, см. mcp_ОркестраторLLM.ОтправитьВопрос
//
&НаКлиенте
Процедура ЗавершитьЗапрос(Ответ)

	ЗапросВыполняется = Ложь;
	Элементы.ВыполнитьЗапрос.Доступность = Истина;

	Если ЗначениеЗаполнено(Ответ.ХодВыполнения) Тогда
		СобытияЗапроса = Ответ.ХодВыполнения;
	КонецЕсли;

	Если Ответ.ОшибкаСоединения Тогда
		Ответ.ОписаниеОшибки = ЗапуститьLLMПослеОшибкиСоединения(Ответ.ОписаниеОшибки);
	КонецЕсли;

	ОтветЗапроса = Ответ;
	ОбновитьНадписьСостояния();
	ОбновитьОтвет();

КонецПроцедуры

// Текст над полем ответа: время выполнения, номер шага и связь с оркестратором.
//
// Параметры:
//  Связь - Булево - оркестратор ответил на последний запрос журнала
//
&НаКлиенте
Процедура ОбновитьНадписьСостояния(Связь = Истина)

	Если ЗапросВыполняется Тогда
		Секунд = ТекущаяДата() - ВремяНачала;
		ТекстСостояния = СтрШаблон("Модель работает %1:%2, шаг %3",
			Формат(Цел(Секунд / 60), "ЧН=0; ЧГ="), Формат(Секунд % 60, "ЧЦ=2; ЧВН=; ЧН=00"), ТекущийШаг());
		Если Не Связь Тогда
			ТекстСостояния = ТекстСостояния + ". Журнал оркестратора недоступен, ответ все равно придет";
		КонецЕсли;
	ИначеЕсли ОтветЗапроса = Неопределено Тогда
		ТекстСостояния = СтрШаблон("Инструментов MCP: %1. Задайте вопрос и нажмите ""Спросить""", КоличествоИнструментов);
	ИначеЕсли ОтветЗапроса.Ответ Тогда
		ТекстСостояния = "Ответ получен за " + ПредставлениеСекунд(ТекущаяДата() - ВремяНачала);
	Иначе
		ТекстСостояния = "Запрос завершился ошибкой";
	КонецЕсли;

	Элементы.ДекорацияСостояние.Заголовок = ТекстСостояния;

КонецПроцедуры

// Номер шага модели, который выполняется сейчас: по последнему событию llm_start.
&НаКлиенте
Функция ТекущийШаг()

	Шаг = 1;
	Для Каждого Событие Из СобытияЗапроса Цикл
		Если Событие.kind = "llm_start" Тогда
			Шаг = Макс(Шаг, ЗначениеПоля(Событие.data, "step", 1));
		КонецЕсли;
	КонецЦикла;

	Возврат Шаг;

КонецФункции

// Запускает Ollama и LLM-оркестратор, когда оркестратор не ответил на запрос.
// Запущенному оркестратору нужно время, чтобы опросить MCP-сервер и загрузить модель,
// поэтому текущий запрос не повторяется: пользователь получает просьбу повторить его.
// Запуск процессов недоступен в безопасном режиме расширения - тогда возвращается подсказка.
//
// Параметры:
//  ТекстОшибкиСоединения - Строка - описание ошибки соединения с оркестратором
//
// Возвращаемое значение:
//  Строка - сообщение пользователю
//
&НаСервере
Функция ЗапуститьLLMПослеОшибкиСоединения(ТекстОшибкиСоединения)

	ПричинаНедоступности = "LLM-оркестратор не отвечает на localhost:9000 (" + ТекстОшибкиСоединения + ").";

	Попытка
		Если Не ПроверитьЗапускOllama() Тогда
			ЗапускOllamaLLM();
		КонецЕсли;
		Если Не ПроверитьЗапускOrchestrator() Тогда
			Если РежимИсполнения Тогда
				Если Не ЗапускOrchestratorServer() Тогда
					Возврат ПричинаНедоступности
						+ " Запуск в серверном режиме не реализован: запустите LLM_Orchestrator.py вручную.";
				КонецЕсли;
			Иначе
				ЗапускOrchestratorLocal();
			КонецЕсли;
		КонецЕсли;
	Исключение
		Возврат ПричинаНедоступности
			+ " Автоматический запуск недоступен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ ". Запустите Ollama и LLM_Orchestrator.py вручную или выключите безопасный режим расширения.";
	КонецПопытки;

	Возврат "Ollama и LLM-оркестратор запускаются. Повторите запрос через 1-2 минуты.";

КонецФункции

&НаСервере
Функция ЗапускOrchestratorServer()

	// Для клиент-серверного варианта запуск пока не сделан.
	Возврат Ложь;

КонецФункции

&НаСервере
Функция ЗапускOrchestratorLocal()

	Если Не ПроверитьЗапускOrchestrator() Тогда

		ИмяКаталога = "C:\llm_orchestrator";
		СоздатьКаталог(ИмяКаталога);

		// Оркестратор хранится в макете обработки
		Обработка = РеквизитФормыВЗначение("Объект");
		ДанныеOrchestrator = Обработка.ПолучитьМакет("LLM_Orchestrator");
		ПутьКФайлу = ИмяКаталога + "\" + "LLM_Orchestrator.py";
		ДанныеOrchestrator.Записать(ПутьКФайлу);

		ЗапуститьПриложение(СтрШаблон("cmd.exe /c cd /d %1 && pip install requests", ИмяКаталога));
		// Ключ --monitor открывает монитор оркестратора отдельным окном
		ЗапуститьПриложение("cmd.exe /k python C:\llm_orchestrator\LLM_Orchestrator.py --monitor");

	Иначе
		Сообщить("LLM-Orchestrator уже запущен");
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаСервере
Функция ЗапускOllamaLLM()

    Если Не ПроверитьЗапускOllama() Тогда

        ЗапуститьПриложение("cmd.exe /c """"C:\Users\%USERNAME%\AppData\Local\Programs\Ollama\ollama.exe"" serve""");
    Иначе
        Сообщить("Ollama уже запущена");
	КонецЕсли;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область ОформлениеОтвета

// Читает HTML-шаблон ответа из макета ОформлениеОтвета: страницу со стилями и логотип,
// который записан в конце макета после метки <!--LOGOIMAGE-->. Логотип - PNG в base64, а не SVG:
// поле HTML тонкого клиента на Windows рисует встроенный SVG без градиентов и текста.
&НаСервере
Процедура ЗагрузитьОформлениеОтвета()

	Обработка = РеквизитФормыВЗначение("Объект");
	ТекстМакета = ПолучитьСтрокуИзДвоичныхДанных(Обработка.ПолучитьМакет("ОформлениеОтвета"), КодировкаТекста.UTF8);

	Метка = "<!--LOGOIMAGE-->";
	Позиция = СтрНайти(ТекстМакета, Метка);
	ШаблонHTML  = Лев(ТекстМакета, Позиция - 1);
	ЛоготипHTML = СокрЛП(Сред(ТекстМакета, Позиция + СтрДлина(Метка)));
	ШаблонHTML  = СтрЗаменить(ШаблонHTML, "<!--LOGO-->", ЛоготипHTML);

КонецПроцедуры

// Собирает HTML поля ответа по текущему состоянию: приветствие, вопрос, ход выполнения, ответ.
&НаКлиенте
Процедура ОбновитьОтвет()

	Если ВопросЗапроса = Неопределено Тогда
		ОтветHTML = СтраницаHTML(HTMLСостояния(), HTMLПриветствия(), "");
		Возврат;
	КонецЕсли;

	Содержимое = "<div class=""card question""><div class=""label"">Вопрос</div><div class=""text"">"
		+ Экранировать(ВопросЗапроса) + "</div></div>";

	Если ПоказыватьХодВыполнения И ЗначениеЗаполнено(СобытияЗапроса) Тогда
		Содержимое = Содержимое + HTMLХодаВыполнения();
	КонецЕсли;

	Если ЗапросВыполняется Тогда
		Содержимое = Содержимое + "<div class=""card waiting""><span class=""spin""></span>"
			+ "<div class=""big"">Модель работает: шаг " + ТекущийШаг() + "</div>"
			+ "<div>Локальная модель читает ответы инструментов 1С. Обычно ответ занимает от 30 секунд до нескольких минут.</div></div>";
		Скрипт = "window.onload = function () { window.scrollTo(0, document.body.scrollHeight); };";
	Иначе
		Содержимое = Содержимое + HTMLИтоговогоОтвета();
		// scrollIntoView прокрутил бы и форму, в которой стоит поле HTML, поэтому прокручивается только документ поля
		Скрипт = "window.onload = function () { var a = document.getElementById(""answer""); if (a) { window.scrollTo(0, Math.max(0, a.offsetTop - 12)); } };";
	КонецЕсли;

	ОтветHTML = СтраницаHTML(HTMLСостояния(), Содержимое, Скрипт);

КонецПроцедуры

// Подставляет в шаблон статус, содержимое и скрипт страницы.
//
// Параметры:
//  Статус     - Строка - HTML значка состояния в шапке
//  Содержимое - Строка - HTML основной части страницы
//  Скрипт     - Строка - JavaScript, который выполняется при загрузке
//
// Возвращаемое значение:
//  Строка - HTML-документ
//
&НаКлиенте
Функция СтраницаHTML(Статус, Содержимое, Скрипт)

	Текст = СтрЗаменить(ШаблонHTML, "<!--STATUS-->", Статус);
	Текст = СтрЗаменить(Текст, "<!--CONTENT-->", Содержимое);
	Возврат СтрЗаменить(Текст, "<!--SCRIPT-->", Скрипт);

КонецФункции

// Значок состояния в шапке: ожидание, работа модели, ответ или ошибка.
&НаКлиенте
Функция HTMLСостояния()

	Если ЗапросВыполняется = Истина Тогда
		Возврат "<span class=""pill busy""><span class=""dot""></span>Модель работает</span>";
	ИначеЕсли ОтветЗапроса = Неопределено Тогда
		Возврат "<span class=""pill""><span class=""dot""></span>Готов к вопросу</span>";
	ИначеЕсли ОтветЗапроса.Ответ Тогда
		Возврат "<span class=""pill ok""><span class=""dot""></span>Ответ получен</span>";
	Иначе
		Возврат "<span class=""pill err""><span class=""dot""></span>Ошибка</span>";
	КонецЕсли;

КонецФункции

// Стартовый экран: логотип и примеры вопросов к инструментам конфигурации.
&НаКлиенте
Функция HTMLПриветствия()

	ТекстПримеров = "";
	Номер = 0;
	Для Каждого Пример Из ПримерыВопросов() Цикл
		ТекстПримеров = ТекстПримеров + "<a href=""#ask:" + Формат(Номер, "ЧН=0; ЧГ=") + """><b>?</b>"
			+ Экранировать(Пример) + "</a>";
		Номер = Номер + 1;
	КонецЦикла;

	Возврат "<div class=""welcome"">" + ЛоготипHTML
		+ "<h2>Спросите базу обычным языком</h2>"
		+ "<p>Модель работает на этом компьютере через Ollama и вызывает инструменты 1С по протоколу MCP.<br>"
		+ "Данные базы не уходят во внешние сервисы.</p>"
		+ "<div class=""examples"">" + ТекстПримеров + "</div>"
		+ "<p class=""tiny"">Нажмите на пример, чтобы задать этот вопрос</p></div>";

КонецФункции

// Примеры вопросов на стартовом экране: по одному на основные инструменты конфигурации.
&НаКлиенте
Функция ПримерыВопросов()

	Примеры = Новый Массив;
	Примеры.Добавить("Какая версия платформы и конфигурации?");
	Примеры.Добавить("Какие реквизиты у документа ""Перемещение товаров""?");
	Примеры.Добавить("Какие документы делают движения по регистру ТоварыНаСкладах?");
	Примеры.Добавить("Какие есть отчеты по продажам и какие у них параметры?");
	Возврат Примеры;

КонецФункции

// Ход выполнения в виде светлого терминала: шаги модели, вызовы инструментов, время и контекст.
&НаКлиенте
Функция HTMLХодаВыполнения()

	ЗавершенныеШаги = Новый Соответствие;
	Для Каждого Событие Из СобытияЗапроса Цикл
		Если Событие.kind = "llm_done" Тогда
			ЗавершенныеШаги.Вставить(ЗначениеПоля(Событие.data, "step", 0), Истина);
		КонецЕсли;
	КонецЦикла;

	Строки = "";
	Номер = 0;
	Для Каждого Событие Из СобытияЗапроса Цикл
		Номер = Номер + 1;
		Строки = Строки + HTMLСобытия(Событие, Номер, ЗавершенныеШаги);
	КонецЦикла;

	Возврат "<div class=""term""><div class=""termbar mono"">"
		+ "<i style=""background:#FF6B6B""></i><i style=""background:#FFC94D""></i><i style=""background:#6EE7A8""></i>"
		+ "<span class=""t"">Ход выполнения  ·  журнал LLM-оркестратора</span></div>"
		+ "<div class=""lines mono"">" + Строки + "</div></div>";

КонецФункции

// Строка хода выполнения для одного события журнала оркестратора.
//
// Параметры:
//  Событие         - Структура - событие журнала: time, kind, level, text, data
//  Номер           - Число - порядковый номер события, из него строится id раскрываемого блока
//  ЗавершенныеШаги - Соответствие - номера шагов модели, на которые уже получен ответ
//
// Возвращаемое значение:
//  Строка - HTML строки; пустая строка для служебных событий
//
&НаКлиенте
Функция HTMLСобытия(Событие, Номер, ЗавершенныеШаги)

	Данные = Событие.data;
	Вид = Событие.kind;
	Время = "<span class=""tm"">" + Экранировать(Событие.time) + "</span>";

	Если Вид = "llm_start" Тогда
		Шаг = ЗначениеПоля(Данные, "step", 0);
		Признак = "";
		Если ЗапросВыполняется = Истина И ЗавершенныеШаги.Получить(Шаг) = Неопределено Тогда
			Признак = "<span class=""spin""></span>";
		КонецЕсли;
		Возврат "<div class=""ln"">" + Время + "<span class=""k llm"">LLM</span>Шаг " + Шаг
			+ ": модель формирует ответ" + Признак + "</div>";

	ИначеЕсли Вид = "llm_done" Тогда
		Возврат "<div class=""ln"">" + Время + "<span class=""k llm"">LLM</span>" + HTMLШагаМодели(Данные) + "</div>";

	ИначеЕсли Вид = "tool_call" Тогда
		Возврат "<div class=""ln"">" + Время + "<span class=""k mcp"">MCP CALL</span>"
			+ Экранировать(ЗначениеПоля(Данные, "tool", "")) + " <span class=""c"">"
			+ Экранировать(ЗначениеПоля(Данные, "arguments_text", "")) + "</span></div>";

	ИначеЕсли Вид = "tool_result" Тогда
		ИдБлока = "p" + Формат(Номер, "ЧГ=");
		ОписаниеОтвета = ПредставлениеЧисла(ЗначениеПоля(Данные, "chars", 0)) + " симв.  ·  "
			+ ПредставлениеСекунд(ЗначениеПоля(Данные, "seconds", 0));
		Если ЗначениеПоля(Данные, "truncated", Ложь) = Истина Тогда
			ОписаниеОтвета = ОписаниеОтвета + "  ·  обрезано для контекста модели";
		КонецЕсли;
		КлассИнструмента = "";
		Если ЗначениеПоля(Данные, "is_error", Ложь) = Истина Тогда
			КлассИнструмента = " class=""err""";
		КонецЕсли;
		Возврат "<div class=""ln"">" + Время + "<span class=""k mcp"">MCP RESPONSE</span><span" + КлассИнструмента + ">"
			+ Экранировать(ЗначениеПоля(Данные, "tool", "")) + "</span>  <span class=""dim"">" + ОписаниеОтвета + "</span>  "
			+ "<span class=""more"" onclick=""return mcpToggle('" + ИдБлока + "')"">показать ответ</span></div>"
			+ "<div class=""preview"" id=""" + ИдБлока + """>" + Экранировать(ЗначениеПоля(Данные, "preview", "")) + "</div>";

	ИначеЕсли Вид = "final" Тогда
		Возврат "<div class=""ln"">" + Время + "<span class=""k ok"">ГОТОВО</span>"
			+ "<span class=""dim"">шагов: " + ЗначениеПоля(Данные, "steps", 0) + "  ·  "
			+ ПредставлениеСекунд(ЗначениеПоля(Данные, "seconds", 0)) + "</span></div>";

	ИначеЕсли Вид = "error" Тогда
		Возврат "<div class=""ln"">" + Время + "<span class=""k err"">ОШИБКА</span>"
			+ Экранировать(Событие.text) + "</div>";

	ИначеЕсли Вид = "warning" Или (Вид = "log" И Событие.level <> "INFO") Тогда
		Возврат "<div class=""ln"">" + Время + "<span class=""k warn"">ВНИМАНИЕ</span><span class=""warn"">"
			+ Экранировать(Событие.text) + "</span></div>";

	Иначе
		// Начало запроса (вопрос показан отдельной карточкой) и информационные записи лога
		Возврат "";
	КонецЕсли;

КонецФункции

// Описание завершенного шага модели: время, заполнение контекста, число токенов ответа и решение модели.
//
// Параметры:
//  Данные - Структура - данные события llm_done
//
// Возвращаемое значение:
//  Строка - HTML
//
&НаКлиенте
Функция HTMLШагаМодели(Данные)

	Текст = "Шаг " + ЗначениеПоля(Данные, "step", 0) + ": " + ПредставлениеСекунд(ЗначениеПоля(Данные, "seconds", 0)) + "  ";

	ТокеновПромпта = ЗначениеПоля(Данные, "prompt_tokens", 0);
	РазмерКонтекста = ЗначениеПоля(Данные, "num_ctx", 0);
	Если ЗначениеЗаполнено(ТокеновПромпта) И ЗначениеЗаполнено(РазмерКонтекста) Тогда
		Доля = Мин(1, ТокеновПромпта / РазмерКонтекста);
		Заполнен = Доля >= 0.98;
		КлассПолосы = "bar";
		Пометка = "";
		Если Заполнен Тогда
			КлассПолосы = "bar full";
			Пометка = " (заполнен)";
		КонецЕсли;
		Текст = Текст + "<span class=""" + КлассПолосы + """><i style=""width:" + Формат(Окр(Доля * 100), "ЧН=0; ЧГ=")
			+ "%""></i></span> <span class=""dim"">контекст " + ПредставлениеЧисла(ТокеновПромпта) + " / "
			+ ПредставлениеЧисла(РазмерКонтекста) + " ток." + Пометка + "  ·  ответ "
			+ ПредставлениеЧисла(ЗначениеПоля(Данные, "output_tokens", 0)) + " ток.</span>";
	КонецЕсли;

	Действие = ЗначениеПоля(Данные, "action", "");
	Если Действие = "call_tool" Тогда
		Текст = Текст + "  →  <span class=""v"">вызов " + Экранировать(ЗначениеПоля(Данные, "tool", "")) + "</span>";
	ИначеЕсли Действие = "final" Тогда
		Текст = Текст + "  →  <span class=""ok"">итоговый ответ</span>";
	Иначе
		Текст = Текст + "  →  <span class=""warn"">" + Экранировать(Строка(Действие)) + "</span>";
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Карточка итогового ответа: краткий текст модели, сводка по шагам и данные из Result.
&НаКлиенте
Функция HTMLИтоговогоОтвета()

	Если ОтветЗапроса = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ИспользованныеИнструменты = Новый Массив;
	Сводка = "";
	Для Каждого Событие Из СобытияЗапроса Цикл
		Если Событие.kind = "tool_call" Тогда
			ИмяИнструмента = ЗначениеПоля(Событие.data, "tool", "");
			Если ИспользованныеИнструменты.Найти(ИмяИнструмента) = Неопределено Тогда
				ИспользованныеИнструменты.Добавить(ИмяИнструмента);
			КонецЕсли;
		ИначеЕсли Событие.kind = "final" Или Событие.kind = "error" Тогда
			Сводка = "Ответ за " + ПредставлениеСекунд(ЗначениеПоля(Событие.data, "seconds", 0))
				+ "  ·  шагов модели: " + ЗначениеПоля(Событие.data, "steps", 0);
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(ИспользованныеИнструменты) Тогда
		Сводка = Сводка + "  ·  инструменты 1С: " + Экранировать(СтрСоединить(ИспользованныеИнструменты, ", "));
	КонецЕсли;

	Если Не ОтветЗапроса.Ответ Тогда
		Подсказка = "";
		Если ЭтоКоллекцияКлючей(ОтветЗапроса.Результат) Тогда
			Подсказка = ЗначениеПоля(ОтветЗапроса.Результат, "suggestion", "");
		КонецЕсли;
		ТекстОшибки = ОтветЗапроса.ОписаниеОшибки;
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = ОтветЗапроса.Текст;
		КонецЕсли;
		HTML = "<div class=""card answer error"" id=""answer""><div class=""label"">Ошибка</div>"
			+ "<div class=""summary"">" + Экранировать(ТекстОшибки) + "</div>";
		Если ЗначениеЗаполнено(Сводка) Тогда
			HTML = HTML + "<div class=""meta"">" + Сводка + "</div>";
		КонецЕсли;
		Если ЗначениеЗаполнено(Подсказка) Тогда
			HTML = HTML + "<div class=""hint"">" + Экранировать(Подсказка) + "</div>";
		КонецЕсли;
		Возврат HTML + "</div>";
	КонецЕсли;

	HTML = "<div class=""card answer"" id=""answer""><div class=""label"">Ответ модели</div>"
		+ "<div class=""summary"">" + Экранировать(ОтветЗапроса.Текст) + "</div>";
	Если ЗначениеЗаполнено(Сводка) Тогда
		HTML = HTML + "<div class=""meta"">" + Сводка + "</div>";
	КонецЕсли;

	Возврат HTML + HTMLЗначения(ОтветЗапроса.Результат, 0) + "</div>";

КонецФункции

// HTML для данных из Result ответа модели любой вложенности: простые поля - таблицей
// "имя - значение", списки строк - маркированным списком, списки объектов - таблицей с колонками.
//
// Параметры:
//  Значение - Произвольный - значение из Result
//  Уровень  - Число - глубина вложенности, ограничивает рекурсию
//
// Возвращаемое значение:
//  Строка - HTML
//
&НаКлиенте
Функция HTMLЗначения(Значение, Уровень)

	МаксимумСтрок = 300;

	Если Значение = Неопределено Тогда
		Возврат "<span class=""dim"">нет данных</span>";
	ИначеЕсли Уровень > 6 Тогда
		Возврат "<span class=""dim"">...</span>";
	КонецЕсли;

	Если ЭтоКоллекцияКлючей(Значение) Тогда
		Если Значение.Количество() = 0 Тогда
			Возврат "<span class=""dim"">нет данных</span>";
		КонецЕсли;

		СтрокиТаблицы = "";
		Разделы = "";
		Для Каждого КлючЗначение Из Значение Цикл
			Если ЭтоКоллекция(КлючЗначение.Значение) Тогда
				Разделы = Разделы + "<h3>" + Экранировать(Строка(КлючЗначение.Ключ))
					+ "<span class=""cnt"">" + КлючЗначение.Значение.Количество() + "</span></h3>"
					+ HTMLЗначения(КлючЗначение.Значение, Уровень + 1);
			Иначе
				СтрокиТаблицы = СтрокиТаблицы + "<tr><td class=""key"">" + Экранировать(Строка(КлючЗначение.Ключ))
					+ "</td><td>" + HTMLПростогоЗначения(КлючЗначение.Значение) + "</td></tr>";
			КонецЕсли;
		КонецЦикла;

		Если ЗначениеЗаполнено(СтрокиТаблицы) Тогда
			СтрокиТаблицы = "<table class=""data"">" + СтрокиТаблицы + "</table>";
		КонецЕсли;
		Возврат СтрокиТаблицы + Разделы;

	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Если Значение.Количество() = 0 Тогда
			Возврат "<span class=""dim"">пусто</span>";
		КонецЕсли;

		Колонки = КолонкиТаблицы(Значение);
		Если Колонки <> Неопределено Тогда
			Возврат HTMLТаблицыОбъектов(Значение, Колонки, МаксимумСтрок);
		КонецЕсли;

		HTML = "";
		ВсеПростые = Истина;
		Для Каждого Элемент Из Значение Цикл
			Если ЭтоКоллекция(Элемент) Тогда
				ВсеПростые = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Номер = 0;
		Для Каждого Элемент Из Значение Цикл
			Номер = Номер + 1;
			Если Номер > МаксимумСтрок Тогда
				HTML = HTML + "<li class=""dim"">и еще " + (Значение.Количество() - МаксимумСтрок) + "</li>";
				Прервать;
			КонецЕсли;
			Если ВсеПростые Тогда
				HTML = HTML + "<li>" + HTMLПростогоЗначения(Элемент) + "</li>";
			Иначе
				HTML = HTML + "<li>" + HTMLЗначения(Элемент, Уровень + 1) + "</li>";
			КонецЕсли;
		КонецЦикла;
		Возврат "<ul class=""list"">" + HTML + "</ul>";
	КонецЕсли;

	Возврат HTMLПростогоЗначения(Значение);

КонецФункции

// Колонки для вывода массива таблицей: объединение ключей, если каждый элемент массива - коллекция
// ключей только с простыми значениями.
//
// Параметры:
//  Значение - Массив - элементы из Result
//
// Возвращаемое значение:
//  Массив из Строка, Неопределено - имена колонок; Неопределено, если таблицей массив не выводится
//
&НаКлиенте
Функция КолонкиТаблицы(Значение)

	Колонки = Новый Массив;
	Для Каждого Элемент Из Значение Цикл
		Если Не ЭтоКоллекцияКлючей(Элемент) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Для Каждого КлючЗначение Из Элемент Цикл
			Если ЭтоКоллекция(КлючЗначение.Значение) Тогда
				Возврат Неопределено;
			КонецЕсли;
			Если Колонки.Найти(КлючЗначение.Ключ) = Неопределено Тогда
				Колонки.Добавить(КлючЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Колонки;

КонецФункции

// Таблица из массива коллекций ключей с простыми значениями.
//
// Параметры:
//  Значение      - Массив - элементы из Result
//  Колонки       - Массив из Строка - имена колонок, см. КолонкиТаблицы
//  МаксимумСтрок - Число - сколько строк выводить
//
// Возвращаемое значение:
//  Строка - HTML
//
&НаКлиенте
Функция HTMLТаблицыОбъектов(Значение, Колонки, МаксимумСтрок)

	HTML = "<table class=""data""><tr>";
	Для Каждого Колонка Из Колонки Цикл
		HTML = HTML + "<th>" + Экранировать(Строка(Колонка)) + "</th>";
	КонецЦикла;
	HTML = HTML + "</tr>";

	Номер = 0;
	Для Каждого Элемент Из Значение Цикл
		Номер = Номер + 1;
		Если Номер > МаксимумСтрок Тогда
			HTML = HTML + "<tr><td class=""dim"" colspan=""" + Колонки.Количество() + """>и еще "
				+ (Значение.Количество() - МаксимумСтрок) + "</td></tr>";
			Прервать;
		КонецЕсли;
		HTML = HTML + "<tr>";
		Для Каждого Колонка Из Колонки Цикл
			HTML = HTML + "<td>" + HTMLПростогоЗначения(ЗначениеПоля(Элемент, Колонка, "")) + "</td>";
		КонецЦикла;
		HTML = HTML + "</tr>";
	КонецЦикла;

	Возврат HTML + "</table>";

КонецФункции

// Простое значение для HTML: строка, число, булево или дата.
//
// Параметры:
//  Значение - Строка, Число, Булево, Дата, Неопределено - значение поля
//
// Возвращаемое значение:
//  Строка - HTML
//
&НаКлиенте
Функция HTMLПростогоЗначения(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Тогда
		Возврат "<span class=""dim"">-</span>";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Если Значение Тогда
			Возврат "<span class=""tag"">да</span>";
		КонецЕсли;
		Возврат "<span class=""tag"">нет</span>";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат ПредставлениеЧисла(Значение);
	Иначе
		Возврат Экранировать(Строка(Значение));
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область ВспомогательныеФункции

// Заменяет символы разметки, чтобы текст из ответа модели и данных базы выводился как текст.
//
// Параметры:
//  Текст - Произвольный - значение, которое выводится в HTML
//
// Возвращаемое значение:
//  Строка - текст без активной разметки
//
&НаКлиенте
Функция Экранировать(Текст)

	Результат = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Возврат СтрЗаменить(Результат, "'", "&#39;");

КонецФункции

// Значение поля структуры или соответствия, прочитанных из JSON.
//
// Параметры:
//  Коллекция    - Структура, Соответствие, Произвольный - объект JSON
//  ИмяПоля      - Строка - имя поля
//  ПоУмолчанию  - Произвольный - значение, если поля нет или оно равно null
//
// Возвращаемое значение:
//  Произвольный - значение поля
//
&НаКлиенте
Функция ЗначениеПоля(Коллекция, ИмяПоля, ПоУмолчанию)

	Значение = Неопределено;
	Если ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Коллекция.Свойство(ИмяПоля, Значение);
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Значение = Коллекция.Получить(ИмяПоля);
	КонецЕсли;

	Если Значение = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Истина для структуры и соответствия: объект JSON с именованными полями.
&НаКлиенте
Функция ЭтоКоллекцияКлючей(Значение)

	Возврат ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("Соответствие");

КонецФункции

// Истина для объекта или массива JSON.
&НаКлиенте
Функция ЭтоКоллекция(Значение)

	Возврат ЭтоКоллекцияКлючей(Значение) Или ТипЗнч(Значение) = Тип("Массив");

КонецФункции

// Число с разделением разрядов пробелом: 1 772.
&НаКлиенте
Функция ПредставлениеЧисла(Число)

	Возврат Формат(Число, "ЧРГ=' '; ЧН=0");

КонецФункции

// Длительность: до 10 секунд с десятыми, до минуты в секундах, дальше в минутах и секундах.
//
// Параметры:
//  Секунд - Число - длительность в секундах
//
// Возвращаемое значение:
//  Строка - например "1,4 с", "38 с", "2 мин 21 с"
//
&НаКлиенте
Функция ПредставлениеСекунд(Секунд)

	Если Секунд < 10 Тогда
		Возврат Формат(Секунд, "ЧДЦ=1; ЧН=0") + " с";
	ИначеЕсли Секунд < 60 Тогда
		Возврат Формат(Окр(Секунд), "ЧГ=") + " с";
	КонецЕсли;
	ВсегоСекунд = Окр(Секунд);
	Возврат Формат(Цел(ВсегоСекунд / 60), "ЧГ=") + " мин " + Формат(ВсегоСекунд % 60, "ЧН=0; ЧГ=") + " с";

КонецФункции

#КонецОбласти

#КонецОбласти

#Область Проверки

&НаСервере
Функция ПроверитьЗапускOllama()

	КоличествоПроцессов = 0;

	Попытка
		Локатор = Новый COMОбъект("wbemscripting.swbemlocator");
		Сервис = Локатор.ConnectServer();
		Запрос = Сервис.ExecQuery("SELECT * FROM Win32_Process WHERE Name = 'ollama.exe'");
		КоличествоПроцессов = Запрос.Count;
	Исключение
		Сообщить("Ошибка при проверке процесса ollama.exe: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	Возврат КоличествоПроцессов > 0;

КонецФункции

&НаСервере
Функция ПроверитьЗапускOrchestrator()

	КоличествоПроцессов = 0;

	Попытка
		Локатор = Новый COMОбъект("wbemscripting.swbemlocator");
        Сервис = Локатор.ConnectServer();
		Запрос = Сервис.ExecQuery("SELECT * FROM Win32_Process WHERE (Name = 'python.exe' OR Name = 'pythonw.exe') AND CommandLine LIKE '%LLM_Orchestrator.py%'");
		КоличествоПроцессов = Запрос.Count;
	Исключение
		Сообщить("Ошибка при проверке процесса LLM_Orchestrator.py: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	Возврат КоличествоПроцессов > 0;

КонецФункции

