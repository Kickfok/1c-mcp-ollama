#Область ОбработчикиСобытийФормы

// Заполняет форму личными настройками текущего пользователя. Если локальный режим не разрешен
// администратором, поля режима недоступны, но проверка подключения работает.
//
// Параметры:
//  Отказ                - Булево
//  СтандартнаяОбработка - Булево
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Настройки = mcp_НастройкиLLM.НастройкиПользователя();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки, ПоляЛичныхНастроек());
	РазрешенЛокальныйРежим = Настройки.РазрешенЛокальныйРежим;

	Если РазрешенЛокальныйРежим Тогда
		КлючЛокальногоОркестратора = mcp_НастройкиLLM.КлючЛокальногоОркестратора();
	Иначе
		Элементы.ЛокальныйРежимНеРазрешен.Видимость = Истина;
		Элементы.ГруппаЛокальныйРежим.Доступность = Ложь;
	КонецЕсли;

	УстановитьДоступностьПолей(Элементы, ЛокальныйРежим);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Поля локального режима доступны, только когда он включен.
//
// Параметры:
//  Элемент - ПолеФормы
//
&НаКлиенте
Процедура ЛокальныйРежимПриИзменении(Элемент)

	УстановитьДоступностьПолей(Элементы, ЛокальныйРежим);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Записывает личные настройки.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура КомандаЗаписать(Команда)

	Если ЗаписатьНаСервере() Тогда
		ПоказатьОповещениеПользователя("Личные настройки LLM записаны");
	КонецЕсли;

КонецПроцедуры

// Записывает личные настройки и закрывает форму.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	Если ЗаписатьНаСервере() Тогда
		Закрыть();
	КонецЕсли;

КонецПроцедуры

// Показывает или скрывает ключ локального оркестратора: его вписывают в файл конфигурации
// оркестратора, если запускают его вручную.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ПоказатьКлюч(Команда)

	Элементы.КлючЛокальногоОркестратора.РежимПароля = Не Элементы.КлючЛокальногоОркестратора.РежимПароля;

КонецПроцедуры

// Записывает настройки и проверяет подключение в действующем режиме: в локальном режиме
// запрос к оркестратору выполняет этот компьютер.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Проверить(Команда)

	Если Не ЗаписатьНаСервере() Тогда
		Возврат;
	КонецЕсли;

	Состояние = НачатьДиагностикуНаСервере();
	Если Не Состояние.Завершена Тогда
		Запрос = Состояние.ЗапросКлиента;
		Ответ = mcp_ОркестраторLLMКлиент.ВыполнитьЗапрос(Запрос.Подключение, "POST", "/diagnostics", Запрос.Тело,
			Запрос.Таймаут);
		Состояние = ЗавершитьДиагностикуНаСервере(Состояние, Ответ);
	КонецЕсли;
	ДиагностикаHTML = Состояние.HTML;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Записывает личные настройки; ошибки проверки показываются пользователю.
//
// Возвращаемое значение:
//  Булево - Истина, если записано
//
&НаСервере
Функция ЗаписатьНаСервере()

	Настройки = mcp_НастройкиLLM.НастройкиПользователя();
	ЗаполнитьЗначенияСвойств(Настройки, ЭтотОбъект, ПоляЛичныхНастроек());

	Попытка
		mcp_НастройкиLLM.ЗаписатьНастройкиПользователя(Настройки);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Если РазрешенЛокальныйРежим И Не ЗначениеЗаполнено(КлючЛокальногоОркестратора) Тогда
		КлючЛокальногоОркестратора = mcp_НастройкиLLM.КлючЛокальногоОркестратора();
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Делает поля адреса, ключа и автозапуска доступными только при включенном локальном режиме.
//
// Параметры:
//  ЭлементыФормы  - ВсеЭлементыФормы
//  ЛокальныйРежим - Булево
//
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьПолей(ЭлементыФормы, ЛокальныйРежим)

	Для Каждого ИмяЭлемента Из СтрРазделить("АдресЛокальногоОркестратора,ГруппаКлюч,Автозапуск,ПутьКOllama,"
		+ "ПутьКPython,КаталогОркестратора", ",") Цикл
		ЭлементыФормы[ИмяЭлемента].Доступность = ЛокальныйРежим;
	КонецЦикла;

КонецПроцедуры

// Начинает проверку подключения.
//
// Возвращаемое значение:
//  Структура - см. mcp_ДиагностикаLLM.НачатьДиагностику
//
&НаСервереБезКонтекста
Функция НачатьДиагностикуНаСервере()

	Возврат mcp_ДиагностикаLLM.НачатьДиагностику();

КонецФункции

// Завершает проверку подключения по ответу локального оркестратора.
//
// Параметры:
//  Состояние - Структура - см. mcp_ДиагностикаLLM.НачатьДиагностику
//  Ответ     - Структура - см. mcp_ОркестраторLLM.НовыйОтветДиагностики
//
// Возвращаемое значение:
//  Структура - см. mcp_ДиагностикаLLM.ЗавершитьДиагностику
//
&НаСервереБезКонтекста
Функция ЗавершитьДиагностикуНаСервере(Знач Состояние, Знач Ответ)

	Возврат mcp_ДиагностикаLLM.ЗавершитьДиагностику(Состояние, Ответ);

КонецФункции

// Реквизиты формы, совпадающие с полями личных настроек. Флаг РазрешенЛокальныйРежим сюда не входит:
// его меняет только администратор.
//
// Возвращаемое значение:
//  Строка - имена через запятую
//
&НаСервереБезКонтекста
Функция ПоляЛичныхНастроек()

	Возврат "ЛокальныйРежим, АдресЛокальногоОркестратора, Автозапуск, ПутьКOllama, ПутьКPython, КаталогОркестратора";

КонецФункции

#КонецОбласти
