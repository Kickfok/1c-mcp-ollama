#Область ОбработчикиСобытийФормы

// Заполняет форму настройками базы, списком пользователей с локальным режимом и персональными
// токенами. Форма доступна только пользователю с полными правами.
//
// Параметры:
//  Отказ                - Булево - выходной: Истина, если у пользователя нет полных прав
//  СтандартнаяОбработка - Булево
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не mcp_НастройкиLLM.ЭтоАдминистратор() Тогда
		ОбщегоНазначения.СообщитьПользователю(
			"Настройки подключения к LLM меняет пользователь с полными правами. Ваши личные настройки - "
			+ "в форме ""Мои настройки LLM"".");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, mcp_НастройкиLLM.НастройкиБазы(), ПоляНастроекБазы());
	МесяцевДействияТокена = 3;
	НовыйТокенСрок = ДобавитьМесяц(НачалоДня(ТекущаяДатаСеанса()), МесяцевДействияТокена);

	ОбновитьСостояниеКлюча();
	ЗаполнитьЛокальныхПользователей();
	ЗаполнитьПерсональныеТокены();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Открывает выбор пользователя, для которого выпускается персональный токен.
//
// Параметры:
//  Элемент              - ПолеФормы
//  ДанныеВыбора         - Произвольный
//  СтандартнаяОбработка - Булево
//
&НаКлиенте
Процедура НовыйТокенПользовательНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьПользователя(Новый ОписаниеОповещения("НовыйТокенПользовательЗавершение", ЭтотОбъект));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Записывает настройки базы и ключ оркестратора.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура КомандаЗаписать(Команда)

	Если ЗаписатьНаСервере() Тогда
		ПоказатьОповещениеПользователя("Настройки подключения к LLM записаны");
	КонецЕсли;

КонецПроцедуры

// Записывает настройки и закрывает форму.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	Если ЗаписатьНаСервере() Тогда
		Закрыть();
	КонецЕсли;

КонецПроцедуры

// Разрешает выбранному пользователю локальный режим.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура РазрешитьЛокальныйРежим(Команда)

	ВыбратьПользователя(Новый ОписаниеОповещения("РазрешитьЛокальныйРежимЗавершение", ЭтотОбъект));

КонецПроцедуры

// Запрещает локальный режим пользователю из текущей строки списка.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ЗапретитьЛокальныйРежим(Команда)

	ТекущиеДанные = Элементы.ЛокальныеПользователи.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИзменитьРазрешениеЛокальногоРежима(ТекущиеДанные.ИдентификаторПользователя, Ложь);

КонецПроцедуры

// Выпускает персональный токен и показывает его один раз.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ВыпуститьТокен(Команда)

	Если Не ЗначениеЗаполнено(НовыйТокенИдентификатор) Тогда
		ТекстСообщения = "Выберите пользователя, с правами которого будет работать токен";
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "НовыйТокенПользователь");
		Возврат;
	КонецЕсли;
	Если НовыйТокенСрок < НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса()) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Срок действия токена уже прошел", , "НовыйТокенСрок");
		Возврат;
	КонецЕсли;

	ВыпуститьТокенНаСервере();

КонецПроцедуры

// Отзывает персональный токен из текущей строки списка после подтверждения.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ОтозватьТокен(Команда)

	ТекущиеДанные = Элементы.ПерсональныеТокены.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОписаниеТокена = ТекущиеДанные.ИмяПользователя;
	Если ЗначениеЗаполнено(ТекущиеДанные.Описание) Тогда
		ОписаниеТокена = СтрШаблон("%1 (%2)", ОписаниеТокена, ТекущиеДанные.Описание);
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ОтозватьТокенЗавершение", ЭтотОбъект, ТекущиеДанные.Хеш);
	ТекстВопроса = СтрШаблон("Отозвать токен пользователя %1? Клиент с этим токеном потеряет доступ.", ОписаниеТокена);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

// Записывает настройки и проверяет подключение: 10 проверок, итог в HTML.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Проверить(Команда)

	Если Не ЗаписатьНаСервере() Тогда
		Возврат;
	КонецЕсли;

	Состояние = НачатьДиагностикуНаСервере();
	Если Не Состояние.Завершена Тогда
		Запрос = Состояние.ЗапросКлиента;
		Ответ = mcp_ОркестраторLLMКлиент.ВыполнитьЗапрос(Запрос.Подключение, "POST", "/diagnostics", Запрос.Тело,
			Запрос.Таймаут);
		Состояние = ЗавершитьДиагностикуНаСервере(Состояние, Ответ);
	КонецЕсли;
	ДиагностикаHTML = Состояние.HTML;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Открывает выбор элемента справочника Пользователи.
//
// Параметры:
//  Оповещение - ОписаниеОповещения - получает выбранную ссылку
//
&НаКлиенте
Процедура ВыбратьПользователя(Оповещение)

	ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", Новый Структура("РежимВыбора", Истина), ЭтотОбъект, , , ,
		Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// Обработка выбора пользователя для локального режима.
//
// Параметры:
//  Пользователь            - СправочникСсылка.Пользователи, Неопределено - выбранный пользователь
//  ДополнительныеПараметры - Неопределено
//
&НаКлиенте
Процедура РазрешитьЛокальныйРежимЗавершение(Пользователь, ДополнительныеПараметры) Экспорт

	Если ЗначениеЗаполнено(Пользователь) Тогда
		ИзменитьРазрешениеЛокальногоРежима(Пользователь, Истина);
	КонецЕсли;

КонецПроцедуры

// Обработка выбора пользователя для персонального токена.
//
// Параметры:
//  Пользователь            - СправочникСсылка.Пользователи, Неопределено - выбранный пользователь
//  ДополнительныеПараметры - Неопределено
//
&НаКлиенте
Процедура НовыйТокенПользовательЗавершение(Пользователь, ДополнительныеПараметры) Экспорт

	Если ЗначениеЗаполнено(Пользователь) Тогда
		ЗаполнитьПользователяТокена(Пользователь);
	КонецЕсли;

КонецПроцедуры

// Отзыв токена после ответа на вопрос.
//
// Параметры:
//  Ответ - КодВозвратаДиалога
//  Хеш   - Строка - хеш токена
//
&НаКлиенте
Процедура ОтозватьТокенЗавершение(Ответ, Хеш) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОтозватьТокенНаСервере(Хеш);
	КонецЕсли;

КонецПроцедуры

// Записывает настройки базы и, если введен, ключ оркестратора. Ошибки проверки показываются
// пользователю.
//
// Возвращаемое значение:
//  Булево - Истина, если записано
//
&НаСервере
Функция ЗаписатьНаСервере()

	Настройки = mcp_НастройкиLLM.НастройкиБазы();
	ЗаполнитьЗначенияСвойств(Настройки, ЭтотОбъект, ПоляНастроекБазы());

	Попытка
		mcp_НастройкиLLM.ЗаписатьНастройкиБазы(Настройки);
		Если ЗначениеЗаполнено(КлючОркестратора) Тогда
			mcp_НастройкиLLM.ЗаписатьКлючОркестратора(СокрЛП(КлючОркестратора));
		КонецЕсли;
	Исключение
		ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	КлючОркестратора = "";
	ОбновитьСостояниеКлюча();
	Возврат Истина;

КонецФункции

// Показывает, записан ли ключ серверного оркестратора. Сам ключ на форму не выводится.
&НаСервере
Процедура ОбновитьСостояниеКлюча()

	Если mcp_НастройкиLLM.ЕстьКлючОркестратора(mcp_НастройкиLLM.РежимСерверный()) Тогда
		Элементы.СостояниеКлюча.Заголовок = "Ключ записан";
	Иначе
		Элементы.СостояниеКлюча.Заголовок = "Ключ не записан";
	КонецЕсли;

КонецПроцедуры

// Заполняет список пользователей, которым разрешен локальный режим.
&НаСервере
Процедура ЗаполнитьЛокальныхПользователей()

	ЛокальныеПользователи.Очистить();
	Для Каждого ОписаниеПользователя Из mcp_НастройкиLLM.ПользователиСЛокальнымРежимом() Цикл
		ЗаполнитьЗначенияСвойств(ЛокальныеПользователи.Добавить(), ОписаниеПользователя);
	КонецЦикла;
	ЛокальныеПользователи.Сортировать("Пользователь");

КонецПроцедуры

// Разрешает или запрещает пользователю локальный режим.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи, Строка - пользователь или UUID элемента справочника
//  Разрешен     - Булево
//
&НаСервере
Процедура ИзменитьРазрешениеЛокальногоРежима(Знач Пользователь, Знач Разрешен)

	Если ТипЗнч(Пользователь) = Тип("Строка") Тогда
		ИдентификаторПользователя = Пользователь;
	Иначе
		ИдентификаторПользователя = XMLСтрока(Пользователь);
	КонецЕсли;

	Настройки = mcp_НастройкиLLM.НастройкиПользователя(ИдентификаторПользователя);
	Настройки.РазрешенЛокальныйРежим = Разрешен;
	mcp_НастройкиLLM.ЗаписатьНастройкиПользователя(Настройки, ИдентификаторПользователя);

	ЗаполнитьЛокальныхПользователей();

КонецПроцедуры

// Заполняет список персональных токенов: пользователь, описание, сроки. Самих токенов в базе нет.
&НаСервере
Процедура ЗаполнитьПерсональныеТокены()

	ПерсональныеТокены.Очистить();
	Для Каждого ОписаниеТокена Из mcp_ДоступПользователей.ПерсональныеТокены() Цикл
		ЗаполнитьЗначенияСвойств(ПерсональныеТокены.Добавить(), ОписаниеТокена);
	КонецЦикла;
	ПерсональныеТокены.Сортировать("ИмяПользователя, СрокДействия");

КонецПроцедуры

// Запоминает пользователя, для которого выпускается токен.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи
//
&НаСервере
Процедура ЗаполнитьПользователяТокена(Знач Пользователь)

	НовыйТокенПользователь = Строка(Пользователь);
	НовыйТокенИдентификатор = XMLСтрока(Пользователь);

КонецПроцедуры

// Выпускает персональный токен, показывает его и обновляет список.
&НаСервере
Процедура ВыпуститьТокенНаСервере()

	Пользователь = Справочники.Пользователи.ПолучитьСсылку(Новый УникальныйИдентификатор(НовыйТокенИдентификатор));
	ВыпущенныйТокен = mcp_ДоступПользователей.ВыпуститьПерсональныйТокен(Пользователь, КонецДня(НовыйТокенСрок),
		НовыйТокенОписание);
	Элементы.ВыпущенныйТокен.Видимость = Истина;

	ЗаполнитьПерсональныеТокены();

КонецПроцедуры

// Отзывает персональный токен и обновляет список.
//
// Параметры:
//  Хеш - Строка - хеш токена
//
&НаСервере
Процедура ОтозватьТокенНаСервере(Знач Хеш)

	mcp_ДоступПользователей.ОтозватьТокенПоХешу(Хеш);
	ВыпущенныйТокен = "";
	Элементы.ВыпущенныйТокен.Видимость = Ложь;
	ЗаполнитьПерсональныеТокены();

КонецПроцедуры

// Начинает проверку подключения.
//
// Возвращаемое значение:
//  Структура - см. mcp_ДиагностикаLLM.НачатьДиагностику
//
&НаСервереБезКонтекста
Функция НачатьДиагностикуНаСервере()

	Возврат mcp_ДиагностикаLLM.НачатьДиагностику();

КонецФункции

// Завершает проверку подключения по ответу локального оркестратора.
//
// Параметры:
//  Состояние - Структура - см. mcp_ДиагностикаLLM.НачатьДиагностику
//  Ответ     - Структура - см. mcp_ОркестраторLLM.НовыйОтветДиагностики
//
// Возвращаемое значение:
//  Структура - см. mcp_ДиагностикаLLM.ЗавершитьДиагностику
//
&НаСервереБезКонтекста
Функция ЗавершитьДиагностикуНаСервере(Знач Состояние, Знач Ответ)

	Возврат mcp_ДиагностикаLLM.ЗавершитьДиагностику(Состояние, Ответ);

КонецФункции

// Реквизиты формы, совпадающие с полями настроек базы.
//
// Возвращаемое значение:
//  Строка - имена через запятую
//
&НаСервереБезКонтекста
Функция ПоляНастроекБазы()

	Возврат "АдресОркестратора, ПроверятьСертификат, ТаймаутОтвета, АдресПубликацииMCP, "
		+ "ДоступКИнструментамБезТокена, СрокДействияТокенаЗапроса";

КонецФункции

#КонецОбласти
