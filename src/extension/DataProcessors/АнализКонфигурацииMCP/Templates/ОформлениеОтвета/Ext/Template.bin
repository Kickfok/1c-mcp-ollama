<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<style>
  html, body { margin: 0; padding: 0; background: #F3F4FA; }
  body { color: #1F2440; font: 13px/1.5 "Segoe UI", Arial, sans-serif; padding: 14px 16px 24px; }
  .mono { font-family: "Cascadia Mono", Consolas, "Courier New", monospace; font-size: 12px; }
  a { color: #5B49D6; }

  .head { display: table; width: 100%; margin-bottom: 14px; }
  .head .cell { display: table-cell; vertical-align: middle; }
  .head .logo { width: 46px; padding-right: 12px; }
  .head .logo img { width: 44px; height: 44px; display: block; }
  .head h1 { margin: 0; font-size: 17px; font-weight: 800; color: #0D1024; }
  .head h1 .y { color: #E09B00; } .head h1 .v { color: #6C5CE7; }
  .head .sub { color: #6B7194; font-size: 12px; }
  .head .right { text-align: right; white-space: nowrap; }

  .pill { display: inline-block; padding: 4px 11px; border-radius: 999px; font-size: 12px; font-weight: 600;
          border: 1px solid #DCE0F0; background: #FFFFFF; color: #1F2440; }
  .pill .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; background: #9AA0BF; }
  .pill.busy { background: #FFF6DA; border-color: #F2D27A; color: #7A5200; }
  .pill.busy .dot { background: #F5A800; animation: pulse 1.1s ease-in-out infinite; }
  .pill.ok { background: #E8F7EF; border-color: #A9DEC1; color: #0E6B3B; }
  .pill.ok .dot { background: #12864A; }
  .pill.err { background: #FDECEC; border-color: #F2B8B8; color: #A12B2B; }
  .pill.err .dot { background: #D23C3C; }
  @keyframes pulse { 50% { opacity: 0.3; } }

  .card { background: #FFFFFF; border: 1px solid #DDE1EF; border-radius: 12px; padding: 14px 16px; margin-bottom: 12px;
          box-shadow: 0 6px 20px rgba(27, 31, 59, 0.06); }
  .label { font-size: 11px; font-weight: 700; letter-spacing: 0.7px; text-transform: uppercase; color: #6B7194; margin-bottom: 6px; }
  .question { border-left: 4px solid #F5A800; }
  .question .text { font-size: 15px; font-weight: 600; color: #0D1024; white-space: pre-wrap; }

  .term { background: #FFFFFF; border: 1px solid #DDE1EF; border-radius: 12px; margin-bottom: 12px; overflow: hidden;
          box-shadow: 0 6px 20px rgba(27, 31, 59, 0.06); }
  .termbar { background: #EEF0F8; border-bottom: 1px solid #DDE1EF; padding: 8px 14px; color: #6B7194; }
  .termbar i { display: inline-block; width: 11px; height: 11px; border-radius: 50%; margin-right: 5px; vertical-align: -1px; }
  .termbar .t { margin-left: 10px; }
  .lines { padding: 10px 14px 12px; }
  .ln { padding: 2px 0; white-space: pre-wrap; word-wrap: break-word; }
  .ln .tm { color: #8A90B0; margin-right: 10px; }
  .ln .k { font-weight: 700; margin-right: 8px; }
  .k.req { color: #A86A00; } .k.llm { color: #5B49D6; } .k.mcp { color: #5B49D6; } .k.ok { color: #12864A; }
  .k.err { color: #D23C3C; } .k.warn { color: #A65F00; } .k.log { color: #8A90B0; font-weight: 400; }
  .y { color: #A86A00; } .v { color: #5B49D6; } .c { color: #0B6FA0; } .ok { color: #12864A; } .err { color: #D23C3C; }
  .dim { color: #6B7194; } .warn { color: #A65F00; }
  .bar { display: inline-block; width: 80px; height: 6px; border-radius: 3px; background: #E3E6F2; vertical-align: middle; overflow: hidden; }
  .bar i { display: block; height: 6px; background: #8B7CFF; }
  .bar.full i { background: #D23C3C; }
  .more { color: #0B6FA0; cursor: pointer; text-decoration: underline; }
  .preview { display: none; margin: 4px 0 6px 0; padding: 8px 10px; border-radius: 8px; background: #F7F8FD;
             border: 1px dashed #DDE1EF; color: #0B6FA0; max-height: 260px; overflow: auto; white-space: pre-wrap; }
  .spin { display: inline-block; width: 9px; height: 9px; border: 2px solid #8B7CFF; border-right-color: transparent;
          border-radius: 50%; animation: rot 0.8s linear infinite; vertical-align: -1px; margin-left: 6px; }
  @keyframes rot { to { transform: rotate(360deg); } }

  .answer { border-left: 4px solid #8B7CFF; }
  .answer.error { border-left-color: #D23C3C; }
  .answer .summary { font-size: 15px; font-weight: 600; color: #0D1024; margin-bottom: 4px; white-space: pre-wrap; }
  .answer .meta { color: #6B7194; font-size: 12px; margin-bottom: 10px; }
  .answer h3 { margin: 14px 0 6px; font-size: 13px; color: #0D1024; }
  .answer h3 .cnt { display: inline-block; margin-left: 6px; padding: 0 7px; border-radius: 9px; background: #EEEBFF;
                    color: #5B49D6; font-size: 11px; font-weight: 700; }
  .waiting { text-align: center; color: #6B7194; padding: 22px 10px; }
  .waiting .big { font-size: 14px; color: #1F2440; font-weight: 600; margin-top: 8px; }
  .hint { background: #F7F8FD; border: 1px solid #E3E6F2; border-radius: 8px; padding: 8px 12px; margin-top: 10px; color: #4A5072; }

  table.data { border-collapse: collapse; width: 100%; margin: 4px 0 8px; }
  table.data th { text-align: left; background: #F3F4FA; color: #4A5072; font-weight: 600; font-size: 12px;
                  padding: 6px 10px; border-bottom: 1px solid #DDE1EF; }
  table.data td { padding: 5px 10px; border-bottom: 1px solid #EEF0F6; vertical-align: top; word-wrap: break-word; }
  table.data tr:hover td { background: #FAFAFE; }
  table.data td.key { color: #4A5072; width: 34%; }
  ul.list { margin: 4px 0 8px; padding-left: 20px; }
  ul.list li { padding: 1px 0; }
  .tag { display: inline-block; padding: 1px 8px; border-radius: 6px; background: #EEF0F8; color: #4A5072; font-size: 11.5px; }

  .welcome { text-align: center; padding: 26px 10px 10px; }
  .welcome img { width: 92px; height: 92px; }
  .welcome h2 { margin: 10px 0 4px; font-size: 20px; color: #0D1024; }
  .welcome p { color: #6B7194; margin: 0 0 16px; }
  .examples { display: inline-block; text-align: left; }
  .examples a { display: block; background: #FFFFFF; border: 1px solid #DDE1EF; border-radius: 10px; padding: 8px 14px;
                margin: 6px 0; color: #1F2440; text-decoration: none; }
  .examples a:hover { border-color: #8B7CFF; background: #FAF9FF; }
  .tiny { font-size: 11.5px; color: #8A90B0; margin-top: 10px; }
  .examples b { color: #5B49D6; margin-right: 6px; }
</style>
</head>
<body>
<div class="head">
  <div class="cell logo"><!--LOGO--></div>
  <div class="cell">
    <h1><span class="y">1C</span> MCP <span class="v">Ollama</span> Bridge</h1>
    <div class="sub">Ответ локальной модели по данным этой базы</div>
  </div>
  <div class="cell right"><!--STATUS--></div>
</div>
<!--CONTENT-->
<script>
  function mcpToggle(id) {
    var e = document.getElementById(id);
    if (e) { e.style.display = e.style.display === "block" ? "none" : "block"; }
    return false;
  }
  <!--SCRIPT-->
</script>
</body>
</html>
<!--LOGOIMAGE--><img src="data:image/png;base64," alt="">
