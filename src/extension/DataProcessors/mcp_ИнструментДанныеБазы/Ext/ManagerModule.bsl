#Область ПрограммныйИнтерфейс

// Описывает инструменты контейнера: чтение таблицы без языка запросов, профиль данных базы, журнал
// регистрации, готовые варианты отчетов.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - см. mcp_Метаданные.ТаблицаИнструментов
//
Процедура ДобавитьИнструменты(Инструменты) Экспорт

	ДобавитьИнструментЧтениеТаблицы(Инструменты);
	ДобавитьИнструментПрофильДанных(Инструменты);
	ДобавитьИнструментЖурналРегистрации(Инструменты);
	ДобавитьИнструментСписокВариантовОтчетов(Инструменты);
	ДобавитьИнструментВыполнениеВариантаОтчета(Инструменты);

КонецПроцедуры

// Выполняет инструмент контейнера.
//
// Параметры:
//  ИмяИнструмента - Строка - имя инструмента
//  Аргументы      - Структура - аргументы и контекст доступа
//
// Возвращаемое значение:
//  Строка - JSON результата
//
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Если ИмяИнструмента = "read_table" Тогда
		Результат = ЧтениеТаблицы(Аргументы);
	ИначеЕсли ИмяИнструмента = "data_profile" Тогда
		Результат = ПрофильДанных(Аргументы);
	ИначеЕсли ИмяИнструмента = "read_event_log" Тогда
		Результат = СобытияЖурнала(Аргументы);
	ИначеЕсли ИмяИнструмента = "list_report_variants" Тогда
		Результат = СписокВариантовОтчетов(Аргументы);
	ИначеЕсли ИмяИнструмента = "run_report_variant" Тогда
		Результат = РезультатВариантаОтчета(Аргументы);
	Иначе
		ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
	КонецЕсли;

	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(Результат);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнструментЧтениеТаблицы

// Описывает инструмент read_table: чтение таблицы по описанию в JSON без текста запроса.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - см. mcp_Метаданные.ТаблицаИнструментов
//
Процедура ДобавитьИнструментЧтениеТаблицы(Инструменты)

	Параметры = Новый Массив;
	ДобавитьСтроку(Параметры, "table",
		"Таблица: Справочник.Контрагенты, Документ.РеализацияТоваровУслуг, Документ.РеализацияТоваровУслуг.Товары "
		+ "(табличная часть), РегистрНакопления.ТоварыНаСкладах.Остатки, РегистрНакопления.Продажи.Обороты, "
		+ "РегистрСведений.КурсыВалют.СрезПоследних", , Истина);
	ДобавитьМассивСтрок(Параметры, "fields",
		"Поля результата, через точку - реквизит ссылки: [""Номер"", ""Дата"", ""Контрагент.ИНН""]. "
		+ "Пусто - все поля таблицы");
	ДобавитьМассивОбъектов(Параметры, "filters",
		"Отборы: [{""field"": ""Склад"", ""comparison"": ""="", ""value"": ""Основной склад""}]. comparison: "
		+ "=, <>, >, >=, <, <=, in (value - массив), contains (подстрока). Ссылку задают наименованием, кодом "
		+ "или номером");
	ДобавитьМассивСтрок(Параметры, "groupBy",
		"Группировка: [""Номенклатура""]; дату группируют по периоду: ""Дата:month"" (day, week, month, "
		+ "quarter, year)");
	ДобавитьМассивОбъектов(Параметры, "aggregates",
		"Итоги по группам: [{""field"": ""Сумма"", ""function"": ""sum""}]; function: sum, count, "
		+ "countDistinct, max, min, avg. Колонка итога называется по функции и полю: СуммаСумма");
	ДобавитьМассивСтрок(Параметры, "order",
		"Порядок: [""Дата desc"", ""Номер""]; можно указывать колонки итогов");
	ДобавитьСтроку(Параметры, "periodStart",
		"Начало периода ГГГГ-ММ-ДД: отбор по дате документа или периоду регистра, параметр виртуальной "
		+ "таблицы");
	ДобавитьСтроку(Параметры, "periodEnd",
		"Конец периода ГГГГ-ММ-ДД включительно; для остатков и среза последних - дата, на которую они нужны");
	МаксимумСтрок = mcp_ЗапросыМодели.МаксимумСтрокРезультата();
	СтрокПоУмолчанию = mcp_ЗапросыМодели.СтрокРезультатаПоУмолчанию();
	ДобавитьЧисло(Параметры, "maxRows", СтрШаблон("Сколько строк вернуть, не больше %1", МаксимумСтрок),
		СтрокПоУмолчанию);
	ДобавитьЧисло(Параметры, "offset",
		"Сколько первых строк пропустить: следующая страница, если truncated = true", 0);

	Описание = "Чтение одной таблицы без языка запросов. Пример: {""table"": ""Документ.РеализацияТоваровУслуг"", "
		+ """fields"": [""Номер"", ""Дата"", ""Контрагент""], ""filters"": [{""field"": ""Контрагент"", "
		+ """comparison"": ""="", ""value"": ""Ромашка""}], ""periodStart"": ""2026-03-01"", ""periodEnd"": "
		+ """2026-03-31""}. Итоги: ""groupBy"": [""Дата:month""], ""aggregates"": [{""field"": ""СуммаДокумента"", "
		+ """function"": ""sum""}]. Остатки: table РегистрНакопления.Имя.Остатки и periodEnd";
	mcp_Метаданные.ДобавитьИнструмент(Инструменты, "read_table", Описание,
		mcp_Метаданные.СхемаПараметровИнструмента(Параметры));

КонецПроцедуры

// Собирает запрос по описанию из аргументов и выполняет его движком запросов модели: права, РАЗРЕШЕННЫЕ
// и ограничение строк те же, что у run_query. Имена таблиц и полей проверяются как идентификаторы,
// значения отборов передаются параметрами запроса, поэтому текст запроса не собирается из значений.
//
// Параметры:
//  Аргументы - Структура - table, fields, filters, groupBy, aggregates, order, periodStart, periodEnd,
//              maxRows, offset и контекст доступа
//
// Возвращаемое значение:
//  Структура - см. mcp_ЗапросыМодели.ВыполнитьЗапрос; дополнительно query - текст выполненного запроса
//
Функция ЧтениеТаблицы(Аргументы)

	Таблица = ОписаниеТаблицы(СтрокаАргумента(Аргументы, "table"));
	Период = ПериодИзАргументов(Аргументы);
	ЗначенияПараметров = Новый Структура;

	Источник = ИсточникЗапроса(Таблица, Период, ЗначенияПараметров);
	Выборка = ВыборкаЗапроса(Аргументы);
	Условия = УсловияОтборов(Аргументы, ЗначенияПараметров);
	ДобавитьУсловиеПериода(Условия, Таблица, Период, ЗначенияПараметров);

	ТекстЗапроса = "ВЫБРАТЬ" + Символы.ПС + Символы.Таб + СтрСоединить(Выборка.Поля, "," + Символы.ПС + Символы.Таб)
		+ Символы.ПС + "ИЗ" + Символы.ПС + Символы.Таб + Источник + " КАК Т";
	Если ЗначениеЗаполнено(Условия) Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "ГДЕ" + Символы.ПС + Символы.Таб
			+ СтрСоединить(Условия, Символы.ПС + Символы.Таб + "И ");
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.Группировка) Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "СГРУППИРОВАТЬ ПО" + Символы.ПС + Символы.Таб
			+ СтрСоединить(Выборка.Группировка, "," + Символы.ПС + Символы.Таб);
	КонецЕсли;
	Порядок = ПорядокЗапроса(Аргументы, Выборка.Псевдонимы);
	Если ЗначениеЗаполнено(Порядок) Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС + Символы.Таб
			+ СтрСоединить(Порядок, "," + Символы.ПС + Символы.Таб);
	КонецЕсли;

	АргументыЗапроса = Новый Структура;
	АргументыЗапроса.Вставить("query", ТекстЗапроса);
	АргументыЗапроса.Вставить("parameters", ЗначенияПараметров);
	КлючКонтекста = mcp_ДоступПользователей.ИмяКлючаКонтекста();
	Если Аргументы.Свойство(КлючКонтекста) Тогда
		АргументыЗапроса.Вставить(КлючКонтекста, Аргументы[КлючКонтекста]);
	КонецЕсли;

	МаксимумСтрок = mcp_ЗапросыМодели.ЧислоИзАргументов(Аргументы, "maxRows",
		mcp_ЗапросыМодели.СтрокРезультатаПоУмолчанию(), 1, mcp_ЗапросыМодели.МаксимумСтрокРезультата());
	Пропустить = mcp_ЗапросыМодели.ЧислоИзАргументов(Аргументы, "offset", 0, 0,
		mcp_ЗапросыМодели.МаксимумСмещения());

	Результат = mcp_ЗапросыМодели.ВыполнитьЗапрос(АргументыЗапроса, Пропустить, МаксимумСтрок);
	Результат.Вставить("query", ТекстЗапроса);
	Возврат Результат;

КонецФункции

// Разбирает имя таблицы: объект метаданных, табличная часть или виртуальная таблица регистра.
//
// Параметры:
//  ИмяТаблицы - Строка - например РегистрНакопления.ТоварыНаСкладах.Остатки
//
// Возвращаемое значение:
//  Структура:
//   * ПолноеИмя        - Строка - имя таблицы для запроса
//   * Объект           - ОбъектМетаданных
//   * Класс            - Строка - Справочник, Документ, РегистрНакопления...
//   * ТабличнаяЧасть   - Строка - имя табличной части или пустая строка
//   * ВиртуальнаяТаблица - Строка - имя виртуальной таблицы или пустая строка
//
Функция ОписаниеТаблицы(ИмяТаблицы)

	Если Не ЗначениеЗаполнено(ИмяТаблицы) Тогда
		ВызватьИсключение "Не задано имя таблицы (table), например Справочник.Контрагенты";
	КонецЕсли;
	Части = СтрРазделить(ИмяТаблицы, ".");
	ЧастейОбъекта = 2;
	ЧастейСТабличнойЧастью = 3;
	Если Части.Количество() < ЧастейОбъекта Или Части.Количество() > ЧастейСТабличнойЧастью Тогда
		ВызватьИсключение СтрШаблон("Неверное имя таблицы ""%1"": ожидается Класс.Объект или "
			+ "Класс.Объект.ТабличнаяЧасть, например Документ.РеализацияТоваровУслуг.Товары", ИмяТаблицы);
	КонецЕсли;
	Для Каждого Часть Из Части Цикл
		ПроверитьИмя(Часть, "таблица");
	КонецЦикла;

	Класс = РусскоеИмяКласса(Части[0]);
	Объект = Метаданные.НайтиПоПолномуИмени(Класс + "." + Части[1]);
	Если Объект = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Объект %1.%2 не найден. Имена объектов уточните через list_metadata_objects",
			Класс, Части[1]);
	КонецЕсли;

	Результат = НовоеОписаниеТаблицы(Класс + "." + Объект.Имя, Объект, Класс);
	Если Части.Количество() = ЧастейОбъекта Тогда
		Возврат Результат;
	КонецЕсли;

	ИмяЧасти = Части[2];
	Если ЕстьТабличнаяЧасть(Объект, ИмяЧасти) Тогда
		Результат.ТабличнаяЧасть = Объект.ТабличныеЧасти[ИмяЧасти].Имя;
		Результат.ПолноеИмя = Результат.ПолноеИмя + "." + Результат.ТабличнаяЧасть;
		Возврат Результат;
	КонецЕсли;

	Виртуальные = ВиртуальныеТаблицы(Класс);
	Индекс = ИндексБезРегистра(Виртуальные, ИмяЧасти);
	Если Индекс = Неопределено Тогда
		СписокВиртуальных = СтрСоединить(Виртуальные, ", ");
		ВызватьИсключение СтрШаблон("У %1 нет табличной части или виртуальной таблицы ""%2"". Виртуальные "
			+ "таблицы: %3; табличные части смотрите в get_metadata_structure", Результат.ПолноеИмя, ИмяЧасти,
			СписокВиртуальных);
	КонецЕсли;
	Результат.ВиртуальнаяТаблица = Виртуальные[Индекс];
	Результат.ПолноеИмя = Результат.ПолноеИмя + "." + Результат.ВиртуальнаяТаблица;
	Возврат Результат;

КонецФункции

// Описание таблицы для запроса, см. ОписаниеТаблицы.
//
// Параметры:
//  ПолноеИмя - Строка
//  Объект    - ОбъектМетаданных
//  Класс     - Строка
//
// Возвращаемое значение:
//  Структура - ПолноеИмя, Объект, Класс, ТабличнаяЧасть, ВиртуальнаяТаблица
//
Функция НовоеОписаниеТаблицы(ПолноеИмя, Объект, Класс)

	Описание = Новый Структура;
	Описание.Вставить("ПолноеИмя",          ПолноеИмя);
	Описание.Вставить("Объект",             Объект);
	Описание.Вставить("Класс",              Класс);
	Описание.Вставить("ТабличнаяЧасть",     "");
	Описание.Вставить("ВиртуальнаяТаблица", "");
	Возврат Описание;

КонецФункции

// Источник запроса: имя таблицы и параметры виртуальной таблицы. Остатки и срезы берутся на конец
// периода, обороты - за период.
//
// Параметры:
//  Таблица            - Структура - см. ОписаниеТаблицы
//  Период             - Структура - см. ПериодИзАргументов
//  ЗначенияПараметров - Структура - значения параметров запроса, дополняется
//
// Возвращаемое значение:
//  Строка
//
Функция ИсточникЗапроса(Таблица, Период, ЗначенияПараметров)

	Если Не ЗначениеЗаполнено(Таблица.ВиртуальнаяТаблица) Тогда
		Возврат Таблица.ПолноеИмя;
	КонецЕсли;

	Если ВиртуальнаяТаблицаНаДату(Таблица.ВиртуальнаяТаблица) Тогда
		НаДату = Период.Конец;
		Если Не ЗначениеЗаполнено(НаДату) Тогда
			НаДату = Период.Начало;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НаДату) Тогда
			Возврат Таблица.ПолноеИмя;
		КонецЕсли;
		ЗначенияПараметров.Вставить("КонецПериода", НаДату);
		Возврат Таблица.ПолноеИмя + "(&КонецПериода)";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Период.Начало) И Не ЗначениеЗаполнено(Период.Конец) Тогда
		Возврат Таблица.ПолноеИмя;
	КонецЕсли;
	ПараметрыТаблицы = Новый Массив;
	ПараметрыТаблицы.Добавить("");
	ПараметрыТаблицы.Добавить("");
	Если ЗначениеЗаполнено(Период.Начало) Тогда
		ЗначенияПараметров.Вставить("НачалоПериода", Период.Начало);
		ПараметрыТаблицы[0] = "&НачалоПериода";
	КонецЕсли;
	Если ЗначениеЗаполнено(Период.Конец) Тогда
		ЗначенияПараметров.Вставить("КонецПериода", Период.Конец);
		ПараметрыТаблицы[1] = "&КонецПериода";
	КонецЕсли;
	Возврат Таблица.ПолноеИмя + "(" + СтрСоединить(ПараметрыТаблицы, ", ") + ")";

КонецФункции

// Поля выборки, группировки и псевдонимы колонок по fields, groupBy и aggregates.
//
// Параметры:
//  Аргументы - Структура
//
// Возвращаемое значение:
//  Структура:
//   * Поля        - Массив из Строка - выражения списка выборки с псевдонимами
//   * Группировка - Массив из Строка - выражения СГРУППИРОВАТЬ ПО
//   * Псевдонимы  - Массив из Строка - имена колонок результата
//
Функция ВыборкаЗапроса(Аргументы)

	Результат = Новый Структура("Поля, Группировка, Псевдонимы", Новый Массив, Новый Массив, Новый Массив);
	Группы = МассивАргумента(Аргументы, "groupBy");
	Итоги = МассивАргумента(Аргументы, "aggregates");

	Если Не ЗначениеЗаполнено(Группы) И Не ЗначениеЗаполнено(Итоги) Тогда
		Поля = МассивАргумента(Аргументы, "fields");
		Если Не ЗначениеЗаполнено(Поля) Тогда
			Результат.Поля.Добавить("*");
		КонецЕсли;
		Для Каждого Поле Из Поля Цикл
			ДобавитьПолеВыборки(Результат, "Т." + ПутьПоля(Поле), ПсевдонимПоля(Поле));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Для Каждого Группа Из Группы Цикл
		ОписаниеГруппы = ВыражениеГруппы(Группа);
		ДобавитьПолеВыборки(Результат, ОписаниеГруппы.Выражение, ОписаниеГруппы.Псевдоним);
		Результат.Группировка.Добавить(ОписаниеГруппы.Выражение);
	КонецЦикла;

	Если Не ЗначениеЗаполнено(Итоги) Тогда
		ДобавитьПолеВыборки(Результат, "КОЛИЧЕСТВО(*)", "Количество");
	КонецЕсли;
	Для Каждого Итог Из Итоги Цикл
		ОписаниеИтога = ВыражениеИтога(Итог);
		ДобавитьПолеВыборки(Результат, ОписаниеИтога.Выражение, ОписаниеИтога.Псевдоним);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Добавляет поле выборки. Повторяющийся псевдоним получает номер.
//
// Параметры:
//  Выборка   - Структура - см. ВыборкаЗапроса
//  Выражение - Строка
//  Псевдоним - Строка
//
Процедура ДобавитьПолеВыборки(Выборка, Выражение, Псевдоним)

	Имя = Псевдоним;
	Номер = 1;
	Пока ИндексБезРегистра(Выборка.Псевдонимы, Имя) <> Неопределено Цикл
		Номер = Номер + 1;
		Имя = Псевдоним + Формат(Номер, "ЧГ=");
	КонецЦикла;
	Выборка.Псевдонимы.Добавить(Имя);
	Выборка.Поля.Добавить(Выражение + " КАК " + Имя);

КонецПроцедуры

// Выражение группировки: поле или начало периода даты ("Дата:month").
//
// Параметры:
//  Группа - Строка
//
// Возвращаемое значение:
//  Структура - Выражение, Псевдоним
//
Функция ВыражениеГруппы(Группа)

	Части = СтрРазделить(Строка(Группа), ":");
	Поле = СокрЛП(Части[0]);
	Если Части.Количество() = 1 Тогда
		Возврат Новый Структура("Выражение, Псевдоним", "Т." + ПутьПоля(Поле), ПсевдонимПоля(Поле));
	КонецЕсли;

	Периодичность = ПериодичностьПоИмени(СокрЛП(Части[1]));
	Если Периодичность = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Неизвестная периодичность в groupBy ""%1"": допустимы day, week, month, "
			+ "quarter, year", Группа);
	КонецЕсли;
	Выражение = СтрШаблон("НАЧАЛОПЕРИОДА(Т.%1, %2)", ПутьПоля(Поле), Периодичность);
	Возврат Новый Структура("Выражение, Псевдоним", Выражение, ПсевдонимПоля(Поле) + ТРег(Периодичность));

КонецФункции

// Выражение итога: агрегатная функция над полем.
//
// Параметры:
//  Итог - Структура, Строка - {"field", "function"} или "sum:Поле"
//
// Возвращаемое значение:
//  Структура - Выражение, Псевдоним
//
Функция ВыражениеИтога(Итог)

	Если ТипЗнч(Итог) = Тип("Структура") Тогда
		Поле = ЗначениеСвойства(Итог, "field");
		ИмяФункции = ЗначениеСвойства(Итог, "function");
	Иначе
		Части = СтрРазделить(Строка(Итог), ":");
		ИмяФункции = Части[0];
		Поле = "*";
		Если Части.Количество() > 1 Тогда
			Поле = Части[1];
		КонецЕсли;
	КонецЕсли;
	Поле = СокрЛП(Строка(Поле));
	ОписаниеФункции = АгрегатнаяФункция(СокрЛП(Строка(ИмяФункции)));

	Если Поле = "*" Или Не ЗначениеЗаполнено(Поле) Тогда
		Если ОписаниеФункции.Выражение <> "КОЛИЧЕСТВО(%1)" Тогда
			ВызватьИсключение "В aggregates у функции, кроме count, должно быть поле field";
		КонецЕсли;
		Возврат Новый Структура("Выражение, Псевдоним", "КОЛИЧЕСТВО(*)", "Количество");
	КонецЕсли;

	Выражение = СтрШаблон(ОписаниеФункции.Выражение, "Т." + ПутьПоля(Поле));
	Возврат Новый Структура("Выражение, Псевдоним", Выражение, ОписаниеФункции.Псевдоним + ПсевдонимПоля(Поле));

КонецФункции

// Агрегатная функция по имени из aggregates.
//
// Параметры:
//  ИмяФункции - Строка - sum, count, countDistinct, max, min, avg или русское имя
//
// Возвращаемое значение:
//  Структура - Выражение (шаблон с %1 для поля), Псевдоним (начало имени колонки)
//
Функция АгрегатнаяФункция(ИмяФункции)

	Функции = Новый Соответствие;
	ДобавитьАгрегатнуюФункцию(Функции, "SUM",           "СУММА(%1)",                "Сумма");
	ДобавитьАгрегатнуюФункцию(Функции, "COUNT",         "КОЛИЧЕСТВО(%1)",           "Количество");
	ДобавитьАгрегатнуюФункцию(Функции, "COUNTDISTINCT", "КОЛИЧЕСТВО(РАЗЛИЧНЫЕ %1)", "КоличествоРазличных");
	ДобавитьАгрегатнуюФункцию(Функции, "MAX",           "МАКСИМУМ(%1)",             "Максимум");
	ДобавитьАгрегатнуюФункцию(Функции, "MIN",           "МИНИМУМ(%1)",              "Минимум");
	ДобавитьАгрегатнуюФункцию(Функции, "AVG",           "СРЕДНЕЕ(%1)",              "Среднее");
	Функции.Вставить("СУММА",         Функции["SUM"]);
	Функции.Вставить("КОЛИЧЕСТВО",    Функции["COUNT"]);
	Функции.Вставить("МАКСИМУМ",      Функции["MAX"]);
	Функции.Вставить("МИНИМУМ",       Функции["MIN"]);
	Функции.Вставить("СРЕДНЕЕ",       Функции["AVG"]);

	Описание = Функции[ВРег(ИмяФункции)];
	Если Описание = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Неизвестная функция в aggregates ""%1"": допустимы sum, count, countDistinct, "
			+ "max, min, avg", ИмяФункции);
	КонецЕсли;
	Возврат Описание;

КонецФункции

// Добавляет агрегатную функцию в соответствие функций по имени.
//
// Параметры:
//  Функции   - Соответствие - дополняется
//  Ключ      - Строка - имя функции в aggregates
//  Выражение - Строка - шаблон выражения с %1 для поля
//  Псевдоним - Строка - начало имени колонки
//
Процедура ДобавитьАгрегатнуюФункцию(Функции, Ключ, Выражение, Псевдоним)

	Описание = Новый Структура;
	Описание.Вставить("Выражение", Выражение);
	Описание.Вставить("Псевдоним", Псевдоним);
	Функции.Вставить(Ключ, Описание);

КонецПроцедуры

// Периодичность группировки даты по имени.
//
// Параметры:
//  Имя - Строка - day, week, month, quarter, year или русское имя
//
// Возвращаемое значение:
//  Строка, Неопределено - периодичность языка запросов: ДЕНЬ, НЕДЕЛЯ, МЕСЯЦ, КВАРТАЛ, ГОД
//
Функция ПериодичностьПоИмени(Имя)

	Периодичности = Новый Соответствие;
	Периодичности.Вставить("DAY",     "ДЕНЬ");
	Периодичности.Вставить("WEEK",    "НЕДЕЛЯ");
	Периодичности.Вставить("MONTH",   "МЕСЯЦ");
	Периодичности.Вставить("QUARTER", "КВАРТАЛ");
	Периодичности.Вставить("YEAR",    "ГОД");
	Для Каждого Периодичность Из СтрРазделить("ДЕНЬ,НЕДЕЛЯ,МЕСЯЦ,КВАРТАЛ,ГОД", ",") Цикл
		Периодичности.Вставить(Периодичность, Периодичность);
	КонецЦикла;

	Возврат Периодичности[ВРег(Имя)];

КонецФункции

// Условия ГДЕ по отборам filters. Значения передаются параметрами запроса &Отбор1, &Отбор2...
//
// Параметры:
//  Аргументы          - Структура
//  ЗначенияПараметров - Структура - дополняется значениями отборов
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция УсловияОтборов(Аргументы, ЗначенияПараметров)

	Условия = Новый Массив;
	Номер = 0;
	Для Каждого Отбор Из МассивАргумента(Аргументы, "filters") Цикл
		Если ТипЗнч(Отбор) <> Тип("Структура") Тогда
			ВызватьИсключение "Элемент filters должен быть объектом {""field"", ""comparison"", ""value""}";
		КонецЕсли;
		Номер = Номер + 1;
		ИмяПараметра = "Отбор" + Формат(Номер, "ЧГ=");
		Поле = "Т." + ПутьПоля(ЗначениеСвойства(Отбор, "field"));
		Сравнение = ВРег(СокрЛП(Строка(ЗначениеСвойства(Отбор, "comparison", "="))));
		Значение = ЗначениеСвойства(Отбор, "value");
		Условия.Добавить(УсловиеОтбора(Поле, Сравнение, ИмяПараметра, Значение, ЗначенияПараметров));
	КонецЦикла;
	Возврат Условия;

КонецФункции

// Условие одного отбора.
//
// Параметры:
//  Поле               - Строка - выражение поля
//  Сравнение          - Строка - вид сравнения в верхнем регистре
//  ИмяПараметра       - Строка
//  Значение           - Произвольный - значение из JSON
//  ЗначенияПараметров - Структура - дополняется значением параметра
//
// Возвращаемое значение:
//  Строка
//
Функция УсловиеОтбора(Поле, Сравнение, ИмяПараметра, Значение, ЗначенияПараметров)

	Операторы = Новый Соответствие;
	Для Каждого Оператор Из СтрРазделить("=,<>,>,>=,<,<=", ",") Цикл
		Операторы.Вставить(Оператор, Оператор);
	КонецЦикла;
	Операторы.Вставить("!=", "<>");

	Если Операторы[Сравнение] <> Неопределено Тогда
		ЗначенияПараметров.Вставить(ИмяПараметра, Значение);
		Возврат СтрШаблон("%1 %2 &%3", Поле, Операторы[Сравнение], ИмяПараметра);
	ИначеЕсли Сравнение = "IN" Или Сравнение = "В" Тогда
		Список = Значение;
		Если ТипЗнч(Список) <> Тип("Массив") Тогда
			Список = Новый Массив;
			Список.Добавить(Значение);
		КонецЕсли;
		ЗначенияПараметров.Вставить(ИмяПараметра, Список);
		Возврат СтрШаблон("%1 В (&%2)", Поле, ИмяПараметра);
	ИначеЕсли Сравнение = "CONTAINS" Или Сравнение = "СОДЕРЖИТ" Тогда
		ЗначенияПараметров.Вставить(ИмяПараметра, "%" + ЭкранироватьДляПодобно(Строка(Значение)) + "%");
		Возврат СтрШаблон("%1 ПОДОБНО &%2 СПЕЦСИМВОЛ ""~""", Поле, ИмяПараметра);
	Иначе
		ВызватьИсключение СтрШаблон("Неизвестный вид сравнения ""%1"": допустимы =, <>, >, >=, <, <=, in, "
			+ "contains", Сравнение);
	КонецЕсли;

КонецФункции

// Добавляет отбор по периоду для таблиц с датой: документа, его табличной части, регистра.
//
// Параметры:
//  Условия            - Массив из Строка - дополняется
//  Таблица            - Структура - см. ОписаниеТаблицы
//  Период             - Структура - см. ПериодИзАргументов
//  ЗначенияПараметров - Структура - дополняется
//
Процедура ДобавитьУсловиеПериода(Условия, Таблица, Период, ЗначенияПараметров)

	Если Не ЗначениеЗаполнено(Период.Начало) И Не ЗначениеЗаполнено(Период.Конец)
		Или ЗначениеЗаполнено(Таблица.ВиртуальнаяТаблица) Тогда
		Возврат;
	КонецЕсли;

	ПолеДаты = ПолеДатыТаблицы(Таблица);
	Если Не ЗначениеЗаполнено(ПолеДаты) Тогда
		ВызватьИсключение СтрШаблон("У таблицы %1 нет даты, periodStart и periodEnd к ней не применяются. "
			+ "Задайте отбор по нужному полю в filters", Таблица.ПолноеИмя);
	КонецЕсли;

	Если ЗначениеЗаполнено(Период.Начало) Тогда
		ЗначенияПараметров.Вставить("НачалоПериода", Период.Начало);
		Условия.Добавить(СтрШаблон("Т.%1 >= &НачалоПериода", ПолеДаты));
	КонецЕсли;
	Если ЗначениеЗаполнено(Период.Конец) Тогда
		ЗначенияПараметров.Вставить("КонецПериода", Период.Конец);
		Условия.Добавить(СтрШаблон("Т.%1 <= &КонецПериода", ПолеДаты));
	КонецЕсли;

КонецПроцедуры

// Поле даты таблицы для отбора по периоду: Дата документа, Ссылка.Дата табличной части, Период регистра.
//
// Параметры:
//  Таблица - Структура - см. ОписаниеТаблицы
//
// Возвращаемое значение:
//  Строка - пустая, если у таблицы нет даты
//
Функция ПолеДатыТаблицы(Таблица)

	Если Таблица.Класс = "Документ" И ЗначениеЗаполнено(Таблица.ТабличнаяЧасть) Тогда
		Возврат "Ссылка.Дата";
	ИначеЕсли Таблица.Класс = "Документ" Тогда
		Возврат "Дата";
	ИначеЕсли ЭтоРегистрСПериодом(Таблица) Тогда
		Возврат "Период";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Истина, если у основной таблицы регистра есть поле Период.
//
// Параметры:
//  Таблица - Структура - см. ОписаниеТаблицы
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоРегистрСПериодом(Таблица)

	Если Таблица.Класс = "РегистрСведений" Тогда
		Возврат Таблица.Объект.ПериодичностьРегистраСведений
			<> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
	КонецЕсли;
	Возврат Таблица.Класс = "РегистрНакопления" Или Таблица.Класс = "РегистрБухгалтерии"
		Или Таблица.Класс = "РегистрРасчета";

КонецФункции

// Порядок результата по order: колонки результата или поля таблицы, с направлением desc/asc.
//
// Параметры:
//  Аргументы  - Структура
//  Псевдонимы - Массив из Строка - колонки результата
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ПорядокЗапроса(Аргументы, Псевдонимы)

	Порядок = Новый Массив;
	Для Каждого Элемент Из МассивАргумента(Аргументы, "order") Цикл
		Слова = СтрРазделить(СокрЛП(Строка(Элемент)), " ", Ложь);
		Если Не ЗначениеЗаполнено(Слова) Тогда
			Продолжить;
		КонецЕсли;
		Направление = "";
		Если Слова.Количество() > 1 Тогда
			ИмяНаправления = ВРег(Слова[1]);
			Если ИмяНаправления = "DESC" Или ИмяНаправления = "УБЫВ" Тогда
				Направление = " УБЫВ";
			ИначеЕсли ИмяНаправления = "ASC" Или ИмяНаправления = "ВОЗР" Тогда
				Направление = "";
			Иначе
				ВызватьИсключение СтрШаблон("Неверный порядок ""%1"": ожидается ""Поле"" или ""Поле desc""", Элемент);
			КонецЕсли;
		КонецЕсли;
		Индекс = ИндексБезРегистра(Псевдонимы, Слова[0]);
		Если Индекс = Неопределено Тогда
			Порядок.Добавить("Т." + ПутьПоля(Слова[0]) + Направление);
		Иначе
			Порядок.Добавить(Псевдонимы[Индекс] + Направление);
		КонецЕсли;
	КонецЦикла;
	Возврат Порядок;

КонецФункции

// Классы таблиц, для которых есть виртуальные таблицы, и их имена.
//
// Параметры:
//  Класс - Строка
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ВиртуальныеТаблицы(Класс)

	Если Класс = "РегистрНакопления" Тогда
		Имена = "Остатки,Обороты,ОстаткиИОбороты";
	ИначеЕсли Класс = "РегистрБухгалтерии" Тогда
		Имена = "Остатки,Обороты,ОстаткиИОбороты,ДвиженияССубконто";
	ИначеЕсли Класс = "РегистрСведений" Тогда
		Имена = "СрезПоследних,СрезПервых";
	Иначе
		Имена = "";
	КонецЕсли;
	Возврат СтрРазделить(Имена, ",", Ложь);

КонецФункции

// Истина, если виртуальная таблица строится на дату, а не за период.
//
// Параметры:
//  Имя - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ВиртуальнаяТаблицаНаДату(Имя)

	Возврат Имя = "Остатки" Или Имя = "СрезПоследних" Или Имя = "СрезПервых";

КонецФункции

// Истина, если у объекта есть табличная часть с таким именем.
//
// Параметры:
//  Объект - ОбъектМетаданных
//  Имя    - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьТабличнаяЧасть(Объект, Имя)

	СвойстваОбъекта = Новый Структура("ТабличныеЧасти");
	ЗаполнитьЗначенияСвойств(СвойстваОбъекта, Объект);
	Возврат СвойстваОбъекта.ТабличныеЧасти <> Неопределено И Объект.ТабличныеЧасти.Найти(Имя) <> Неопределено;

КонецФункции

// Русское имя класса таблицы: модель может написать Catalog или Document.
//
// Параметры:
//  Класс - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция РусскоеИмяКласса(Класс)

	Классы = Новый Соответствие;
	Классы.Вставить("CATALOG",                 "Справочник");
	Классы.Вставить("DOCUMENT",                "Документ");
	Классы.Вставить("ACCUMULATIONREGISTER",    "РегистрНакопления");
	Классы.Вставить("INFORMATIONREGISTER",     "РегистрСведений");
	Классы.Вставить("ACCOUNTINGREGISTER",      "РегистрБухгалтерии");
	Классы.Вставить("CALCULATIONREGISTER",     "РегистрРасчета");
	Классы.Вставить("CHARTOFACCOUNTS",         "ПланСчетов");
	Классы.Вставить("CHARTOFCHARACTERISTICTYPES", "ПланВидовХарактеристик");
	Классы.Вставить("BUSINESSPROCESS",         "БизнесПроцесс");
	Классы.Вставить("TASK",                    "Задача");

	РусскоеИмя = Классы[ВРег(Класс)];
	Если РусскоеИмя = Неопределено Тогда
		Возврат Класс;
	КонецЕсли;
	Возврат РусскоеИмя;

КонецФункции

// Период из periodStart и periodEnd: начало дня и конец дня.
//
// Параметры:
//  Аргументы - Структура
//
// Возвращаемое значение:
//  Структура - Начало, Конец (Дата или Неопределено)
//
Функция ПериодИзАргументов(Аргументы)

	Период = Новый Структура("Начало, Конец");
	ТекстНачала = СтрокаАргумента(Аргументы, "periodStart");
	Если ЗначениеЗаполнено(ТекстНачала) Тогда
		Период.Начало = НачалоДня(mcp_ОбщегоНазначения.ДатаИзСтроки(ТекстНачала));
	КонецЕсли;
	ТекстКонца = СтрокаАргумента(Аргументы, "periodEnd");
	Если ЗначениеЗаполнено(ТекстКонца) Тогда
		Период.Конец = КонецДня(mcp_ОбщегоНазначения.ДатаИзСтроки(ТекстКонца));
	КонецЕсли;
	Если ЗначениеЗаполнено(Период.Начало) И ЗначениеЗаполнено(Период.Конец) И Период.Начало > Период.Конец Тогда
		ВызватьИсключение "periodStart позже periodEnd";
	КонецЕсли;
	Возврат Период;

КонецФункции

// Экранирует служебные символы шаблона ПОДОБНО спецсимволом ~.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ЭкранироватьДляПодобно(Текст)

	Результат = Текст;
	Для Каждого Символ Из СтрРазделить("~,%,_,[,],^", ",") Цикл
		Результат = СтрЗаменить(Результат, Символ, "~" + Символ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ИнструментПрофильДанных

// Описывает инструмент data_profile: в каких таблицах есть записи за период.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - см. mcp_Метаданные.ТаблицаИнструментов
//
Процедура ДобавитьИнструментПрофильДанных(Инструменты)

	Параметры = Новый Массив;
	Виды = ВидыТаблицПрофиля();
	ДобавитьМассивСтрок(Параметры, "kinds",
		"Виды таблиц, по умолчанию все, кроме справочников; registers - все регистры", , Виды);
	ДобавитьСтроку(Параметры, "words",
		"Слова через пробел: берутся таблицы, в имени или синониме которых есть хотя бы одно слово");
	ДобавитьСтроку(Параметры, "periodStart",
		"Начало периода ГГГГ-ММ-ДД: считаются записи с датой или периодом не раньше");
	ДобавитьСтроку(Параметры, "periodEnd",
		"Конец периода ГГГГ-ММ-ДД включительно");
	ТаблицПоУмолчанию = ТаблицПрофиляПоУмолчанию();
	ДобавитьЧисло(Параметры, "maxTables", "Сколько таблиц с данными вернуть, самые заполненные первыми",
		ТаблицПоУмолчанию);
	ДобавитьЧисло(Параметры, "offset",
		"С какой таблицы продолжить обход: значение nextOffset прошлого ответа", 0);

	Описание = "Профиль данных базы: в каких документах и регистрах есть записи, сколько их и за какие даты. "
		+ "Помогает выбрать таблицу для read_table или run_query и не искать данные там, где их нет";
	mcp_Метаданные.ДобавитьИнструмент(Инструменты, "data_profile", Описание,
		mcp_Метаданные.СхемаПараметровИнструмента(Параметры));

КонецПроцедуры

// Считает записи доступных пользователю таблиц пачками по одному запросу с ОБЪЕДИНИТЬ ВСЕ. Обход
// ограничен по времени: если время вышло, ответ содержит nextOffset для продолжения.
//
// Параметры:
//  Аргументы - Структура - kinds, words, periodStart, periodEnd, maxTables, offset и контекст доступа
//
// Возвращаемое значение:
//  Структура:
//   * tablesTotal - Число - сколько таблиц подходит под отбор
//   * checked     - Число - сколько проверено в этом вызове
//   * nextOffset  - Число, Неопределено - откуда продолжить, если обход не закончен
//   * columns, rows, rowCount, totalRows, truncated - таблицы с записями, самые заполненные первыми
//   * emptyTables - Число - проверенных таблиц без записей
//
Функция ПрофильДанных(Аргументы)

	Период = ПериодИзАргументов(Аргументы);
	Таблицы = ТаблицыПрофиля(Аргументы);
	БезДаты = 0;
	Если ЗначениеЗаполнено(Период.Начало) Или ЗначениеЗаполнено(Период.Конец) Тогда
		БезДаты = ОставитьТаблицыСДатой(Таблицы);
	КонецЕсли;
	Начало = mcp_ЗапросыМодели.ЧислоИзАргументов(Аргументы, "offset", 0, 0, Таблицы.Количество());
	МаксимумТаблиц = mcp_ЗапросыМодели.ЧислоИзАргументов(Аргументы, "maxTables", ТаблицПрофиляПоУмолчанию(), 1,
		МаксимумТаблицПрофиля());

	СДанными = Новый ТаблицаЗначений;
	СДанными.Колонки.Добавить("table");
	СДанными.Колонки.Добавить("synonym");
	СДанными.Колонки.Добавить("records");
	СДанными.Колонки.Добавить("first");
	СДанными.Колонки.Добавить("last");

	Позиция = Начало;
	Привилегированно = mcp_ДоступПользователей.ЕстьТокенПользователя(Аргументы);
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Попытка
		Позиция = ОбойтиТаблицыПрофиля(Таблицы, Начало, Период, СДанными);
	Исключение
		Если Привилегированно Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение "Не удалось посчитать записи таблиц: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

	СДанными.Сортировать("records Убыв");
	Строки = Новый Массив;
	Для Каждого СтрокаСДанными Из СДанными Цикл
		Если Строки.Количество() >= МаксимумТаблиц Тогда
			Прервать;
		КонецЕсли;
		Значения = Новый Массив;
		Значения.Добавить(СтрокаСДанными.table);
		Значения.Добавить(СтрокаСДанными.synonym);
		Значения.Добавить(СтрокаСДанными.records);
		Значения.Добавить(mcp_ЗапросыМодели.ЗначениеДляМодели(СтрокаСДанными.first));
		Значения.Добавить(mcp_ЗапросыМодели.ЗначениеДляМодели(СтрокаСДанными.last));
		Строки.Добавить(Значения);
	КонецЦикла;

	СледующаяПозиция = Неопределено;
	Если Позиция < Таблицы.Количество() Тогда
		СледующаяПозиция = Позиция;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("columns",     СтрРазделить("Таблица,Синоним,Записей,Первая запись,Последняя запись", ","));
	Результат.Вставить("rows",        Строки);
	Результат.Вставить("rowCount",    Строки.Количество());
	Результат.Вставить("totalRows",   СДанными.Количество());
	Результат.Вставить("truncated",   СДанными.Количество() > Строки.Количество());
	Результат.Вставить("tablesTotal", Таблицы.Количество());
	Результат.Вставить("checked",     Позиция - Начало);
	Результат.Вставить("nextOffset",  СледующаяПозиция);
	Результат.Вставить("emptyTables", Позиция - Начало - СДанными.Количество());

	Пометки = Новый Массив;
	Если Не ЗначениеЗаполнено(Строки) Тогда
		Пометки.Добавить(СтрШаблон("В проверенных таблицах (%1) записей нет", Позиция - Начало));
	КонецЕсли;
	Если СледующаяПозиция <> Неопределено Тогда
		Пометки.Добавить(СтрШаблон("Проверено %1 таблиц из %2: продолжение - offset = %3", Позиция - Начало,
			Таблицы.Количество(), СледующаяПозиция));
	КонецЕсли;
	Если БезДаты > 0 Тогда
		Пометки.Добавить(СтрШаблон("%1 таблиц без даты записи (справочники, непериодические регистры сведений) "
			+ "не проверялись: период к ним не применяется. Без periodStart и periodEnd они считаются целиком",
			БезДаты));
	КонецЕсли;
	Если ЗначениеЗаполнено(Пометки) Тогда
		Результат.Вставить("note", СтрСоединить(Пометки, ". "));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Убирает из списка таблицы без поля даты: справочники и непериодические регистры сведений. Их записи
// нельзя отнести к периоду, и в профиле за период они дали бы общее число записей.
//
// Параметры:
//  Таблицы - Массив из Структура - см. ТаблицыПрофиля, изменяется
//
// Возвращаемое значение:
//  Число - сколько таблиц убрано
//
Функция ОставитьТаблицыСДатой(Таблицы)

	Убрано = 0;
	Индекс = Таблицы.ВГраница();
	Пока Индекс >= 0 Цикл
		Если Не ЗначениеЗаполнено(Таблицы[Индекс].ПолеДаты) Тогда
			Таблицы.Удалить(Индекс);
			Убрано = Убрано + 1;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат Убрано;

КонецФункции

// Считает записи таблиц пачками, пока не кончится бюджет времени.
//
// Параметры:
//  Таблицы  - Массив из Структура - см. ТаблицыПрофиля
//  Начало   - Число - индекс первой таблицы
//  Период   - Структура - см. ПериодИзАргументов
//  СДанными - ТаблицаЗначений - дополняется таблицами с записями
//
// Возвращаемое значение:
//  Число - индекс первой непроверенной таблицы
//
Функция ОбойтиТаблицыПрофиля(Таблицы, Начало, Период, СДанными)

	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Позиция = Начало;
	Пока Позиция < Таблицы.Количество()
		И ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт < БюджетПрофиляМиллисекунд() Цикл
		Пачка = Новый Массив;
		Пока Позиция < Таблицы.Количество() И Пачка.Количество() < РазмерПачкиПрофиля() Цикл
			Пачка.Добавить(Таблицы[Позиция]);
			Позиция = Позиция + 1;
		КонецЦикла;
		ПосчитатьПачку(Пачка, Период, СДанными);
	КонецЦикла;
	Возврат Позиция;

КонецФункции

// Таблицы для профиля: объекты выбранных видов, доступные пользователю и подходящие под слова.
//
// Параметры:
//  Аргументы - Структура
//
// Возвращаемое значение:
//  Массив из Структура - Имя (полное имя таблицы), Синоним, ПолеДаты
//
Функция ТаблицыПрофиля(Аргументы)

	Виды = МассивАргумента(Аргументы, "kinds");
	Если Не ЗначениеЗаполнено(Виды) Тогда
		Виды = СтрРазделить("documents,accumulationRegisters,accountingRegisters,informationRegisters", ",");
	КонецЕсли;
	Слова = СтрРазделить(ВРег(СтрокаАргумента(Аргументы, "words")), " ", Ложь);

	Таблицы = Новый Массив;
	Для Каждого Вид Из РазвернутьВидыПрофиля(Виды) Цикл
		Описание = ОписаниеВидаПрофиля(Вид);
		Для Каждого Объект Из Метаданные[Описание.Коллекция] Цикл
			Если ПодходитПодСлова(Объект, Слова) И mcp_ДоступПользователей.ДоступноПользователю(Аргументы, Объект) Тогда
				Таблица = НовоеОписаниеТаблицы(Описание.Класс + "." + Объект.Имя, Объект, Описание.Класс);
				ПолеДаты = ПолеДатыТаблицы(Таблица);
				Таблицы.Добавить(Новый Структура("Имя, Синоним, ПолеДаты", Таблица.ПолноеИмя, Объект.Синоним, ПолеДаты));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Таблицы;

КонецФункции

// Заменяет общий вид registers тремя видами регистров: модель часто называет регистры одним словом.
//
// Параметры:
//  Виды - Массив из Строка - значения kinds
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция РазвернутьВидыПрофиля(Виды)

	Результат = Новый Массив;
	Для Каждого Вид Из Виды Цикл
		Если ВРег(Строка(Вид)) = "REGISTERS" Тогда
			Результат.Добавить("accumulationRegisters");
			Результат.Добавить("accountingRegisters");
			Результат.Добавить("informationRegisters");
		Иначе
			Результат.Добавить(Строка(Вид));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Коллекция метаданных и класс таблицы для вида из kinds.
//
// Параметры:
//  Вид - Строка - documents, accumulationRegisters, accountingRegisters, informationRegisters, catalogs
//
// Возвращаемое значение:
//  Структура - Коллекция, Класс
//
Функция ОписаниеВидаПрофиля(Вид)

	Виды = Новый Соответствие;
	ДобавитьВидПрофиля(Виды, "DOCUMENTS",             "Документы",           "Документ");
	ДобавитьВидПрофиля(Виды, "ACCUMULATIONREGISTERS", "РегистрыНакопления",  "РегистрНакопления");
	ДобавитьВидПрофиля(Виды, "ACCOUNTINGREGISTERS",   "РегистрыБухгалтерии", "РегистрБухгалтерии");
	ДобавитьВидПрофиля(Виды, "INFORMATIONREGISTERS",  "РегистрыСведений",    "РегистрСведений");
	ДобавитьВидПрофиля(Виды, "CATALOGS",              "Справочники",         "Справочник");

	Описание = Виды[ВРег(Вид)];
	Если Описание = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Неизвестный вид таблиц ""%1"" в kinds: допустимы %2", Вид, ВидыТаблицПрофиля());
	КонецЕсли;
	Возврат Описание;

КонецФункции

// Добавляет вид таблиц профиля.
//
// Параметры:
//  Виды      - Соответствие - дополняется
//  Ключ      - Строка - значение kinds в верхнем регистре
//  Коллекция - Строка - имя коллекции метаданных
//  Класс     - Строка - класс таблицы в языке запросов
//
Процедура ДобавитьВидПрофиля(Виды, Ключ, Коллекция, Класс)

	Описание = Новый Структура;
	Описание.Вставить("Коллекция", Коллекция);
	Описание.Вставить("Класс",     Класс);
	Виды.Вставить(Ключ, Описание);

КонецПроцедуры

// Считает записи пачки таблиц одним запросом и добавляет таблицы с данными.
//
// Параметры:
//  Пачка    - Массив из Структура - см. ТаблицыПрофиля
//  Период   - Структура - см. ПериодИзАргументов
//  СДанными - ТаблицаЗначений - дополняется
//
Процедура ПосчитатьПачку(Пачка, Период, СДанными)

	Части = Новый Массив;
	Для Каждого Таблица Из Пачка Цикл
		Части.Добавить(ЗапросПодсчета(Таблица, Период, Части.Количество() = 0));
	КонецЦикла;
	Запрос = Новый Запрос(СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС));
	Если ЗначениеЗаполнено(Период.Начало) Тогда
		Запрос.УстановитьПараметр("НачалоПериода", Период.Начало);
	КонецЕсли;
	Если ЗначениеЗаполнено(Период.Конец) Тогда
		Запрос.УстановитьПараметр("КонецПериода", Период.Конец);
	КонецЕсли;

	Синонимы = Новый Соответствие;
	Для Каждого Таблица Из Пачка Цикл
		Синонимы.Вставить(Таблица.Имя, Таблица.Синоним);
	КонецЦикла;

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Записей = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаСДанными = СДанными.Добавить();
		СтрокаСДанными.table = Выборка.Таблица;
		СтрокаСДанными.synonym = Синонимы[Выборка.Таблица];
		СтрокаСДанными.records = Выборка.Записей;
		СтрокаСДанными.first = Выборка.Первая;
		СтрокаСДанными.last = Выборка.Последняя;
	КонецЦикла;

КонецПроцедуры

// Текст подсчета записей одной таблицы для объединения. Имя таблицы состоит из имен метаданных и
// подставляется в текст как есть.
//
// Параметры:
//  Таблица - Структура - см. ТаблицыПрофиля
//  Период  - Структура - см. ПериодИзАргументов
//  Первая  - Булево - первый запрос объединения получает РАЗРЕШЕННЫЕ
//
// Возвращаемое значение:
//  Строка
//
Функция ЗапросПодсчета(Таблица, Период, Первая)

	Разрешенные = "";
	Если Первая Тогда
		Разрешенные = " РАЗРЕШЕННЫЕ";
	КонецЕсли;
	Если ЗначениеЗаполнено(Таблица.ПолеДаты) Тогда
		Даты = СтрШаблон("МИНИМУМ(Т.%1) КАК Первая, МАКСИМУМ(Т.%1) КАК Последняя", Таблица.ПолеДаты);
	Иначе
		Даты = "NULL КАК Первая, NULL КАК Последняя";
	КонецЕсли;
	Текст = СтрШаблон("ВЫБРАТЬ%1 ""%2"" КАК Таблица, КОЛИЧЕСТВО(*) КАК Записей, %3 ИЗ %2 КАК Т",
		Разрешенные, Таблица.Имя, Даты);

	Условия = Новый Массив;
	Если ЗначениеЗаполнено(Таблица.ПолеДаты) И ЗначениеЗаполнено(Период.Начало) Тогда
		Условия.Добавить(СтрШаблон("Т.%1 >= &НачалоПериода", Таблица.ПолеДаты));
	КонецЕсли;
	Если ЗначениеЗаполнено(Таблица.ПолеДаты) И ЗначениеЗаполнено(Период.Конец) Тогда
		Условия.Добавить(СтрШаблон("Т.%1 <= &КонецПериода", Таблица.ПолеДаты));
	КонецЕсли;
	Если ЗначениеЗаполнено(Условия) Тогда
		Текст = Текст + " ГДЕ " + СтрСоединить(Условия, " И ");
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Истина, если в имени или синониме объекта есть хотя бы одно из слов; без слов - всегда Истина.
//
// Параметры:
//  Объект - ОбъектМетаданных
//  Слова  - Массив из Строка - в верхнем регистре
//
// Возвращаемое значение:
//  Булево
//
Функция ПодходитПодСлова(Объект, Слова)

	Если Не ЗначениеЗаполнено(Слова) Тогда
		Возврат Истина;
	КонецЕсли;
	Текст = ВРег(Объект.Имя + " " + Объект.Синоним);
	Для Каждого Слово Из Слова Цикл
		Если СтрНайти(Текст, Слово) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

