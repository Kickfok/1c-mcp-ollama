// Описывает инструмент run_report_variant: формирование варианта отчета с периодом и отборами.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - см. mcp_Метаданные.ТаблицаИнструментов
//
Процедура ДобавитьИнструментВыполнениеВариантаОтчета(Инструменты)

	Параметры = Новый Массив;
	ДобавитьСтроку(Параметры, "variant",
		"Ключ variant из list_report_variants или точное название варианта", , Истина);
	ДобавитьСтроку(Параметры, "periodStart", "Начало периода ГГГГ-ММ-ДД");
	ДобавитьСтроку(Параметры, "periodEnd",
		"Конец периода ГГГГ-ММ-ДД включительно");
	ДобавитьМассивОбъектов(Параметры, "filters",
		"Отборы отчета: [{""field"": ""Организация"", ""comparison"": ""="", ""value"": ""Наше предприятие""}]. "
		+ "comparison: =, <>, >, >=, <, <=, in, contains");
	ДобавитьОбъект(Параметры, "parameters",
		"Параметры отчета по именам, например {""Пользователь"": ""Иванов""}; ссылку задают наименованием или кодом");
	СтрокОтчета = СтрокОтчетаПоУмолчанию();
	ДобавитьЧисло(Параметры, "maxRows", "Сколько строк отчета вернуть", СтрокОтчета);
	ДобавитьЧисло(Параметры, "offset",
		"Сколько первых непустых строк отчета пропустить", 0);

	Описание = "Формирование готового отчета: {""variant"": ""<ключ>"", ""periodStart"": ""2026-01-01"", "
		+ """periodEnd"": ""2026-03-31""}; обязательные параметры отчета - в parameters. Возвращает записи отчета с "
		+ "названиями полей; пустой отчет помечен в note";
	mcp_Метаданные.ДобавитьИнструмент(Инструменты, "run_report_variant", Описание,
		mcp_Метаданные.СхемаПараметровИнструмента(Параметры));

КонецПроцедуры

// Формирует вариант отчета штатным методом отчета СкомпоноватьРезультат, поэтому обработчики
// модуля отчета работают как при формировании из формы. Результат - строки табличного документа.
//
// Параметры:
//  Аргументы - Структура - variant, periodStart, periodEnd, filters, maxRows, offset и контекст доступа
//
// Возвращаемое значение:
//  Структура - report, variant, applied, warnings, columns, rows, rowCount, totalRows, truncated, offset
//
Функция РезультатВариантаОтчета(Аргументы)

	ПроверитьПодсистемуВариантов();
	Вариант = НайтиВариантОтчета(СтрокаАргумента(Аргументы, "variant"), Аргументы);
	mcp_ДоступПользователей.ПроверитьДоступПользователя(Аргументы, Вариант.ОбъектОтчета);
	Если Вариант.ОбъектОтчета.ОсновнаяСхемаКомпоновкиДанных = Неопределено Тогда
		ВызватьИсключение СтрШаблон("У отчета %1 нет схемы компоновки данных: используйте read_table или run_query",
			Вариант.ОбъектОтчета.ПолноеИмя());
	КонецЕсли;

	Применено = Новый Массив;
	Предупреждения = Новый Массив;
	Привилегированно = mcp_ДоступПользователей.ЕстьТокенПользователя(Аргументы);
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Попытка
		ОтчетОбъект = Отчеты[Вариант.ОбъектОтчета.Имя].Создать();
		Схема = ОтчетОбъект.ПолучитьМакет(Вариант.ОбъектОтчета.ОсновнаяСхемаКомпоновкиДанных.Имя);
		Компоновщик = ОтчетОбъект.КомпоновщикНастроек;
		Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
		Компоновщик.ЗагрузитьНастройки(НастройкиВарианта(Вариант, Схема));
		ЗаполнитьСвойстваВарианта(Компоновщик.Настройки, Вариант);
		ПрименитьПериодОтчета(Компоновщик.Настройки, ПериодИзАргументов(Аргументы), Применено, Предупреждения);
		ПрименитьОтборыОтчета(Компоновщик.Настройки, Аргументы, Применено, Предупреждения);
		ПрименитьПараметрыОтчета(Компоновщик.Настройки, Аргументы, Применено, Предупреждения);

		Документ = Новый ТабличныйДокумент;
		ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
		ОтчетОбъект.СкомпоноватьРезультат(Документ, ДанныеРасшифровки);
	Исключение
		Если Привилегированно Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации("MCP.ОшибкаОтчета", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ПодробностиОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		Если СтрНайти(ПодробностиОшибки, "Не установлено значение параметра") > 0 Тогда
			Пояснение = "Передайте значение параметра в parameters, например {""Пользователь"": ""Иванов""}";
		ИначеЕсли Привилегированно И СтрНайти(ПодробностиОшибки, "НарушениеПравДоступа") > 0 Тогда
			// Выражения схемы компоновки вычисляются без привилегированного режима: отчет читает данные с
			// правами пользователя публикации, а их для типового отчета обычно не хватает
			Пояснение = "Отчет вызван через публикацию MCP, и для него не хватает прав ее пользователя. Готовые "
				+ "отчеты формируются, когда вопрос задан из формы 1С: там инструменты работают в сеансе "
				+ "пользователя. Сейчас данные можно получить через read_table или run_query";
		Иначе
			Пояснение = "Данные можно получить через read_table или run_query";
		КонецЕсли;
		ВызватьИсключение СтрШаблон("Отчет ""%1"" не сформирован: %2. %3", Вариант.Наименование,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке), Пояснение);
	КонецПопытки;
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

	МаксимумСтрок = mcp_ЗапросыМодели.ЧислоИзАргументов(Аргументы, "maxRows", СтрокОтчетаПоУмолчанию(), 1,
		МаксимумСтрокОтчета());
	Пропустить = mcp_ЗапросыМодели.ЧислоИзАргументов(Аргументы, "offset", 0, 0,
		mcp_ЗапросыМодели.МаксимумСмещения());
	// Значения берутся из данных расшифровки: у каждой ячейки с данными компоновка хранит поля и их значения.
	// Отчет без расшифровки отдается текстом ячеек
	Если ЗначениеЗаполнено(ДанныеРасшифровки.Элементы) Тогда
		Результат = ЗаписиОтчета(Документ, ДанныеРасшифровки, Пропустить, МаксимумСтрок);
	Иначе
		Результат = СтрокиТабличногоДокумента(Документ, Пропустить, МаксимумСтрок);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Результат.rows) И Пропустить = 0 Тогда
		Результат.Вставить("note", ПометкаПустогоОтчета(ПериодИзАргументов(Аргументы)));
	КонецЕсли;
	Результат.Вставить("report",   Вариант.ОбъектОтчета.ПолноеИмя());
	Результат.Вставить("variant",  Вариант.Наименование);
	Результат.Вставить("applied",  Применено);
	Результат.Вставить("warnings", Предупреждения);
	Возврат Результат;

КонецФункции

// Пояснение к пустому отчету с периодом, за который он сформирован: по нему видно, правильный ли период
// выбрала модель.
//
// Параметры:
//  Период - Структура - см. ПериодИзАргументов
//
// Возвращаемое значение:
//  Строка
//
Функция ПометкаПустогоОтчета(Период)

	ФорматДаты = "ДЛФ=D";
	Начало = Формат(Период.Начало, ФорматДаты);
	Конец = Формат(Период.Конец, ФорматДаты);
	Если ЗначениеЗаполнено(Период.Начало) И ЗначениеЗаполнено(Период.Конец) Тогда
		ТекстПериода = СтрШаблон("за период с %1 по %2", Начало, Конец);
	ИначеЕсли ЗначениеЗаполнено(Период.Конец) Тогда
		ТекстПериода = СтрШаблон("на %1", Конец);
	ИначеЕсли ЗначениеЗаполнено(Период.Начало) Тогда
		ТекстПериода = СтрШаблон("с %1", Начало);
	Иначе
		ТекстПериода = "за период по умолчанию";
	КонецЕсли;
	Возврат СтрШаблон("Отчет сформирован %1, но данных с этими отборами в базе нет", ТекстПериода);

КонецФункции

// Находит вариант отчета по ключу (уникальный идентификатор элемента справочника) или по названию.
//
// Параметры:
//  КлючИлиНазвание - Строка
//  Аргументы       - Структура - контекст доступа
//
// Возвращаемое значение:
//  Структура - Наименование, КлючВарианта, Пользовательский, Настройки, ОбъектОтчета
//
Функция НайтиВариантОтчета(КлючИлиНазвание, Аргументы)

	Если Не ЗначениеЗаполнено(КлючИлиНазвание) Тогда
		ВызватьИсключение "Не задан вариант отчета (variant): возьмите ключ из list_report_variants";
	КонецЕсли;

	// Вариант ищется по ключу из list_report_variants или по названию: условие подставляется в текст
	// одно, без ИЛИ, чтобы поиск шел по индексу
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	Варианты.Наименование КАК Наименование,
	|	Варианты.КлючВарианта КАК КлючВарианта,
	|	Варианты.Пользовательский КАК Пользовательский,
	|	Варианты.Настройки КАК Настройки,
	|	Варианты.Отчет КАК Отчет,
	|	Варианты.ПредопределенныйВариант КАК ПредопределенныйВариант
	|ИЗ
	|	Справочник.ВариантыОтчетов КАК Варианты
	|ГДЕ
	|	НЕ Варианты.ПометкаУдаления
	|	И &УсловиеПоиска
	|
	|УПОРЯДОЧИТЬ ПО
	|	Варианты.Ссылка");
	Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(КлючИлиНазвание) Тогда
		Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Справочник.ВариантыОтчетов");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоиска", "Варианты.Ссылка = &Значение");
		Запрос.УстановитьПараметр("Значение", Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(КлючИлиНазвание)));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоиска", "Варианты.Наименование = &Значение");
		Запрос.УстановитьПараметр("Значение", КлючИлиНазвание);
	КонецЕсли;

	Привилегированно = mcp_ДоступПользователей.ЕстьТокенПользователя(Аргументы);
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Выгрузка = Запрос.Выполнить().Выгрузить();
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

	Если Выгрузка.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("Вариант отчета ""%1"" не найден: возьмите ключ variant из list_report_variants",
			КлючИлиНазвание);
	ИначеЕсли Выгрузка.Количество() > 1 Тогда
		ВызватьИсключение СтрШаблон("Вариантов с названием ""%1"" несколько: передайте ключ variant из "
			+ "list_report_variants", КлючИлиНазвание);
	Иначе
		НайденныйВариант = Выгрузка[0];
	КонецЕсли;

	ОбъектОтчета = ОбъектМетаданныхОтчета(НайденныйВариант.Отчет);
	Если ОбъектОтчета = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Отчет варианта ""%1"" не найден в конфигурации", НайденныйВариант.Наименование);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Наименование",     НайденныйВариант.Наименование);
	Результат.Вставить("КлючВарианта",     НайденныйВариант.КлючВарианта);
	Результат.Вставить("КлючПредопределенногоВарианта", "");
	Если ЗначениеЗаполнено(НайденныйВариант.ПредопределенныйВариант) Тогда
		Результат.КлючПредопределенногоВарианта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			НайденныйВариант.ПредопределенныйВариант, "КлючВарианта", Истина);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Результат.КлючПредопределенногоВарианта) Тогда
		Результат.КлючПредопределенногоВарианта = НайденныйВариант.КлючВарианта;
	КонецЕсли;
	Результат.Вставить("Пользовательский", НайденныйВариант.Пользовательский);
	Результат.Вставить("Настройки",        Неопределено);
	Результат.Вставить("ОбъектОтчета",     ОбъектОтчета);
	Если ТипЗнч(НайденныйВариант.Настройки) = Тип("ХранилищеЗначения") Тогда
		Результат.Настройки = НайденныйВариант.Настройки.Получить();
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Настройки варианта: сохраненные в справочнике для пользовательского варианта, иначе вариант схемы по
// ключу, иначе настройки схемы по умолчанию.
//
// Параметры:
//  Вариант - Структура - см. НайтиВариантОтчета
//  Схема   - СхемаКомпоновкиДанных
//
// Возвращаемое значение:
//  НастройкиКомпоновкиДанных
//
Функция НастройкиВарианта(Вариант, Схема)

	Если ТипЗнч(Вариант.Настройки) = Тип("НастройкиКомпоновкиДанных") Тогда
		Возврат Вариант.Настройки;
	КонецЕсли;
	ВариантСхемы = Схема.ВариантыНастроек.Найти(Вариант.КлючВарианта);
	Если ВариантСхемы <> Неопределено Тогда
		Возврат ВариантСхемы.Настройки;
	КонецЕсли;
	Возврат Схема.НастройкиПоУмолчанию;

КонецФункции

// Заполняет дополнительные свойства настроек, которые подсистема "Варианты отчетов" задает перед
// формированием отчета из формы: модули типовых отчетов читают по ним, какой вариант формируется.
//
// Параметры:
//  Настройки - НастройкиКомпоновкиДанных
//  Вариант   - Структура - см. НайтиВариантОтчета
//
Процедура ЗаполнитьСвойстваВарианта(Настройки, Вариант)

	Свойства = Настройки.ДополнительныеСвойства;
	Свойства.Вставить("КлючВарианта",                  Вариант.КлючВарианта);
	Свойства.Вставить("КлючПредопределенногоВарианта", Вариант.КлючПредопределенногоВарианта);
	Свойства.Вставить("КонтекстВарианта",              "");
	Свойства.Вставить("ФормаПараметрыОтбор",           Новый Структура);

КонецПроцедуры

// Задает период в параметрах данных отчета: стандартный период или пару дат начала и конца.
//
// Параметры:
//  Настройки      - НастройкиКомпоновкиДанных
//  Период         - Структура - см. ПериодИзАргументов
//  Применено      - Массив из Строка - дополняется
//  Предупреждения - Массив из Строка - дополняется
//
Процедура ПрименитьПериодОтчета(Настройки, Период, Применено, Предупреждения)

	Если Не ЗначениеЗаполнено(Период.Начало) И Не ЗначениеЗаполнено(Период.Конец) Тогда
		Возврат;
	КонецЕсли;

	ИменаНачала = СтрРазделить("НАЧАЛОПЕРИОДА,ДАТАНАЧАЛА,ПЕРИОДС", ",");
	ИменаКонца = СтрРазделить("КОНЕЦПЕРИОДА,ДАТАОКОНЧАНИЯ,ПЕРИОДПО,ДАТАОТЧЕТА", ",");
	Задан = Ложь;
	Для Каждого Параметр Из Настройки.ПараметрыДанных.Элементы Цикл
		Имя = ВРег(Строка(Параметр.Параметр));
		Если ТипЗнч(Параметр.Значение) = Тип("СтандартныйПериод") Тогда
			Значение = Новый СтандартныйПериод;
			Значение.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
			Значение.ДатаНачала = Период.Начало;
			Значение.ДатаОкончания = Период.Конец;
			Параметр.Значение = Значение;
		ИначеЕсли ИменаНачала.Найти(Имя) <> Неопределено И ЗначениеЗаполнено(Период.Начало) Тогда
			Параметр.Значение = Период.Начало;
		ИначеЕсли ИменаКонца.Найти(Имя) <> Неопределено И ЗначениеЗаполнено(Период.Конец) Тогда
			Параметр.Значение = Период.Конец;
		Иначе
			Продолжить;
		КонецЕсли;
		Параметр.Использование = Истина;
		Применено.Добавить(СтрШаблон("параметр %1 = %2", Параметр.Параметр, Параметр.Значение));
		Задан = Истина;
	КонецЦикла;

	Если Не Задан Тогда
		Предупреждения.Добавить("У отчета нет параметра периода: periodStart и periodEnd не применены");
	КонецЕсли;

КонецПроцедуры

// Добавляет отборы filters в отбор настроек отчета. Поле, которого нет среди доступных полей отбора,
// не применяется и попадает в предупреждения со списком доступных полей.
//
// Параметры:
//  Настройки      - НастройкиКомпоновкиДанных
//  Аргументы      - Структура - filters и контекст доступа
//  Применено      - Массив из Строка - дополняется
//  Предупреждения - Массив из Строка - дополняется
//
Процедура ПрименитьОтборыОтчета(Настройки, Аргументы, Применено, Предупреждения)

	Для Каждого Отбор Из МассивАргумента(Аргументы, "filters") Цикл
		Если ТипЗнч(Отбор) <> Тип("Структура") Тогда
			ВызватьИсключение "Элемент filters должен быть объектом {""field"", ""comparison"", ""value""}";
		КонецЕсли;
		ИмяПоля = СокрЛП(Строка(ЗначениеСвойства(Отбор, "field")));
		Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		ДоступноеПоле = Настройки.Отбор.ДоступныеПоляОтбора.НайтиПоле(Поле);
		Если ДоступноеПоле = Неопределено Тогда
			Доступные = ДоступныеПоляОтбора(Настройки);
			Предупреждение = СтрШаблон("Поля отбора ""%1"" в отчете нет. Доступные поля: %2", ИмяПоля, Доступные);
			Предупреждения.Добавить(Предупреждение);
			Продолжить;
		КонецЕсли;

		ВидСравнения = ВидСравненияОтчета(Строка(ЗначениеСвойства(Отбор, "comparison", "=")));
		Значение = mcp_ЗапросыМодели.ЗначениеПараметра(ЗначениеСвойства(Отбор, "value"), ДоступноеПоле.ТипЗначения,
			ИмяПоля, Аргументы);
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Список = Новый СписокЗначений;
			Список.ЗагрузитьЗначения(Значение);
			Значение = Список;
		КонецЕсли;

		Элемент = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Элемент.ЛевоеЗначение = Поле;
		Элемент.ВидСравнения = ВидСравнения;
		Элемент.ПравоеЗначение = Значение;
		Элемент.Использование = Истина;
		Применено.Добавить(СтрШаблон("отбор %1 %2 %3", ИмяПоля, ВидСравнения, Значение));
	КонецЦикла;

КонецПроцедуры

// Задает параметры данных отчета из аргумента parameters. Значение приводится к типу параметра; параметр,
// которого в отчете нет, не применяется и попадает в предупреждения со списком параметров отчета.
//
// Параметры:
//  Настройки      - НастройкиКомпоновкиДанных
//  Аргументы      - Структура - parameters и контекст доступа
//  Применено      - Массив из Строка - дополняется
//  Предупреждения - Массив из Строка - дополняется
//
Процедура ПрименитьПараметрыОтчета(Настройки, Аргументы, Применено, Предупреждения)

	Значения = Неопределено;
	Если Не Аргументы.Свойство("parameters", Значения) Или ТипЗнч(Значения) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЗначениеИзJSON Из Значения Цикл
		ПараметрКомпоновки = Новый ПараметрКомпоновкиДанных(ЗначениеИзJSON.Ключ);
		ЗначениеПараметра = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКомпоновки);
		ДоступныйПараметр = Настройки.ПараметрыДанных.ДоступныеПараметры.НайтиПараметр(ПараметрКомпоновки);
		Если ЗначениеПараметра = Неопределено Или ДоступныйПараметр = Неопределено Тогда
			ИменаПараметров = ПараметрыОтчетаСтрокой(Настройки);
			Предупреждение = СтрШаблон("Параметра ""%1"" в отчете нет. Параметры отчета: %2", ЗначениеИзJSON.Ключ,
				ИменаПараметров);
			Предупреждения.Добавить(Предупреждение);
			Продолжить;
		КонецЕсли;
		Значение = mcp_ЗапросыМодели.ЗначениеПараметра(ЗначениеИзJSON.Значение, ДоступныйПараметр.ТипЗначения,
			ЗначениеИзJSON.Ключ, Аргументы);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(ПараметрКомпоновки, Значение);
		Применено.Добавить(СтрШаблон("параметр %1 = %2", ЗначениеИзJSON.Ключ, Значение));
	КонецЦикла;

КонецПроцедуры

// Имена параметров данных отчета через запятую.
//
// Параметры:
//  Настройки - НастройкиКомпоновкиДанных
//
// Возвращаемое значение:
//  Строка
//
Функция ПараметрыОтчетаСтрокой(Настройки)

	ПараметровВПодсказке = 20;
	Имена = Новый Массив;
	Для Каждого Параметр Из Настройки.ПараметрыДанных.Элементы Цикл
		Если Имена.Количество() >= ПараметровВПодсказке Тогда
			Прервать;
		КонецЕсли;
		Имена.Добавить(Строка(Параметр.Параметр));
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");

КонецФункции

// Вид сравнения компоновки по имени из filters.
//
// Параметры:
//  Имя - Строка
//
// Возвращаемое значение:
//  ВидСравненияКомпоновкиДанных
//
Функция ВидСравненияОтчета(Имя)

	Виды = Новый Соответствие;
	Виды.Вставить("=",        ВидСравненияКомпоновкиДанных.Равно);
	Виды.Вставить("<>",       ВидСравненияКомпоновкиДанных.НеРавно);
	Виды.Вставить("!=",       ВидСравненияКомпоновкиДанных.НеРавно);
	Виды.Вставить(">",        ВидСравненияКомпоновкиДанных.Больше);
	Виды.Вставить(">=",       ВидСравненияКомпоновкиДанных.БольшеИлиРавно);
	Виды.Вставить("<",        ВидСравненияКомпоновкиДанных.Меньше);
	Виды.Вставить("<=",       ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	Виды.Вставить("IN",       ВидСравненияКомпоновкиДанных.ВСписке);
	Виды.Вставить("CONTAINS", ВидСравненияКомпоновкиДанных.Содержит);

	ВидСравнения = Виды[ВРег(СокрЛП(Имя))];
	Если ВидСравнения = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Неизвестный вид сравнения ""%1"": допустимы =, <>, >, >=, <, <=, in, contains",
			Имя);
	КонецЕсли;
	Возврат ВидСравнения;

КонецФункции

// Имена доступных полей отбора верхнего уровня, не больше 30.
//
// Параметры:
//  Настройки - НастройкиКомпоновкиДанных
//
// Возвращаемое значение:
//  Строка
//
Функция ДоступныеПоляОтбора(Настройки)

	ПолейВПодсказке = 30;
	Имена = Новый Массив;
	Для Каждого Поле Из Настройки.Отбор.ДоступныеПоляОтбора.Элементы Цикл
		Если Поле.Папка Или Имена.Количество() >= ПолейВПодсказке Тогда
			Продолжить;
		КонецЕсли;
		Имена.Добавить(Строка(Поле.Поле));
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");

КонецФункции

// Записи отчета по данным расшифровки: для каждой строки табличного документа собираются поля ее ячеек
// с данными и поля группировок, в которые ячейки входят. Заголовки, параметры и шапки таблиц расшифровки
// не имеют и в записи не попадают. Колонки называются заголовками полей отчета.
//
// Параметры:
//  Документ          - ТабличныйДокумент - результат отчета
//  ДанныеРасшифровки - ДанныеРасшифровкиКомпоновкиДанных - заполнены при формировании
//  Пропустить        - Число - сколько первых записей пропустить
//  МаксимумСтрок     - Число
//
// Возвращаемое значение:
//  Структура - columns, rows, rowCount, totalRows, truncated, offset
//
Функция ЗаписиОтчета(Документ, ДанныеРасшифровки, Пропустить, МаксимумСтрок)

	Поля = Новый Массив;
	Записи = Новый Массив;
	Ширина = Мин(Документ.ШиринаТаблицы, МаксимумКолонокОтчета());
	ПредыдущаяЗапись = "";
	Для НомерСтроки = 1 По Документ.ВысотаТаблицы Цикл
		Запись = ЗаписьСтрокиОтчета(Документ, ДанныеРасшифровки, НомерСтроки, Ширина, Поля);
		Если Запись = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Значение группировки, растянутое на несколько строк документа, дает одинаковые записи подряд
		ПредставлениеЗаписи = mcp_ОбщегоНазначения.СтруктураВJSON(Запись);
		Если ПредставлениеЗаписи <> ПредыдущаяЗапись Тогда
			Записи.Добавить(Запись);
			ПредыдущаяЗапись = ПредставлениеЗаписи;
		КонецЕсли;
	КонецЦикла;

	Строки = Новый Массив;
	Для Индекс = Пропустить По Мин(Записи.ВГраница(), Пропустить + МаксимумСтрок - 1) Цикл
		Значения = Новый Массив;
		Для Каждого Поле Из Поля Цикл
			Значения.Добавить(Записи[Индекс][Поле]);
		КонецЦикла;
		Строки.Добавить(Значения);
	КонецЦикла;

	Колонки = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		Колонки.Добавить(ЗаголовокПоляОтчета(ДанныеРасшифровки, Поле));
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("columns",   Колонки);
	Результат.Вставить("fields",    Поля);
	Результат.Вставить("rows",      Строки);
	Результат.Вставить("rowCount",  Строки.Количество());
	Результат.Вставить("totalRows", Записи.Количество());
	Результат.Вставить("truncated", Записи.Количество() > Пропустить + Строки.Количество());
	Результат.Вставить("offset",    Пропустить);
	Возврат Результат;

КонецФункции

// Поля и значения одной строки табличного документа по расшифровке ее ячеек.
//
// Параметры:
//  Документ          - ТабличныйДокумент
//  ДанныеРасшифровки - ДанныеРасшифровкиКомпоновкиДанных
//  НомерСтроки       - Число
//  Ширина            - Число - сколько колонок читать
//  Поля              - Массив из Строка - имена полей в порядке появления, дополняется
//
// Возвращаемое значение:
//  Соответствие, Неопределено - ключ: имя поля, значение: значение для модели; Неопределено, если в
//                               строке нет данных
//
Функция ЗаписьСтрокиОтчета(Документ, ДанныеРасшифровки, НомерСтроки, Ширина, Поля)

	Запись = Новый Соответствие;
	ЕстьЗначение = Ложь;
	Для НомерКолонки = 1 По Ширина Цикл
		Расшифровка = Документ.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Расшифровка;
		Если ТипЗнч(Расшифровка) <> Тип("ИдентификаторРасшифровкиКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьПоляРасшифровки(ДанныеРасшифровки.Элементы[Расшифровка], Запись, Поля);
	КонецЦикла;

	Для Каждого ПолеЗаписи Из Запись Цикл
		ЕстьЗначение = ЕстьЗначение Или ЗначениеЗаполнено(ПолеЗаписи.Значение);
	КонецЦикла;
	Если Не ЕстьЗначение Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Запись;

КонецФункции

// Добавляет в запись поля элемента расшифровки и его родителей: сначала группировки верхнего уровня,
// затем поля самой ячейки.
//
// Параметры:
//  Элемент - ЭлементРасшифровкиКомпоновкиДанныхПоля, ЭлементРасшифровкиКомпоновкиДанныхГруппировка
//  Запись  - Соответствие - дополняется
//  Поля    - Массив из Строка - имена полей в порядке появления, дополняется
//
Процедура ДобавитьПоляРасшифровки(Элемент, Запись, Поля)

	Для Каждого Родитель Из Элемент.ПолучитьРодителей() Цикл
		ДобавитьПоляРасшифровки(Родитель, Запись, Поля);
	КонецЦикла;

	Если ТипЗнч(Элемент) <> Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ЗначениеПоля Из Элемент.ПолучитьПоля() Цикл
		Если Поля.Найти(ЗначениеПоля.Поле) = Неопределено Тогда
			Поля.Добавить(ЗначениеПоля.Поле);
		КонецЕсли;
		Запись.Вставить(ЗначениеПоля.Поле, mcp_ЗапросыМодели.ЗначениеДляМодели(ЗначениеПоля.Значение));
	КонецЦикла;

КонецПроцедуры

// Заголовок поля отчета для колонки результата; если поле не найдено среди полей выбора - имя поля.
//
// Параметры:
//  ДанныеРасшифровки - ДанныеРасшифровкиКомпоновкиДанных
//  Поле              - Строка - имя поля
//
// Возвращаемое значение:
//  Строка
//
Функция ЗаголовокПоляОтчета(ДанныеРасшифровки, Поле)

	ПолеКомпоновки = Новый ПолеКомпоновкиДанных(Поле);
	ДоступноеПоле = ДанныеРасшифровки.Настройки.Выбор.ДоступныеПоляВыбора.НайтиПоле(ПолеКомпоновки);
	Если ДоступноеПоле = Неопределено Или Не ЗначениеЗаполнено(ДоступноеПоле.Заголовок) Тогда
		Возврат Поле;
	КонецЕсли;

	// Поле внутри папки (Себестоимость товаров - Всего) без названия папки непонятно
	Заголовок = ДоступноеПоле.Заголовок;
	Родитель = ДоступноеПоле.Родитель;
	Пока Родитель <> Неопределено И ЗначениеЗаполнено(Родитель.Заголовок) Цикл
		Заголовок = Родитель.Заголовок + " / " + Заголовок;
		Родитель = Родитель.Родитель;
	КонецЦикла;
	Возврат Заголовок;

КонецФункции

// Непустые строки табличного документа: текст ячеек по колонкам, пустые колонки справа отброшены.
//
// Параметры:
//  Документ      - ТабличныйДокумент
//  Пропустить    - Число - сколько первых непустых строк пропустить
//  МаксимумСтрок - Число
//
// Возвращаемое значение:
//  Структура - columns, rows, rowCount, totalRows, truncated, offset
//
Функция СтрокиТабличногоДокумента(Документ, Пропустить, МаксимумСтрок)

	Ширина = Мин(Документ.ШиринаТаблицы, МаксимумКолонокОтчета());
	Строки = Новый Массив;
	ВсегоСтрок = 0;
	ЗанятоКолонок = 0;
	Для НомерСтроки = 1 По Документ.ВысотаТаблицы Цикл
		Ячейки = ЯчейкиСтроки(Документ, НомерСтроки, Ширина);
		Если Ячейки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВсегоСтрок = ВсегоСтрок + 1;
		Если ВсегоСтрок > Пропустить И Строки.Количество() < МаксимумСтрок Тогда
			Строки.Добавить(Ячейки);
			ЗанятоКолонок = Макс(ЗанятоКолонок, ПоследняяЗаполненная(Ячейки));
		КонецЕсли;
	КонецЦикла;

	Колонки = Новый Массив;
	Для Номер = 1 По ЗанятоКолонок Цикл
		Колонки.Добавить(ИмяКолонкиТабличногоДокумента(Номер));
	КонецЦикла;
	Для Каждого Ячейки Из Строки Цикл
		Пока Ячейки.Количество() > ЗанятоКолонок Цикл
			Ячейки.Удалить(Ячейки.ВГраница());
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("columns",   Колонки);
	Результат.Вставить("rows",      Строки);
	Результат.Вставить("rowCount",  Строки.Количество());
	Результат.Вставить("totalRows", ВсегоСтрок);
	Результат.Вставить("truncated", ВсегоСтрок > Пропустить + Строки.Количество());
	Результат.Вставить("offset",    Пропустить);
	Возврат Результат;

КонецФункции

// Тексты ячеек строки табличного документа.
//
// Параметры:
//  Документ    - ТабличныйДокумент
//  НомерСтроки - Число
//  Ширина      - Число - сколько колонок читать
//
// Возвращаемое значение:
//  Массив из Строка, Неопределено - Неопределено, если строка пустая
//
Функция ЯчейкиСтроки(Документ, НомерСтроки, Ширина)

	ДлинаЯчейки = 100;
	Ячейки = Новый Массив;
	ЕстьТекст = Ложь;
	Для НомерКолонки = 1 По Ширина Цикл
		Текст = СокрЛП(Документ.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
		Ячейки.Добавить(Лев(Текст, ДлинаЯчейки));
		ЕстьТекст = ЕстьТекст Или ЗначениеЗаполнено(Текст);
	КонецЦикла;
	Если Не ЕстьТекст Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ячейки;

КонецФункции

// Номер последней непустой ячейки.
//
// Параметры:
//  Ячейки - Массив из Строка
//
// Возвращаемое значение:
//  Число
//
Функция ПоследняяЗаполненная(Ячейки)

	Номер = Ячейки.Количество();
	Пока Номер > 0 И Не ЗначениеЗаполнено(Ячейки[Номер - 1]) Цикл
		Номер = Номер - 1;
	КонецЦикла;
	Возврат Номер;

КонецФункции

// Имя колонки табличного документа: A, B ... Z, AA, AB.
//
// Параметры:
//  Номер - Число - от 1
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяКолонкиТабличногоДокумента(Номер)

	Буквы = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	БукВАлфавите = СтрДлина(Буквы);
	Имя = "";
	Остаток = Номер;
	Пока Остаток > 0 Цикл
		Индекс = (Остаток - 1) % БукВАлфавите;
		Имя = Сред(Буквы, Индекс + 1, 1) + Имя;
		Остаток = Цел((Остаток - 1) / БукВАлфавите);
	КонецЦикла;
	Возврат Имя;

КонецФункции

// Сколько строк отчета возвращается по умолчанию.
//
// Возвращаемое значение:
//  Число
//
Функция СтрокОтчетаПоУмолчанию()

	Возврат 40;

КонецФункции

// Наибольшее значение maxRows для отчета.
//
// Возвращаемое значение:
//  Число
//
Функция МаксимумСтрокОтчета()

	Возврат 300;

КонецФункции

// Сколько колонок табличного документа читается.
//
// Возвращаемое значение:
//  Число
//
Функция МаксимумКолонокОтчета()

	Возврат 30;

КонецФункции

#КонецОбласти

#Область ВариантыОтчетов

// Вызывает исключение, если в конфигурации нет подсистемы БСП "Варианты отчетов".
Процедура ПроверитьПодсистемуВариантов()

	Если Метаданные.Справочники.Найти("ВариантыОтчетов") = Неопределено Тогда
		ВызватьИсключение "В конфигурации нет подсистемы ""Варианты отчетов"": готовые отчеты недоступны. "
			+ "Данные можно получить через read_table или run_query";
	КонецЕсли;

КонецПроцедуры

// Объект метаданных отчета по ссылке на идентификатор объекта метаданных или расширения.
//
// Параметры:
//  СсылкаОтчета - СправочникСсылка.ИдентификаторыОбъектовМетаданных, СправочникСсылка.ИдентификаторыОбъектовРасширений
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено
//
Функция ОбъектМетаданныхОтчета(СсылкаОтчета)

	Если Не ЗначениеЗаполнено(СсылкаОтчета) Или ТипЗнч(СсылкаОтчета) = Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОбъектОтчета = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(СсылкаОтчета, Ложь);
	Если ТипЗнч(ОбъектОтчета) <> Тип("ОбъектМетаданных") Или Не Метаданные.Отчеты.Содержит(ОбъектОтчета) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ОбъектОтчета;

КонецФункции

