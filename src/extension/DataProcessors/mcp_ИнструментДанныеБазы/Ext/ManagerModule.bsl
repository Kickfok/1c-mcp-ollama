#Область Аргументы

// Строковое значение аргумента или пустая строка.
//
// Параметры:
//  Аргументы - Структура
//  Имя       - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция СтрокаАргумента(Аргументы, Имя)

	Значение = Неопределено;
	Если Не Аргументы.Свойство(Имя, Значение) Или Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Массив из аргумента; одиночное значение становится массивом из одного элемента.
//
// Параметры:
//  Аргументы - Структура
//  Имя       - Строка
//
// Возвращаемое значение:
//  Массив
//
Функция МассивАргумента(Аргументы, Имя)

	Значение = Неопределено;
	Результат = Новый Массив;
	Если Не Аргументы.Свойство(Имя, Значение) Или Значение = Неопределено Тогда
		Возврат Результат;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	Иначе
		Результат.Добавить(Значение);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Значение свойства структуры из JSON без учета регистра имени.
//
// Параметры:
//  Объект      - Структура
//  Имя         - Строка
//  ПоУмолчанию - Произвольный
//
// Возвращаемое значение:
//  Произвольный
//
Функция ЗначениеСвойства(Объект, Имя, ПоУмолчанию = Неопределено)

	ИмяВРег = ВРег(Имя);
	Для Каждого Свойство Из Объект Цикл
		Если ВРег(Свойство.Ключ) = ИмяВРег Тогда
			Возврат Свойство.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат ПоУмолчанию;

КонецФункции

// Путь поля для текста запроса: имена через точку, каждое - идентификатор.
//
// Параметры:
//  Поле - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ПутьПоля(Поле)

	Путь = СокрЛП(Строка(Поле));
	Если Не ЗначениеЗаполнено(Путь) Тогда
		ВызватьИсключение "Не задано имя поля";
	КонецЕсли;
	Для Каждого Часть Из СтрРазделить(Путь, ".") Цикл
		ПроверитьИмя(Часть, "поле");
	КонецЦикла;
	Возврат Путь;

КонецФункции

// Псевдоним колонки для поля: точки убираются (Контрагент.ИНН - КонтрагентИНН).
//
// Параметры:
//  Поле - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ПсевдонимПоля(Поле)

	Возврат СтрЗаменить(ПутьПоля(Поле), ".", "");

КонецФункции

// Вызывает исключение, если имя не является идентификатором языка запросов.
//
// Параметры:
//  Имя - Строка
//  Что - Строка - для текста ошибки
//
Процедура ПроверитьИмя(Имя, Что)

	Правильное = ЗначениеЗаполнено(Имя) И СтрНайти("0123456789", Лев(Имя, 1)) = 0;
	Для Позиция = 1 По СтрДлина(Имя) Цикл
		Символ = Сред(Имя, Позиция, 1);
		Если ВРег(Символ) = НРег(Символ) И Символ <> "_" И СтрНайти("0123456789", Символ) = 0 Тогда
			Правильное = Ложь;
		КонецЕсли;
	КонецЦикла;
	Если Не Правильное Тогда
		ВызватьИсключение СтрШаблон("Неверное имя (%1): ""%2"". Допустимы буквы, цифры и _", Что, Имя);
	КонецЕсли;

КонецПроцедуры

// Индекс строки в массиве без учета регистра.
//
// Параметры:
//  Массив   - Массив из Строка
//  Искомая  - Строка
//
// Возвращаемое значение:
//  Число, Неопределено
//
Функция ИндексБезРегистра(Массив, Искомая)

	СтрокаВРег = ВРег(Искомая);
	Для Индекс = 0 По Массив.ВГраница() Цикл
		Если ВРег(Массив[Индекс]) = СтрокаВРег Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Истина, если строка содержит часть без учета регистра; пустая часть - всегда Истина.
//
// Параметры:
//  Текст      - Строка
//  ЧастьВРег  - Строка - в верхнем регистре
//
// Возвращаемое значение:
//  Булево
//
Функция СодержитЧасть(Текст, ЧастьВРег)

	Возврат Не ЗначениеЗаполнено(ЧастьВРег) Или СтрНайти(ВРег(Строка(Текст)), ЧастьВРег) > 0;

КонецФункции

#КонецОбласти

#КонецОбласти
