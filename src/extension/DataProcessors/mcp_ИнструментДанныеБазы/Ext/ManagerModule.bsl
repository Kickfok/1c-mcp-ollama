// Описывает инструмент read_event_log: события журнала регистрации за период.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - см. mcp_Метаданные.ТаблицаИнструментов
//
Процедура ДобавитьИнструментЖурналРегистрации(Инструменты)

	Параметры = Новый Массив;
	ДобавитьСтроку(Параметры, "periodStart",
		"Начало периода ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTчч:мм:сс, по умолчанию сутки назад");
	ДобавитьСтроку(Параметры, "periodEnd",
		"Конец периода, по умолчанию сейчас");
	ДобавитьМассивСтрок(Параметры, "levels", "Уровни событий", ,
		"error,warning,information,note");
	ДобавитьСтроку(Параметры, "event",
		"Часть имени события, например Данные.Изменение или Сеанс");
	ДобавитьСтроку(Параметры, "user", "Часть имени пользователя");
	ДобавитьСтроку(Параметры, "text",
		"Часть текста комментария или представления данных");
	ДобавитьСтроку(Параметры, "mode",
		"records - последние события, summary - сколько событий каждого уровня и вида", "records", ,
		"records,summary");
	СобытийПоУмолчанию = СобытийЖурналаПоУмолчанию();
	ДобавитьЧисло(Параметры, "maxRows", "Сколько последних событий вернуть в режиме records", СобытийПоУмолчанию);

	Описание = "Журнал регистрации 1С: ошибки, предупреждения и действия пользователей за период. Нужно право "
		+ """Журнал регистрации"" у пользователя, задавшего вопрос";
	mcp_Метаданные.ДобавитьИнструмент(Инструменты, "read_event_log", Описание,
		mcp_Метаданные.СхемаПараметровИнструмента(Параметры));

КонецПроцедуры

// Читает журнал регистрации за период. Уровни и пользователи отбираются платформой, вид события и текст -
// в памяти. Читается не больше ПотолокЧтенияЖурнала событий периода.
//
// Параметры:
//  Аргументы - Структура - periodStart, periodEnd, levels, event, user, text, mode, maxRows и контекст
//
// Возвращаемое значение:
//  Структура - columns, rows, rowCount, totalRows, truncated; note, если событий нет или прочитаны не все
//
Функция СобытияЖурнала(Аргументы)

	Если Не mcp_ДоступПользователей.ЕстьПравоПользователя(Аргументы, "ЖурналРегистрации", Метаданные) Тогда
		ВызватьИсключение "У пользователя нет права ""Журнал регистрации"": просмотр журнала ему недоступен";
	КонецЕсли;

	Отбор = ОтборЖурнала(Аргументы);
	События = Новый ТаблицаЗначений;
	Привилегированно = mcp_ДоступПользователей.ЕстьТокенПользователя(Аргументы);
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Попытка
		ДобавитьОтборПользователей(Отбор, СтрокаАргумента(Аргументы, "user"));
		ВыгрузитьЖурналРегистрации(События, Отбор, КолонкиЖурнала(), , ПотолокЧтенияЖурнала());
	Исключение
		Если Привилегированно Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение "Не удалось прочитать журнал регистрации: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

	Подходящие = ПодходящиеСобытия(События, Аргументы);
	Если ВРег(СтрокаАргумента(Аргументы, "mode")) = "SUMMARY" Тогда
		Результат = СводкаСобытий(Подходящие);
	Иначе
		МаксимумСтрок = mcp_ЗапросыМодели.ЧислоИзАргументов(Аргументы, "maxRows", СобытийЖурналаПоУмолчанию(), 1,
			МаксимумСобытийЖурнала());
		Результат = СтрокиСобытий(Подходящие, МаксимумСтрок);
	КонецЕсли;

	Пометка = "";
	Потолок = ПотолокЧтенияЖурнала();
	Если События.Количество() >= Потолок Тогда
		Пометка = СтрШаблон("Прочитаны первые %1 событий периода, более поздние могли не попасть: сузьте период "
			+ "или уточните пользователя и уровень", Потолок);
	ИначеЕсли Не ЗначениеЗаполнено(Подходящие) Тогда
		Пометка = "За период событий с такими отборами нет";
	Иначе
		Пометка = "";
	КонецЕсли;
	Если ЗначениеЗаполнено(Пометка) Тогда
		Результат.Вставить("note", Пометка);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Отбирает пользователей журнала платформой: в отбор попадают пользователи информационной базы, в имени
// или полном имени которых есть часть из аргумента user. Без права получить список пользователей отбор
// не добавляется, и пользователь отбирается в памяти (ПодходящиеСобытия).
//
// Параметры:
//  Отбор      - Структура - отбор ВыгрузитьЖурналРегистрации, дополняется
//  ЧастьИмени - Строка
//
Процедура ДобавитьОтборПользователей(Отбор, ЧастьИмени)

	Если Не ЗначениеЗаполнено(ЧастьИмени) Тогда
		Возврат;
	КонецЕсли;

	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		Возврат;
	КонецЕсли;

	ЧастьВРег = ВРег(ЧастьИмени);
	Найденные = Новый Массив;
	Для Каждого ПользовательИБ Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Если СтрНайти(ВРег(ПользовательИБ.Имя + " " + ПользовательИБ.ПолноеИмя), ЧастьВРег) > 0 Тогда
			Найденные.Добавить(ПользовательИБ);
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Найденные) Тогда
		Отбор.Вставить("Пользователь", Найденные);
	КонецЕсли;

КонецПроцедуры

// Колонки выгрузки журнала регистрации.
//
// Возвращаемое значение:
//  Строка
//
Функция КолонкиЖурнала()

	Возврат "Дата,Уровень,Событие,ПредставлениеСобытия,ИмяПользователя,ПредставлениеМетаданных,ПредставлениеДанных,"
		+ "Комментарий";

КонецФункции

// Отбор для ВыгрузитьЖурналРегистрации: период и уровни.
//
// Параметры:
//  Аргументы - Структура
//
// Возвращаемое значение:
//  Структура - ДатаНачала, ДатаОкончания, Уровень (если уровни заданы)
//
Функция ОтборЖурнала(Аргументы)

	СекундВСутках = 86400;
	Сейчас = ТекущаяДатаСеанса();
	Отбор = Новый Структура("ДатаНачала, ДатаОкончания", Сейчас - СекундВСутках, Сейчас);
	ТекстНачала = СтрокаАргумента(Аргументы, "periodStart");
	Если ЗначениеЗаполнено(ТекстНачала) Тогда
		Отбор.ДатаНачала = mcp_ОбщегоНазначения.ДатаИзСтроки(ТекстНачала);
	КонецЕсли;
	ТекстКонца = СтрокаАргумента(Аргументы, "periodEnd");
	Если ЗначениеЗаполнено(ТекстКонца) Тогда
		Конец = mcp_ОбщегоНазначения.ДатаИзСтроки(ТекстКонца);
		Если Конец = НачалоДня(Конец) Тогда
			Конец = КонецДня(Конец);
		КонецЕсли;
		Отбор.ДатаОкончания = Конец;
	КонецЕсли;

	Уровни = Новый Массив;
	Для Каждого ИмяУровня Из МассивАргумента(Аргументы, "levels") Цикл
		Уровни.Добавить(УровеньПоИмени(Строка(ИмяУровня)));
	КонецЦикла;
	Если ЗначениеЗаполнено(Уровни) Тогда
		Отбор.Вставить("Уровень", Уровни);
	КонецЕсли;
	Возврат Отбор;

КонецФункции

// Уровень журнала по имени: английскому или русскому.
//
// Параметры:
//  Имя - Строка
//
// Возвращаемое значение:
//  УровеньЖурналаРегистрации
//
Функция УровеньПоИмени(Имя)

	ИмяВРег = ВРег(СокрЛП(Имя));
	Если ИмяВРег = "ERROR" Или ИмяВРег = "ОШИБКА" Тогда
		Возврат УровеньЖурналаРегистрации.Ошибка;
	ИначеЕсли ИмяВРег = "WARNING" Или ИмяВРег = "ПРЕДУПРЕЖДЕНИЕ" Тогда
		Возврат УровеньЖурналаРегистрации.Предупреждение;
	ИначеЕсли ИмяВРег = "INFORMATION" Или ИмяВРег = "ИНФОРМАЦИЯ" Тогда
		Возврат УровеньЖурналаРегистрации.Информация;
	ИначеЕсли ИмяВРег = "NOTE" Или ИмяВРег = "ПРИМЕЧАНИЕ" Тогда
		Возврат УровеньЖурналаРегистрации.Примечание;
	Иначе
		ВызватьИсключение СтрШаблон("Неизвестный уровень журнала ""%1"": допустимы error, warning, information, "
			+ "note", Имя);
	КонецЕсли;

КонецФункции

// События, подходящие под отборы event, user и text. Вид события сравнивается и с кодом события, и с его
// представлением.
//
// Параметры:
//  События   - ТаблицаЗначений - выгрузка журнала
//  Аргументы - Структура
//
// Возвращаемое значение:
//  Массив из СтрокаТаблицыЗначений
//
Функция ПодходящиеСобытия(События, Аргументы)

	ЧастьСобытия = ВРег(СтрокаАргумента(Аргументы, "event"));
	ЧастьПользователя = ВРег(СтрокаАргумента(Аргументы, "user"));
	ЧастьТекста = ВРег(СтрокаАргумента(Аргументы, "text"));

	Подходящие = Новый Массив;
	Для Каждого Событие Из События Цикл
		Если СодержитЧасть(Событие.Событие + " " + Событие.ПредставлениеСобытия, ЧастьСобытия)
			И СодержитЧасть(Событие.ИмяПользователя, ЧастьПользователя)
			И СодержитЧасть(Строка(Событие.Комментарий) + " " + Строка(Событие.ПредставлениеДанных), ЧастьТекста) Тогда
			Подходящие.Добавить(Событие);
		КонецЕсли;
	КонецЦикла;
	Возврат Подходящие;

КонецФункции

// Последние события таблицей, новые первыми.
//
// Параметры:
//  Подходящие    - Массив из СтрокаТаблицыЗначений
//  МаксимумСтрок - Число
//
// Возвращаемое значение:
//  Структура - columns, rows, rowCount, totalRows, truncated
//
Функция СтрокиСобытий(Подходящие, МаксимумСтрок)

	ДлинаТекста = 300;
	Строки = Новый Массив;
	Индекс = Подходящие.ВГраница();
	Пока Индекс >= 0 И Строки.Количество() < МаксимумСтрок Цикл
		Событие = Подходящие[Индекс];
		Значения = Новый Массив;
		Значения.Добавить(mcp_ЗапросыМодели.ЗначениеДляМодели(Событие.Дата));
		Значения.Добавить(Строка(Событие.Уровень));
		Значения.Добавить(ПредставлениеСобытияЖурнала(Событие));
		Значения.Добавить(Событие.ИмяПользователя);
		Значения.Добавить(Строка(Событие.ПредставлениеМетаданных));
		Значения.Добавить(Лев(Строка(Событие.ПредставлениеДанных), ДлинаТекста));
		Значения.Добавить(Лев(Строка(Событие.Комментарий), ДлинаТекста));
		Строки.Добавить(Значения);
		Индекс = Индекс - 1;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("columns",   СтрРазделить("Дата,Уровень,Событие,Пользователь,Объект,Данные,Комментарий", ","));
	Результат.Вставить("rows",      Строки);
	Результат.Вставить("rowCount",  Строки.Количество());
	Результат.Вставить("totalRows", Подходящие.Количество());
	Результат.Вставить("truncated", Подходящие.Количество() > Строки.Количество());
	Возврат Результат;

КонецФункции

// Сводка таблицей: сколько событий каждого вида и уровня, самые частые первыми.
//
// Параметры:
//  Подходящие - Массив из СтрокаТаблицыЗначений
//
// Возвращаемое значение:
//  Структура - columns, rows, rowCount, totalRows, truncated
//
Функция СводкаСобытий(Подходящие)

	КолонкаКоличества = "Количество";
	Сводка = Новый ТаблицаЗначений;
	Сводка.Колонки.Добавить("Уровень");
	Сводка.Колонки.Добавить("Событие");
	Сводка.Колонки.Добавить(КолонкаКоличества);
	Для Каждого Событие Из Подходящие Цикл
		СтрокаСводки = Сводка.Добавить();
		СтрокаСводки.Уровень = Строка(Событие.Уровень);
		СтрокаСводки.Событие = ПредставлениеСобытияЖурнала(Событие);
		СтрокаСводки.Количество = 1;
	КонецЦикла;
	Сводка.Свернуть("Уровень, Событие", КолонкаКоличества);
	Сводка.Сортировать(КолонкаКоличества + " Убыв");

	ВидовСобытий = 20;
	Строки = Новый Массив;
	Для Каждого СтрокаСводки Из Сводка Цикл
		Если Строки.Количество() >= ВидовСобытий Тогда
			Прервать;
		КонецЕсли;
		Значения = Новый Массив;
		Значения.Добавить(СтрокаСводки.Уровень);
		Значения.Добавить(СтрокаСводки.Событие);
		Значения.Добавить(СтрокаСводки.Количество);
		Строки.Добавить(Значения);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("columns",   СтрРазделить("Уровень,Событие,Количество", ","));
	Результат.Вставить("rows",      Строки);
	Результат.Вставить("rowCount",  Строки.Количество());
	Результат.Вставить("totalRows", Сводка.Количество());
	Результат.Вставить("truncated", Сводка.Количество() > Строки.Количество());
	Возврат Результат;

КонецФункции

// Представление события журнала: "Сеанс. Начало" вместо кода _$Session$_.Start.
