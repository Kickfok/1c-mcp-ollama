// Описывает инструмент list_report_variants: готовые варианты отчетов конфигурации.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - см. mcp_Метаданные.ТаблицаИнструментов
//
Процедура ДобавитьИнструментСписокВариантовОтчетов(Инструменты)

	Параметры = Новый Массив;
	ДобавитьСтроку(Параметры, "search",
		"Слова через пробел: ищутся в названии варианта, описании и имени отчета, например ""выручка продажи""");
	ВариантовВОтвете = ВариантовПоУмолчанию();
	ДобавитьЧисло(Параметры, "maxItems", "Сколько вариантов вернуть", ВариантовВОтвете);

	Описание = "Поиск готовых отчетов конфигурации по словам (выручка, остатки, задолженность). Отчет считает "
		+ "по методике конфигурации; ключ variant из ответа передается в run_report_variant";
	mcp_Метаданные.ДобавитьИнструмент(Инструменты, "list_report_variants", Описание,
		mcp_Метаданные.СхемаПараметровИнструмента(Параметры));

КонецПроцедуры

// Варианты отчетов из справочника ВариантыОтчетов: не помеченные на удаление, общие (не только для автора),
// отчеты конфигурации и расширений, доступные пользователю по праву "Использование".
//
// Параметры:
//  Аргументы - Структура - search, maxItems и контекст доступа
//
// Возвращаемое значение:
//  Структура - found (Число), variants (Массив из Структура variant, name, report, description)
//
Функция СписокВариантовОтчетов(Аргументы)

	ПроверитьПодсистемуВариантов();
	Слова = СтрРазделить(ВРег(СтрокаАргумента(Аргументы, "search")), " ", Ложь);
	МаксимумВариантов = mcp_ЗапросыМодели.ЧислоИзАргументов(Аргументы, "maxItems", ВариантовПоУмолчанию(), 1,
		МаксимумВариантов());

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Варианты.Ссылка КАК Ссылка,
	|	Варианты.Наименование КАК Наименование,
	|	Варианты.Описание КАК Описание,
	|	Варианты.Отчет КАК Отчет
	|ИЗ
	|	Справочник.ВариантыОтчетов КАК Варианты
	|ГДЕ
	|	НЕ Варианты.ПометкаУдаления
	|	И НЕ Варианты.ТолькоДляАвтора
	|	И Варианты.ТипОтчета В (ЗНАЧЕНИЕ(Перечисление.ТипыОтчетов.Внутренний),
	|		ЗНАЧЕНИЕ(Перечисление.ТипыОтчетов.Расширение))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование");
	Привилегированно = mcp_ДоступПользователей.ЕстьТокенПользователя(Аргументы);
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	РезультатЗапроса = Запрос.Выполнить();
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

	ДлинаОписания = 200;
	Подходящие = Новый ТаблицаЗначений;
	Подходящие.Колонки.Добавить("variant");
	Подходящие.Колонки.Добавить("name");
	Подходящие.Колонки.Добавить("report");
	Подходящие.Колонки.Добавить("description");
	Подходящие.Колонки.Добавить("Совпадений");
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбъектОтчета = ОбъектМетаданныхОтчета(Выборка.Отчет);
		Если ОбъектОтчета = Неопределено Или ОбъектОтчета.ОсновнаяСхемаКомпоновкиДанных = Неопределено
			Или Не mcp_ДоступПользователей.ДоступноПользователю(Аргументы, ОбъектОтчета) Тогда
			Продолжить;
		КонецЕсли;
		Совпадений = ЧислоСовпаденийВарианта(Выборка, ОбъектОтчета, Слова);
		Если ЗначениеЗаполнено(Слова) И Совпадений = 0 Тогда
			Продолжить;
		КонецЕсли;
		НовыйВариант = Подходящие.Добавить();
		НовыйВариант.variant     = Строка(Выборка.Ссылка.УникальныйИдентификатор());
		НовыйВариант.name        = Выборка.Наименование;
		НовыйВариант.report      = ОбъектОтчета.ПолноеИмя();
		НовыйВариант.description = Лев(Выборка.Описание, ДлинаОписания);
		НовыйВариант.Совпадений  = Совпадений;
	КонецЦикла;

	// Сначала варианты, где совпало больше слов вопроса
	Подходящие.Сортировать("Совпадений Убыв, name");
	Варианты = Новый Массив;
	Для Каждого Подходящий Из Подходящие Цикл
		Если Варианты.Количество() >= МаксимумВариантов Тогда
			Прервать;
		КонецЕсли;
		Вариант = Новый Структура("variant, name, report, description");
		ЗаполнитьЗначенияСвойств(Вариант, Подходящий);
		Варианты.Добавить(Вариант);
	КонецЦикла;

	Возврат Новый Структура("found, variants", Подходящие.Количество(), Варианты);

КонецФункции

// Сколько слов поиска есть в названии, описании, имени или синониме отчета.
//
// Параметры:
//  Выборка      - ВыборкаИзРезультатаЗапроса - Наименование, Описание
//  ОбъектОтчета - ОбъектМетаданных
//  Слова        - Массив из Строка - в верхнем регистре
//
// Возвращаемое значение:
//  Число
//
Функция ЧислоСовпаденийВарианта(Выборка, ОбъектОтчета, Слова)

	Текст = ВРег(Выборка.Наименование + " " + Выборка.Описание + " " + ОбъектОтчета.Имя + " " + ОбъектОтчета.Синоним);
	Совпадений = 0;
	Для Каждого Слово Из Слова Цикл
		Если СтрНайти(Текст, Слово) > 0 Тогда
			Совпадений = Совпадений + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Совпадений;

КонецФункции

