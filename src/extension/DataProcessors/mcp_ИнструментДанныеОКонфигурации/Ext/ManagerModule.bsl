#Область ИнструментАнализЗависимостейОбъектов

Процедура ДобавитьИнструментАнализЗависимостейОбъектов(Инструменты)

	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"objectName",
		"string",
		"Имя объекта метаданных",
		,
		Истина
	));
	
	// objectType — имя коллекции метаданных во множественном числе (как в Метаданные[...]).
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"objectType",
		"string",
		"Имя коллекции метаданных во множественном числе: Documents, Catalogs, InformationRegisters, AccumulationRegisters, AccountingRegisters, CalculationRegisters, ChartsOfCharacteristicTypes, ChartsOfAccounts, ChartsOfCalculationTypes, BusinessProcesses, Tasks, ExchangePlans",
		,
		Истина,
		"Documents,Catalogs,InformationRegisters,AccumulationRegisters,AccountingRegisters,CalculationRegisters,ChartsOfCharacteristicTypes,ChartsOfAccounts,ChartsOfCalculationTypes,BusinessProcesses,Tasks,ExchangePlans"
	));

	// Лимит на количество связей в каждой группе (uses/usedBy), чтобы ответ
	// не раздувался на сотни записей и не переполнял контекст модели.
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxItems",
		"number",
		"Максимум связей в каждой группе uses/usedBy (по умолчанию 50)",
		50
	));

	// Фильтр области поиска usedBy по типам коллекций (через запятую).
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"scopeTypes",
		"string",
		"Где искать использование (usedBy): имена коллекций через запятую, например Documents,AccumulationRegisters. Пусто — искать везде."
	));

	// Фильтр области поиска usedBy по подсистеме.
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"scopeSubsystem",
		"string",
		"Имя подсистемы для ограничения поиска usedBy (только объекты, входящие в неё, в т.ч. вложенные). Пусто — без ограничения."
	));
			
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"list_object_dependencies",
		"Анализ зависимостей объектов метаданных. Возвращает uses (что использует объект) и usedBy (где используется объект).",
		СхемаПараметров
	);

КонецПроцедуры

Функция АнализЗависимостейОбъектов(Аргументы)
	
	Если Не Аргументы.Свойство("objectName") Или Не ЗначениеЗаполнено(Аргументы.objectName) Тогда
		ВызватьИсключение "Не задан обязательный параметр objectName.";
	КонецЕсли;
	Если Не Аргументы.Свойство("objectType") Или Не ЗначениеЗаполнено(Аргументы.objectType) Тогда
		ВызватьИсключение "Не задан обязательный параметр objectType (имя коллекции, например Documents).";
	КонецЕсли;
	
	ИмяОбъекта = Аргументы.objectName;
	ТипОбъекта = Аргументы.objectType;  
	Лимит = ?(Аргументы.Свойство("maxItems"), Число(Аргументы.maxItems), 50);
	Если Лимит <= 0 Тогда
		Лимит = 50;
	КонецЕсли;
	
	// Фильтры области поиска usedBy.
	СписокТипов = Неопределено;
	Если Аргументы.Свойство("scopeTypes") И ЗначениеЗаполнено(Аргументы.scopeTypes) Тогда
		СписокТипов = СтрРазделить(Аргументы.scopeTypes, ",", Ложь);
	КонецЕсли;
	ИмяПодсистемы = ?(Аргументы.Свойство("scopeSubsystem"), СокрЛП(Аргументы.scopeSubsystem), "");
	
	ОбработкаОбъект = Создать();
	
	ОбъектМД = ОбработкаОбъект.НайтиОбъектМетаданных(ТипОбъекта, ИмяОбъекта);
	Если ОбъектМД = Неопределено Тогда
		ВызватьИсключение "Объект метаданных не найден: " + ТипОбъекта + "." + ИмяОбъекта
			+ ". Проверьте, что objectType задан именем коллекции во множественном числе (например, Documents).";
	КонецЕсли;   
	
	Результат = Новый Структура;
	Результат.Вставить("objectName", ИмяОбъекта);
	Результат.Вставить("objectType", ТипОбъекта);
	Результат.Вставить("fullName", ОбъектМД.ПолноеИмя());
	
	Uses   = Новый Массив;
	UsedBy = Новый Массив;
	
	ОбработкаОбъект.СобратьИспользуемыеОбъекты(ОбъектМД, Uses);
	ОбработкаОбъект.СобратьИспользующиеОбъекты(ОбъектМД, UsedBy, СписокТипов, ИмяПодсистемы);
	
	// Полные размеры до усечения — чтобы LLM знал, что данные обрезаны.
	ВсегоUses   = Uses.Количество();
	ВсегоUsedBy = UsedBy.Количество();
	
	Результат.Вставить("usesTotal", ВсегоUses);
	Результат.Вставить("usedByTotal", ВсегоUsedBy);
	Результат.Вставить("uses", ОбрезатьМассив(Uses, Лимит));
	Результат.Вставить("usedBy", ОбрезатьМассив(UsedBy, Лимит));
	Результат.Вставить("truncated", (ВсегоUses > Лимит) Или (ВсегоUsedBy > Лимит));
	
	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(Результат);
	
КонецФункции

// Возвращает копию массива, обрезанную до Лимит элементов.
Функция ОбрезатьМассив(Исходный, Лимит)
	Если Исходный.Количество() <= Лимит Тогда
		Возврат Исходный;
	КонецЕсли;
	Результат = Новый Массив;
	Для Сч = 0 По Лимит - 1 Цикл
		Результат.Добавить(Исходный[Сч]);
	КонецЦикла;
	Возврат Результат;
КонецФункции  

#КонецОбласти   

#Область ИнструментПолучитьСписокОтчетов

Процедура ДобавитьИнструментПолучитьСписокОтчетов(Инструменты)

	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"reportName",
		"string",
		"Имя или часть имени отчета для фильтрации (опционально). Проверяется вхождение в имя, синоним и наименование."
	));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"includeDescription",
		"boolean",
		"Включать описание отчетов",
		Ложь
	));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"source",
		"string",
		"Источник отчётов: All — все, Configuration — только встроенные, External — только внешние (из справочника ДополнительныеОтчетыИОбработки)",
		"All",
		Ложь,
		"All,Configuration,External"
	));

	// Если задано имя конкретного отчёта — читать его параметры из СКД.
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"includeParameters",
		"boolean",
		"Читать обязательные параметры отчёта из его схемы компоновки данных (для конкретного отчёта по reportName). Для внешних отчётов работает только при выключенном безопасном режиме.",
		Ложь
	));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_report_list",
		"Получение списка отчетов конфигурации (встроенных и внешних) и их обязательных параметров. Внешние отмечаются как [Внешний отчет].",
		СхемаПараметров
	);

КонецПроцедуры

Функция ПолучитьСписокОтчетов(Аргументы)
	
	ИмяОтчета        = ?(Аргументы.Свойство("reportName"), Аргументы.reportName, "");
	ВключатьОписание = ?(Аргументы.Свойство("includeDescription"), Аргументы.includeDescription, Ложь);
	Источник         = ?(Аргументы.Свойство("source"), Аргументы.source, "All");
	ВключатьПараметры = ?(Аргументы.Свойство("includeParameters"), Аргументы.includeParameters, Ложь);
	
	Результат = "СПИСОК ОТЧЕТОВ
	| ====================";
	
	Счетчик = 0;
	
	// --- Встроенные отчёты конфигурации ---
	Если Источник = "All" Или Источник = "Configuration" Тогда
		Для Каждого Отчет Из Метаданные.Отчеты Цикл
			Если ЗначениеЗаполнено(ИмяОтчета)
				И СтрНайти(ВРег(Отчет.Имя), ВРег(ИмяОтчета)) = 0
				И СтрНайти(ВРег(Отчет.Синоним), ВРег(ИмяОтчета)) = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Счетчик = Счетчик + 1;
			Результат = Результат + "
			| " + Счетчик + ". " + Отчет.Имя + " (" + Отчет.Синоним + ")";
			
			Если ВключатьОписание Тогда
				Результат = Результат + "
				| Описание: " + Отчет.Комментарий;
				
				// Основной макет (безопасно — свойство не гарантировано во всех версиях).
				СтруктураОсновнойМакет = Новый Структура("ОсновнойМакет");
				ЗаполнитьЗначенияСвойств(СтруктураОсновнойМакет, Отчет);
				Если СтруктураОсновнойМакет.ОсновнойМакет <> Неопределено Тогда
					Результат = Результат + "
					| Основной макет: " + СтруктураОсновнойМакет.ОсновнойМакет.Имя;
				КонецЕсли;
			КонецЕсли;
			
			// Параметры СКД встроенного отчёта (если запрошены).
			Если ВключатьПараметры Тогда
				Результат = Результат + ПрочитатьПараметрыВстроенногоОтчета(Отчет.Имя);
			КонецЕсли;
			
			Результат = Результат + "
			| ------------------------";
		КонецЦикла;
	КонецЕсли;
	
	// --- Внешние отчёты из справочника ДополнительныеОтчетыИОбработки ---
	Если (Источник = "All" Или Источник = "External")
		И Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки") <> Неопределено Тогда
		
		Счетчик = ДобавитьВнешниеОтчеты(Результат, ИмяОтчета, ВключатьОписание, ВключатьПараметры, Счетчик);
	КонецЕсли;
	
	Результат = Результат + "
	| Всего отчетов: " + Счетчик;
	
	Возврат Результат;

КонецФункции

// Читает параметры СКД встроенного отчёта.
// API подтверждён: Отчеты[Имя].ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных"),
// СхемаКД.НастройкиПоУмолчанию.ПараметрыДанных.Элементы (.Параметр/.Значение/.Использование).
Функция ПрочитатьПараметрыВстроенногоОтчета(ИмяОтчета)
	
	Попытка
		ОтчетОбъект = Отчеты[ИмяОтчета].Создать();
		СхемаКД = ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Исключение
		Возврат "
		| Параметры: не удалось получить схему компоновки (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")";
	КонецПопытки;
	
	Если СхемаКД = Неопределено Тогда
		Возврат "
		| Параметры: отчёт не на СКД (нет ОсновнаяСхемаКомпоновкиДанных)";
	КонецЕсли;
	
	Возврат ПрочитатьПараметрыСхемыКД(СхемаКД);
	
КонецФункции

// Общая функция: читает параметры из СхемаКомпоновкиДанных и форматирует.
// Используется и для встроенных, и для внешних отчётов.
Функция ПрочитатьПараметрыСхемыКД(СхемаКД)
	
	Попытка
		Настройки = СхемаКД.НастройкиПоУмолчанию;
		ПараметрыДанных = Настройки.ПараметрыДанных;
	Исключение
		Возврат "
		| Параметры: не удалось прочитать (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")";
	КонецПопытки;
	
	Если ПараметрыДанных.Элементы.Количество() = 0 Тогда
		Возврат "
		| Параметры: нет";
	КонецЕсли;
	
	Текст = "
	| Параметры:";
	Для Каждого Элемент Из ПараметрыДанных.Элементы Цикл
		// Имя параметра (.Параметр — это ПараметрКомпоновкиДанных, строковое представление = имя).
		ИмяПараметра = Строка(Элемент.Параметр);
		
		// Тип значения параметра (если задан в доступных параметрах схемы).
		ТипПараметра = "";
		Попытка
			ДоступныйПараметр = СхемаКД.Параметры.Найти(Элемент.Параметр);
			Если ДоступныйПараметр <> Неопределено И ДоступныйПараметр.ТипЗначения <> Неопределено Тогда
				ТипПараметра = " [" + Строка(ДоступныйПараметр.ТипЗначения) + "]";
			КонецЕсли;
		Исключение
			// Тип недоступен — пропускаем.
		КонецПопытки;
		
		Текст = Текст + "
		|   - " + ИмяПараметра + ТипПараметра;
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

// Обход справочника внешних отчётов БСП. Возвращает обновлённый счётчик.
Функция ДобавитьВнешниеОтчеты(Результат, ИмяОтчета, ВключатьОписание, ВключатьПараметры, Счетчик)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Доп.Ссылка КАК Ссылка,
	|	Доп.Наименование КАК Наименование,
	|	Доп.Вид КАК Вид,
	|	Доп.БезопасныйРежим КАК БезопасныйРежим
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Доп
	|ГДЕ
	|	НЕ Доп.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ЭтоВнешнийОтчет(Выборка.Вид) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяОтчета)
			И СтрНайти(ВРег(Строка(Выборка.Наименование)), ВРег(ИмяОтчета)) = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
		Результат = Результат + "
		| " + Счетчик + ". [Внешний отчет] " + Выборка.Наименование;
		
		Если ВключатьОписание Тогда
			ПометкаРежима = ?(Выборка.БезопасныйРежим, "безопасный режим включён", "безопасный режим выключен");
			Результат = Результат + "
			| Подключение: " + ПометкаРежима;
		КонецЕсли;
		
		// Параметры внешнего отчёта: только при выключенном безопасном режиме
		// (подключение внешнего отчёта в безопасном режиме недоступно/ограничено).
		Если ВключатьПараметры Тогда
			Если Выборка.БезопасныйРежим Тогда
				Результат = Результат + "
				| Параметры: пропущены (безопасный режим включён, подключение не выполняется)";
			Иначе
				Результат = Результат + ПрочитатьПараметрыВнешнегоОтчета(Выборка.Ссылка);
			КонецЕсли;
		КонецЕсли;
		
		Результат = Результат + "
		| ------------------------";
		
	КонецЦикла;
	
	Возврат Счетчик;
	
КонецФункции

// Читает параметры внешнего отчёта, подключая его из хранилища справочника.
// API подтверждён: ХранилищеОбработки.Получить() -> ДвоичныеДанные,
// ПоместитьВоВременноеХранилище, ВнешниеОтчеты.Подключить(адрес) -> имя,
// ВнешниеОтчеты.Создать(имя) -> объект, .ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных").
// Вызывается только при БезопасныйРежим = Ложь.
Функция ПрочитатьПараметрыВнешнегоОтчета(СсылкаОтчета)
	
	Попытка
		// Безопасное чтение реквизита-хранилища.
		Хранилище = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаОтчета, "ХранилищеОбработки");
		Если Хранилище = Неопределено Тогда
			Возврат "
			| Параметры: хранилище отчёта пусто";
		КонецЕсли;
		
		ДвоичныеДанные = Хранилище.Получить();
		Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
			Возврат "
			| Параметры: не удалось извлечь двоичные данные отчёта";
		КонецЕсли;
		
		АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
		ИмяПодключенного = ВнешниеОтчеты.Подключить(АдресХранилища, , Ложь);
		ОтчетОбъект = ВнешниеОтчеты.Создать(ИмяПодключенного);
		СхемаКД = ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Исключение
		Возврат "
		| Параметры: не удалось подключить внешний отчёт (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")";
	КонецПопытки;
	
	Если СхемаКД = Неопределено Тогда
		Возврат "
		| Параметры: внешний отчёт не на СКД";
	КонецЕсли;
	
	Возврат ПрочитатьПараметрыСхемыКД(СхемаКД);
	
КонецФункции

// Безопасная проверка вида доп. отчёта/обработки.
Функция ЭтоВнешнийОтчет(Вид)
	
	Попытка
		Возврат Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.Отчет
			Или Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет;
	Исключение
		Возврат Истина;
	КонецПопытки;
	
КонецФункции

#КонецОбласти
