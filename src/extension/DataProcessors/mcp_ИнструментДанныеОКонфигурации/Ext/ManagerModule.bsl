#Область ИнструментПолучитьВерсиюКонфигурации

Процедура ДобавитьИнструментПолучитьВерсиюКонфигурации(Инструменты)

	МассивПараметров = Новый Массив;
	
	// Список допустимых значений (enum). Должен совпадать с ключами структуры
	// в ПолучитьВерсиюКонфигурации.
	ДопустимыеСвойства =
		"ОперационнаяСистема,ВерсияПлатформы,ОбъемОЗУ,Процессор,ТипПлатформы,"
		+ "Конфигурация,ВерсияКонфигурации,КраткаяИнформация,ПодробнаяИнформация,"
		+ "Поставщик,ИнформацияОПоставщике,ИнформацияОКонфигурации,АвторскиеПрава,ОсновнойЯзык";

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"configurationProperty",
		"string",
		"Имя свойства конфигурации (необязательно). Если не задано — возвращаются все свойства. Имя выбирается из списка допустимых значений.",
		,
		Ложь,
		ДопустимыеСвойства
	));

	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_configuration_version",
		"Получение системной информации о компьютере и конфигурации (имя, версия конфигурации, версия платформы и т.д.)",
		СхемаПараметров
	);

КонецПроцедуры

Функция ПолучитьВерсиюКонфигурации(Аргументы)

   	СтруктураДанныхКонфигурации = Новый Структура;
	
	СисИнфо = Новый СистемнаяИнформация;
	СтруктураДанныхКонфигурации.Вставить("ОперационнаяСистема", Строка(СисИнфо.ВерсияОС));
	СтруктураДанныхКонфигурации.Вставить("ВерсияПлатформы", Строка(СисИнфо.ВерсияПриложения));
	СтруктураДанныхКонфигурации.Вставить("ОбъемОЗУ", Строка(СисИнфо.ОперативнаяПамять));
	СтруктураДанныхКонфигурации.Вставить("Процессор", Строка(СисИнфо.Процессор));
	СтруктураДанныхКонфигурации.Вставить("ТипПлатформы", Строка(СисИнфо.ТипПлатформы));	
	
	СтруктураДанныхКонфигурации.Вставить("Конфигурация", Строка(Метаданные.Синоним));
	СтруктураДанныхКонфигурации.Вставить("ВерсияКонфигурации", Строка(Метаданные.Версия));
	СтруктураДанныхКонфигурации.Вставить("КраткаяИнформация", Строка(Метаданные.КраткаяИнформация));
	СтруктураДанныхКонфигурации.Вставить("ПодробнаяИнформация", Строка(Метаданные.ПодробнаяИнформация));
	СтруктураДанныхКонфигурации.Вставить("Поставщик", Строка(Метаданные.Поставщик));
	СтруктураДанныхКонфигурации.Вставить("ИнформацияОПоставщике", Строка(Метаданные.АдресИнформацииОПоставщике));
	СтруктураДанныхКонфигурации.Вставить("ИнформацияОКонфигурации", Строка(Метаданные.АдресИнформацииОКонфигурации));
	СтруктураДанныхКонфигурации.Вставить("АвторскиеПрава", Строка(Метаданные.АвторскиеПрава));
    СтруктураДанныхКонфигурации.Вставить("ОсновнойЯзык", Строка(Метаданные.ОсновнойЯзык.Имя));
		
	// Если задано конкретное свойство — возвращаем только его (регистронезависимо).
	Если Аргументы.Свойство("configurationProperty")
		И ЗначениеЗаполнено(Аргументы.configurationProperty) Тогда

		ИскомоеСвойство = СокрЛП(Аргументы.configurationProperty);

		НайденоИмя = "";
		НайденноеЗначение = Неопределено;
		Для Каждого ТекСвойство Из СтруктураДанныхКонфигурации Цикл
			Если ВРег(ТекСвойство.Ключ) = ВРег(ИскомоеСвойство) Тогда
				НайденоИмя = ТекСвойство.Ключ;
				НайденноеЗначение = ТекСвойство.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если НайденоИмя = "" Тогда
			МассивИмён = Новый Массив;
			Для Каждого ТекСвойство Из СтруктураДанныхКонфигурации Цикл
				МассивИмён.Добавить(ТекСвойство.Ключ);
			КонецЦикла;
			ВызватьИсключение "Свойство конфигурации не найдено: " + Аргументы.configurationProperty
				+ ". Доступные свойства: " + СтрСоединить(МассивИмён, ", ");
		КонецЕсли;

		СтруктураОдногоСвойства = Новый Структура;
		СтруктураОдногоСвойства.Вставить("ИмяСвойства", НайденоИмя);
		СтруктураОдногоСвойства.Вставить("ЗначениеСвойства", НайденноеЗначение);

		Возврат mcp_ОбщегоНазначения.СтруктураВJSON(СтруктураОдногоСвойства);
	КонецЕсли; 
	
	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(СтруктураДанныхКонфигурации);
	
КонецФункции

