	);

КонецПроцедуры

Функция СтруктураОбъектаМетаданных(Аргументы)

	Если Не Аргументы.Свойство("metaType") Или Не ЗначениеЗаполнено(Аргументы.metaType) Тогда
		ВызватьИсключение "Не задан обязательный параметр metaType.";
	КонецЕсли;
	Если Не Аргументы.Свойство("name") Или Не ЗначениеЗаполнено(Аргументы.name) Тогда
		ВызватьИсключение "Не задан обязательный параметр name.";
	КонецЕсли;
	
	МетаТип = Аргументы.metaType;
	ИмяОбъекта = Аргументы.name;
	
	Попытка
		КоллекцияМД = Метаданные[МетаТип];
	Исключение
		ВызватьИсключение "Неизвестный тип метаданных в metaType: " + МетаТип;
	КонецПопытки;
	
	МетаданныеОбъекта = КоллекцияМД.Найти(ИмяОбъекта);
	Если МетаданныеОбъекта = Неопределено Тогда
		ВызватьИсключение "Объект метаданных не найден: " + МетаТип + "." + ИмяОбъекта;
	КонецЕсли;
	mcp_ДоступПользователей.ПроверитьДоступПользователя(Аргументы, МетаданныеОбъекта);
	
	ОбработкаОбъект = Создать();
	
	Возврат ОбработкаОбъект.ОписаниеСтруктурыОбъектаМетаданных(МетаданныеОбъекта);
	
КонецФункции

#КонецОбласти  

#Область ИнструментПолучитьВерсиюКонфигурации

Процедура ДобавитьИнструментПолучитьВерсиюКонфигурации(Инструменты)

	МассивПараметров = Новый Массив;
	
	// Список допустимых значений (enum). Должен совпадать с ключами структуры
	// в ПолучитьВерсиюКонфигурации.
	ДопустимыеСвойства =
		"ОперационнаяСистема,ВерсияПлатформы,ОбъемОЗУ,Процессор,ТипПлатформы,"
		+ "Конфигурация,ВерсияКонфигурации,КраткаяИнформация,ПодробнаяИнформация,"
		+ "Поставщик,ИнформацияОПоставщике,ИнформацияОКонфигурации,АвторскиеПрава,ОсновнойЯзык";

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"configurationProperty",
		"string",
		"Имя свойства конфигурации (необязательно). Если не задано - возвращаются все свойства. Имя выбирается из списка допустимых значений.",
		,
		Ложь,
		ДопустимыеСвойства
	));

	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_configuration_version",
		"Получение системной информации о компьютере и конфигурации (имя, версия конфигурации, версия платформы и т.д.)",
		СхемаПараметров
	);

КонецПроцедуры

Функция ПолучитьВерсиюКонфигурации(Аргументы)

   	СтруктураДанныхКонфигурации = Новый Структура;
	
	СисИнфо = Новый СистемнаяИнформация;
	СтруктураДанныхКонфигурации.Вставить("ОперационнаяСистема", Строка(СисИнфо.ВерсияОС));
	СтруктураДанныхКонфигурации.Вставить("ВерсияПлатформы", Строка(СисИнфо.ВерсияПриложения));
	СтруктураДанныхКонфигурации.Вставить("ОбъемОЗУ", Строка(СисИнфо.ОперативнаяПамять));
	СтруктураДанныхКонфигурации.Вставить("Процессор", Строка(СисИнфо.Процессор));
	СтруктураДанныхКонфигурации.Вставить("ТипПлатформы", Строка(СисИнфо.ТипПлатформы));	
	
	СтруктураДанныхКонфигурации.Вставить("Конфигурация", Строка(Метаданные.Синоним));
	СтруктураДанныхКонфигурации.Вставить("ВерсияКонфигурации", Строка(Метаданные.Версия));
	СтруктураДанныхКонфигурации.Вставить("КраткаяИнформация", Строка(Метаданные.КраткаяИнформация));
	СтруктураДанныхКонфигурации.Вставить("ПодробнаяИнформация", Строка(Метаданные.ПодробнаяИнформация));
	СтруктураДанныхКонфигурации.Вставить("Поставщик", Строка(Метаданные.Поставщик));
	СтруктураДанныхКонфигурации.Вставить("ИнформацияОПоставщике", Строка(Метаданные.АдресИнформацииОПоставщике));
	СтруктураДанныхКонфигурации.Вставить("ИнформацияОКонфигурации", Строка(Метаданные.АдресИнформацииОКонфигурации));
	СтруктураДанныхКонфигурации.Вставить("АвторскиеПрава", Строка(Метаданные.АвторскиеПрава));
    СтруктураДанныхКонфигурации.Вставить("ОсновнойЯзык", Строка(Метаданные.ОсновнойЯзык.Имя));
		
	// Задано свойство - возвращаем только его, регистр имени не важен
	Если Аргументы.Свойство("configurationProperty")
		И ЗначениеЗаполнено(Аргументы.configurationProperty) Тогда

		ИскомоеСвойство = СокрЛП(Аргументы.configurationProperty);

		НайденоИмя = "";
		НайденноеЗначение = Неопределено;
		Для Каждого ТекСвойство Из СтруктураДанныхКонфигурации Цикл
			Если ВРег(ТекСвойство.Ключ) = ВРег(ИскомоеСвойство) Тогда
				НайденоИмя = ТекСвойство.Ключ;
				НайденноеЗначение = ТекСвойство.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если НайденоИмя = "" Тогда
			МассивИмён = Новый Массив;
			Для Каждого ТекСвойство Из СтруктураДанныхКонфигурации Цикл
				МассивИмён.Добавить(ТекСвойство.Ключ);
			КонецЦикла;
			ВызватьИсключение "Свойство конфигурации не найдено: " + Аргументы.configurationProperty
				+ ". Доступные свойства: " + СтрСоединить(МассивИмён, ", ");
		КонецЕсли;

		СтруктураОдногоСвойства = Новый Структура;
		СтруктураОдногоСвойства.Вставить("ИмяСвойства", НайденоИмя);
		СтруктураОдногоСвойства.Вставить("ЗначениеСвойства", НайденноеЗначение);

		Возврат mcp_ОбщегоНазначения.СтруктураВJSON(СтруктураОдногоСвойства);
	КонецЕсли; 
	
	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(СтруктураДанныхКонфигурации);
	
КонецФункции

#КонецОбласти 

#Область ИнструментАнализЗависимостейОбъектов

Процедура ДобавитьИнструментАнализЗависимостейОбъектов(Инструменты)

	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"objectName",
		"string",
		"Имя объекта метаданных",
		,
		Истина
	));
	
	// objectType - имя коллекции во множественном числе, как в Метаданные[...]
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"objectType",
		"string",
		"Имя коллекции метаданных во множественном числе: Documents, Catalogs, InformationRegisters, AccumulationRegisters, AccountingRegisters, CalculationRegisters, ChartsOfCharacteristicTypes, ChartsOfAccounts, ChartsOfCalculationTypes, BusinessProcesses, Tasks, ExchangePlans",
		,
		Истина,
		"Documents,Catalogs,InformationRegisters,AccumulationRegisters,AccountingRegisters,CalculationRegisters,ChartsOfCharacteristicTypes,ChartsOfAccounts,ChartsOfCalculationTypes,BusinessProcesses,Tasks,ExchangePlans"
	));

	// Ограничение на число связей в uses и usedBy: у популярных объектов их сотни,
	// а контекст модели всего 4096 токенов
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxItems",
		"number",
		"Максимум связей в каждой группе uses/usedBy (по умолчанию 50)",
		50
	));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"scopeTypes",
		"string",
		"Где искать использование (usedBy): имена коллекций через запятую, например Documents,AccumulationRegisters. Пусто - искать везде."
	));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"scopeSubsystem",
		"string",
		"Имя подсистемы для ограничения поиска usedBy (только объекты, входящие в неё, в т.ч. вложенные). Пусто - без ограничения."
	));
			
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"list_object_dependencies",
		"Анализ зависимостей объектов метаданных. Возвращает uses (что использует объект) и usedBy (где используется объект).",
		СхемаПараметров
	);

КонецПроцедуры

Функция АнализЗависимостейОбъектов(Аргументы)
	
	Если Не Аргументы.Свойство("objectName") Или Не ЗначениеЗаполнено(Аргументы.objectName) Тогда
		ВызватьИсключение "Не задан обязательный параметр objectName.";
	КонецЕсли;
	Если Не Аргументы.Свойство("objectType") Или Не ЗначениеЗаполнено(Аргументы.objectType) Тогда
		ВызватьИсключение "Не задан обязательный параметр objectType (имя коллекции, например Documents).";
	КонецЕсли;
	
	ИмяОбъекта = Аргументы.objectName;
	ТипОбъекта = Аргументы.objectType;  
	Лимит = ?(Аргументы.Свойство("maxItems"), Число(Аргументы.maxItems), 50);
	Если Лимит <= 0 Тогда
		Лимит = 50;
	КонецЕсли;
	
	// Фильтры области поиска usedBy.
	СписокТипов = Неопределено;
	Если Аргументы.Свойство("scopeTypes") И ЗначениеЗаполнено(Аргументы.scopeTypes) Тогда
		СписокТипов = СтрРазделить(Аргументы.scopeTypes, ",", Ложь);
	КонецЕсли;
	ИмяПодсистемы = ?(Аргументы.Свойство("scopeSubsystem"), СокрЛП(Аргументы.scopeSubsystem), "");
	
	ОбработкаОбъект = Создать();
	
	ОбъектМД = ОбработкаОбъект.НайтиОбъектМетаданных(ТипОбъекта, ИмяОбъекта);
	Если ОбъектМД = Неопределено Тогда
		ВызватьИсключение "Объект метаданных не найден: " + ТипОбъекта + "." + ИмяОбъекта
			+ ". Проверьте, что objectType задан именем коллекции во множественном числе (например, Documents).";
	КонецЕсли;
	mcp_ДоступПользователей.ПроверитьДоступПользователя(Аргументы, ОбъектМД);
	
	Результат = Новый Структура;
	Результат.Вставить("objectName", ИмяОбъекта);
	Результат.Вставить("objectType", ТипОбъекта);
	Результат.Вставить("fullName", ОбъектМД.ПолноеИмя());
	
	Uses   = Новый Массив;
	UsedBy = Новый Массив;
	
	ОбработкаОбъект.СобратьИспользуемыеОбъекты(ОбъектМД, Uses);
	ОбработкаОбъект.СобратьИспользующиеОбъекты(ОбъектМД, UsedBy, СписокТипов, ИмяПодсистемы);
	
	// Объекты без прав пользователя убираются до подсчета: счетчики тоже не должны их выдавать
	Uses   = ДоступныеСвязи(Аргументы, Uses);
	UsedBy = ДоступныеСвязи(Аргументы, UsedBy);
	
	// Полное количество до обрезки, по нему видно, что список неполный
	ВсегоUses   = Uses.Количество();
	ВсегоUsedBy = UsedBy.Количество();
	
	Результат.Вставить("usesTotal", ВсегоUses);
	Результат.Вставить("usedByTotal", ВсегоUsedBy);
	Результат.Вставить("uses", ОбрезатьМассив(Uses, Лимит));
	Результат.Вставить("usedBy", ОбрезатьМассив(UsedBy, Лимит));
	Результат.Вставить("truncated", (ВсегоUses > Лимит) Или (ВсегоUsedBy > Лимит));
	
	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(Результат);
	
КонецФункции

// Связи с объектами, которые доступны пользователю, задавшему вопрос.
//
// Параметры:
//  Аргументы - Структура - аргументы инструмента с контекстом доступа
//  Связи     - Массив из Структура - записи связей с полем object (полное имя объекта метаданных)
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция ДоступныеСвязи(Аргументы, Связи)
	
	Результат = Новый Массив;
	Для Каждого Связь Из Связи Цикл
		ОбъектСвязи = Метаданные.НайтиПоПолномуИмени(Связь.object);
		Если ОбъектСвязи = Неопределено Или mcp_ДоступПользователей.ДоступноПользователю(Аргументы, ОбъектСвязи) Тогда
			Результат.Добавить(Связь);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает копию массива, обрезанную до Лимит элементов.
Функция ОбрезатьМассив(Исходный, Лимит)
	Если Исходный.Количество() <= Лимит Тогда
		Возврат Исходный;
	КонецЕсли;
	Результат = Новый Массив;
	Для Сч = 0 По Лимит - 1 Цикл
		Результат.Добавить(Исходный[Сч]);
	КонецЦикла;
	Возврат Результат;
КонецФункции  

#КонецОбласти   

#Область ИнструментПолучитьСписокОтчетов

Процедура ДобавитьИнструментПолучитьСписокОтчетов(Инструменты)

	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"reportName",
		"string",
		"Имя или часть имени отчета для фильтрации (опционально). Проверяется вхождение в имя, синоним и наименование."
	));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"includeDescription",
		"boolean",
		"Включать описание отчетов",
		Ложь
	));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"source",
		"string",
		"Источник отчётов: All - все, Configuration - только встроенные, External - только внешние (из справочника ДополнительныеОтчетыИОбработки)",
		"All",
		Ложь,
		"All,Configuration,External"
	));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"includeParameters",
		"boolean",
		"Читать обязательные параметры отчёта из его схемы компоновки данных (для конкретного отчёта по reportName). Для внешних отчётов работает только при выключенном безопасном режиме.",
		Ложь
	));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_report_list",
		"Получение списка отчетов конфигурации (встроенных и внешних) и их обязательных параметров. Внешние отмечаются как [Внешний отчет].",
		СхемаПараметров
	);

КонецПроцедуры

Функция ПолучитьСписокОтчетов(Аргументы)
	
	ИмяОтчета        = ?(Аргументы.Свойство("reportName"), Аргументы.reportName, "");
	ВключатьОписание = ?(Аргументы.Свойство("includeDescription"), Аргументы.includeDescription, Ложь);
	Источник         = ?(Аргументы.Свойство("source"), Аргументы.source, "All");
	ВключатьПараметры = ?(Аргументы.Свойство("includeParameters"), Аргументы.includeParameters, Ложь);
	
	Результат = "СПИСОК ОТЧЕТОВ
	| ====================";
	
	Счетчик = 0;
	
	// Отчеты конфигурации
	Если Источник = "All" Или Источник = "Configuration" Тогда
		Для Каждого Отчет Из Метаданные.Отчеты Цикл
			Если Не ЭлементВходитВСписок(Аргументы, Отчет, ВРег(ИмяОтчета)) Тогда
				Продолжить;
			КонецЕсли;
			
			Счетчик = Счетчик + 1;
			Результат = Результат + "
			| " + Счетчик + ". " + Отчет.Имя + " (" + Отчет.Синоним + ")";
			
			Если ВключатьОписание Тогда
				Результат = Результат + "
				| Описание: " + Отчет.Комментарий;
				
				// Свойства ОсновнойМакет может не быть, поэтому через ЗаполнитьЗначенияСвойств
				СтруктураОсновнойМакет = Новый Структура("ОсновнойМакет");
				ЗаполнитьЗначенияСвойств(СтруктураОсновнойМакет, Отчет);
				Если СтруктураОсновнойМакет.ОсновнойМакет <> Неопределено Тогда
					Результат = Результат + "
					| Основной макет: " + СтруктураОсновнойМакет.ОсновнойМакет.Имя;
				КонецЕсли;
			КонецЕсли;
			
			Если ВключатьПараметры Тогда
				Результат = Результат + ПрочитатьПараметрыВстроенногоОтчета(Отчет.Имя);
			КонецЕсли;
			
			Результат = Результат + "
			| ------------------------";
		КонецЦикла;
	КонецЕсли;
	
	// Внешние отчеты из справочника ДополнительныеОтчетыИОбработки
	Если (Источник = "All" Или Источник = "External") И ВнешниеОтчетыДоступны(Аргументы) Тогда
		
		Счетчик = ДобавитьВнешниеОтчеты(Результат, ИмяОтчета, ВключатьОписание, ВключатьПараметры, Счетчик);
	КонецЕсли;
	
	Результат = Результат + "
	| Всего отчетов: " + Счетчик;
	
	Возврат Результат;

КонецФункции

// Истина, если справочник внешних отчетов можно читать: он есть в конфигурации, доступен пользователю,
// задавшему вопрос, и читается в этом сеансе. Без токена справочник читается с правами технического
// пользователя публикации, если они у него есть.
//
// Параметры:
//  Аргументы - Структура - аргументы инструмента с контекстом доступа
//
// Возвращаемое значение:
//  Булево
//
Функция ВнешниеОтчетыДоступны(Аргументы)
	
	МетаданныеВнешнихОтчетов = Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки");
	Если МетаданныеВнешнихОтчетов = Неопределено
		Или Не mcp_ДоступПользователей.ДоступноПользователю(Аргументы, МетаданныеВнешнихОтчетов) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ПривилегированныйРежим() Или ПравоДоступа("Чтение", МетаданныеВнешнихОтчетов);
	
КонецФункции

// Читает параметры СКД отчета конфигурации.
Функция ПрочитатьПараметрыВстроенногоОтчета(ИмяОтчета)
	
	Попытка
		ОтчетОбъект = Отчеты[ИмяОтчета].Создать();
		СхемаКД = ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Исключение
		Возврат "
		| Параметры: не удалось получить схему компоновки (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")";
	КонецПопытки;
	
	Если СхемаКД = Неопределено Тогда
		Возврат "
		| Параметры: отчёт не на СКД (нет ОсновнаяСхемаКомпоновкиДанных)";
	КонецЕсли;
	
	Возврат ПрочитатьПараметрыСхемыКД(СхемаКД);
	
КонецФункции

// Список параметров схемы компоновки в виде текста.
// Нужен и для отчетов конфигурации, и для внешних.
Функция ПрочитатьПараметрыСхемыКД(СхемаКД)
	
	Попытка
		Настройки = СхемаКД.НастройкиПоУмолчанию;
		ПараметрыДанных = Настройки.ПараметрыДанных;
	Исключение
		Возврат "
		| Параметры: не удалось прочитать (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")";
	КонецПопытки;
	
	Если ПараметрыДанных.Элементы.Количество() = 0 Тогда
		Возврат "
		| Параметры: нет";
	КонецЕсли;
	
	Текст = "
	| Параметры:";
	Для Каждого Элемент Из ПараметрыДанных.Элементы Цикл
		// Строкой ПараметрКомпоновкиДанных является имя параметра
		ИмяПараметра = Строка(Элемент.Параметр);
		
		ТипПараметра = "";
		Попытка
			ДоступныйПараметр = СхемаКД.Параметры.Найти(Элемент.Параметр);
			Если ДоступныйПараметр <> Неопределено И ДоступныйПараметр.ТипЗначения <> Неопределено Тогда
				ТипПараметра = " [" + Строка(ДоступныйПараметр.ТипЗначения) + "]";
			КонецЕсли;
		Исключение
			// У параметра не задан тип
		КонецПопытки;
		
		Текст = Текст + "
		|   - " + ИмяПараметра + ТипПараметра;
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

// Добавляет к результату внешние отчеты из справочника БСП. Возвращает счетчик.
Функция ДобавитьВнешниеОтчеты(Результат, ИмяОтчета, ВключатьОписание, ВключатьПараметры, Счетчик)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Доп.Ссылка КАК Ссылка,
	|	Доп.Наименование КАК Наименование,
	|	Доп.Вид КАК Вид,
	|	Доп.БезопасныйРежим КАК БезопасныйРежим
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Доп
	|ГДЕ
	|	НЕ Доп.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ЭтоВнешнийОтчет(Выборка.Вид) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяОтчета)
			И СтрНайти(ВРег(Строка(Выборка.Наименование)), ВРег(ИмяОтчета)) = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
		Результат = Результат + "
		| " + Счетчик + ". [Внешний отчет] " + Выборка.Наименование;
		
		Если ВключатьОписание Тогда
			ПометкаРежима = ?(Выборка.БезопасныйРежим, "безопасный режим включён", "безопасный режим выключен");
			Результат = Результат + "
			| Подключение: " + ПометкаРежима;
		КонецЕсли;
		
		// Внешний отчет в безопасном режиме подключить нельзя, параметры не читаем
		Если ВключатьПараметры Тогда
			Если Выборка.БезопасныйРежим Тогда
				Результат = Результат + "
				| Параметры: пропущены (безопасный режим включён, подключение не выполняется)";
			Иначе
				Результат = Результат + ПрочитатьПараметрыВнешнегоОтчета(Выборка.Ссылка);
			КонецЕсли;
		КонецЕсли;
		
		Результат = Результат + "
		| ------------------------";
		
	КонецЦикла;
	
	Возврат Счетчик;
	
КонецФункции

// Подключает внешний отчет из хранилища справочника и читает параметры его СКД.
// Вызывается только для отчетов, у которых выключен безопасный режим.
Функция ПрочитатьПараметрыВнешнегоОтчета(СсылкаОтчета)
	
	Попытка
		// Подключение средствами БСП: учитываются безопасный режим и профиль безопасности,
		// заданные для дополнительного отчета в справочнике
		ОтчетОбъект = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(СсылкаОтчета);
		СхемаКД = ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Исключение
		Возврат "
		| Параметры: не удалось подключить внешний отчёт (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")";
	КонецПопытки;
	
	Если СхемаКД = Неопределено Тогда
		Возврат "
		| Параметры: внешний отчёт не на СКД";
	КонецЕсли;
	
	Возврат ПрочитатьПараметрыСхемыКД(СхемаКД);
	
КонецФункции

// Без перечисления видов (старая БСП) считаем запись отчетом
Функция ЭтоВнешнийОтчет(Вид)
	
	Попытка
		Возврат Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.Отчет
			Или Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет;
	Исключение
		Возврат Истина;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнструментПримерыЗапросовОтчетов

// Описывает инструмент find_report_queries: тексты запросов из схем компоновки отчетов конфигурации как
// образцы для модели, которая пишет свой запрос.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - см. mcp_Метаданные.ТаблицаИнструментов
//
Процедура ДобавитьИнструментПримерыЗапросовОтчетов(Инструменты)

	МассивПараметров = Новый Массив;
	ОписаниеСлов = "Слова для поиска через пробел: имя регистра, документа или справочника, тема отчета "
		+ "(например: ТоварыНаСкладах остатки)";
	ДобавитьПараметр(МассивПараметров, "keywords", "string", ОписаниеСлов, , Истина);
	ДобавитьПараметр(МассивПараметров, "maxItems", "number", "Сколько запросов вернуть, от 1 до 3", 1);

	Описание = "Поиск готовых запросов в отчетах конфигурации: образец, по которому составить свой запрос "
		+ "для run_query";
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	mcp_Метаданные.ДобавитьИнструмент(Инструменты, "find_report_queries", Описание, СхемаПараметров);

КонецПроцедуры

// Находит запросы наборов данных отчетов, в имени, синониме или тексте которых есть слова поиска. Первыми
// идут запросы с большим числом совпавших слов, при равенстве - более короткие: они проще как образец.
// Отчеты, недоступные пользователю, не просматриваются.
//
// Параметры:
//  Аргументы - Структура - keywords, maxItems и контекст доступа
//
// Возвращаемое значение:
//  Строка - найденные запросы с именами отчетов и наборов данных
//
Функция ПримерыЗапросовОтчетов(Аргументы)

	Слова = СловаПоиска(Аргументы);
	МаксимумОбразцов = МаксимумОбразцовЗапросов();
	Лимит = ЧислоИзАргументов(Аргументы, "maxItems", 1, 1, МаксимумОбразцов);

	Найденные = Новый ТаблицаЗначений;
	Найденные.Колонки.Добавить("Отчет");
	Найденные.Колонки.Добавить("Набор");
	Найденные.Колонки.Добавить("Текст");
	Найденные.Колонки.Добавить("Совпадений");
	Найденные.Колонки.Добавить("Длина");

	ДоступностьОтчетов = Новый Соответствие;
	Для Каждого Образец Из mcp_КонтейнерыПовтИсп.ЗапросыОтчетов() Цикл
		Если Не ОтчетДоступен(Аргументы, Образец.Отчет, ДоступностьОтчетов) Тогда
			Продолжить;
		КонецЕсли;
		Совпадений = ЧислоСовпадений(Образец, Слова);
		Если Совпадений > 0 Тогда
			НоваяСтрока = Найденные.Добавить();
			НоваяСтрока.Отчет      = СтрШаблон("%1 (%2)", Образец.Отчет, Образец.Синоним);
			НоваяСтрока.Набор      = Образец.Набор;
			НоваяСтрока.Текст      = Образец.Текст;
			НоваяСтрока.Совпадений = Совпадений;
			НоваяСтрока.Длина      = СтрДлина(Образец.Текст);
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(Найденные) Тогда
		СловаСтрокой = СтрСоединить(Слова, " ");
		Возврат СтрШаблон("Запросов в отчетах по словам ""%1"" не найдено. Попробуйте имя регистра или документа.",
			СловаСтрокой);
	КонецЕсли;

	Найденные.Сортировать("Совпадений Убыв, Длина Возр");
	Возврат ТекстОбразцов(Найденные, Лимит);

КонецФункции

// Истина, если отчет доступен пользователю. Результат проверки запоминается: у отчета бывает несколько
// наборов данных.
//
// Параметры:
//  Аргументы          - Структура - контекст доступа
//  ИмяОтчета          - Строка
//  ДоступностьОтчетов - Соответствие - ключ: имя отчета, значение: Булево
//
// Возвращаемое значение:
//  Булево
//
Функция ОтчетДоступен(Аргументы, ИмяОтчета, ДоступностьОтчетов)

	Доступен = ДоступностьОтчетов.Получить(ИмяОтчета);
	Если Доступен = Неопределено Тогда
		МетаданныеОтчета = Метаданные.Отчеты[ИмяОтчета];
		Доступен = mcp_ДоступПользователей.ДоступноПользователю(Аргументы, МетаданныеОтчета);
		ДоступностьОтчетов.Вставить(ИмяОтчета, Доступен);
	КонецЕсли;

	Возврат Доступен;

КонецФункции

// Сколько слов поиска есть в имени, синониме или тексте запроса отчета.
//
// Параметры:
//  Образец - ФиксированнаяСтруктура - см. mcp_КонтейнерыПовтИсп.ЗапросыОтчетов
//  Слова   - Массив из Строка - слова в верхнем регистре
//
// Возвращаемое значение:
//  Число
//
Функция ЧислоСовпадений(Образец, Слова)

	ГдеИскать = ВРег(Образец.Отчет + " " + Образец.Синоним + " " + Образец.Текст);
	Совпадений = 0;
	Для Каждого Слово Из Слова Цикл
		Если СтрНайти(ГдеИскать, Слово) > 0 Тогда
			Совпадений = Совпадений + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Совпадений;

КонецФункции

// Текст ответа: первые запросы из найденных, длинные сокращаются.
//
// Параметры:
//  Найденные - ТаблицаЗначений - отсортированные запросы
//  Лимит     - Число - сколько запросов вывести
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстОбразцов(Найденные, Лимит)

	ДлинаОбразца = 1800;
	Количество = Мин(Лимит, Найденные.Количество());
	Части = Новый Массив;
	Для Индекс = 0 По Количество - 1 Цикл
		Найденная = Найденные[Индекс];
		Текст = Найденная.Текст;
		Если СтрДлина(Текст) > ДлинаОбразца Тогда
			Текст = Лев(Текст, ДлинаОбразца) + Символы.ПС + "... (запрос сокращен)";
		КонецЕсли;
		Части.Добавить(СтрШаблон("Отчет %1, набор данных %2:%3%4", Найденная.Отчет, Найденная.Набор, Символы.ПС, Текст));
	КонецЦикла;

	Возврат СтрСоединить(Части, Символы.ПС + Символы.ПС);

КонецФункции

// Слова поиска из аргумента keywords в верхнем регистре.
//
// Параметры:
//  Аргументы - Структура - аргументы инструмента
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция СловаПоиска(Аргументы)

	ТекстПоиска = "";
	Если Аргументы.Свойство("keywords") Тогда
		ТекстПоиска = СтрЗаменить(Строка(Аргументы.keywords), ",", " ");
	КонецЕсли;

	Слова = Новый Массив;
	Для Каждого Слово Из СтрРазделить(ТекстПоиска, " ", Ложь) Цикл
		Слово = ВРег(СокрЛП(Слово));
		Если ЗначениеЗаполнено(Слово) И Слова.Найти(Слово) = Неопределено Тогда
			Слова.Добавить(Слово);
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(Слова) Тогда
		ВызватьИсключение "Не заданы слова поиска (keywords), например: ТоварыНаСкладах остатки";
	КонецЕсли;

	Возврат Слова;

КонецФункции

// Наибольшее число запросов, которое возвращает find_report_queries: ответ инструмента оркестратор
// сокращает до 2500 символов.
//
// Возвращаемое значение:
//  Число
//
Функция МаксимумОбразцовЗапросов()

	Возврат 3;

КонецФункции

#КонецОбласти

#Область ИнструментПроверкаЗапроса

// Описывает инструмент validate_query: проверка запроса без чтения данных.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - см. mcp_Метаданные.ТаблицаИнструментов
//
Процедура ДобавитьИнструментПроверкаЗапроса(Инструменты)

	МассивПараметров = Новый Массив;
	ОписаниеЗапроса = "Текст запроса на языке запросов 1С (ВЫБРАТЬ ... ИЗ ...), параметры задаются как &Имя";
	ДобавитьПараметр(МассивПараметров, "query", "string", ОписаниеЗапроса, , Истина);

	Описание = "Проверка запроса 1С без чтения данных: синтаксис, имена таблиц и полей, права пользователя. "
		+ "Возвращает таблицы, колонки результата и параметры запроса с типами";
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	mcp_Метаданные.ДобавитьИнструмент(Инструменты, "validate_query", Описание, СхемаПараметров);

КонецПроцедуры

// Проверяет запрос: разбирает текст, проверяет права пользователя на таблицы и поля, читаемые через
// точку. Данные не читаются.
//
// Параметры:
//  Аргументы - Структура - query и контекст доступа
//
// Возвращаемое значение:
//  Строка - JSON: ok, tables, columns, parameters
//
Функция ПроверкаЗапроса(Аргументы)

	Разбор = РазобратьЗапрос(Аргументы);

	// Поиск параметров тоже разбирает текст с проверкой прав сеанса: см. РазобратьЗапрос
	ТекстЗапроса = Разбор.Схема.ПолучитьТекстЗапроса();
	Запрос = Новый Запрос(ТекстЗапроса);
	Если mcp_ДоступПользователей.ЕстьТокенПользователя(Аргументы) Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Попытка
		ПараметрыЗапроса = Запрос.НайтиПараметры();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение "Ошибка в тексте запроса: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	ОписанияПараметров = Новый Массив;
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		ОписаниеПараметра = Новый Структура("name, type", Параметр.Имя, Строка(Параметр.ТипЗначения));
		ОписанияПараметров.Добавить(ОписаниеПараметра);
	КонецЦикла;

	Колонки = Новый Массив;
	ИндексРезультата = ИндексЗапросаРезультата(Разбор.Схема);
	Если ИндексРезультата >= 0 Тогда
		Для Каждого Колонка Из Разбор.Схема.ПакетЗапросов[ИндексРезультата].Колонки Цикл
			Колонки.Добавить(Колонка.Псевдоним);
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ok",         Истина);
	Результат.Вставить("tables",     Разбор.Таблицы);
	Результат.Вставить("columns",    Колонки);
	Результат.Вставить("parameters", ОписанияПараметров);

	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(Результат);

КонецФункции

#КонецОбласти

#Область ИнструментВыполнениеЗапроса

// Описывает инструмент run_query: выполнение запроса только на чтение с проверкой прав пользователя.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - см. mcp_Метаданные.ТаблицаИнструментов
//
Процедура ДобавитьИнструментВыполнениеЗапроса(Инструменты)

	МассивПараметров = Новый Массив;
	ДобавитьПараметр(МассивПараметров, "query", "string",
		"Текст запроса на языке запросов 1С, проверенный через validate_query", , Истина);

	ОписаниеПараметров = "Значения параметров &Имя, например {""НачалоПериода"": ""2026-01-01"", "
		+ """Склад"": ""Основной склад""}. Даты - ГГГГ-ММ-ДД, ссылку можно задать наименованием, кодом "
		+ "или номером документа";
	ДобавитьПараметр(МассивПараметров, "parameters", "object", ОписаниеПараметров);

	ОписаниеСтрок = СтрШаблон("Сколько строк результата вернуть, не больше %1", МаксимумСтрокРезультата());
	ДобавитьПараметр(МассивПараметров, "maxRows", "number", ОписаниеСтрок, СтрокРезультатаПоУмолчанию());

	Описание = "Выполнение запроса 1С только на чтение с правами пользователя: возвращает колонки и строки "
		+ "результата. Язык запросов 1С: ВЫБРАТЬ [ПЕРВЫЕ n] Т.Поле КАК Имя ИЗ Справочник.Имя КАК Т [ГДЕ ...] "
		+ "[СГРУППИРОВАТЬ ПО ...] [УПОРЯДОЧИТЬ ПО ...]; агрегаты КОЛИЧЕСТВО(), СУММА(), МАКСИМУМ(), МИНИМУМ()";
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	mcp_Метаданные.ДобавитьИнструмент(Инструменты, "run_query", Описание, СхемаПараметров);

КонецПроцедуры

// Выполняет запрос после проверки прав. В пакете выполняются все запросы, результатом считается последний,
// который не помещает данные во временную таблицу. Ко всем запросам добавляется РАЗРЕШЕННЫЕ, к результату -
// ограничение числа строк. С токеном данные читаются в привилегированном режиме, как в остальных
// инструментах: права пользователя токена уже проверены при разборе.
//
// Параметры:
//  Аргументы - Структура - query, parameters, maxRows и контекст доступа
//
// Возвращаемое значение:
//  Строка - JSON: columns, rows, rowCount, truncated
//
Функция ВыполнениеЗапроса(Аргументы)

	ПоУмолчанию = СтрокРезультатаПоУмолчанию();
	Максимум = МаксимумСтрокРезультата();
	МаксимумСтрок = ЧислоИзАргументов(Аргументы, "maxRows", ПоУмолчанию, 1, Максимум);

	Разбор = РазобратьЗапрос(Аргументы);
	ИндексРезультата = ИндексЗапросаРезультата(Разбор.Схема);
	Если ИндексРезультата < 0 Тогда
		ВызватьИсключение "В запросе нет выборки результата: все запросы пакета помещают данные во временные таблицы";
	КонецЕсли;
	ПодготовитьСхемуКВыполнению(Разбор.Схема, ИндексРезультата, МаксимумСтрок);

	ТекстЗапроса = Разбор.Схема.ПолучитьТекстЗапроса();
	Запрос = Новый Запрос(ТекстЗапроса);

	Если mcp_ДоступПользователей.ЕстьТокенПользователя(Аргументы) Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Попытка
		ЗаполнитьПараметрыЗапроса(Запрос, Аргументы);
		Результаты = Запрос.ВыполнитьПакет();
		Результат = ОписаниеРезультата(Результаты[ИндексРезультата], МаксимумСтрок);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение "Ошибка выполнения запроса: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(Результат);

КонецФункции

// Сколько строк результата run_query возвращает по умолчанию: ответ инструмента оркестратор сокращает
// до 2500 символов.
//
// Возвращаемое значение:
//  Число
//
Функция СтрокРезультатаПоУмолчанию()

	Возврат 20;

КонецФункции

// Наибольшее число строк результата run_query.
//
// Возвращаемое значение:
//  Число
//
Функция МаксимумСтрокРезультата()

	Возврат 500;

КонецФункции

// Ставит РАЗРЕШЕННЫЕ во все запросы пакета и ограничивает число строк результата. Ограничение
// на одну строку больше запрошенного: по лишней строке видно, что результат обрезан. В объединении
// ограничение не ставится, строки отбираются при чтении выборки.
//
// Параметры:
//  Схема            - СхемаЗапроса
//  ИндексРезультата - Число - индекс запроса результата в пакете
//  МаксимумСтрок    - Число
//
Процедура ПодготовитьСхемуКВыполнению(Схема, ИндексРезультата, МаксимумСтрок)

	Для Каждого ЗапросПакета Из Схема.ПакетЗапросов Цикл
		Если ТипЗнч(ЗапросПакета) = Тип("ЗапросВыбораСхемыЗапроса") Тогда
			ЗапросПакета.ВыбиратьРазрешенные = Истина;
		КонецЕсли;
	КонецЦикла;

	Операторы = Схема.ПакетЗапросов[ИндексРезультата].Операторы;
	Если Операторы.Количество() = 1 Тогда
		Ограничение = Операторы[0].КоличествоПолучаемыхЗаписей;
		Если Не ЗначениеЗаполнено(Ограничение) Или Ограничение > МаксимумСтрок + 1 Тогда
			Операторы[0].КоличествоПолучаемыхЗаписей = МаксимумСтрок + 1;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Колонки и строки результата для модели: ссылки - представлением, даты - строкой ГГГГ-ММ-ДД.
//
// Параметры:
//  РезультатЗапроса - РезультатЗапроса
//  МаксимумСтрок    - Число
//
// Возвращаемое значение:
//  Структура:
//   * columns   - Массив из Строка
//   * rows      - Массив из Массив - значения в порядке колонок
//   * rowCount  - Число - строк в rows
//   * truncated - Булево - в результате есть еще строки
//
Функция ОписаниеРезультата(РезультатЗапроса, МаксимумСтрок)

	Колонки = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	Строки = Новый Массив;
	Обрезан = Ложь;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Строки.Количество() >= МаксимумСтрок Тогда
			Обрезан = Истина;
			Прервать;
		КонецЕсли;
		Значения = Новый Массив;
		Для Каждого ИмяКолонки Из Колонки Цикл
			ЗначениеКолонки = ЗначениеДляМодели(Выборка[ИмяКолонки]);
			Значения.Добавить(ЗначениеКолонки);
		КонецЦикла;
		Строки.Добавить(Значения);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("columns",   Колонки);
	Результат.Вставить("rows",      Строки);
	Результат.Вставить("rowCount",  Строки.Количество());
	Результат.Вставить("truncated", Обрезан);

	Возврат Результат;

КонецФункции

// Значение колонки результата в виде, который записывается в JSON.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Число, Строка, Булево, Неопределено
//
Функция ЗначениеДляМодели(Значение)

	ТипЗначения = ТипЗнч(Значение);
	МаксимальнаяДлинаСтроки = 500;
	Если ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
		Результат = Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") И Значение = НачалоДня(Значение) Тогда
		Результат = Формат(Значение, "ДФ=yyyy-MM-dd; ДП=");
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Результат = Формат(Значение, "ДФ='yyyy-MM-dd HH:mm:ss'");
	ИначеЕсли ТипЗначения = Тип("Null") Или ТипЗначения = Тип("Неопределено") Тогда
		Результат = Неопределено;
	Иначе
		Результат = Строка(Значение);
		Если СтрДлина(Результат) > МаксимальнаяДлинаСтроки Тогда
			Результат = Лев(Результат, МаксимальнаяДлинаСтроки) + "...";
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Задает параметры запроса из аргумента parameters, приводя значения к типам параметров. Ссылки ищутся
// по наименованию, коду или номеру; пользователь должен иметь право читать объект, в котором ищется ссылка.
//
// Параметры:
//  Запрос    - Запрос
//  Аргументы - Структура - parameters и контекст доступа
//
Процедура ЗаполнитьПараметрыЗапроса(Запрос, Аргументы)

	Значения = Неопределено;
	Если Аргументы.Свойство("parameters") И ТипЗнч(Аргументы.parameters) = Тип("Структура") Тогда
		Значения = Аргументы.parameters;
	КонецЕсли;

	НеЗаданы = Новый Массив;
	Для Каждого Параметр Из Запрос.НайтиПараметры() Цикл
		ЗначениеИзJSON = ЗначениеПоИмениБезРегистра(Значения, Параметр.Имя);
		Если ЗначениеИзJSON = Неопределено Тогда
			НеЗаданы.Добавить(СтрШаблон("%1 (%2)", Параметр.Имя, Параметр.ТипЗначения));
			Продолжить;
		КонецЕсли;
		ЗначениеПараметра = ЗначениеПараметра(ЗначениеИзJSON.Значение, Параметр.ТипЗначения, Параметр.Имя, Аргументы);
		Запрос.УстановитьПараметр(Параметр.Имя, ЗначениеПараметра);
	КонецЦикла;

	Если ЗначениеЗаполнено(НеЗаданы) Тогда
		ВызватьИсключение "Не заданы значения параметров: " + СтрСоединить(НеЗаданы, ", ")
			+ ". Передайте их в parameters";
	КонецЕсли;

КонецПроцедуры

// Значение из структуры по ключу без учета регистра: модель может написать имя параметра в другом регистре.
//
// Параметры:
//  Значения - Структура, Неопределено
//  Имя      - Строка
//
// Возвращаемое значение:
//  Структура, Неопределено - Значение (Произвольный), если ключ найден
//
Функция ЗначениеПоИмениБезРегистра(Значения, Имя)

	Если Значения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяВРег = ВРег(Имя);
	Для Каждого КлючИЗначение Из Значения Цикл
		Если ВРег(КлючИЗначение.Ключ) = ИмяВРег Тогда
			Возврат Новый Структура("Значение", КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Приводит значение из JSON к одному из типов параметра запроса.
//
// Параметры:
//  Значение      - Строка, Число, Булево, Массив, Неопределено - значение из JSON
//  ОписаниеТипов - ОписаниеТипов - типы параметра; пустое, если платформа тип не вывела
//  ИмяПараметра  - Строка - для текста ошибки
//  Аргументы     - Структура - контекст доступа
//
// Возвращаемое значение:
//  Произвольный
//
Функция ЗначениеПараметра(Значение, ОписаниеТипов, ИмяПараметра, Аргументы)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Элементы = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			ЗначениеЭлемента = ЗначениеПараметра(Элемент, ОписаниеТипов, ИмяПараметра, Аргументы);
			Элементы.Добавить(ЗначениеЭлемента);
		КонецЦикла;
		Возврат Элементы;
	КонецЕсли;

	Типы = ОписаниеТипов.Типы();
	Если Типы.Количество() = 0 Тогда
		ЗначениеДаты = Неопределено;
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			ЗначениеДаты = mcp_ОбщегоНазначения.ДатаИзСтроки(Значение);
		КонецЕсли;
		Если ЗначениеЗаполнено(ЗначениеДаты) Тогда
			Возврат ЗначениеДаты;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;

	Для Каждого ТипПараметра Из Типы Цикл
		Приведенное = ЗначениеТипа(Значение, ТипПараметра, Аргументы);
		Если Приведенное <> Неопределено Тогда
			Возврат Приведенное;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение СтрШаблон("Значение ""%1"" параметра %2 не подходит: ожидается %3",
		Значение, ИмяПараметра, ОписаниеТипов);

КонецФункции

// Приводит значение из JSON к типу или возвращает Неопределено, если оно к типу не приводится.
//
// Параметры:
//  Значение     - Строка, Число, Булево, Неопределено
//  ОжидаемыйТип - Тип
//  Аргументы    - Структура - контекст доступа
//
// Возвращаемое значение:
//  Произвольный, Неопределено
//
Функция ЗначениеТипа(Значение, ОжидаемыйТип, Аргументы)

	ТипСтрока = Тип("Строка");
	ТипЗначения = ТипЗнч(Значение);
	Если ОжидаемыйТип = ТипЗначения И ОжидаемыйТип <> ТипСтрока Тогда
		Результат = Значение;
	ИначеЕсли ОжидаемыйТип = ТипСтрока Тогда
		Результат = Строка(Значение);
	ИначеЕсли ТипЗначения <> ТипСтрока Тогда
		Результат = Неопределено;
	ИначеЕсли ОжидаемыйТип = Тип("Дата") Тогда
		Результат = mcp_ОбщегоНазначения.ДатаИзСтроки(Значение);
		Если Не ЗначениеЗаполнено(Результат) Тогда
			Результат = Неопределено;
		КонецЕсли;
	ИначеЕсли ОжидаемыйТип = Тип("Число") Тогда
		ТекстЧисла = СтрЗаменить(Значение, ",", ".");
		Результат = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ТекстЧисла);
	ИначеЕсли ОжидаемыйТип = Тип("Булево") Тогда
		Результат = ВРег(Значение) = "TRUE" Или ВРег(Значение) = "ИСТИНА";
	Иначе
		МетаданныеТипа = Метаданные.НайтиПоТипу(ОжидаемыйТип);
		Результат = Неопределено;
		Если МетаданныеТипа <> Неопределено Тогда
			Результат = СсылкаПоСтроке(МетаданныеТипа, Значение, Аргументы);
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Ищет ссылку по строке: идентификатору, имени значения перечисления, наименованию, коду или номеру.
//
// Параметры:
//  МетаданныеТипа  - ОбъектМетаданных - справочник, документ, перечисление, план видов характеристик и т.п.
//  ИскомоеЗначение - Строка
//  Аргументы       - Структура - контекст доступа
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено
//
Функция СсылкаПоСтроке(МетаданныеТипа, ИскомоеЗначение, Аргументы)

	mcp_ДоступПользователей.ПроверитьДоступПользователя(Аргументы, МетаданныеТипа);
	ПолноеИмя = МетаданныеТипа.ПолноеИмя();
	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
	ИскомоеЗначение = СокрЛП(ИскомоеЗначение);

	Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ИскомоеЗначение) Тогда
		Идентификатор = Новый УникальныйИдентификатор(ИскомоеЗначение);
		Ссылка = Менеджер.ПолучитьСсылку(Идентификатор);
	ИначеЕсли Метаданные.Перечисления.Содержит(МетаданныеТипа) Тогда
		Ссылка = ЗначениеПеречисленияПоСтроке(МетаданныеТипа, Менеджер, ИскомоеЗначение);
	ИначеЕсли Метаданные.Документы.Содержит(МетаданныеТипа) Тогда
		Ссылка = Менеджер.НайтиПоНомеру(ИскомоеЗначение);
	Иначе
		Ссылка = СсылкаПоНаименованиюИлиКоду(Менеджер, ИскомоеЗначение);
	КонецЕсли;

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Значение перечисления по имени или синониму.
//
// Параметры:
//  МетаданныеТипа  - ОбъектМетаданных - перечисление
//  Менеджер        - ПеречислениеМенеджер
//  ИскомоеЗначение - Строка
//
// Возвращаемое значение:
//  ПеречислениеСсылка, Неопределено
//
Функция ЗначениеПеречисленияПоСтроке(МетаданныеТипа, Менеджер, ИскомоеЗначение)

	ИскомоеВРег = ВРег(ИскомоеЗначение);
	Для Каждого ЗначениеПеречисления Из МетаданныеТипа.ЗначенияПеречисления Цикл
		Если ВРег(ЗначениеПеречисления.Имя) = ИскомоеВРег Или ВРег(ЗначениеПеречисления.Синоним) = ИскомоеВРег Тогда
			Возврат Менеджер[ЗначениеПеречисления.Имя];
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Ссылка справочника, плана видов характеристик или плана счетов по наименованию, затем по коду.
//
// Параметры:
//  Менеджер        - СправочникМенеджер - менеджер объекта, в котором ищется ссылка
//  ИскомоеЗначение - Строка
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - пустая ссылка, если не найдено
//
Функция СсылкаПоНаименованиюИлиКоду(Менеджер, ИскомоеЗначение)

	Ссылка = Неопределено;
	Попытка
		Ссылка = Менеджер.НайтиПоНаименованию(ИскомоеЗначение, Истина);
	Исключение
		// У объекта нет наименования: остается поиск по коду
		Ссылка = Неопределено;
	КонецПопытки;
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Попытка
		Ссылка = Менеджер.НайтиПоКоду(ИскомоеЗначение);
	Исключение
		// У объекта нет кода
		Ссылка = Неопределено;
	КонецПопытки;

	Возврат Ссылка;

КонецФункции

#КонецОбласти

#Область РазборЗапроса

// Разбирает запрос и проверяет права пользователя, задавшего вопрос: на каждую таблицу, упомянутую в тексте,
// в том числе во вложенных запросах условий, и на объекты, поля которых читаются через точку
// (Т.Контрагент.ИНН).
//
// Параметры:
//  Аргументы - Структура - query и контекст доступа
//
// Возвращаемое значение:
//  Структура:
//   * Схема   - СхемаЗапроса
//   * Таблицы - Массив из Строка - полные имена объектов метаданных, данные которых читает запрос
//
Функция РазобратьЗапрос(Аргументы)

	ТекстЗапроса = "";
	Если Аргументы.Свойство("query") Тогда
		ТекстЗапроса = СокрЛП(Строка(Аргументы.query));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
		ВызватьИсключение "Не задан текст запроса (query)";
	КонецЕсли;
	МаксимальнаяДлинаЗапроса = 20000;
	Если СтрДлина(ТекстЗапроса) > МаксимальнаяДлинаЗапроса Тогда
		ВызватьИсключение СтрШаблон("Текст запроса длиннее %1 символов", МаксимальнаяДлинаЗапроса);
	КонецЕсли;

	// Разбор текста проверяет права сеанса на таблицы. Сеанс HTTP-сервиса работает под техническим
	// пользователем публикации, поэтому с токеном текст разбирается в привилегированном режиме: права
	// пользователя токена проверяются ниже по каждой таблице и каждому полю, прочитанному через точку
	Схема = Новый СхемаЗапроса;
	Если mcp_ДоступПользователей.ЕстьТокенПользователя(Аргументы) Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Попытка
		Схема.УстановитьТекстЗапроса(ТекстЗапроса);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение "Ошибка в тексте запроса: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ ". Имена полей уточните через get_metadata_structure. В языке запросов 1С агрегатные функции - "
			+ "КОЛИЧЕСТВО, СУММА, МАКСИМУМ, МИНИМУМ, СРЕДНЕЕ; поля без агрегата перечисляются в СГРУППИРОВАТЬ ПО";
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Цепочки = ЦепочкиИмен(ТекстЗапроса);
	Таблицы = ПроверитьТаблицыЗапроса(Цепочки, Аргументы);

	Псевдонимы = Новый Соответствие;
	Для Каждого ЗапросПакета Из Схема.ПакетЗапросов Цикл
		СобратьПсевдонимы(ЗапросПакета, Псевдонимы);
	КонецЦикла;
	ПроверитьПоляЧерезТочку(Цепочки, Псевдонимы, Аргументы);

	Возврат Новый Структура("Схема, Таблицы", Схема, Таблицы);

КонецФункции

// Индекс запроса, результат которого возвращается: последний в пакете запрос выборки без ПОМЕСТИТЬ.
//
// Параметры:
//  Схема - СхемаЗапроса
//
// Возвращаемое значение:
//  Число - индекс в пакете или -1
//
Функция ИндексЗапросаРезультата(Схема)

	Индекс = -1;
	Для Номер = 0 По Схема.ПакетЗапросов.Количество() - 1 Цикл
		ЗапросПакета = Схема.ПакетЗапросов[Номер];
		Если ТипЗнч(ЗапросПакета) = Тип("ЗапросВыбораСхемыЗапроса")
			И Не ЗначениеЗаполнено(ЗапросПакета.ТаблицаДляПомещения) Тогда
			Индекс = Номер;
		КонецЕсли;
	КонецЦикла;

	Возврат Индекс;

КонецФункции

// Цепочки имен через точку из текста запроса без строковых литералов и комментариев: "Справочник.Склады",
// "Т.Контрагент.ИНН". Одиночные имена не возвращаются.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Массив из Массив - части каждой цепочки
//
Функция ЦепочкиИмен(Текст)

	Цепочки = Новый Массив;
	Цепочка = Новый Массив;
	Имя = "";
	ВСтроке = Ложь;
	ВКомментарии = Ложь;

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ВКомментарии Тогда
			ВКомментарии = Символ <> Символы.ПС;
		ИначеЕсли ВСтроке Тогда
			ВСтроке = Символ <> """";
		ИначеЕсли ЭтоСимволИмени(Символ) Тогда
			Имя = Имя + Символ;
		Иначе
			Если ЗначениеЗаполнено(Имя) Тогда
				Цепочка.Добавить(Имя);
				Имя = "";
			КонецЕсли;
			Если Символ <> "." Или Не ЗначениеЗаполнено(Цепочка) Тогда
				ДобавитьЦепочку(Цепочки, Цепочка);
				Цепочка = Новый Массив;
				ВСтроке = Символ = """";
				ВКомментарии = Символ = "/" И Сред(Текст, Позиция + 1, 1) = "/";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(Имя) Тогда
		Цепочка.Добавить(Имя);
	КонецЕсли;
	ДобавитьЦепочку(Цепочки, Цепочка);

	Возврат Цепочки;

КонецФункции

// Добавляет цепочку из двух и более имен; цепочки, которые начинаются с цифры (числа 1.5), пропускаются.
//
// Параметры:
//  Цепочки - Массив из Массив
//  Цепочка - Массив из Строка
//
Процедура ДобавитьЦепочку(Цепочки, Цепочка)

	МинимумЧастей = 2;
	Если Цепочка.Количество() >= МинимумЧастей И СтрНайти("0123456789", Лев(Цепочка[0], 1)) = 0 Тогда
		Цепочки.Добавить(Цепочка);
	КонецЕсли;

КонецПроцедуры

// Истина для буквы, цифры и подчеркивания: у букв любого алфавита верхний и нижний регистр различаются.
//
// Параметры:
//  Символ - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоСимволИмени(Символ)

	Возврат ВРег(Символ) <> НРег(Символ) Или СтрНайти("_0123456789", Символ) > 0;

КонецФункции

// Проверяет права на объекты метаданных, упомянутые в тексте как таблицы (Документ.Реализация,
// РегистрНакопления.Остатки.Остатки): данные таблицы пользователь должен иметь право читать.
//
// Параметры:
//  Цепочки   - Массив из Массив - см. ЦепочкиИмен
//  Аргументы - Структура - контекст доступа
//
// Возвращаемое значение:
//  Массив из Строка - полные имена проверенных объектов
//
Функция ПроверитьТаблицыЗапроса(Цепочки, Аргументы)

	Классы = КлассыТаблиц();
	Таблицы = Новый Массив;
	Для Каждого Цепочка Из Цепочки Цикл
		Если Классы.Получить(ВРег(Цепочка[0])) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Цепочка[0] + "." + Цепочка[1]);
		Если ОбъектМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Если Таблицы.Найти(ПолноеИмя) = Неопределено Тогда
			ПроверитьПравоНаТаблицу(Аргументы, ОбъектМетаданных);
			Таблицы.Добавить(ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Возврат Таблицы;

КонецФункции

// Вызывает исключение, если у пользователя, задавшего вопрос, нет права читать объект.
//
// Параметры:
//  Аргументы        - Структура - контекст доступа
//  ОбъектМетаданных - ОбъектМетаданных
//
Процедура ПроверитьПравоНаТаблицу(Аргументы, ОбъектМетаданных)

	Если Не mcp_ДоступПользователей.ДоступноПользователю(Аргументы, ОбъектМетаданных) Тогда
		ВызватьИсключение СтрШаблон("У пользователя нет прав на %1: запрос к этим данным не выполняется",
			ОбъектМетаданных.ПолноеИмя());
	КонецЕсли;

КонецПроцедуры

// Имена классов таблиц запроса в верхнем регистре, русские и английские.
//
// Возвращаемое значение:
//  Соответствие - ключ: имя класса, значение: Истина
//
Функция КлассыТаблиц()

	Классы = Новый Соответствие;
	Имена = "СПРАВОЧНИК,ДОКУМЕНТ,ЖУРНАЛДОКУМЕНТОВ,ПЕРЕЧИСЛЕНИЕ,ПЛАНВИДОВХАРАКТЕРИСТИК,ПЛАНСЧЕТОВ,ПЛАНВИДОВРАСЧЕТА,"
		+ "РЕГИСТРСВЕДЕНИЙ,РЕГИСТРНАКОПЛЕНИЯ,РЕГИСТРБУХГАЛТЕРИИ,РЕГИСТРРАСЧЕТА,БИЗНЕСПРОЦЕСС,ЗАДАЧА,ПЛАНОБМЕНА,"
		+ "КОНСТАНТА,ПОСЛЕДОВАТЕЛЬНОСТЬ,ВНЕШНИЙИСТОЧНИКДАННЫХ,CATALOG,DOCUMENT,DOCUMENTJOURNAL,ENUM,"
		+ "CHARTOFCHARACTERISTICTYPES,CHARTOFACCOUNTS,CHARTOFCALCULATIONTYPES,INFORMATIONREGISTER,"
		+ "ACCUMULATIONREGISTER,ACCOUNTINGREGISTER,CALCULATIONREGISTER,BUSINESSPROCESS,TASK,EXCHANGEPLAN,"
		+ "CONSTANT,SEQUENCE,EXTERNALDATASOURCE";
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Классы.Вставить(Имя, Истина);
	КонецЦикла;

	Возврат Классы;

КонецФункции

// Собирает псевдонимы источников запроса: псевдоним - объекты метаданных, поля которых он дает. Псевдоним
// вложенного запроса и временной таблицы связывается с Неопределено: их поля по метаданным не проверить.
//
// Параметры:
//  ЗапросПакета - ЗапросВыбораСхемыЗапроса, ЗапросУничтоженияТаблицыСхемыЗапроса
//  Псевдонимы   - Соответствие - ключ: псевдоним в верхнем регистре, значение: Массив
//
Процедура СобратьПсевдонимы(ЗапросПакета, Псевдонимы)

	Если ТипЗнч(ЗапросПакета) <> Тип("ЗапросВыбораСхемыЗапроса") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Оператор Из ЗапросПакета.Операторы Цикл
		Для Каждого ИсточникОператора Из Оператор.Источники Цикл
			Источник = ИсточникОператора.Источник;
			Если ТипЗнч(Источник) = Тип("ТаблицаСхемыЗапроса") Тогда
				Владелец = ВладелецПолейТаблицы(Источник.ИмяТаблицы);
			ИначеЕсли ТипЗнч(Источник) = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
				Владелец = Неопределено;
				СобратьПсевдонимы(Источник.Запрос, Псевдонимы);
			Иначе
				// Временная таблица: ее поля по метаданным не проверить
				Владелец = Неопределено;
			КонецЕсли;
			ДобавитьВладельцаПсевдонима(Псевдонимы, Источник.Псевдоним, Владелец);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Добавляет владельца полей к псевдониму: один псевдоним в разных запросах пакета дает разные таблицы.
//
// Параметры:
//  Псевдонимы - Соответствие - см. СобратьПсевдонимы
//  Псевдоним  - Строка
//  Владелец   - ОбъектМетаданных, Неопределено
//
Процедура ДобавитьВладельцаПсевдонима(Псевдонимы, Псевдоним, Владелец)

	Ключ = ВРег(Псевдоним);
	Владельцы = Псевдонимы.Получить(Ключ);
	Если Владельцы = Неопределено Тогда
		Владельцы = Новый Массив;
		Псевдонимы.Вставить(Ключ, Владельцы);
	КонецЕсли;
	Владельцы.Добавить(Владелец);

КонецПроцедуры

// Объект метаданных, поля которого дает таблица запроса: сам объект, его табличная часть или регистр
// виртуальной таблицы (РегистрНакопления.ТоварыНаСкладах.Остатки).
//
// Параметры:
//  ИмяТаблицы - Строка
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено
//
Функция ВладелецПолейТаблицы(ИмяТаблицы)

	Части = СтрРазделить(ИмяТаблицы, ".");
	ЧастейИмениОбъекта = 2;
	Если Части.Количество() < ЧастейИмениОбъекта Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]);
	Если ОбъектМетаданных = Неопределено Или Части.Количество() = ЧастейИмениОбъекта Тогда
		Возврат ОбъектМетаданных;
	КонецЕсли;

	// Третья часть имени - табличная часть объекта или виртуальная таблица регистра
	Свойства = Новый Структура("ТабличныеЧасти");
	ЗаполнитьЗначенияСвойств(Свойства, ОбъектМетаданных);
	ТабличнаяЧасть = Неопределено;
	Если Свойства.ТабличныеЧасти <> Неопределено Тогда
		ТабличнаяЧасть = Свойства.ТабличныеЧасти.Найти(Части[ЧастейИмениОбъекта]);
	КонецЕсли;
	Если ТабличнаяЧасть <> Неопределено Тогда
		Возврат ТабличнаяЧасть;
	КонецЕсли;

	Возврат ОбъектМетаданных;

КонецФункции

// Проверяет обращения к полям через точку (Т.Контрагент.ИНН): чтобы прочитать поле ИНН, пользователь должен
// иметь право читать справочник, на который ссылается Контрагент. Цепочку, которую не удается разобрать по
// метаданным (поле вложенного запроса или временной таблицы), запрос не допускает.
//
// Параметры:
//  Цепочки    - Массив из Массив - см. ЦепочкиИмен
//  Псевдонимы - Соответствие - см. СобратьПсевдонимы
//  Аргументы  - Структура - контекст доступа
//
Процедура ПроверитьПоляЧерезТочку(Цепочки, Псевдонимы, Аргументы)

	МинимумЧастей = 3;
	Для Каждого Цепочка Из Цепочки Цикл
		Владельцы = Псевдонимы.Получить(ВРег(Цепочка[0]));
		Если Владельцы = Неопределено Или Цепочка.Количество() < МинимумЧастей Тогда
			Продолжить;
		КонецЕсли;

		ПоследнееПромежуточное = Цепочка.Количество() - 1;
		Для Номер = 1 По ПоследнееПромежуточное - 1 Цикл
			Владельцы = ВладельцыСледующегоПоля(Владельцы, Цепочка[Номер], Аргументы);
			Если Владельцы = Неопределено Тогда
				Поле = СтрСоединить(Цепочка, ".");
				ВызватьИсключение СтрШаблон("Не удалось проверить права на поле %1: обращение через точку "
					+ "разрешено только к полям таблиц базы. Соедините нужную таблицу явно или используйте ВЫРАЗИТЬ",
					Поле);
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Владельцы) Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Объекты метаданных, поля которых читаются после поля ИмяПоля. Проверяет право пользователя на каждый
// объект, на который ссылается поле.
//
// Параметры:
//  Владельцы - Массив из ОбъектМетаданных, Неопределено - объекты, у которых ищется поле
//  ИмяПоля   - Строка
//  Аргументы - Структура - контекст доступа
//
// Возвращаемое значение:
//  Массив из ОбъектМетаданных - пустой, если поле примитивного типа; Неопределено, если поле не найдено
//
Функция ВладельцыСледующегоПоля(Владельцы, ИмяПоля, Аргументы)

	Найдено = Ложь;
	Следующие = Новый Массив;
	Для Каждого Владелец Из Владельцы Цикл
		Поле = Неопределено;
		Если Владелец <> Неопределено Тогда
			Поле = ПолеОбъектаМетаданных(Владелец, ИмяПоля);
		КонецЕсли;
		Если Поле = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Найдено = Истина;

		Если Поле.ТабличнаяЧасть <> Неопределено Тогда
			Следующие.Добавить(Поле.ТабличнаяЧасть);
		Иначе
			ДобавитьОбъектыТипа(Следующие, Поле.Тип, Аргументы);
		КонецЕсли;
	КонецЦикла;

	Если Не Найдено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Следующие;

КонецФункции

// Добавляет объекты метаданных, на которые ссылается тип поля, проверяя право пользователя на каждый.
//
// Параметры:
//  Объекты   - Массив из ОбъектМетаданных
//  ТипПоля   - ОписаниеТипов
//  Аргументы - Структура - контекст доступа
//
Процедура ДобавитьОбъектыТипа(Объекты, ТипПоля, Аргументы)

	Для Каждого ТипСсылки Из ТипПоля.Типы() Цикл
		ОбъектТипа = Метаданные.НайтиПоТипу(ТипСсылки);
		Если ОбъектТипа <> Неопределено И Объекты.Найти(ОбъектТипа) = Неопределено Тогда
			ПроверитьПравоНаТаблицу(Аргументы, ОбъектТипа);
			Объекты.Добавить(ОбъектТипа);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Поле объекта метаданных по имени: реквизит, стандартный реквизит, измерение, ресурс или табличная часть.
//
// Параметры:
//  Владелец - ОбъектМетаданных
//  ИмяПоля  - Строка
//
// Возвращаемое значение:
//  Структура, Неопределено:
//   * Тип            - ОписаниеТипов, Неопределено - тип поля; Неопределено для табличной части
//   * ТабличнаяЧасть - ОбъектМетаданных, Неопределено - табличная часть, если имя - ее имя
//
Функция ПолеОбъектаМетаданных(Владелец, ИмяПоля)

	ИмяВРег = ВРег(ИмяПоля);
	ИменаКоллекций = "Реквизиты,СтандартныеРеквизиты,Измерения,Ресурсы,ТабличныеЧасти";
	Свойства = Новый Структура(ИменаКоллекций);
	ЗаполнитьЗначенияСвойств(Свойства, Владелец);

	Для Каждого Коллекция Из Свойства Цикл
		Если Коллекция.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Элемент Из Коллекция.Значение Цикл
			Если ВРег(Элемент.Имя) <> ИмяВРег Тогда
				Продолжить;
			ИначеЕсли Коллекция.Ключ = "ТабличныеЧасти" Тогда
				Возврат Новый Структура("Тип, ТабличнаяЧасть", Неопределено, Элемент);
			Иначе
				Возврат Новый Структура("Тип, ТабличнаяЧасть", Элемент.Тип, Неопределено);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Добавляет описание параметра инструмента в массив параметров.
//
// Параметры:
//  МассивПараметров - Массив - см. mcp_Метаданные.ПараметрИнструмента
//  Имя              - Строка
//  Тип              - Строка - string, number, object
//  Описание         - Строка
//  ПоУмолчанию      - Произвольный - значение по умолчанию
//  Обязательный     - Булево
//
Процедура ДобавитьПараметр(МассивПараметров, Имя, Тип, Описание, ПоУмолчанию = Неопределено, Обязательный = Ложь)

	Параметр = mcp_Метаданные.ПараметрИнструмента(Имя, Тип, Описание, ПоУмолчанию, Обязательный);
	МассивПараметров.Добавить(Параметр);

КонецПроцедуры

// Число из аргумента инструмента в заданных пределах.
//
// Параметры:
//  Аргументы   - Структура
//  Имя         - Строка - имя аргумента
//  ПоУмолчанию - Число - если аргумент не задан
//  Минимум     - Число
//  Максимум    - Число
//
// Возвращаемое значение:
//  Число
//
Функция ЧислоИзАргументов(Аргументы, Имя, ПоУмолчанию, Минимум, Максимум)

	Значение = ПоУмолчанию;
	Если Аргументы.Свойство(Имя) И ТипЗнч(Аргументы[Имя]) = Тип("Число") Тогда
		Значение = Цел(Аргументы[Имя]);
	КонецЕсли;

	Возврат Макс(Минимум, Мин(Максимум, Значение));

КонецФункции

#КонецОбласти

#КонецОбласти
