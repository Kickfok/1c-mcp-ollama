		СхемаПараметров
	);

КонецПроцедуры

Функция СписокМетаданных(Аргументы)

	Если Не Аргументы.Свойство("metaType") Или Не ЗначениеЗаполнено(Аргументы.metaType) Тогда
		ВызватьИсключение "Не задан обязательный параметр metaType (например: Documents, Catalogs).";
	КонецЕсли;
	
	МетаТип     = Аргументы.metaType;
	МаскаИмени  = ?(Аргументы.Свойство("nameMask"), Аргументы.nameMask, "");
	Лимит       = ?(Аргументы.Свойство("maxItems"), Аргументы.maxItems, 100);

	МаскаИмениВРег = ВРег(МаскаИмени);

	Попытка
		КоллекцияМД = Метаданные[МетаТип];
	Исключение
		ВызватьИсключение "Неизвестный тип метаданных в metaType: " + МетаТип;
	КонецПопытки;

	МассивСтрок = Новый Массив;
	Счетчик = 0;

	Для Каждого Элемент Из КоллекцияМД Цикл
		Если Не ЭлементВходитВСписок(Аргументы, Элемент, МаскаИмениВРег) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаРезультата = Элемент.ПолноеИмя() + " (" + Элемент.Синоним + ")";
		МассивСтрок.Добавить(СтрокаРезультата);
		
		Счетчик = Счетчик + 1;
		Если Счетчик >= Лимит Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Результат = СтрСоединить(МассивСтрок, Символы.ПС);
	
	Возврат Результат;

КонецФункции

// Истина, если объект метаданных попадает в список: доступен пользователю, задавшему вопрос, и
// подходит под маску имени.
//
// Параметры:
//  Аргументы      - Структура - аргументы инструмента с контекстом доступа
//  Элемент        - ОбъектМетаданных - проверяемый объект
//  МаскаИмениВРег - Строка - часть имени или синонима в верхнем регистре; пустая строка - без отбора
//
// Возвращаемое значение:
//  Булево
//
Функция ЭлементВходитВСписок(Аргументы, Элемент, МаскаИмениВРег)
	
	Если Не mcp_ДоступПользователей.ДоступноПользователю(Аргументы, Элемент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Не ЗначениеЗаполнено(МаскаИмениВРег)
		Или СтрНайти(ВРег(Элемент.Имя), МаскаИмениВРег) > 0
		Или СтрНайти(ВРег(Элемент.Синоним), МаскаИмениВРег) > 0;
	
КонецФункции

