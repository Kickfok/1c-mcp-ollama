Процедура ДобавитьИнструменты(Инструменты) Экспорт

	ДобавитьИнструментСписокМетаданных(Инструменты);
	ДобавитьИнструментСтруктураОбъекта(Инструменты);
	ДобавитьИнструментПолучитьВерсиюКонфигурации(Инструменты);
	ДобавитьИнструментАнализЗависимостейОбъектов(Инструменты);
	ДобавитьИнструментПолучитьСписокОтчетов(Инструменты);
	ДобавитьИнструментПримерыЗапросовОтчетов(Инструменты);
	ДобавитьИнструментПроверкаЗапроса(Инструменты);
	ДобавитьИнструментВыполнениеЗапроса(Инструменты);

КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Если ИмяИнструмента = "list_metadata_objects" Тогда
		Возврат СписокМетаданных(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_metadata_structure" Тогда
		Возврат СтруктураОбъектаМетаданных(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_configuration_version" Тогда
		Возврат ПолучитьВерсиюКонфигурации(Аргументы);
	ИначеЕсли ИмяИнструмента = "list_object_dependencies" Тогда
		Возврат АнализЗависимостейОбъектов(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_report_list" Тогда
		// Читает справочник внешних отчетов и схемы отчетов: по правам пользователя из токена
		// Привилегированный режим действует до выхода из этой функции, в том числе при исключении
		Если mcp_ДоступПользователей.ЕстьТокенПользователя(Аргументы) Тогда
			УстановитьПривилегированныйРежим(Истина);
		КонецЕсли;
		Возврат ПолучитьСписокОтчетов(Аргументы);
	ИначеЕсли ИмяИнструмента = "find_report_queries" Тогда
		Возврат ПримерыЗапросовОтчетов(Аргументы);
	ИначеЕсли ИмяИнструмента = "validate_query" Тогда
		Возврат ПроверкаЗапроса(Аргументы);
	ИначеЕсли ИмяИнструмента = "run_query" Тогда
		Возврат ВыполнениеЗапроса(Аргументы);
	Иначе
		ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
	КонецЕсли;

КонецФункции

#Область ИнструментСписокМетаданных

Процедура ДобавитьИнструментСписокМетаданных(Инструменты)

	МассивПараметров = Новый Массив;
	
	СписокТиповМетаданных = "Catalogs,Documents,InformationRegisters,AccumulationRegisters,AccountingRegisters,CalculationRegisters,ChartsOfCharacteristicTypes,ChartsOfAccounts,ChartsOfCalculationTypes,BusinessProcesses,Tasks,ExchangePlans,FilterCriteria,Reports,DataProcessors,Enums,CommonModules,SessionParameters,CommonTemplates,CommonPictures,XDTOPackages,WebServices,HTTPServices,WSReferences,Styles,Languages,FunctionalOptions,FunctionalOptionsParameters,DefinedTypes,CommonAttributes,CommonCommands,CommandGroups,Constants,CommonForms,Roles,Subsystems,EventSubscriptions,ScheduledJobs,SettingsStorages,Sequences,DocumentJournals,ExternalDataSources,Interfaces";
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType",
		"string",
		"Тип объекта метаданных",
		,
		Истина,
		СписокТиповМетаданных
	));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"nameMask",
		"string",
		"Маска имени объекта. Проверяется на вхождение подстроки в имя или синоним объекта."
	));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxItems",
		"number",
		"Максимальное количество возвращаемых результатов",
		100
	));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"list_metadata_objects",
		"Получение списка объектов метаданных конфигурации с возможностью фильтрации по типу и имени",
		СхемаПараметров
	);

КонецПроцедуры

Функция СписокМетаданных(Аргументы)

	Если Не Аргументы.Свойство("metaType") Или Не ЗначениеЗаполнено(Аргументы.metaType) Тогда
		ВызватьИсключение "Не задан обязательный параметр metaType (например: Documents, Catalogs).";
	КонецЕсли;
	
	МетаТип     = Аргументы.metaType;
	МаскаИмени  = ?(Аргументы.Свойство("nameMask"), Аргументы.nameMask, "");
	Лимит       = ?(Аргументы.Свойство("maxItems"), Аргументы.maxItems, 100);

	// Модели передают маску с подстановочными символами (*Контрагент*), а отбор идет по подстроке.
	МаскаИмениВРег = ВРег(СтрЗаменить(СтрЗаменить(Строка(МаскаИмени), "*", ""), "%", ""));

	Попытка
		КоллекцияМД = Метаданные[МетаТип];
	Исключение
		ВызватьИсключение "Неизвестный тип метаданных в metaType: " + МетаТип;
	КонецПопытки;

	МассивСтрок = Новый Массив;
	Счетчик = 0;

	Для Каждого Элемент Из КоллекцияМД Цикл
		Если Не ЭлементВходитВСписок(Аргументы, Элемент, МаскаИмениВРег) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаРезультата = Элемент.ПолноеИмя() + " (" + Элемент.Синоним + ")";
		МассивСтрок.Добавить(СтрокаРезультата);
		
		Счетчик = Счетчик + 1;
		Если Счетчик >= Лимит Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(МассивСтрок) Тогда
		Возврат СтрШаблон("Объекты %1 по маске ""%2"" не найдены или недоступны пользователю. "
			+ "Маска - часть имени или синонима объекта, без подстановочных символов.", МетаТип, МаскаИмени);
	КонецЕсли;

	Результат = СтрСоединить(МассивСтрок, Символы.ПС);

	Возврат Результат;

КонецФункции

// Истина, если объект метаданных попадает в список: доступен пользователю, задавшему вопрос, и
// подходит под маску имени.
//
// Параметры:
//  Аргументы      - Структура - аргументы инструмента с контекстом доступа
//  Элемент        - ОбъектМетаданных - проверяемый объект
//  МаскаИмениВРег - Строка - часть имени или синонима в верхнем регистре; пустая строка - без отбора
//
// Возвращаемое значение:
//  Булево
//
Функция ЭлементВходитВСписок(Аргументы, Элемент, МаскаИмениВРег)
	
	Если Не mcp_ДоступПользователей.ДоступноПользователю(Аргументы, Элемент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Не ЗначениеЗаполнено(МаскаИмениВРег)
		Или СтрНайти(ВРег(Элемент.Имя), МаскаИмениВРег) > 0
		Или СтрНайти(ВРег(Элемент.Синоним), МаскаИмениВРег) > 0;
	
КонецФункции

