	);

КонецПроцедуры

Функция СтруктураОбъектаМетаданных(Аргументы)

	Если Не Аргументы.Свойство("metaType") Или Не ЗначениеЗаполнено(Аргументы.metaType) Тогда
		ВызватьИсключение "Не задан обязательный параметр metaType.";
	КонецЕсли;
	Если Не Аргументы.Свойство("name") Или Не ЗначениеЗаполнено(Аргументы.name) Тогда
		ВызватьИсключение "Не задан обязательный параметр name.";
	КонецЕсли;
	
	МетаТип = Аргументы.metaType;
	ИмяОбъекта = Аргументы.name;
	
	Попытка
		КоллекцияМД = Метаданные[МетаТип];
	Исключение
		ВызватьИсключение "Неизвестный тип метаданных в metaType: " + МетаТип;
	КонецПопытки;
	
	МетаданныеОбъекта = КоллекцияМД.Найти(ИмяОбъекта);
	Если МетаданныеОбъекта = Неопределено Тогда
		ВызватьИсключение "Объект метаданных не найден: " + МетаТип + "." + ИмяОбъекта;
	КонецЕсли;
	mcp_ДоступПользователей.ПроверитьДоступПользователя(Аргументы, МетаданныеОбъекта);
	
	ОбработкаОбъект = Создать();
	
	Возврат ОбработкаОбъект.ОписаниеСтруктурыОбъектаМетаданных(МетаданныеОбъекта);
	
КонецФункции

#КонецОбласти  

#Область ИнструментПолучитьВерсиюКонфигурации

Процедура ДобавитьИнструментПолучитьВерсиюКонфигурации(Инструменты)

	МассивПараметров = Новый Массив;
	
	// Список допустимых значений (enum). Должен совпадать с ключами структуры
	// в ПолучитьВерсиюКонфигурации.
	ДопустимыеСвойства =
		"ОперационнаяСистема,ВерсияПлатформы,ОбъемОЗУ,Процессор,ТипПлатформы,"
		+ "Конфигурация,ВерсияКонфигурации,КраткаяИнформация,ПодробнаяИнформация,"
		+ "Поставщик,ИнформацияОПоставщике,ИнформацияОКонфигурации,АвторскиеПрава,ОсновнойЯзык";

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"configurationProperty",
		"string",
		"Имя свойства конфигурации (необязательно). Если не задано - возвращаются все свойства. Имя выбирается из списка допустимых значений.",
		,
		Ложь,
		ДопустимыеСвойства
	));

	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_configuration_version",
		"Получение системной информации о компьютере и конфигурации (имя, версия конфигурации, версия платформы и т.д.)",
		СхемаПараметров
	);

КонецПроцедуры

Функция ПолучитьВерсиюКонфигурации(Аргументы)

   	СтруктураДанныхКонфигурации = Новый Структура;
	
	СисИнфо = Новый СистемнаяИнформация;
	СтруктураДанныхКонфигурации.Вставить("ОперационнаяСистема", Строка(СисИнфо.ВерсияОС));
	СтруктураДанныхКонфигурации.Вставить("ВерсияПлатформы", Строка(СисИнфо.ВерсияПриложения));
	СтруктураДанныхКонфигурации.Вставить("ОбъемОЗУ", Строка(СисИнфо.ОперативнаяПамять));
	СтруктураДанныхКонфигурации.Вставить("Процессор", Строка(СисИнфо.Процессор));
	СтруктураДанныхКонфигурации.Вставить("ТипПлатформы", Строка(СисИнфо.ТипПлатформы));	
	
	СтруктураДанныхКонфигурации.Вставить("Конфигурация", Строка(Метаданные.Синоним));
	СтруктураДанныхКонфигурации.Вставить("ВерсияКонфигурации", Строка(Метаданные.Версия));
	СтруктураДанныхКонфигурации.Вставить("КраткаяИнформация", Строка(Метаданные.КраткаяИнформация));
	СтруктураДанныхКонфигурации.Вставить("ПодробнаяИнформация", Строка(Метаданные.ПодробнаяИнформация));
	СтруктураДанныхКонфигурации.Вставить("Поставщик", Строка(Метаданные.Поставщик));
	СтруктураДанныхКонфигурации.Вставить("ИнформацияОПоставщике", Строка(Метаданные.АдресИнформацииОПоставщике));
	СтруктураДанныхКонфигурации.Вставить("ИнформацияОКонфигурации", Строка(Метаданные.АдресИнформацииОКонфигурации));
	СтруктураДанныхКонфигурации.Вставить("АвторскиеПрава", Строка(Метаданные.АвторскиеПрава));
    СтруктураДанныхКонфигурации.Вставить("ОсновнойЯзык", Строка(Метаданные.ОсновнойЯзык.Имя));
		
	// Задано свойство - возвращаем только его, регистр имени не важен
	Если Аргументы.Свойство("configurationProperty")
		И ЗначениеЗаполнено(Аргументы.configurationProperty) Тогда

		ИскомоеСвойство = СокрЛП(Аргументы.configurationProperty);

		НайденоИмя = "";
		НайденноеЗначение = Неопределено;
		Для Каждого ТекСвойство Из СтруктураДанныхКонфигурации Цикл
			Если ВРег(ТекСвойство.Ключ) = ВРег(ИскомоеСвойство) Тогда
				НайденоИмя = ТекСвойство.Ключ;
				НайденноеЗначение = ТекСвойство.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если НайденоИмя = "" Тогда
			МассивИмён = Новый Массив;
			Для Каждого ТекСвойство Из СтруктураДанныхКонфигурации Цикл
				МассивИмён.Добавить(ТекСвойство.Ключ);
			КонецЦикла;
			ВызватьИсключение "Свойство конфигурации не найдено: " + Аргументы.configurationProperty
				+ ". Доступные свойства: " + СтрСоединить(МассивИмён, ", ");
		КонецЕсли;

		СтруктураОдногоСвойства = Новый Структура;
		СтруктураОдногоСвойства.Вставить("ИмяСвойства", НайденоИмя);
		СтруктураОдногоСвойства.Вставить("ЗначениеСвойства", НайденноеЗначение);

		Возврат mcp_ОбщегоНазначения.СтруктураВJSON(СтруктураОдногоСвойства);
	КонецЕсли; 
	
	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(СтруктураДанныхКонфигурации);
	
КонецФункции

#КонецОбласти 

#Область ИнструментАнализЗависимостейОбъектов

Процедура ДобавитьИнструментАнализЗависимостейОбъектов(Инструменты)

	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"objectName",
		"string",
		"Имя объекта метаданных",
		,
		Истина
	));
	
	// objectType - имя коллекции во множественном числе, как в Метаданные[...]
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"objectType",
		"string",
		"Имя коллекции метаданных во множественном числе: Documents, Catalogs, InformationRegisters, AccumulationRegisters, AccountingRegisters, CalculationRegisters, ChartsOfCharacteristicTypes, ChartsOfAccounts, ChartsOfCalculationTypes, BusinessProcesses, Tasks, ExchangePlans",
		,
		Истина,
		"Documents,Catalogs,InformationRegisters,AccumulationRegisters,AccountingRegisters,CalculationRegisters,ChartsOfCharacteristicTypes,ChartsOfAccounts,ChartsOfCalculationTypes,BusinessProcesses,Tasks,ExchangePlans"
	));

	// Ограничение на число связей в uses и usedBy: у популярных объектов их сотни,
	// а контекст модели всего 4096 токенов
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxItems",
		"number",
		"Максимум связей в каждой группе uses/usedBy (по умолчанию 50)",
		50
	));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"scopeTypes",
		"string",
		"Где искать использование (usedBy): имена коллекций через запятую, например Documents,AccumulationRegisters. Пусто - искать везде."
	));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"scopeSubsystem",
		"string",
		"Имя подсистемы для ограничения поиска usedBy (только объекты, входящие в неё, в т.ч. вложенные). Пусто - без ограничения."
	));
			
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"list_object_dependencies",
		"Анализ зависимостей объектов метаданных. Возвращает uses (что использует объект) и usedBy (где используется объект).",
		СхемаПараметров
	);

КонецПроцедуры

Функция АнализЗависимостейОбъектов(Аргументы)
	
	Если Не Аргументы.Свойство("objectName") Или Не ЗначениеЗаполнено(Аргументы.objectName) Тогда
		ВызватьИсключение "Не задан обязательный параметр objectName.";
	КонецЕсли;
	Если Не Аргументы.Свойство("objectType") Или Не ЗначениеЗаполнено(Аргументы.objectType) Тогда
		ВызватьИсключение "Не задан обязательный параметр objectType (имя коллекции, например Documents).";
	КонецЕсли;
	
	ИмяОбъекта = Аргументы.objectName;
	ТипОбъекта = Аргументы.objectType;  
	Лимит = ?(Аргументы.Свойство("maxItems"), Число(Аргументы.maxItems), 50);
	Если Лимит <= 0 Тогда
		Лимит = 50;
	КонецЕсли;
	
	// Фильтры области поиска usedBy.
	СписокТипов = Неопределено;
	Если Аргументы.Свойство("scopeTypes") И ЗначениеЗаполнено(Аргументы.scopeTypes) Тогда
		СписокТипов = СтрРазделить(Аргументы.scopeTypes, ",", Ложь);
	КонецЕсли;
	ИмяПодсистемы = ?(Аргументы.Свойство("scopeSubsystem"), СокрЛП(Аргументы.scopeSubsystem), "");
	
	ОбработкаОбъект = Создать();
	
	ОбъектМД = ОбработкаОбъект.НайтиОбъектМетаданных(ТипОбъекта, ИмяОбъекта);
	Если ОбъектМД = Неопределено Тогда
		ВызватьИсключение "Объект метаданных не найден: " + ТипОбъекта + "." + ИмяОбъекта
			+ ". Проверьте, что objectType задан именем коллекции во множественном числе (например, Documents).";
	КонецЕсли;
	mcp_ДоступПользователей.ПроверитьДоступПользователя(Аргументы, ОбъектМД);
	
	Результат = Новый Структура;
	Результат.Вставить("objectName", ИмяОбъекта);
	Результат.Вставить("objectType", ТипОбъекта);
	Результат.Вставить("fullName", ОбъектМД.ПолноеИмя());
	
	Uses   = Новый Массив;
	UsedBy = Новый Массив;
	
	ОбработкаОбъект.СобратьИспользуемыеОбъекты(ОбъектМД, Uses);
	ОбработкаОбъект.СобратьИспользующиеОбъекты(ОбъектМД, UsedBy, СписокТипов, ИмяПодсистемы);
	
	// Объекты без прав пользователя убираются до подсчета: счетчики тоже не должны их выдавать
	Uses   = ДоступныеСвязи(Аргументы, Uses);
	UsedBy = ДоступныеСвязи(Аргументы, UsedBy);
	
	// Полное количество до обрезки, по нему видно, что список неполный
	ВсегоUses   = Uses.Количество();
	ВсегоUsedBy = UsedBy.Количество();
	
	Результат.Вставить("usesTotal", ВсегоUses);
	Результат.Вставить("usedByTotal", ВсегоUsedBy);
	Результат.Вставить("uses", ОбрезатьМассив(Uses, Лимит));
	Результат.Вставить("usedBy", ОбрезатьМассив(UsedBy, Лимит));
	Результат.Вставить("truncated", (ВсегоUses > Лимит) Или (ВсегоUsedBy > Лимит));
	
	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(Результат);
	
КонецФункции

// Связи с объектами, которые доступны пользователю, задавшему вопрос.
//
// Параметры:
//  Аргументы - Структура - аргументы инструмента с контекстом доступа
//  Связи     - Массив из Структура - записи связей с полем object (полное имя объекта метаданных)
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция ДоступныеСвязи(Аргументы, Связи)
	
	Результат = Новый Массив;
	Для Каждого Связь Из Связи Цикл
		ОбъектСвязи = Метаданные.НайтиПоПолномуИмени(Связь.object);
		Если ОбъектСвязи = Неопределено Или mcp_ДоступПользователей.ДоступноПользователю(Аргументы, ОбъектСвязи) Тогда
			Результат.Добавить(Связь);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает копию массива, обрезанную до Лимит элементов.
Функция ОбрезатьМассив(Исходный, Лимит)
	Если Исходный.Количество() <= Лимит Тогда
		Возврат Исходный;
	КонецЕсли;
	Результат = Новый Массив;
	Для Сч = 0 По Лимит - 1 Цикл
		Результат.Добавить(Исходный[Сч]);
	КонецЦикла;
	Возврат Результат;
КонецФункции  

#КонецОбласти   

#Область ИнструментПолучитьСписокОтчетов

Процедура ДобавитьИнструментПолучитьСписокОтчетов(Инструменты)

	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"reportName",
		"string",
		"Имя или часть имени отчета для фильтрации (опционально). Проверяется вхождение в имя, синоним и наименование."
	));
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"includeDescription",
		"boolean",
		"Включать описание отчетов",
		Ложь
	));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"source",
		"string",
		"Источник отчётов: All - все, Configuration - только встроенные, External - только внешние (из справочника ДополнительныеОтчетыИОбработки)",
		"All",
		Ложь,
		"All,Configuration,External"
	));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"includeParameters",
		"boolean",
		"Читать обязательные параметры отчёта из его схемы компоновки данных (для конкретного отчёта по reportName). Для внешних отчётов работает только при выключенном безопасном режиме.",
		Ложь
	));
	
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_report_list",
		"Получение списка отчетов конфигурации (встроенных и внешних) и их обязательных параметров. Внешние отмечаются как [Внешний отчет].",
		СхемаПараметров
	);

КонецПроцедуры

Функция ПолучитьСписокОтчетов(Аргументы)
	
	ИмяОтчета        = ?(Аргументы.Свойство("reportName"), Аргументы.reportName, "");
	ВключатьОписание = ?(Аргументы.Свойство("includeDescription"), Аргументы.includeDescription, Ложь);
	Источник         = ?(Аргументы.Свойство("source"), Аргументы.source, "All");
	ВключатьПараметры = ?(Аргументы.Свойство("includeParameters"), Аргументы.includeParameters, Ложь);
	
	Результат = "СПИСОК ОТЧЕТОВ
	| ====================";
	
	Счетчик = 0;
	
	// Отчеты конфигурации
	Если Источник = "All" Или Источник = "Configuration" Тогда
		Для Каждого Отчет Из Метаданные.Отчеты Цикл
			Если Не ЭлементВходитВСписок(Аргументы, Отчет, ВРег(ИмяОтчета)) Тогда
				Продолжить;
			КонецЕсли;
			
			Счетчик = Счетчик + 1;
			Результат = Результат + "
			| " + Счетчик + ". " + Отчет.Имя + " (" + Отчет.Синоним + ")";
			
			Если ВключатьОписание Тогда
				Результат = Результат + "
				| Описание: " + Отчет.Комментарий;
				
				// Свойства ОсновнойМакет может не быть, поэтому через ЗаполнитьЗначенияСвойств
				СтруктураОсновнойМакет = Новый Структура("ОсновнойМакет");
				ЗаполнитьЗначенияСвойств(СтруктураОсновнойМакет, Отчет);
				Если СтруктураОсновнойМакет.ОсновнойМакет <> Неопределено Тогда
					Результат = Результат + "
					| Основной макет: " + СтруктураОсновнойМакет.ОсновнойМакет.Имя;
				КонецЕсли;
			КонецЕсли;
			
			Если ВключатьПараметры Тогда
				Результат = Результат + ПрочитатьПараметрыВстроенногоОтчета(Отчет.Имя);
			КонецЕсли;
			
			Результат = Результат + "
			| ------------------------";
		КонецЦикла;
	КонецЕсли;
	
	// Внешние отчеты из справочника ДополнительныеОтчетыИОбработки
	Если (Источник = "All" Или Источник = "External") И ВнешниеОтчетыДоступны(Аргументы) Тогда
		
		Счетчик = ДобавитьВнешниеОтчеты(Результат, ИмяОтчета, ВключатьОписание, ВключатьПараметры, Счетчик);
	КонецЕсли;
	
	Результат = Результат + "
	| Всего отчетов: " + Счетчик;
	
	Возврат Результат;

КонецФункции

// Истина, если справочник внешних отчетов можно читать: он есть в конфигурации, доступен пользователю,
// задавшему вопрос, и читается в этом сеансе. Без токена справочник читается с правами технического
// пользователя публикации, если они у него есть.
//
// Параметры:
//  Аргументы - Структура - аргументы инструмента с контекстом доступа
//
// Возвращаемое значение:
//  Булево
//
Функция ВнешниеОтчетыДоступны(Аргументы)
	
	МетаданныеВнешнихОтчетов = Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки");
	Если МетаданныеВнешнихОтчетов = Неопределено
		Или Не mcp_ДоступПользователей.ДоступноПользователю(Аргументы, МетаданныеВнешнихОтчетов) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ПривилегированныйРежим() Или ПравоДоступа("Чтение", МетаданныеВнешнихОтчетов);
	
КонецФункции

// Читает параметры СКД отчета конфигурации.
Функция ПрочитатьПараметрыВстроенногоОтчета(ИмяОтчета)
	
	Попытка
		ОтчетОбъект = Отчеты[ИмяОтчета].Создать();
		СхемаКД = ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Исключение
		Возврат "
		| Параметры: не удалось получить схему компоновки (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")";
	КонецПопытки;
	
	Если СхемаКД = Неопределено Тогда
		Возврат "
		| Параметры: отчёт не на СКД (нет ОсновнаяСхемаКомпоновкиДанных)";
	КонецЕсли;
	
	Возврат ПрочитатьПараметрыСхемыКД(СхемаКД);
	
КонецФункции

// Список параметров схемы компоновки в виде текста.
// Нужен и для отчетов конфигурации, и для внешних.
Функция ПрочитатьПараметрыСхемыКД(СхемаКД)
	
	Попытка
		Настройки = СхемаКД.НастройкиПоУмолчанию;
		ПараметрыДанных = Настройки.ПараметрыДанных;
	Исключение
		Возврат "
		| Параметры: не удалось прочитать (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")";
	КонецПопытки;
	
	Если ПараметрыДанных.Элементы.Количество() = 0 Тогда
		Возврат "
		| Параметры: нет";
	КонецЕсли;
	
	Текст = "
	| Параметры:";
	Для Каждого Элемент Из ПараметрыДанных.Элементы Цикл
		// Строкой ПараметрКомпоновкиДанных является имя параметра
		ИмяПараметра = Строка(Элемент.Параметр);
		
		ТипПараметра = "";
		Попытка
			ДоступныйПараметр = СхемаКД.Параметры.Найти(Элемент.Параметр);
			Если ДоступныйПараметр <> Неопределено И ДоступныйПараметр.ТипЗначения <> Неопределено Тогда
				ТипПараметра = " [" + Строка(ДоступныйПараметр.ТипЗначения) + "]";
			КонецЕсли;
		Исключение
			// У параметра не задан тип
		КонецПопытки;
		
		Текст = Текст + "
		|   - " + ИмяПараметра + ТипПараметра;
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

// Добавляет к результату внешние отчеты из справочника БСП. Возвращает счетчик.
Функция ДобавитьВнешниеОтчеты(Результат, ИмяОтчета, ВключатьОписание, ВключатьПараметры, Счетчик)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Доп.Ссылка КАК Ссылка,
	|	Доп.Наименование КАК Наименование,
	|	Доп.Вид КАК Вид,
	|	Доп.БезопасныйРежим КАК БезопасныйРежим
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Доп
	|ГДЕ
	|	НЕ Доп.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ЭтоВнешнийОтчет(Выборка.Вид) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяОтчета)
			И СтрНайти(ВРег(Строка(Выборка.Наименование)), ВРег(ИмяОтчета)) = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
		Результат = Результат + "
		| " + Счетчик + ". [Внешний отчет] " + Выборка.Наименование;
		
		Если ВключатьОписание Тогда
			ПометкаРежима = ?(Выборка.БезопасныйРежим, "безопасный режим включён", "безопасный режим выключен");
			Результат = Результат + "
			| Подключение: " + ПометкаРежима;
		КонецЕсли;
		
		// Внешний отчет в безопасном режиме подключить нельзя, параметры не читаем
		Если ВключатьПараметры Тогда
			Если Выборка.БезопасныйРежим Тогда
				Результат = Результат + "
				| Параметры: пропущены (безопасный режим включён, подключение не выполняется)";
			Иначе
				Результат = Результат + ПрочитатьПараметрыВнешнегоОтчета(Выборка.Ссылка);
			КонецЕсли;
		КонецЕсли;
		
		Результат = Результат + "
		| ------------------------";
		
	КонецЦикла;
	
	Возврат Счетчик;
	
КонецФункции

// Подключает внешний отчет из хранилища справочника и читает параметры его СКД.
// Вызывается только для отчетов, у которых выключен безопасный режим.
Функция ПрочитатьПараметрыВнешнегоОтчета(СсылкаОтчета)
	
	Попытка
		// Подключение средствами БСП: учитываются безопасный режим и профиль безопасности,
		// заданные для дополнительного отчета в справочнике
		ОтчетОбъект = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(СсылкаОтчета);
		СхемаКД = ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Исключение
		Возврат "
		| Параметры: не удалось подключить внешний отчёт (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")";
	КонецПопытки;
	
	Если СхемаКД = Неопределено Тогда
		Возврат "
		| Параметры: внешний отчёт не на СКД";
	КонецЕсли;
	
	Возврат ПрочитатьПараметрыСхемыКД(СхемаКД);
	
КонецФункции

// Без перечисления видов (старая БСП) считаем запись отчетом
Функция ЭтоВнешнийОтчет(Вид)
	
	Попытка
		Возврат Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.Отчет
			Или Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет;
	Исключение
		Возврат Истина;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнструментПримерыЗапросовОтчетов

// Описывает инструмент find_report_queries: тексты запросов из схем компоновки отчетов конфигурации как
// образцы для модели, которая пишет свой запрос.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - см. mcp_Метаданные.ТаблицаИнструментов
//
Процедура ДобавитьИнструментПримерыЗапросовОтчетов(Инструменты)

	МассивПараметров = Новый Массив;
	ОписаниеСлов = "Слова для поиска через пробел: имя регистра, документа или справочника, тема отчета "
		+ "(например: ТоварыНаСкладах остатки)";
	ДобавитьПараметр(МассивПараметров, "keywords", "string", ОписаниеСлов, , Истина);
	ДобавитьПараметр(МассивПараметров, "maxItems", "number", "Сколько запросов вернуть, от 1 до 3", 1);

	Описание = "Поиск готовых запросов в отчетах конфигурации: образец, по которому составить свой запрос "
		+ "для run_query";
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	mcp_Метаданные.ДобавитьИнструмент(Инструменты, "find_report_queries", Описание, СхемаПараметров);

КонецПроцедуры

// Находит запросы наборов данных отчетов, в имени, синониме или тексте которых есть слова поиска. Первыми
// идут запросы с большим числом совпавших слов, при равенстве - более короткие: они проще как образец.
// Отчеты, недоступные пользователю, не просматриваются.
//
// Параметры:
//  Аргументы - Структура - keywords, maxItems и контекст доступа
//
// Возвращаемое значение:
//  Строка - найденные запросы с именами отчетов и наборов данных
//
Функция ПримерыЗапросовОтчетов(Аргументы)

	Слова = СловаПоиска(Аргументы);
	МаксимумОбразцов = МаксимумОбразцовЗапросов();
	Лимит = mcp_ЗапросыМодели.ЧислоИзАргументов(Аргументы, "maxItems", 1, 1, МаксимумОбразцов);

	Найденные = Новый ТаблицаЗначений;
	Найденные.Колонки.Добавить("Отчет");
	Найденные.Колонки.Добавить("Набор");
	Найденные.Колонки.Добавить("Текст");
	Найденные.Колонки.Добавить("Совпадений");
	Найденные.Колонки.Добавить("Длина");

	ДоступностьОтчетов = Новый Соответствие;
	Для Каждого Образец Из mcp_КонтейнерыПовтИсп.ЗапросыОтчетов() Цикл
		Если Не ОтчетДоступен(Аргументы, Образец.Отчет, ДоступностьОтчетов) Тогда
			Продолжить;
		КонецЕсли;
		Совпадений = ЧислоСовпадений(Образец, Слова);
		Если Совпадений > 0 Тогда
			НоваяСтрока = Найденные.Добавить();
			НоваяСтрока.Отчет      = СтрШаблон("%1 (%2)", Образец.Отчет, Образец.Синоним);
			НоваяСтрока.Набор      = Образец.Набор;
			НоваяСтрока.Текст      = Образец.Текст;
			НоваяСтрока.Совпадений = Совпадений;
			НоваяСтрока.Длина      = СтрДлина(Образец.Текст);
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(Найденные) Тогда
		СловаСтрокой = СтрСоединить(Слова, " ");
		Возврат СтрШаблон("Запросов в отчетах по словам ""%1"" не найдено. Попробуйте имя регистра или документа.",
			СловаСтрокой);
	КонецЕсли;

	Найденные.Сортировать("Совпадений Убыв, Длина Возр");
	Возврат ТекстОбразцов(Найденные, Лимит);

КонецФункции

// Истина, если отчет доступен пользователю. Результат проверки запоминается: у отчета бывает несколько
// наборов данных.
//
// Параметры:
//  Аргументы          - Структура - контекст доступа
//  ИмяОтчета          - Строка
//  ДоступностьОтчетов - Соответствие - ключ: имя отчета, значение: Булево
//
// Возвращаемое значение:
//  Булево
//
Функция ОтчетДоступен(Аргументы, ИмяОтчета, ДоступностьОтчетов)

	Доступен = ДоступностьОтчетов.Получить(ИмяОтчета);
	Если Доступен = Неопределено Тогда
		МетаданныеОтчета = Метаданные.Отчеты[ИмяОтчета];
		Доступен = mcp_ДоступПользователей.ДоступноПользователю(Аргументы, МетаданныеОтчета);
		ДоступностьОтчетов.Вставить(ИмяОтчета, Доступен);
	КонецЕсли;

	Возврат Доступен;

КонецФункции

// Сколько слов поиска есть в имени, синониме или тексте запроса отчета.
//
// Параметры:
//  Образец - ФиксированнаяСтруктура - см. mcp_КонтейнерыПовтИсп.ЗапросыОтчетов
//  Слова   - Массив из Строка - слова в верхнем регистре
//
// Возвращаемое значение:
//  Число
//
Функция ЧислоСовпадений(Образец, Слова)

	ГдеИскать = ВРег(Образец.Отчет + " " + Образец.Синоним + " " + Образец.Текст);
	Совпадений = 0;
	Для Каждого Слово Из Слова Цикл
		Если СтрНайти(ГдеИскать, Слово) > 0 Тогда
			Совпадений = Совпадений + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Совпадений;

КонецФункции

// Текст ответа: первые запросы из найденных, длинные сокращаются.
//
// Параметры:
//  Найденные - ТаблицаЗначений - отсортированные запросы
//  Лимит     - Число - сколько запросов вывести
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстОбразцов(Найденные, Лимит)

	ДлинаОбразца = 1800;
	Количество = Мин(Лимит, Найденные.Количество());
	Части = Новый Массив;
	Для Индекс = 0 По Количество - 1 Цикл
		Найденная = Найденные[Индекс];
		Текст = Найденная.Текст;
		Если СтрДлина(Текст) > ДлинаОбразца Тогда
			Текст = Лев(Текст, ДлинаОбразца) + Символы.ПС + "... (запрос сокращен)";
		КонецЕсли;
		Части.Добавить(СтрШаблон("Отчет %1, набор данных %2:%3%4", Найденная.Отчет, Найденная.Набор, Символы.ПС, Текст));
	КонецЦикла;

	Возврат СтрСоединить(Части, Символы.ПС + Символы.ПС);

КонецФункции

// Слова поиска из аргумента keywords в верхнем регистре.
//
// Параметры:
//  Аргументы - Структура - аргументы инструмента
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция СловаПоиска(Аргументы)

	ТекстПоиска = "";
	Если Аргументы.Свойство("keywords") Тогда
		ТекстПоиска = СтрЗаменить(Строка(Аргументы.keywords), ",", " ");
	КонецЕсли;

	Слова = Новый Массив;
	Для Каждого Слово Из СтрРазделить(ТекстПоиска, " ", Ложь) Цикл
		Слово = ВРег(СокрЛП(Слово));
		Если ЗначениеЗаполнено(Слово) И Слова.Найти(Слово) = Неопределено Тогда
			Слова.Добавить(Слово);
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(Слова) Тогда
		ВызватьИсключение "Не заданы слова поиска (keywords), например: ТоварыНаСкладах остатки";
	КонецЕсли;

	Возврат Слова;

КонецФункции

// Наибольшее число запросов, которое возвращает find_report_queries: ответ инструмента оркестратор
// сокращает до 2500 символов.
//
// Возвращаемое значение:
//  Число
//
Функция МаксимумОбразцовЗапросов()

	Возврат 3;

КонецФункции

#КонецОбласти

#Область ИнструментПроверкаЗапроса

// Описывает инструмент validate_query: проверка запроса без чтения данных.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - см. mcp_Метаданные.ТаблицаИнструментов
//
Процедура ДобавитьИнструментПроверкаЗапроса(Инструменты)

	МассивПараметров = Новый Массив;
	ОписаниеЗапроса = "Текст запроса на языке запросов 1С (ВЫБРАТЬ ... ИЗ ...), параметры задаются как &Имя";
	ДобавитьПараметр(МассивПараметров, "query", "string", ОписаниеЗапроса, , Истина);

	Описание = "Проверка запроса 1С без чтения данных: синтаксис, имена таблиц и полей, права пользователя. "
		+ "Возвращает таблицы, колонки результата и параметры запроса с типами";
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	mcp_Метаданные.ДобавитьИнструмент(Инструменты, "validate_query", Описание, СхемаПараметров);

КонецПроцедуры

// Проверяет запрос: разбирает текст, проверяет права пользователя на таблицы и поля, читаемые через
// точку. Данные не читаются.
//
// Параметры:
//  Аргументы - Структура - query и контекст доступа
//
// Возвращаемое значение:
//  Строка - JSON: ok, tables, columns, parameters
//
Функция ПроверкаЗапроса(Аргументы)

	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(mcp_ЗапросыМодели.ПроверитьЗапрос(Аргументы));

КонецФункции

#КонецОбласти

#Область ИнструментВыполнениеЗапроса

// Описывает инструмент run_query: выполнение запроса только на чтение с проверкой прав пользователя.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - см. mcp_Метаданные.ТаблицаИнструментов
//
Процедура ДобавитьИнструментВыполнениеЗапроса(Инструменты)

	МассивПараметров = Новый Массив;
	ДобавитьПараметр(МассивПараметров, "query", "string",
		"Текст запроса на языке запросов 1С, проверенный через validate_query", , Истина);

	ОписаниеПараметров = "Значения параметров &Имя, например {""НачалоПериода"": ""2026-01-01"", "
		+ """Склад"": ""Основной склад""}. Даты - ГГГГ-ММ-ДД, ссылку можно задать наименованием, кодом "
		+ "или номером документа";
	ДобавитьПараметр(МассивПараметров, "parameters", "object", ОписаниеПараметров);

	ОписаниеСтрок = СтрШаблон("Сколько строк результата вернуть, не больше %1",
		mcp_ЗапросыМодели.МаксимумСтрокРезультата());
	ДобавитьПараметр(МассивПараметров, "maxRows", "number", ОписаниеСтрок,
		mcp_ЗапросыМодели.СтрокРезультатаПоУмолчанию());
	ДобавитьПараметр(МассивПараметров, "offset", "number",
		"Сколько первых строк пропустить: следующая страница результата, если truncated = true", 0);

	Описание = "Выполнение запроса 1С только на чтение с правами пользователя: возвращает колонки и строки "
		+ "результата. Язык запросов 1С: ВЫБРАТЬ [ПЕРВЫЕ n] Т.Поле КАК Имя ИЗ Справочник.Имя КАК Т [ГДЕ ...] "
		+ "[СГРУППИРОВАТЬ ПО ...] [УПОРЯДОЧИТЬ ПО ...]; агрегаты КОЛИЧЕСТВО(), СУММА(), МАКСИМУМ(), МИНИМУМ()";
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	mcp_Метаданные.ДобавитьИнструмент(Инструменты, "run_query", Описание, СхемаПараметров);

КонецПроцедуры

// Выполняет запрос модели с постраничной выдачей, см. mcp_ЗапросыМодели.ВыполнитьЗапрос.
//
// Параметры:
//  Аргументы - Структура - query, parameters, maxRows, offset и контекст доступа
//
// Возвращаемое значение:
//  Строка - JSON: columns, rows, rowCount, truncated, offset; у пакета еще batchResults
//
Функция ВыполнениеЗапроса(Аргументы)

	МаксимумСтрок = mcp_ЗапросыМодели.ЧислоИзАргументов(Аргументы, "maxRows",
		mcp_ЗапросыМодели.СтрокРезультатаПоУмолчанию(), 1, mcp_ЗапросыМодели.МаксимумСтрокРезультата());
	Пропустить = mcp_ЗапросыМодели.ЧислоИзАргументов(Аргументы, "offset", 0, 0,
		mcp_ЗапросыМодели.МаксимумСмещения());
	Результат = mcp_ЗапросыМодели.ВыполнитьЗапрос(Аргументы, Пропустить, МаксимумСтрок);
	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(Результат);

КонецФункции

#КонецОбласти

#Область ВспомогательныеФункции

// Добавляет описание параметра инструмента в массив параметров.
//
// Параметры:
//  МассивПараметров - Массив - см. mcp_Метаданные.ПараметрИнструмента
//  Имя              - Строка
//  Тип              - Строка - string, number, object
//  Описание         - Строка
//  ПоУмолчанию      - Произвольный - значение по умолчанию
//  Обязательный     - Булево
//
Процедура ДобавитьПараметр(МассивПараметров, Имя, Тип, Описание, ПоУмолчанию = Неопределено, Обязательный = Ложь)

	Параметр = mcp_Метаданные.ПараметрИнструмента(Имя, Тип, Описание, ПоУмолчанию, Обязательный);
	МассивПараметров.Добавить(Параметр);

КонецПроцедуры

