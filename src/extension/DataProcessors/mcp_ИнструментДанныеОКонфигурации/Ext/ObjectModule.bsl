#Область Переменные

Перем ЯзыкСинтаксиса;

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция ОписаниеСтруктурыОбъектаМетаданных(МетаданныеОбъекта) Экспорт

	ЯзыкСинтаксиса = ?(
		Метаданные.ВариантВстроенногоЯзыка = Метаданные.СвойстваОбъектов.ВариантВстроенногоЯзыка.Английский,
		"en",
		"ru");
	
	МассивСтрок = Новый Массив;
	
	// Заголовок объекта
	МетаТип = СтрРазделить(МетаданныеОбъекта.ПолноеИмя(), ".")[0];
	ВывестиЗаголовокОбъектаМетаданных(МассивСтрок, МетаданныеОбъекта, МетаТип);
	
	СтруктураСтандартныеРеквизиты = Новый Структура("СтандартныеРеквизиты");
	ЗаполнитьЗначенияСвойств(СтруктураСтандартныеРеквизиты, МетаданныеОбъекта);
	Если СтруктураСтандартныеРеквизиты.СтандартныеРеквизиты <> Неопределено Тогда
		ВывестиСписокРеквизитовМетаданных(МассивСтрок, МетаданныеОбъекта.СтандартныеРеквизиты, НСтр("ru='Стандартные реквизиты';en='Standard attributes'"));
	КонецЕсли;

	// Обработка измерений и ресурсов для регистров
	ЭтоРегистр = ЭтоРегистрМД(МетаданныеОбъекта);
	Если ЭтоРегистр Тогда
		ВывестиСписокРеквизитовМетаданных(МассивСтрок, МетаданныеОбъекта.Измерения, НСтр("ru='Измерения';en='Dimensions'"));
		ВывестиСписокРеквизитовМетаданных(МассивСтрок, МетаданныеОбъекта.Ресурсы, НСтр("ru='Ресурсы';en='Resources'"));
	КонецЕсли;
	
	ВывестиСписокРеквизитовМетаданных(МассивСтрок, МетаданныеОбъекта.Реквизиты, НСтр("ru='Реквизиты';en='Attributes'"));

	Если Метаданные.Справочники.Содержит(МетаданныеОбъекта) И МетаданныеОбъекта.Владельцы.Количество() > 0 Тогда
		ВывестиВладельцевМетаданных(МассивСтрок, МетаданныеОбъекта);
	КонецЕсли;
	
	Если Не ЭтоРегистр Тогда
		ВывестиТабличныеЧастиМетаданных(МассивСтрок, МетаданныеОбъекта.ТабличныеЧасти);
	КонецЕсли;
	
	// Объединяем строки через символ перевода строки
	Результат = СтрСоединить(МассивСтрок, Символы.ПС);
	
	Возврат Результат;

КонецФункции

Функция НайтиОбъектМетаданных(ТипОбъекта, ИмяОбъекта) Экспорт
	Попытка
		Коллекция = Метаданные[ТипОбъекта];
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	// 1) Точный поиск по имени (штатный, без учёта регистра).
	Объект = Коллекция.Найти(ИмяОбъекта);
	Если Объект <> Неопределено Тогда
		Возврат Объект;
	КонецЕсли;

	// 2) ДОБАВЛЕНО: запасной поиск по синониму и по имени без пробелов.
	// LLM нередко передаёт синоним ("Перемещение товаров") вместо имени
	// ("ПеремещениеТоваров"). Сначала пробуем сжать пробелы, затем сверяем синоним.
	ИмяБезПробелов = СтрЗаменить(ИмяОбъекта, " ", "");
	Если ИмяБезПробелов <> ИмяОбъекта Тогда
		Объект = Коллекция.Найти(ИмяБезПробелов);
		Если Объект <> Неопределено Тогда
			Возврат Объект;
		КонецЕсли;
	КонецЕсли;

	ИскомоеВРег = ВРег(СокрЛП(ИмяОбъекта));
	Для Каждого ЭлементКоллекции Из Коллекция Цикл
		Если ВРег(ЭлементКоллекции.Синоним) = ИскомоеВРег Тогда
			Возврат ЭлементКоллекции;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;
КонецФункции

Процедура СобратьИспользуемыеОбъекты(ОбъектМД, Uses) Экспорт
	
	// --- Реквизиты ---
	Если ЕстьСвойство(ОбъектМД, "Реквизиты") Тогда
		Для Каждого Рекв Из ОбъектМД.Реквизиты Цикл
			ДобавитьОбъектыИзТипа(Рекв.Тип, Uses, "Реквизит." + Рекв.Имя);
		КонецЦикла;
	КонецЕсли;
	
	// --- Табличные части ---
	Если ЕстьСвойство(ОбъектМД, "ТабличныеЧасти") Тогда
		Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
			Для Каждого РеквТЧ Из ТЧ.Реквизиты Цикл
				ДобавитьОбъектыИзТипа(РеквТЧ.Тип, Uses, "ТабЧасть." + ТЧ.Имя + "." + РеквТЧ.Имя);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	// --- Измерения, ресурсы, реквизиты адресации (для регистров) ---
	ЭтоРегистр = ЭтоРегистрМД(ОбъектМД);
	Если ЭтоРегистр Тогда
		Если ЕстьСвойство(ОбъектМД, "Измерения") Тогда
			Для Каждого Изм Из ОбъектМД.Измерения Цикл
				ДобавитьОбъектыИзТипа(Изм.Тип, Uses, "Измерение." + Изм.Имя);
			КонецЦикла;
		КонецЕсли;
		Если ЕстьСвойство(ОбъектМД, "Ресурсы") Тогда
			Для Каждого Рес Из ОбъектМД.Ресурсы Цикл
				ДобавитьОбъектыИзТипа(Рес.Тип, Uses, "Ресурс." + Рес.Имя);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	                                                                                             
	// --- Документ: движения по регистрам ---
	// ИСПРАВЛЕНО: у метаданных документа свойства "Регистры" нет — движения
	// лежат в коллекции "Движения" (тип КоллекцияЗначенийСвойствОбъектовМетаданных).
	// Подтверждено документацией по метаданным платформы.
	Если Метаданные.Документы.Содержит(ОбъектМД) Тогда
		Для Каждого Регистр Из ОбъектМД.Движения Цикл
			ДобавитьЗаписьСвязи(Регистр.ПолноеИмя(), "RegisterRecord", "Движения по регистру", Uses);
		КонецЦикла;
	КонецЕсли;
	
	// --- Справочник: владельцы (для подчинённого справочника) ---
	// ДОБАВЛЕНО: владельцы — объекты, которым подчинён справочник.
	// Свойство .Владельцы подтверждено рабочим кодом (ВывестиВладельцевМетаданных).
	Если ЕстьСвойство(ОбъектМД, "Владельцы") Тогда
		Для Каждого Владелец Из ОбъектМД.Владельцы Цикл
			ДобавитьЗаписьСвязи(Владелец.ПолноеИмя(), "Owner", "Владелец справочника", Uses);
		КонецЦикла;
	КонецЕсли;
	
	// --- План обмена: состав ---
	Если Метаданные.ПланыОбмена.Содержит(ОбъектМД) Тогда
		Для Каждого ЭлементСостава Из ОбъектМД.Состав Цикл
			ДобавитьЗаписьСвязи(Строка(ЭлементСостава.Метаданные), "ExchangePlanComposition", "Состав плана обмена", Uses);
		КонецЦикла;
	КонецЕсли;
	
	// --- Подписка на событие: источник ---
	Если Метаданные.ПодпискиНаСобытия.Содержит(ОбъектМД) Тогда
		Источник = ОбъектМД.Источник;
		Если Источник <> Неопределено Тогда
			ДобавитьЗаписьСвязи(Строка(Источник), "EventSource", "Источник события", Uses);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры  

Процедура СобратьИспользующиеОбъекты(ОбъектМД, UsedBy, СписокТипов = Неопределено, ИмяПодсистемы = "") Экспорт
	
	ПолноеИмяИскомого = ОбъектМД.ПолноеИмя();
	
	// Карта "имя коллекции (англ., как в objectType) -> коллекция метаданных".
	// Позволяет фильтровать область поиска по типам, переданным в СписокТипов.
	СоответствиеКоллекций = Новый Соответствие;
	СоответствиеКоллекций.Вставить("Catalogs", Метаданные.Справочники);
	СоответствиеКоллекций.Вставить("Documents", Метаданные.Документы);
	СоответствиеКоллекций.Вставить("InformationRegisters", Метаданные.РегистрыСведений);
	СоответствиеКоллекций.Вставить("AccumulationRegisters", Метаданные.РегистрыНакопления);
	СоответствиеКоллекций.Вставить("AccountingRegisters", Метаданные.РегистрыБухгалтерии);
	СоответствиеКоллекций.Вставить("CalculationRegisters", Метаданные.РегистрыРасчета);
	СоответствиеКоллекций.Вставить("ChartsOfCharacteristicTypes", Метаданные.ПланыВидовХарактеристик);
	СоответствиеКоллекций.Вставить("ChartsOfAccounts", Метаданные.ПланыСчетов);
	СоответствиеКоллекций.Вставить("ChartsOfCalculationTypes", Метаданные.ПланыВидовРасчета);
	СоответствиеКоллекций.Вставить("BusinessProcesses", Метаданные.БизнесПроцессы);
	СоответствиеКоллекций.Вставить("Tasks", Метаданные.Задачи);
	СоответствиеКоллекций.Вставить("ExchangePlans", Метаданные.ПланыОбмена);
	СоответствиеКоллекций.Вставить("EventSubscriptions", Метаданные.ПодпискиНаСобытия);
	
	// Формируем список коллекций для обхода с учётом фильтра типов.
	КоллекцииМД = Новый Массив;
	Если СписокТипов = Неопределено Или СписокТипов.Количество() = 0 Тогда
		// Без фильтра — все коллекции.
		Для Каждого КлючЗначение Из СоответствиеКоллекций Цикл
			КоллекцииМД.Добавить(КлючЗначение.Значение);
		КонецЦикла;
	Иначе
		// Только указанные типы (имена коллекций как в objectType).
		Для Каждого ТипСтр Из СписокТипов Цикл
			Коллекция = СоответствиеКоллекций.Получить(СокрЛП(ТипСтр));
			Если Коллекция <> Неопределено Тогда
				КоллекцииМД.Добавить(Коллекция);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Фильтр по подсистеме: заранее находим объект подсистемы (если задан).
	ОбъектПодсистемы = Неопределено;
	Если ЗначениеЗаполнено(ИмяПодсистемы) Тогда
		ОбъектПодсистемы = НайтиПодсистемуПоИмени(Метаданные.Подсистемы, ИмяПодсистемы);
	КонецЕсли;
	
	Для Каждого Коллекция Из КоллекцииМД Цикл
		Для Каждого ПроверяемыйОбъект Из Коллекция Цикл
			
			Если ПроверяемыйОбъект.ПолноеИмя() = ПолноеИмяИскомого Тогда
				Продолжить;
			КонецЕсли;
			
			// Фильтр по подсистеме: пропускаем объекты вне указанной подсистемы.
			Если ОбъектПодсистемы <> Неопределено
				И Не ОбъектВходитВПодсистему(ПроверяемыйОбъект, ОбъектПодсистемы) Тогда
				Продолжить;
			КонецЕсли;
			
			// Реквизиты
			Если ЕстьСвойство(ПроверяемыйОбъект, "Реквизиты") Тогда
				Для Каждого Рекв Из ПроверяемыйОбъект.Реквизиты Цикл
					Если ТипСодержитОбъект(Рекв.Тип, ПолноеИмяИскомого) Тогда
						ДобавитьЗаписьСвязи(ПроверяемыйОбъект.ПолноеИмя(), "Usage", "Реквизит." + Рекв.Имя, UsedBy);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			// Табличные части
			Если ЕстьСвойство(ПроверяемыйОбъект, "ТабличныеЧасти") Тогда
				Для Каждого ТЧ Из ПроверяемыйОбъект.ТабличныеЧасти Цикл
					Для Каждого РеквТЧ Из ТЧ.Реквизиты Цикл
						Если ТипСодержитОбъект(РеквТЧ.Тип, ПолноеИмяИскомого) Тогда
							ДобавитьЗаписьСвязи(ПроверяемыйОбъект.ПолноеИмя(), "Usage", "ТабЧасть." + ТЧ.Имя + "." + РеквТЧ.Имя, UsedBy);
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
			
			// Измерения, ресурсы (для регистров)
			Если ЭтоРегистрМД(ПроверяемыйОбъект) Тогда
				Если ЕстьСвойство(ПроверяемыйОбъект, "Измерения") Тогда
					Для Каждого Изм Из ПроверяемыйОбъект.Измерения Цикл
						Если ТипСодержитОбъект(Изм.Тип, ПолноеИмяИскомого) Тогда
							ДобавитьЗаписьСвязи(ПроверяемыйОбъект.ПолноеИмя(), "Usage", "Измерение." + Изм.Имя, UsedBy);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если ЕстьСвойство(ПроверяемыйОбъект, "Ресурсы") Тогда
					Для Каждого Рес Из ПроверяемыйОбъект.Ресурсы Цикл
						Если ТипСодержитОбъект(Рес.Тип, ПолноеИмяИскомого) Тогда
							ДобавитьЗаписьСвязи(ПроверяемыйОбъект.ПолноеИмя(), "Usage", "Ресурс." + Рес.Имя, UsedBy);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
			// Документ, делающий движения по искомому регистру
			Если Метаданные.Документы.Содержит(ПроверяемыйОбъект)
				И ПроверяемыйОбъект.Движения.Содержит(ОбъектМД) Тогда
				ДобавитьЗаписьСвязи(ПроверяемыйОбъект.ПолноеИмя(), "RegisterRecord", "Регистратор", UsedBy);
			КонецЕсли;
			
			// Состав плана обмена
			Если Метаданные.ПланыОбмена.Содержит(ПроверяемыйОбъект) Тогда
				Если ПроверяемыйОбъект.Состав.Найти(ОбъектМД) <> Неопределено Тогда 
					ДобавитьЗаписьСвязи(ПроверяемыйОбъект.ПолноеИмя(), "Usage", "Состав плана обмена", UsedBy);
				КонецЕсли;
			КонецЕсли;
			
			// Источник подписки
			// ИСПРАВЛЕНО: было ошибочное условие
			//   ПроверяемыйОбъект.ПолноеИмя() = ПолноеИмяИскомого
			// (требовало, чтобы сама подписка равнялась искомому объекту — невозможно,
			// такие уже отсеяны через Продолжить выше). Из-за этого подписки никогда
			// не попадали в usedBy. Теперь проверяем, что ИСТОЧНИКОМ подписки является
			// искомый объект, через ТипСодержитОбъект (Источник — описание типов).
			Если Метаданные.ПодпискиНаСобытия.Содержит(ПроверяемыйОбъект) Тогда
				Источник = ПроверяемыйОбъект.Источник;
				Если Источник <> Неопределено И ТипСодержитОбъект(Источник, ПолноеИмяИскомого) Тогда
					ДобавитьЗаписьСвязи(ПроверяемыйОбъект.ПолноеИмя(), "Usage", "Источник события", UsedBy);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	// --- Подсистемы: в составе каких подсистем числится объект ---
	// ВНИМАНИЕ (не подтверждено по синтакс-помощнику отдельно): Подсистема.Состав
	// и метод .Содержит(ОбъектМД). Обёрнуто в Попытку: при отсутствии/ином имени
	// свойства ветка пропускается, без падения. Проверь в синтакс-помощнике.
	СобратьПодсистемыИспользующие(ОбъектМД, UsedBy);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, есть ли у объекта (в том числе объекта метаданных) свойство с указанным именем
//
// Параметры:
//  Объект - Произвольный - проверяемый объект
//  ИмяСвойства - Строка - имя свойства
//
// Возвращаемое значение:
//  Булево - Истина, если свойство есть
//
Функция ЕстьСвойство(Объект, ИмяСвойства)
	
	Маркер = Новый УникальныйИдентификатор;
	Проверка = Новый Структура(ИмяСвойства, Маркер);
	ЗаполнитьЗначенияСвойств(Проверка, Объект);
	
	Возврат Проверка[ИмяСвойства] <> Маркер;
	
КонецФункции

// Рекурсивный поиск подсистемы по имени (включая вложенные).
Функция НайтиПодсистемуПоИмени(КоллекцияПодсистем, ИмяПодсистемы)
	ИскомоеВРег = ВРег(СокрЛП(ИмяПодсистемы));
	Для Каждого Подсистема Из КоллекцияПодсистем Цикл
		Если ВРег(Подсистема.Имя) = ИскомоеВРег Тогда
			Возврат Подсистема;
		КонецЕсли;
		Найденная = НайтиПодсистемуПоИмени(Подсистема.Подсистемы, ИмяПодсистемы);
		Если Найденная <> Неопределено Тогда
			Возврат Найденная;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Проверяет, входит ли объект в подсистему (рекурсивно, с учётом вложенных).
// Свойство .Состав и метод .Содержит обёрнуты в Попытку (см. примечание ниже).
Функция ОбъектВходитВПодсистему(ОбъектМетаданных, Подсистема)
	Попытка
		Если Подсистема.Состав.Содержит(ОбъектМетаданных) Тогда
			Возврат Истина;
		КонецЕсли;
		Для Каждого Вложенная Из Подсистема.Подсистемы Цикл
			Если ОбъектВходитВПодсистему(ОбъектМетаданных, Вложенная) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	Исключение
		// .Состав/.Содержит недоступны в этой версии — считаем, что не входит.
	КонецПопытки;
	Возврат Ложь;
КонецФункции

// ДОБАВЛЕНО: обход подсистем с защитой от непроверенного API.
Процедура СобратьПодсистемыИспользующие(ОбъектМД, UsedBy)
	
	Попытка
		Для Каждого Подсистема Из Метаданные.Подсистемы Цикл
			ОбойтиПодсистемуРекурсивно(Подсистема, ОбъектМД, UsedBy);
		КонецЦикла;
	Исключение
		// Свойство Состав/метод Содержит недоступны в этой версии платформы —
		// тихо пропускаем, чтобы не ломать сбор остальных связей.
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбойтиПодсистемуРекурсивно(Подсистема, ОбъектМД, UsedBy)
	
	Если Подсистема.Состав.Содержит(ОбъектМД) Тогда
		ДобавитьЗаписьСвязи(Подсистема.ПолноеИмя(), "Subsystem", "Состав подсистемы", UsedBy);
	КонецЕсли;
	
	// Вложенные подсистемы
	Для Каждого ВложеннаяПодсистема Из Подсистема.Подсистемы Цикл
		ОбойтиПодсистемуРекурсивно(ВложеннаяПодсистема, ОбъектМД, UsedBy);
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоРегистрМД(МетаданныеОбъекта)

	Возврат Метаданные.РегистрыБухгалтерии.Содержит(МетаданныеОбъекта)
		ИЛИ Метаданные.РегистрыНакопления.Содержит(МетаданныеОбъекта)
		ИЛИ Метаданные.РегистрыРасчета.Содержит(МетаданныеОбъекта)
		ИЛИ Метаданные.РегистрыСведений.Содержит(МетаданныеОбъекта);

КонецФункции

Функция ПолучитьСтрокуТипаМетаданных(ТипРеквизита)

	МассивСтрокТипов = Новый Массив;
	
	Для Каждого Тип Из ТипРеквизита.Типы() Цикл
		ТипМД = Метаданные.НайтиПоТипу(Тип);
		
		Если ТипМД = Неопределено Тогда
			МассивСтрокТипов.Добавить(Строка(Тип));
		Иначе
			СтрокаТипа = ТипМД.ПолноеИмя();
			
			Если Метаданные.Перечисления.Содержит(ТипМД) Тогда
				МассивЗначений = Новый Массив;
				Счетчик = 0;
				Для Каждого ЗначениеПеречисления Из ТипМД.ЗначенияПеречисления Цикл
					Если Счетчик < 10 Тогда
						МассивЗначений.Добавить(ЗначениеПеречисления.Имя);
						Счетчик = Счетчик + 1;
					Иначе
						МассивЗначений.Добавить("...");
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если МассивЗначений.Количество() > 0 Тогда
					СтрокаЗначений = СтрСоединить(МассивЗначений, ", ");
					СтрокаТипа = СтрокаТипа + " (" + СтрокаЗначений + ")";
				КонецЕсли;
			КонецЕсли;
			МассивСтрокТипов.Добавить(СтрокаТипа);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(МассивСтрокТипов, ", ");

КонецФункции

Процедура ВывестиЗаголовокОбъектаМетаданных(МассивСтрок, МетаданныеОбъекта, МетаТип)

	МассивСтрок.Добавить(НСтр("ru='Структура объекта ';en='Object structure '") + МетаТип + "." + МетаданныеОбъекта.Имя + ":");
	МассивСтрок.Добавить(НСтр("ru='Синоним: ';en='Synonym: '") + """" + МетаданныеОбъекта.Синоним + """");
	МассивСтрок.Добавить("");

КонецПроцедуры

Процедура ВывестиСписокРеквизитовМетаданных(МассивСтрок, Реквизиты, ИмяРаздела)

	Если Реквизиты.Количество() > 0 Тогда
		МассивСтрок.Добавить(ИмяРаздела + ":");
		
		Для каждого Реквизит Из Реквизиты Цикл
			ТипРекв_Стр = ПолучитьСтрокуТипаМетаданных(Реквизит.Тип);
			МассивСтрок.Добавить(Символы.Таб + Реквизит.Имя + " - " + ТипРекв_Стр + " - """ + Реквизит.Синоним + """");
		КонецЦикла;
		
		МассивСтрок.Добавить("");
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиТабличныеЧастиМетаданных(МассивСтрок, ТабличныеЧасти)

	Если ТабличныеЧасти.Количество() > 0 Тогда
		МассивСтрок.Добавить(НСтр("ru='Табличные части:';en='Tabular sections:'"));
		
		Для каждого ТабЧасть Из ТабличныеЧасти Цикл
			МассивСтрок.Добавить(Символы.Таб + НСтр("ru='ТЧ ';en='TS '") + """" + ТабЧасть.Имя + """ - """ + ТабЧасть.Синоним + """:");
			
			Для каждого Реквизит Из ТабЧасть.Реквизиты Цикл
				ТипРекв_Стр = ПолучитьСтрокуТипаМетаданных(Реквизит.Тип);
				МассивСтрок.Добавить(Символы.Таб + Символы.Таб + Реквизит.Имя + " - " + ТипРекв_Стр + " - """ + Реквизит.Синоним + """");
			КонецЦикла;
		КонецЦикла;
		
		МассивСтрок.Добавить("");
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиВладельцевМетаданных(МассивСтрок, МетаданныеОбъекта)

	МассивСтрок.Добавить(НСтр("ru='Владельцы:';en='Owners:'"));
	
	Для каждого Владелец Из МетаданныеОбъекта.Владельцы Цикл
		МассивСтрок.Добавить(Символы.Таб + Владелец.ПолноеИмя());
	КонецЦикла;
	
	МассивСтрок.Добавить("");

КонецПроцедуры

Процедура ДобавитьОбъектыИзТипа(ТипЗначения, МассивЗависимостей, Путь)
	
	Попытка
		Типы = ТипЗначения.Типы();
	Исключение
		Возврат;
	КонецПопытки;
	
	Для Каждого Т Из Типы Цикл
		ОбъектПоТипу = Метаданные.НайтиПоТипу(Т);
		Если ОбъектПоТипу <> Неопределено Тогда
			ДобавитьЗаписьСвязи(ОбъектПоТипу.ПолноеИмя(), "Reference", Путь, МассивЗависимостей);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ТипСодержитОбъект(ТипЗначения, ПолноеИмяОбъекта)
	
	Попытка
		Типы = ТипЗначения.Типы();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Для Каждого Т Из Типы Цикл
		ОбъектПоТипу = Метаданные.НайтиПоТипу(Т);
		Если ОбъектПоТипу <> Неопределено И ОбъектПоТипу.ПолноеИмя() = ПолноеИмяОбъекта Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура ДобавитьЗаписьСвязи(ПолноеИмя, ТипСвязи, Путь, МассивКуда)
	
	Запись = Новый Структура;
	Запись.Вставить("object", ПолноеИмя);
	Запись.Вставить("type", ТипСвязи);
	Запись.Вставить("path", Путь);
	МассивКуда.Добавить(Запись);
	
КонецПроцедуры

#КонецОбласти