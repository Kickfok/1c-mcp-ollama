#Область ПрограммныйИнтерфейс

// Выполняет инструмент из таблицы инструментов
//
// Параметры:
//  СтрокаТаблицыИнструментов - СтрокаТаблицыЗначений - строка таблицы инструментов
//  Параметры - Структура - параметры для выполнения инструмента
//
// Возвращаемое значение:
//  Произвольный - результат выполнения инструмента
//
Функция ВыполнитьИнструмент(СтрокаТаблицыИнструментов, Параметры) Экспорт
	
	ИмяОбработки = СтрокаТаблицыИнструментов.ИмяОбработкиКонтейнера;
	ИмяИнструмента = СтрокаТаблицыИнструментов.Имя;
	
	МенеджерОбработки = Обработки[ИмяОбработки];
	
	Возврат МенеджерОбработки.ВыполнитьИнструмент(ИмяИнструмента, Параметры);
	
КонецФункции

// Читает ресурс из таблицы ресурсов
//
// Параметры:
//  СтрокаТаблицыРесурсов - СтрокаТаблицыЗначений - строка таблицы ресурсов
//  Адрес - Строка - адрес ресурса
//
// Возвращаемое значение:
//  Произвольный - содержимое ресурса
//
Функция ПрочитатьРесурс(СтрокаТаблицыРесурсов, Адрес) Экспорт
	
	ИмяОбработки = СтрокаТаблицыРесурсов.ИмяОбработкиКонтейнера;
	
	МенеджерОбработки = Обработки[ИмяОбработки];
	
	Возврат МенеджерОбработки.ПрочитатьРесурс(Адрес);
	
КонецФункции

// Получает промпт из таблицы промптов
//
// Параметры:
//  СтрокаТаблицыПромптов - СтрокаТаблицыЗначений - строка таблицы промптов
//  Имя - Строка - имя промпта
//  Параметры - Структура - параметры для получения промпта
//
// Возвращаемое значение:
//  Произвольный - содержимое промпта
//
Функция ПолучитьПромпт(СтрокаТаблицыПромптов, Имя, Параметры) Экспорт
	
	ИмяОбработки = СтрокаТаблицыПромптов.ИмяОбработкиКонтейнера;
	ИмяПромпта = СтрокаТаблицыПромптов.Имя;
	
	МенеджерОбработки = Обработки[ИмяОбработки];

	Возврат МенеджерОбработки.ПолучитьПромпт(ИмяПромпта, Параметры);

КонецФункции

// Выполняет инструмент по имени от имени пользователя из контекста доступа и возвращает результат в
// формате MCP. Ошибка инструмента не выбрасывается: она возвращается текстом с isError = Истина, чтобы
// модель прочитала причину и исправила аргументы. Вызывается HTTP-сервисом mcp_APIBackend и формой
// вопроса, когда инструмент выполняется в сеансе пользователя.
//
// Параметры:
//  ИмяИнструмента  - Строка - имя инструмента из tools/list
//  Аргументы       - Структура, Произвольный - аргументы инструмента; не структура - без аргументов
//  КонтекстДоступа - Структура - см. mcp_ДоступПользователей.КонтекстДоступа
//
// Возвращаемое значение:
//  Структура:
//   * content - Массив из Структура - элементы содержимого (type, text)
//   * isError - Булево - инструмент завершился ошибкой
//
Функция ВызватьИнструментMCP(ИмяИнструмента, Знач Аргументы, КонтекстДоступа) Экспорт

	Если Не ЗначениеЗаполнено(ИмяИнструмента) Тогда
		ВызватьИсключение "Не указано имя инструмента для вызова";
	КонецЕсли;

	СтрокаИнструмента = mcp_КонтейнерыПовтИсп.Инструменты().Найти(ИмяИнструмента, "Имя");
	Если СтрокаИнструмента = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Инструмент '%1' не найден", ИмяИнструмента);
	КонецЕсли;

	// Контекст доступа задает только сервер: значение, присланное клиентом под этим ключом, заменяется
	Если ТипЗнч(Аргументы) <> Тип("Структура") Тогда
		Аргументы = Новый Структура;
	КонецЕсли;
	Аргументы.Вставить(mcp_ДоступПользователей.ИмяКлючаКонтекста(), КонтекстДоступа);
	mcp_ДоступПользователей.ЗаписатьВызовИнструмента(ИмяИнструмента, КонтекстДоступа);

	ОшибкаПараметров = ОшибкаИменПараметров(СтрокаИнструмента, Аргументы);
	Если ЗначениеЗаполнено(ОшибкаПараметров) Тогда
		Возврат РезультатMCP(ОшибкаПараметров, Истина);
	КонецЕсли;

	Попытка
		РезультатВыполнения = ВыполнитьИнструмент(СтрокаИнструмента, Аргументы);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации("MCP.ОшибкаИнструмента", УровеньЖурналаРегистрации.Ошибка, , ,
			СтрШаблон("%1: %2", ИмяИнструмента, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке)));
		ТекстОшибки = СтрШаблон("Ошибка выполнения инструмента '%1': %2",
			ИмяИнструмента, КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		Возврат РезультатMCP(ТекстОшибки, Истина);
	КонецПопытки;

	Содержимое = Новый Массив;
	Если ТипЗнч(РезультатВыполнения) = Тип("Массив") Тогда
		Для Каждого Элемент Из РезультатВыполнения Цикл
			Если ТипЗнч(Элемент) = Тип("Структура") И Элемент.Свойство("type") Тогда
				Содержимое.Добавить(Элемент);
			Иначе
				Содержимое.Добавить(ТекстовоеСодержимое(Строка(Элемент)));
			КонецЕсли;
		КонецЦикла;
	Иначе
		Содержимое.Добавить(ТекстовоеСодержимое(Строка(РезультатВыполнения)));
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("content", Содержимое);
	Результат.Вставить("isError", Ложь);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Текст отказа, если среди аргументов есть имена, которых нет в схеме параметров инструмента. Без
// отказа параметр с опечаткой молча игнорируется, и модель получает не тот результат, не зная почему.
//
// Параметры:
//  СтрокаИнструмента - СтрокаТаблицыЗначений - см. mcp_Метаданные.ТаблицаИнструментов
//  Аргументы         - Структура - аргументы вызова с контекстом доступа
//
// Возвращаемое значение:
//  Строка - текст отказа; пустая строка, если все имена известны
//
Функция ОшибкаИменПараметров(СтрокаИнструмента, Аргументы)

	Допустимые = Новый Массив;
	Схема = mcp_ОбщегоНазначения.JSONВСтруктуру(СтрокаИнструмента.СхемаПараметров);
	Свойства = Неопределено;
	Если ТипЗнч(Схема) = Тип("Структура") И Схема.Свойство("properties", Свойства)
		И ТипЗнч(Свойства) = Тип("Структура") Тогда
		Для Каждого Свойство Из Свойства Цикл
			Допустимые.Добавить(Свойство.Ключ);
		КонецЦикла;
	КонецЕсли;

	КлючКонтекста = mcp_ДоступПользователей.ИмяКлючаКонтекста();
	Неизвестные = Новый Массив;
	Для Каждого Аргумент Из Аргументы Цикл
		Если Аргумент.Ключ <> КлючКонтекста И Допустимые.Найти(Аргумент.Ключ) = Неопределено Тогда
			Неизвестные.Добавить(Аргумент.Ключ);
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(Неизвестные) Тогда
		Возврат "";
	КонецЕсли;

	Если ЗначениеЗаполнено(Допустимые) Тогда
		ТекстДопустимых = "Допустимые параметры: " + СтрСоединить(Допустимые, ", ") + ".";
	Иначе
		ТекстДопустимых = "У инструмента нет параметров.";
	КонецЕсли;
	Возврат СтрШаблон("Инструмент '%1' не знает параметров: %2. %3 Повтори вызов с правильными именами.",
		СтрокаИнструмента.Имя, СтрСоединить(Неизвестные, ", "), ТекстДопустимых);

КонецФункции

// Результат инструмента в формате MCP из одного текста.
//
// Параметры:
//  Текст         - Строка - текст результата
//  ПризнакОшибки - Булево - isError
//
// Возвращаемое значение:
//  Структура - content, isError
//
Функция РезультатMCP(Текст, ПризнакОшибки)

	Содержимое = Новый Массив;
	Содержимое.Добавить(ТекстовоеСодержимое(Текст));

	Результат = Новый Структура;
	Результат.Вставить("content", Содержимое);
	Результат.Вставить("isError", ПризнакОшибки);
	Возврат Результат;

КонецФункции

// Элемент содержимого MCP с текстом.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Структура - type, text
//
Функция ТекстовоеСодержимое(Текст)

	Элемент = Новый Структура;
	Элемент.Вставить("type", "text");
	Элемент.Вставить("text", Текст);
	Возврат Элемент;

КонецФункции

#КонецОбласти
