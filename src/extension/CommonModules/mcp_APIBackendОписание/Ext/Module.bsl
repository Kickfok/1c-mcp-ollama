#Область ПрограммныйИнтерфейс

// Описание методов HTTP-сервиса mcp_APIBackend для расширения swagger-1c
// (https://github.com/zerobig/swagger-1c). Swagger находит модуль по имени
// "<Имя HTTP-сервиса>Описание". Описание собирается структурами того же состава, что строит
// модуль Swag_ФормированиеОписаний, но без его вызова: без установленного Swagger расширение
// MCP_Сервер компилируется и работает. Имя функции задано swagger-1c.
//
// Возвращаемое значение:
//  Массив из Структура - описание методов; ключ метода - имя шаблона URL и HTTP-метод:
//   * Имя         - Строка - например rpcPOST
//   * Описание    - Структура - краткое (Описание) и подробное (ДетальноеОписание) описание
//   * Параметры   - Массив из Структура - параметры заголовков
//   * Ответы      - Массив из Структура - коды ответа
//   * ТелоЗапроса - Структура, Неопределено - схема тела
//
Функция ПолучитьОписаниеHTTPСервиса() Экспорт // BSLLS:LatinAndCyrillicSymbolInWord-off

	КодУспеха = 200;
	КодМетодНеРазрешен = 405;

	Методы = Новый Массив;

	ПодробноJSONRPC = ОписаниеJSONRPC() + Символы.ПС + Символы.ПС + ОписаниеИнструментов();

	Метод = ОписаниеМетода("rpcPOST",
		"JSON-RPC 2.0: протокол MCP (initialize, tools/list, tools/call, resources, prompts)", ПодробноJSONRPC);
	ЗаполнитьМетодJSONRPC(Метод);
	Методы.Добавить(Метод);

	Метод = ОписаниеМетода("mcpPOST",
		"MCP Streamable HTTP: тот же JSON-RPC, адрес для MCP-клиентов (Cursor, Claude Desktop)", ПодробноJSONRPC);
	ЗаполнитьМетодJSONRPC(Метод);
	Методы.Добавить(Метод);

	Метод = ОписаниеМетода("mcpGET", "Не поддерживается", "");
	Ответ = ОписаниеОтвета(КодМетодНеРазрешен, "Поток событий (SSE) не поддерживается: используйте POST");
	Метод.Ответы.Добавить(Ответ);
	Методы.Добавить(Метод);

	Метод = ОписаниеМетода("healthGET", "Проверка доступности HTTP-сервиса",
		"Не требует токена и не обращается к данным базы.");
	Ответ = ОписаниеОтвета(КодУспеха, "HTTP-сервис работает", ТипJSON("Health"));
	Метод.Ответы.Добавить(Ответ);
	Методы.Добавить(Метод);

	Возврат Методы;

КонецФункции

// Схемы объектов запросов и ответов HTTP-сервиса для раздела components/schemas.
// Имя функции задано swagger-1c.
//
// Возвращаемое значение:
//  Массив из Структура - описания объектов в формате swagger-1c:
//   * Имя              - Строка
//   * Тип              - Строка - тип JSON
//   * МассивСвойств    - Массив из Структура - свойства объекта
//   * ОбязательныеПоля - Строка - имена через запятую
//   * ОписаниеОбъекта  - Строка
//
Функция ПолучитьОбъектыHTTPСервиса() Экспорт // BSLLS:LatinAndCyrillicSymbolInWord-off

	ТипСтрока = "string";
	ТипЦелое  = "integer";
	ТипОбъект = "object";
	ВерсияПротокола = "2.0";
	ПримерИдентификатора = 1;

	Объекты = Новый Массив;

	Методы = СтрРазделить(
		"initialize,tools/list,tools/call,resources/list,resources/read,prompts/list,prompts/get", ",");

	Объект = ОписаниеОбъекта("JsonRpcRequest", "jsonrpc,method", "Запрос JSON-RPC 2.0");
	ДобавитьСвойство(Объект, "jsonrpc", ТипСтрока, "Версия протокола", , ВерсияПротокола);
	ДобавитьСвойство(Объект, "id", ТипЦелое,
		"Идентификатор запроса. Запрос без id - уведомление, ответ 204 без тела", , ПримерИдентификатора);
	ДобавитьСвойство(Объект, "method", ТипСтрока, "Метод MCP", , "tools/call", Методы);
	ДобавитьСвойство(Объект, "params", ТипОбъект,
		"Параметры метода. Для tools/call - объект ToolCallParams", "ToolCallParams");
	Объекты.Добавить(Объект);

	Объект = ОписаниеОбъекта("ToolCallParams", "name", "Параметры вызова инструмента");
	ДобавитьСвойство(Объект, "name", ТипСтрока, "Имя инструмента из tools/list", , "get_configuration_version");
	ДобавитьСвойство(Объект, "arguments", ТипОбъект, "Аргументы по inputSchema инструмента");
	Объекты.Добавить(Объект);

	Объект = ОписаниеОбъекта("JsonRpcResponse", "jsonrpc,id",
		"Ответ JSON-RPC 2.0: заполнено либо result, либо error");
	ДобавитьСвойство(Объект, "jsonrpc", ТипСтрока, "Версия протокола", , ВерсияПротокола);
	ДобавитьСвойство(Объект, "id", ТипЦелое, "Идентификатор из запроса", , ПримерИдентификатора);
	ДобавитьСвойство(Объект, "result", ТипОбъект,
		"Результат метода. У tools/call - content (массив блоков type/text) и признак isError");
	ДобавитьСвойство(Объект, "error", ТипОбъект, "Ошибка, если метод не выполнен", "JsonRpcError");
	Объекты.Добавить(Объект);

	Коды = Новый Массив;
	Для Каждого Код Из КодыОшибок() Цикл
		Коды.Добавить(Код.Код);
	КонецЦикла;
	Объект = ОписаниеОбъекта("JsonRpcError", "code,message", "Ошибка JSON-RPC");
	ДобавитьСвойство(Объект, "code", ТипЦелое, "Код ошибки", , Коды[Коды.ВГраница()], Коды);
	ДобавитьСвойство(Объект, "message", ТипСтрока, "Текст ошибки для пользователя", ,
		"Доступ запрещен: срок действия токена истек");
	Объекты.Добавить(Объект);

	Объект = ОписаниеОбъекта("Health", "status", "Ответ проверки доступности");
	ДобавитьСвойство(Объект, "status", ТипСтрока, "Состояние сервиса", , "ok");
	Объекты.Добавить(Объект);

	Возврат Объекты;

КонецФункции

// Общее описание HTTP-сервиса для заголовка раздела в Swagger. Имя функции задано swagger-1c.
//
// Возвращаемое значение:
//  Структура:
//   * Описание - Строка - текст раздела
//
Функция ПолучитьОбщиеНастройки() Экспорт

	Описание =
	"MCP-сервер 1С: инструменты чтения метаданных и данных базы для LLM по протоколу
	|Model Context Protocol (JSON-RPC 2.0). Права проверяются по пользователю 1С из токена
	|в заголовке X-MCP-Token; ограничения доступа на уровне записей (RLS) не применяются.";

	Возврат Новый Структура("Описание", Описание);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подробное описание JSON-RPC: проверка доступа и коды ошибок.
//
// Возвращаемое значение:
//  Строка - текст в разметке Markdown
//
Функция ОписаниеJSONRPC()

	Строки = Новый Массив;
	Строки.Добавить("**Доступ.** Вызов `tools/call` проверяет пользователя 1С по токену из заголовка "
		+ "`X-MCP-Token`: токен вопроса выпускает форма 1С на время ответа модели, персональный токен для "
		+ "внешнего MCP-клиента выпускает администратор. Инструменты скрывают объекты, на которые у пользователя "
		+ "нет права чтения или использования, и отказывают в доступе к ним. Без токена `tools/call` "
		+ "работает, только если администратор разрешил это в настройках, и тогда права проверяются по "
		+ "пользователю публикации.");
	Строки.Добавить("");
	Строки.Добавить("**Коды ошибок JSON-RPC:**");
	Строки.Добавить("");
	Строки.Добавить("| Код | Когда |");
	Строки.Добавить("|---|---|");
	Для Каждого Код Из КодыОшибок() Цикл
		Строки.Добавить(СтрШаблон("| %1 | %2 |", Формат(Код.Код, "ЧГ="), Код.Описание));
	КонецЦикла;
	Строки.Добавить("");
	Строки.Добавить("Ошибка самого инструмента приходит не кодом JSON-RPC, а в `result` с `isError: true` "
		+ "и текстом в `content`.");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Список инструментов из контейнеров расширения: имя и первая строка описания, по контейнерам.
// Список строится при каждом открытии Swagger, поэтому совпадает с ответом tools/list.
//
// Возвращаемое значение:
//  Строка - текст в разметке Markdown
//
Функция ОписаниеИнструментов()

	ТаблицаИнструментов = mcp_КонтейнерыПовтИсп.Инструменты().Скопировать();
	ТаблицаИнструментов.Сортировать("СинонимКонтейнера, Имя");

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("**Инструменты (%1):**", ТаблицаИнструментов.Количество()));
	Контейнер = Неопределено;
	МаксимальнаяДлинаОписания = 160;
	Для Каждого СтрокаИнструмента Из ТаблицаИнструментов Цикл
		Если СтрокаИнструмента.СинонимКонтейнера <> Контейнер Тогда
			Контейнер = СтрокаИнструмента.СинонимКонтейнера;
			Строки.Добавить("");
			Строки.Добавить("*" + Контейнер + "*");
			Строки.Добавить("");
		КонецЕсли;
		КраткоеОписание = СокрЛП(СтрПолучитьСтроку(СтрокаИнструмента.Описание, 1));
		Если СтрДлина(КраткоеОписание) > МаксимальнаяДлинаОписания Тогда
			КраткоеОписание = Лев(КраткоеОписание, МаксимальнаяДлинаОписания) + "...";
		КонецЕсли;
		Строки.Добавить(СтрШаблон("- `%1` - %2", СтрокаИнструмента.Имя, КраткоеОписание));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Коды ошибок JSON-RPC, которые возвращает HTTP-сервис.
//
// Возвращаемое значение:
//  Массив из Структура - в порядке возрастания кода:
//   * Код      - Число
//   * Описание - Строка - когда возвращается
//
Функция КодыОшибок()

	Коды = Новый Массив;
	Коды.Добавить(КодОшибки(-32603, "Внутренняя ошибка сервера"));
	Коды.Добавить(КодОшибки(-32601, "Неизвестный метод"));
	Коды.Добавить(КодОшибки(-32600, "Неподдерживаемая версия JSON-RPC (не 2.0)"));
	ОписаниеОтказа = "Доступ запрещен: нет токена, токен не найден, отозван или истек, "
		+ "пользователь токена недействителен или не имеет права задавать вопросы";
	Коды.Добавить(КодОшибки(-32001, ОписаниеОтказа));

	Возврат Коды;

КонецФункции

// Код ошибки JSON-RPC с пояснением.
//
// Параметры:
//  Код      - Число
//  Описание - Строка - когда возвращается
//
// Возвращаемое значение:
//  Структура - с полями Код и Описание
//
Функция КодОшибки(Код, Описание)

	Возврат Новый Структура("Код, Описание", Код, Описание);

КонецФункции

// Дополняет метод JSON-RPC параметром токена, телом JsonRpcRequest и ответами 200 и 204.
//
// Параметры:
//  Метод - Структура - из ОписаниеМетода
//
Процедура ЗаполнитьМетодJSONRPC(Метод)

	ДлинаТокена = 69;
	КодУспеха = 200;
	КодБезТела = 204;

	Параметр = Новый Структура;
	Параметр.Вставить("Имя",               mcp_ДоступПользователей.ИмяЗаголовкаТокена());
	Параметр.Вставить("Описание",          "Токен пользователя 1С (mcpt_ и 64 шестнадцатеричных символа). "
		+ "Нужен для tools/call, если администратор запретил вызов без токена");
	Параметр.Вставить("ТипПараметра",      "header");
	Параметр.Вставить("Обязательный",      Ложь);
	Параметр.Вставить("Устарел",           Ложь);
	Параметр.Вставить("ТипЗначения",       "string");
	Параметр.Вставить("Перечисление",      Неопределено);
	Параметр.Вставить("МаксимальнаяДлина", ДлинаТокена);
	Параметр.Вставить("МинимальнаяДлина",  ДлинаТокена);
	Метод.Параметры.Добавить(Параметр);

	ТелоЗапроса = Новый Структура("Описание", "Запрос JSON-RPC 2.0 в кодировке UTF-8");
	ТелоЗапроса.Вставить("МассивТиповMIME", ТипJSON("JsonRpcRequest"));
	Метод.ТелоЗапроса = ТелоЗапроса;

	Ответ = ОписаниеОтвета(КодУспеха, "Ответ JSON-RPC: result или error", ТипJSON("JsonRpcResponse"));
	Метод.Ответы.Добавить(Ответ);
	Ответ = ОписаниеОтвета(КодБезТела, "Уведомление (запрос без id) принято, тела нет");
	Метод.Ответы.Добавить(Ответ);

КонецПроцедуры

// Описание метода в формате swagger-1c: краткое описание идет в summary, подробное - в description.
//
// Параметры:
//  Имя      - Строка - имя шаблона URL и HTTP-метод, например rpcPOST
//  Кратко   - Строка - summary
//  Подробно - Строка - description в разметке Markdown
//
// Возвращаемое значение:
//  Структура - метод без параметров, ответов и тела; состав описан в ПолучитьОписаниеHTTPСервиса
//
Функция ОписаниеМетода(Имя, Кратко, Подробно)

	Описание = Новый Структура("Описание, ДетальноеОписание", Кратко, Подробно);

	Метод = Новый Структура;
	Метод.Вставить("Имя",         Имя);
	Метод.Вставить("Описание",    Описание);
	Метод.Вставить("Параметры",   Новый Массив);
	Метод.Вставить("Ответы",      Новый Массив);
	Метод.Вставить("ТелоЗапроса", Неопределено);

	Возврат Метод;

КонецФункции

// Описание кода ответа в формате swagger-1c.
//
// Параметры:
//  Код             - Число - код HTTP
//  Описание        - Строка
//  МассивТиповMIME - Массив из Структура, Неопределено - тело ответа, см. ТипJSON
//
// Возвращаемое значение:
//  Структура - с полями Код, Описание, МассивТиповMIME
//
Функция ОписаниеОтвета(Код, Описание, МассивТиповMIME = Неопределено)

	Ответ = Новый Структура("Код, Описание", Код, Описание);
	Ответ.Вставить("МассивТиповMIME", МассивТиповMIME);

	Возврат Ответ;

КонецФункции

// Тело application/json со ссылкой на схему объекта.
//
// Параметры:
//  ИмяСхемы - Строка - имя схемы из ПолучитьОбъектыHTTPСервиса
//
// Возвращаемое значение:
//  Массив из Структура - типы MIME в формате swagger-1c (Заголовок, Тип, Схема)
//
Функция ТипJSON(ИмяСхемы)

	ТипMIME = Новый Структура("Заголовок, Тип", "application/json");
	ТипMIME.Вставить("Схема", СсылкаНаСхему(ИмяСхемы));

	ТипыMIME = Новый Массив;
	ТипыMIME.Добавить(ТипMIME);
	Возврат ТипыMIME;

КонецФункции

// Схема объекта JSON в формате swagger-1c без свойств; свойства добавляет ДобавитьСвойство.
//
// Параметры:
//  Имя              - Строка - имя схемы
//  ОбязательныеПоля - Строка - имена через запятую
//  Описание         - Строка
//
// Возвращаемое значение:
//  Структура - состав описан в ПолучитьОбъектыHTTPСервиса
//
Функция ОписаниеОбъекта(Имя, ОбязательныеПоля, Описание)

	Объект = Новый Структура;
	Объект.Вставить("Имя",              Имя);
	Объект.Вставить("Тип",              "object");
	Объект.Вставить("МассивСвойств",    Новый Массив);
	Объект.Вставить("ОбязательныеПоля", ОбязательныеПоля);
	Объект.Вставить("ОписаниеОбъекта",  Описание);

	Возврат Объект;

КонецФункции

// Добавляет свойство в схему объекта. Состав полей свойства - как у Swag_ФормированиеОписаний:
// swagger-1c читает поля Схема и Пример без проверки наличия.
//
// Параметры:
//  Объект       - Структура - из ОписаниеОбъекта
//  Имя          - Строка
//  Тип          - Строка - тип JSON: string, integer, object
//  Описание     - Строка
//  Схема        - Строка - имя схемы для свойства типа object
//  Пример       - Строка, Число
//  Перечисление - Массив - допустимые значения
//
Процедура ДобавитьСвойство(Объект, Имя, Тип, Описание, Схема = Неопределено, Пример = Неопределено,
	Перечисление = Неопределено)

	Свойство = Новый Структура("Имя, Тип, Схема, Описание, Nullable, Обязательный, Формат,
		|Максимум, Минимум, НеВключаяМаксимум, НеВключаяМинимум, МаксимальнаяДлина, МинимальнаяДлина,
		|ПоУмолчанию, Пример, Перечисление");
	Свойство.Имя          = Имя;
	Свойство.Тип          = Тип;
	Свойство.Описание     = Описание;
	Свойство.Пример       = Пример;
	Свойство.Перечисление = Перечисление;
	Если ЗначениеЗаполнено(Схема) Тогда
		Свойство.Схема = СсылкаНаСхему(Схема);
	КонецЕсли;

	Объект.МассивСвойств.Добавить(Свойство);

КонецПроцедуры

// Ссылка на схему из раздела components/schemas.
//
// Параметры:
//  ИмяСхемы - Строка
//
// Возвращаемое значение:
//  Строка - ссылка вида #/components/schemas/<ИмяСхемы>
