// Тексты запросов наборов данных из основных схем компоновки отчетов конфигурации (с кешированием на сеанс):
// образцы для инструмента find_report_queries. Схемы читаются в привилегированном режиме, права пользователя
// на отчеты проверяет инструмент.
//
// Возвращаемое значение:
//  ФиксированныйМассив из ФиксированнаяСтруктура:
//   * Отчет   - Строка - имя отчета
//   * Синоним - Строка
//   * Набор   - Строка - имя набора данных
//   * Текст   - Строка - текст запроса
//
Функция ЗапросыОтчетов() Экспорт

	Результат = Новый Массив;

	УстановитьПривилегированныйРежим(Истина);
	Для Каждого Отчет Из Метаданные.Отчеты Цикл
		Свойства = Новый Структура("ОсновнаяСхемаКомпоновкиДанных");
		ЗаполнитьЗначенияСвойств(Свойства, Отчет);
		Если Свойства.ОсновнаяСхемаКомпоновкиДанных = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СхемаКомпоновки = Неопределено;
		Попытка
			СхемаКомпоновки = Отчеты[Отчет.Имя].ПолучитьМакет(Свойства.ОсновнаяСхемаКомпоновкиДанных.Имя);
		Исключение
			// Схема не читается: отчет пропускается, остальные образцы собираются
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("MCP.ЗапросыОтчетов", УровеньЖурналаРегистрации.Ошибка, Отчет, , ТекстОшибки);
		КонецПопытки;
		Если ТипЗнч(СхемаКомпоновки) = Тип("СхемаКомпоновкиДанных") Тогда
			ДобавитьЗапросыНаборов(Результат, Отчет, СхемаКомпоновки.НаборыДанных);
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Новый ФиксированныйМассив(Результат);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавляет тексты запросов наборов данных схемы, в том числе наборов внутри объединения.
//
// Параметры:
//  Результат    - Массив из ФиксированнаяСтруктура - см. ЗапросыОтчетов
//  Отчет        - ОбъектМетаданных - отчет
//  НаборыДанных - НаборыДанныхСхемыКомпоновкиДанных
//
Процедура ДобавитьЗапросыНаборов(Результат, Отчет, НаборыДанных)

	Для Каждого Набор Из НаборыДанных Цикл
		ТипНабора = ТипЗнч(Набор);
		Если ТипНабора = Тип("НаборДанныхОбъединениеСхемыКомпоновкиДанных") Тогда
			ДобавитьЗапросыНаборов(Результат, Отчет, Набор.Элементы);
		ИначеЕсли ТипНабора = Тип("НаборДанныхЗапросСхемыКомпоновкиДанных") И ЗначениеЗаполнено(Набор.Запрос) Тогда
			Образец = Новый Структура;
			Образец.Вставить("Отчет",   Отчет.Имя);
			Образец.Вставить("Синоним", Отчет.Синоним);
			Образец.Вставить("Набор",   Набор.Имя);
			Образец.Вставить("Текст",   Набор.Запрос);
			Результат.Добавить(Новый ФиксированнаяСтруктура(Образец));
		Иначе
			// Набор-объект и пустой запрос образцов не дают
			Продолжить;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
