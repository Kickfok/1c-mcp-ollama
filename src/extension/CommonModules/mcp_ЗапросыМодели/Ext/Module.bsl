#Область ПрограммныйИнтерфейс

// Проверяет запрос модели: разбирает текст, проверяет права пользователя на таблицы и поля, читаемые через
// точку. Данные не читаются.
//
// Параметры:
//  Аргументы - Структура - query и контекст доступа
//
// Возвращаемое значение:
//  Структура:
//   * ok         - Булево - Истина
//   * tables     - Массив из Строка - объекты метаданных, данные которых читает запрос
//   * columns    - Массив из Строка - колонки результата
//   * parameters - Массив из Структура - name, type
//
Функция ПроверитьЗапрос(Аргументы) Экспорт

	Разбор = РазобратьЗапрос(Аргументы);

	// Поиск параметров тоже разбирает текст с проверкой прав сеанса: см. РазобратьЗапрос
	ТекстЗапроса = Разбор.Схема.ПолучитьТекстЗапроса();
	Запрос = Новый Запрос(ТекстЗапроса);
	Привилегированно = mcp_ДоступПользователей.ЕстьТокенПользователя(Аргументы);
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Попытка
		ПараметрыЗапроса = Запрос.НайтиПараметры();
	Исключение
		Если Привилегированно Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение "Ошибка в тексте запроса: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

	ОписанияПараметров = Новый Массив;
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		ОписаниеПараметра = Новый Структура("name, type", Параметр.Имя, Строка(Параметр.ТипЗначения));
		ОписанияПараметров.Добавить(ОписаниеПараметра);
	КонецЦикла;

	Колонки = Новый Массив;
	ИндексРезультата = ИндексЗапросаРезультата(Разбор.Схема);
	Если ИндексРезультата >= 0 Тогда
		Для Каждого Колонка Из Разбор.Схема.ПакетЗапросов[ИндексРезультата].Колонки Цикл
			Колонки.Добавить(Колонка.Псевдоним);
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ok",         Истина);
	Результат.Вставить("tables",     Разбор.Таблицы);
	Результат.Вставить("columns",    Колонки);
	Результат.Вставить("parameters", ОписанияПараметров);

	Возврат Результат;

КонецФункции

// Выполняет запрос модели после проверки прав. В пакете выполняются все запросы; основной результат -
// последний запрос выборки без ПОМЕСТИТЬ, результаты предыдущих таких запросов возвращаются в batchResults,
// чтобы модель не решила, что первый запрос пакета ничего не нашел. Ко всем запросам добавляется
// РАЗРЕШЕННЫЕ, к результатам - ограничение числа строк. С токеном данные читаются в привилегированном
// режиме: права пользователя токена уже проверены при разборе. В сеансе пользователя привилегированный
// режим не включается, и платформа применяет его роли и ограничения на уровне записей.
//
// Параметры:
//  Аргументы     - Структура - query, parameters и контекст доступа
//  Пропустить    - Число - сколько первых строк каждого результата пропустить
//  МаксимумСтрок - Число - сколько строк каждого результата вернуть
//
// Возвращаемое значение:
//  Структура - см. ОписаниеРезультата; у пакета еще batchResults
//
Функция ВыполнитьЗапрос(Аргументы, Пропустить, МаксимумСтрок) Экспорт

	Разбор = РазобратьЗапрос(Аргументы);
	Индексы = ИндексыЗапросовРезультата(Разбор.Схема);
	Если Не ЗначениеЗаполнено(Индексы) Тогда
		ВызватьИсключение "В запросе нет выборки результата: все запросы пакета помещают данные во временные таблицы";
	КонецЕсли;
	ПодготовитьСхемуКВыполнению(Разбор.Схема, Индексы, Пропустить + МаксимумСтрок);

	ТекстЗапроса = Разбор.Схема.ПолучитьТекстЗапроса();
	Запрос = Новый Запрос(ТекстЗапроса);

	Привилегированно = mcp_ДоступПользователей.ЕстьТокенПользователя(Аргументы);
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Попытка
		ЗаполнитьПараметрыЗапроса(Запрос, Аргументы);
		Результаты = Запрос.ВыполнитьПакет();
		Результат = ОписаниеРезультатаПакета(Результаты, Индексы, Пропустить, МаксимумСтрок);
	Исключение
		Если Привилегированно Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение "Ошибка выполнения запроса: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Значение колонки результата в виде, который записывается в JSON.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Число, Строка, Булево, Неопределено
//
Функция ЗначениеДляМодели(Значение) Экспорт

	ТипЗначения = ТипЗнч(Значение);
	МаксимальнаяДлинаСтроки = 500;
	Если ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
		Результат = Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") И Значение = НачалоДня(Значение) Тогда
		Результат = Формат(Значение, "ДФ=yyyy-MM-dd; ДП=");
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Результат = Формат(Значение, "ДФ='yyyy-MM-dd HH:mm:ss'");
	ИначеЕсли ТипЗначения = Тип("Null") Или ТипЗначения = Тип("Неопределено") Тогда
		Результат = Неопределено;
	Иначе
		Результат = Строка(Значение);
		Если СтрДлина(Результат) > МаксимальнаяДлинаСтроки Тогда
			Результат = Лев(Результат, МаксимальнаяДлинаСтроки) + "...";
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Приводит значение из JSON к одному из типов параметра запроса.
//
// Параметры:
//  Значение      - Строка, Число, Булево, Массив, Неопределено - значение из JSON
//  ОписаниеТипов - ОписаниеТипов - типы параметра; пустое, если платформа тип не вывела
//  ИмяПараметра  - Строка - для текста ошибки
//  Аргументы     - Структура - контекст доступа
//
// Возвращаемое значение:
//  Произвольный
//
Функция ЗначениеПараметра(Значение, ОписаниеТипов, ИмяПараметра, Аргументы) Экспорт

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Элементы = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			ЗначениеЭлемента = ЗначениеПараметра(Элемент, ОписаниеТипов, ИмяПараметра, Аргументы);
			Элементы.Добавить(ЗначениеЭлемента);
		КонецЦикла;
		Возврат Элементы;
	КонецЕсли;

	Типы = ОписаниеТипов.Типы();
	Если Типы.Количество() = 0 Тогда
		ЗначениеДаты = Неопределено;
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			ЗначениеДаты = mcp_ОбщегоНазначения.ДатаИзСтроки(Значение);
		КонецЕсли;
		Если ЗначениеЗаполнено(ЗначениеДаты) Тогда
			Возврат ЗначениеДаты;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;

	Для Каждого ТипПараметра Из Типы Цикл
		Приведенное = ЗначениеТипа(Значение, ТипПараметра, Аргументы);
		Если Приведенное <> Неопределено Тогда
			Возврат Приведенное;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение СтрШаблон("Значение ""%1"" параметра %2 не подходит: ожидается %3",
		Значение, ИмяПараметра, ОписаниеТипов);

КонецФункции

// Число из аргумента инструмента в заданных пределах.
//
// Параметры:
//  Аргументы   - Структура
//  Имя         - Строка - имя аргумента
//  ПоУмолчанию - Число - если аргумент не задан
//  Минимум     - Число
//  Максимум    - Число
//
// Возвращаемое значение:
//  Число
//
Функция ЧислоИзАргументов(Аргументы, Имя, ПоУмолчанию, Минимум, Максимум) Экспорт

	Значение = ПоУмолчанию;
	Если Аргументы.Свойство(Имя) И ТипЗнч(Аргументы[Имя]) = Тип("Число") Тогда
		Значение = Цел(Аргументы[Имя]);
	КонецЕсли;

	Возврат Макс(Минимум, Мин(Максимум, Значение));

КонецФункции

// Сколько строк результата run_query возвращает по умолчанию: ответ инструмента оркестратор сокращает
// до 2500 символов.
//
// Возвращаемое значение:
//  Число
//
Функция СтрокРезультатаПоУмолчанию() Экспорт

	Возврат 20;

КонецФункции

// Наибольшее число строк результата run_query.
//
// Возвращаемое значение:
//  Число
//
Функция МаксимумСтрокРезультата() Экспорт

	Возврат 500;

КонецФункции

// Наибольшее значение offset в run_query.
//
// Возвращаемое значение:
//  Число
//
Функция МаксимумСмещения() Экспорт

	Возврат 100000;

КонецФункции

// Индекс запроса, результат которого возвращается: последний в пакете запрос выборки без ПОМЕСТИТЬ.
//
// Параметры:
//  Схема - СхемаЗапроса
//
// Возвращаемое значение:
//  Число - индекс в пакете или -1
//
Функция ИндексЗапросаРезультата(Схема) Экспорт

	Индекс = -1;
	Для Номер = 0 По Схема.ПакетЗапросов.Количество() - 1 Цикл
		ЗапросПакета = Схема.ПакетЗапросов[Номер];
		Если ТипЗнч(ЗапросПакета) = Тип("ЗапросВыбораСхемыЗапроса")
			И Не ЗначениеЗаполнено(ЗапросПакета.ТаблицаДляПомещения) Тогда
			Индекс = Номер;
		КонецЕсли;
	КонецЦикла;

	Возврат Индекс;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область РезультатЗапроса

// Основной результат пакета (последний запрос выборки) и результаты предыдущих запросов выборки.
//
// Параметры:
//  Результаты    - Массив из РезультатЗапроса - результаты всех запросов пакета
//  Индексы       - Массив из Число - индексы запросов выборки без ПОМЕСТИТЬ
//  Пропустить    - Число - сколько первых строк пропустить
//  МаксимумСтрок - Число
//
// Возвращаемое значение:
//  Структура - см. ОписаниеРезультата; у пакета еще batchResults - Массив из Структура с полем index
//
Функция ОписаниеРезультатаПакета(Результаты, Индексы, Пропустить, МаксимумСтрок)

	Последний = Индексы[Индексы.ВГраница()];
	Результат = ОписаниеРезультата(Результаты[Последний], Пропустить, МаксимумСтрок);
	Если Индексы.Количество() = 1 Тогда
		Возврат Результат;
	КонецЕсли;

	Предыдущие = Новый Массив;
	Для Каждого Индекс Из Индексы Цикл
		Если Индекс = Последний Тогда
			Продолжить;
		КонецЕсли;
		ОписаниеПредыдущего = ОписаниеРезультата(Результаты[Индекс], Пропустить, МаксимумСтрок);
		ОписаниеПредыдущего.Вставить("index", Индекс + 1);
		Предыдущие.Добавить(ОписаниеПредыдущего);
	КонецЦикла;
	Результат.Вставить("batchResults", Предыдущие);

	Возврат Результат;

КонецФункции

// Ставит РАЗРЕШЕННЫЕ во все запросы пакета и ограничивает число строк каждого результата. Ограничение
// на одну строку больше нужного: по лишней строке видно, что результат обрезан. В объединении
// ограничение не ставится, строки отбираются при чтении выборки.
//
// Параметры:
//  Схема   - СхемаЗапроса
//  Индексы - Массив из Число - индексы запросов результата в пакете
//  Предел  - Число - сколько строк читается из каждого результата (пропущенные и выдаваемые)
//
Процедура ПодготовитьСхемуКВыполнению(Схема, Индексы, Предел)

	Для Каждого ЗапросПакета Из Схема.ПакетЗапросов Цикл
		Если ТипЗнч(ЗапросПакета) = Тип("ЗапросВыбораСхемыЗапроса") Тогда
			ЗапросПакета.ВыбиратьРазрешенные = Истина;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Индекс Из Индексы Цикл
		Операторы = Схема.ПакетЗапросов[Индекс].Операторы;
		Если Операторы.Количество() = 1 Тогда
			Ограничение = Операторы[0].КоличествоПолучаемыхЗаписей;
			Если Не ЗначениеЗаполнено(Ограничение) Или Ограничение > Предел + 1 Тогда
				Операторы[0].КоличествоПолучаемыхЗаписей = Предел + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Колонки и строки результата для модели: ссылки - представлением, даты - строкой ГГГГ-ММ-ДД.
//
// Параметры:
//  РезультатЗапроса - РезультатЗапроса
//  Пропустить       - Число - сколько первых строк пропустить
//  МаксимумСтрок    - Число
//
// Возвращаемое значение:
//  Структура:
//   * columns   - Массив из Строка
//   * rows      - Массив из Массив - значения в порядке колонок
//   * rowCount  - Число - строк в rows
//   * truncated - Булево - в результате есть еще строки
//   * offset    - Число - сколько строк пропущено
//
Функция ОписаниеРезультата(РезультатЗапроса, Пропустить, МаксимумСтрок)

	Колонки = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	Строки = Новый Массив;
	Обрезан = Ложь;
	Пропущено = 0;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Пропущено < Пропустить Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Если Строки.Количество() >= МаксимумСтрок Тогда
			Обрезан = Истина;
			Прервать;
		КонецЕсли;
		Значения = Новый Массив;
		Для Каждого ИмяКолонки Из Колонки Цикл
			ЗначениеКолонки = ЗначениеДляМодели(Выборка[ИмяКолонки]);
			Значения.Добавить(ЗначениеКолонки);
		КонецЦикла;
		Строки.Добавить(Значения);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("columns",   Колонки);
	Результат.Вставить("rows",      Строки);
	Результат.Вставить("rowCount",  Строки.Количество());
	Результат.Вставить("truncated", Обрезан);
	Результат.Вставить("offset",    Пропущено);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ПараметрыЗапроса

// Задает параметры запроса из аргумента parameters, приводя значения к типам параметров. Ссылки ищутся
// по наименованию, коду или номеру; пользователь должен иметь право читать объект, в котором ищется ссылка.
//
// Параметры:
//  Запрос    - Запрос
//  Аргументы - Структура - parameters и контекст доступа
//
Процедура ЗаполнитьПараметрыЗапроса(Запрос, Аргументы)

	Значения = Неопределено;
	Если Аргументы.Свойство("parameters") И ТипЗнч(Аргументы.parameters) = Тип("Структура") Тогда
		Значения = Аргументы.parameters;
	КонецЕсли;

	НеЗаданы = Новый Массив;
	Для Каждого Параметр Из Запрос.НайтиПараметры() Цикл
		ЗначениеИзJSON = ЗначениеПоИмениБезРегистра(Значения, Параметр.Имя);
		Если ЗначениеИзJSON = Неопределено Тогда
			НеЗаданы.Добавить(СтрШаблон("%1 (%2)", Параметр.Имя, Параметр.ТипЗначения));
			Продолжить;
		КонецЕсли;
		ЗначениеПараметра = ЗначениеПараметра(ЗначениеИзJSON.Значение, Параметр.ТипЗначения, Параметр.Имя, Аргументы);
		Запрос.УстановитьПараметр(Параметр.Имя, ЗначениеПараметра);
	КонецЦикла;

	Если ЗначениеЗаполнено(НеЗаданы) Тогда
		ВызватьИсключение "Не заданы значения параметров: " + СтрСоединить(НеЗаданы, ", ")
			+ ". Передайте их в parameters";
	КонецЕсли;

КонецПроцедуры

// Значение из структуры по ключу без учета регистра: модель может написать имя параметра в другом регистре.
//
// Параметры:
//  Значения - Структура, Неопределено
//  Имя      - Строка
//
// Возвращаемое значение:
//  Структура, Неопределено - Значение (Произвольный), если ключ найден
//
Функция ЗначениеПоИмениБезРегистра(Значения, Имя)

	Если Значения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяВРег = ВРег(Имя);
	Для Каждого КлючИЗначение Из Значения Цикл
		Если ВРег(КлючИЗначение.Ключ) = ИмяВРег Тогда
			Возврат Новый Структура("Значение", КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Приводит значение из JSON к типу или возвращает Неопределено, если оно к типу не приводится.
//
// Параметры:
//  Значение     - Строка, Число, Булево, Неопределено
//  ОжидаемыйТип - Тип
//  Аргументы    - Структура - контекст доступа
//
// Возвращаемое значение:
//  Произвольный, Неопределено
//
Функция ЗначениеТипа(Значение, ОжидаемыйТип, Аргументы)

	ТипСтрока = Тип("Строка");
	ТипЗначения = ТипЗнч(Значение);
	Если ОжидаемыйТип = ТипЗначения И ОжидаемыйТип <> ТипСтрока Тогда
		Результат = Значение;
	ИначеЕсли ОжидаемыйТип = ТипСтрока Тогда
		Результат = Строка(Значение);
	ИначеЕсли ТипЗначения <> ТипСтрока Тогда
		Результат = Неопределено;
	ИначеЕсли ОжидаемыйТип = Тип("Дата") Тогда
		Результат = mcp_ОбщегоНазначения.ДатаИзСтроки(Значение);
		Если Не ЗначениеЗаполнено(Результат) Тогда
			Результат = Неопределено;
		КонецЕсли;
	ИначеЕсли ОжидаемыйТип = Тип("Число") Тогда
		ТекстЧисла = СтрЗаменить(Значение, ",", ".");
		Результат = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ТекстЧисла);
	ИначеЕсли ОжидаемыйТип = Тип("Булево") Тогда
		Результат = ВРег(Значение) = "TRUE" Или ВРег(Значение) = "ИСТИНА";
	Иначе
		МетаданныеТипа = Метаданные.НайтиПоТипу(ОжидаемыйТип);
		Результат = Неопределено;
		Если МетаданныеТипа <> Неопределено Тогда
			Результат = СсылкаПоСтроке(МетаданныеТипа, Значение, Аргументы);
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Ищет ссылку по строке: идентификатору, имени значения перечисления, наименованию, коду или номеру.
//
// Параметры:
//  МетаданныеТипа  - ОбъектМетаданных - справочник, документ, перечисление, план видов характеристик и т.п.
//  ИскомоеЗначение - Строка
//  Аргументы       - Структура - контекст доступа
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено
//
Функция СсылкаПоСтроке(МетаданныеТипа, Знач ИскомоеЗначение, Аргументы)

	mcp_ДоступПользователей.ПроверитьДоступПользователя(Аргументы, МетаданныеТипа);
	ПолноеИмя = МетаданныеТипа.ПолноеИмя();
	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
	ИскомоеЗначение = СокрЛП(ИскомоеЗначение);

	Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ИскомоеЗначение) Тогда
		Идентификатор = Новый УникальныйИдентификатор(ИскомоеЗначение);
		Ссылка = Менеджер.ПолучитьСсылку(Идентификатор);
	ИначеЕсли Метаданные.Перечисления.Содержит(МетаданныеТипа) Тогда
		Ссылка = ЗначениеПеречисленияПоСтроке(МетаданныеТипа, Менеджер, ИскомоеЗначение);
	ИначеЕсли Метаданные.Документы.Содержит(МетаданныеТипа) Тогда
		Ссылка = Менеджер.НайтиПоНомеру(ИскомоеЗначение);
	Иначе
		Ссылка = СсылкаПоНаименованиюИлиКоду(Менеджер, ИскомоеЗначение);
	КонецЕсли;

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Значение перечисления по имени или синониму.
//
// Параметры:
//  МетаданныеТипа  - ОбъектМетаданных - перечисление
//  Менеджер        - ПеречислениеМенеджер
//  ИскомоеЗначение - Строка
//
// Возвращаемое значение:
//  ПеречислениеСсылка, Неопределено
//
Функция ЗначениеПеречисленияПоСтроке(МетаданныеТипа, Менеджер, ИскомоеЗначение)

	ИскомоеВРег = ВРег(ИскомоеЗначение);
	Для Каждого ЗначениеПеречисления Из МетаданныеТипа.ЗначенияПеречисления Цикл
		Если ВРег(ЗначениеПеречисления.Имя) = ИскомоеВРег Или ВРег(ЗначениеПеречисления.Синоним) = ИскомоеВРег Тогда
			Возврат Менеджер[ЗначениеПеречисления.Имя];
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Ссылка справочника, плана видов характеристик или плана счетов по наименованию, затем по коду.
//
// Параметры:
//  Менеджер        - СправочникМенеджер - менеджер объекта, в котором ищется ссылка
//  ИскомоеЗначение - Строка
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - пустая ссылка, если не найдено
//
Функция СсылкаПоНаименованиюИлиКоду(Менеджер, ИскомоеЗначение)

	Ссылка = Неопределено;
	Попытка
		Ссылка = Менеджер.НайтиПоНаименованию(ИскомоеЗначение, Истина);
	Исключение
		// У объекта нет наименования: остается поиск по коду
		Ссылка = Неопределено;
	КонецПопытки;
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Попытка
		Ссылка = Менеджер.НайтиПоКоду(ИскомоеЗначение);
	Исключение
		// У объекта нет кода
		Ссылка = Неопределено;
	КонецПопытки;

	Возврат Ссылка;

КонецФункции

#КонецОбласти

#Область РазборЗапроса

// Разбирает запрос и проверяет права пользователя, задавшего вопрос: на каждую таблицу, упомянутую в тексте,
// в том числе во вложенных запросах условий, и на объекты, поля которых читаются через точку
// (Т.Контрагент.ИНН).
//
// Параметры:
//  Аргументы - Структура - query и контекст доступа
//
// Возвращаемое значение:
//  Структура:
//   * Схема   - СхемаЗапроса
//   * Таблицы - Массив из Строка - полные имена объектов метаданных, данные которых читает запрос
//
Функция РазобратьЗапрос(Аргументы)

	ТекстЗапроса = "";
	Если Аргументы.Свойство("query") Тогда
		ТекстЗапроса = СокрЛП(Строка(Аргументы.query));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
		ВызватьИсключение "Не задан текст запроса (query)";
	КонецЕсли;
	МаксимальнаяДлинаЗапроса = 20000;
	Если СтрДлина(ТекстЗапроса) > МаксимальнаяДлинаЗапроса Тогда
		ВызватьИсключение СтрШаблон("Текст запроса длиннее %1 символов", МаксимальнаяДлинаЗапроса);
	КонецЕсли;

	// Разбор текста проверяет права сеанса на таблицы. Сеанс HTTP-сервиса работает под техническим
	// пользователем публикации, поэтому с токеном текст разбирается в привилегированном режиме: права
	// пользователя токена проверяются ниже по каждой таблице и каждому полю, прочитанному через точку
	Схема = Новый СхемаЗапроса;
	Привилегированно = mcp_ДоступПользователей.ЕстьТокенПользователя(Аргументы);
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Попытка
		Схема.УстановитьТекстЗапроса(ТекстЗапроса);
	Исключение
		Если Привилегированно Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение "Ошибка в тексте запроса: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ ". Имена полей уточните через get_metadata_structure. В языке запросов 1С агрегатные функции - "
			+ "КОЛИЧЕСТВО, СУММА, МАКСИМУМ, МИНИМУМ, СРЕДНЕЕ; поля без агрегата перечисляются в СГРУППИРОВАТЬ ПО";
	КонецПопытки;
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

	Цепочки = ЦепочкиИмен(ТекстЗапроса);
	Таблицы = ПроверитьТаблицыЗапроса(Цепочки, Аргументы);

	Псевдонимы = Новый Соответствие;
	Для Каждого ЗапросПакета Из Схема.ПакетЗапросов Цикл
		СобратьПсевдонимы(ЗапросПакета, Псевдонимы);
	КонецЦикла;
	ПроверитьПоляЧерезТочку(Цепочки, Псевдонимы, Аргументы);

	Возврат Новый Структура("Схема, Таблицы", Схема, Таблицы);

КонецФункции

// Индексы запросов пакета, результаты которых возвращаются: запросы выборки без ПОМЕСТИТЬ.
//
// Параметры:
//  Схема - СхемаЗапроса
//
// Возвращаемое значение:
//  Массив из Число
//
Функция ИндексыЗапросовРезультата(Схема)

	Индексы = Новый Массив;
	Для Номер = 0 По Схема.ПакетЗапросов.Количество() - 1 Цикл
		ЗапросПакета = Схема.ПакетЗапросов[Номер];
		Если ТипЗнч(ЗапросПакета) = Тип("ЗапросВыбораСхемыЗапроса")
			И Не ЗначениеЗаполнено(ЗапросПакета.ТаблицаДляПомещения) Тогда
			Индексы.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;

	Возврат Индексы;

КонецФункции

// Цепочки имен через точку из текста запроса без строковых литералов и комментариев: "Справочник.Склады",
// "Т.Контрагент.ИНН". Одиночные имена не возвращаются.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Массив из Массив - части каждой цепочки
//
Функция ЦепочкиИмен(Текст)

	Цепочки = Новый Массив;
	Цепочка = Новый Массив;
	Имя = "";
	ВСтроке = Ложь;
	ВКомментарии = Ложь;

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ВКомментарии Тогда
			ВКомментарии = Символ <> Символы.ПС;
		ИначеЕсли ВСтроке Тогда
			ВСтроке = Символ <> """";
		ИначеЕсли ЭтоСимволИмени(Символ) Тогда
			Имя = Имя + Символ;
		Иначе
			Если ЗначениеЗаполнено(Имя) Тогда
				Цепочка.Добавить(Имя);
				Имя = "";
			КонецЕсли;
			Если Символ <> "." Или Не ЗначениеЗаполнено(Цепочка) Тогда
				ДобавитьЦепочку(Цепочки, Цепочка);
				Цепочка = Новый Массив;
				ВСтроке = Символ = """";
				ВКомментарии = Символ = "/" И Сред(Текст, Позиция + 1, 1) = "/";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(Имя) Тогда
		Цепочка.Добавить(Имя);
	КонецЕсли;
	ДобавитьЦепочку(Цепочки, Цепочка);

	Возврат Цепочки;

КонецФункции

// Добавляет цепочку из двух и более имен; цепочки, которые начинаются с цифры (числа 1.5), пропускаются.
//
// Параметры:
//  Цепочки - Массив из Массив
//  Цепочка - Массив из Строка
//
Процедура ДобавитьЦепочку(Цепочки, Цепочка)

	МинимумЧастей = 2;
	Если Цепочка.Количество() >= МинимумЧастей И СтрНайти("0123456789", Лев(Цепочка[0], 1)) = 0 Тогда
		Цепочки.Добавить(Цепочка);
	КонецЕсли;

КонецПроцедуры

// Истина для буквы, цифры и подчеркивания: у букв любого алфавита верхний и нижний регистр различаются.
//
// Параметры:
//  Символ - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоСимволИмени(Символ)

	Возврат ВРег(Символ) <> НРег(Символ) Или СтрНайти("_0123456789", Символ) > 0;

КонецФункции

// Проверяет права на объекты метаданных, упомянутые в тексте как таблицы (Документ.Реализация,
// РегистрНакопления.Остатки.Остатки): данные таблицы пользователь должен иметь право читать.
//
// Параметры:
//  Цепочки   - Массив из Массив - см. ЦепочкиИмен
//  Аргументы - Структура - контекст доступа
//
// Возвращаемое значение:
//  Массив из Строка - полные имена проверенных объектов
//
Функция ПроверитьТаблицыЗапроса(Цепочки, Аргументы)

	Классы = КлассыТаблиц();
	Таблицы = Новый Массив;
	Для Каждого Цепочка Из Цепочки Цикл
		Если Классы.Получить(ВРег(Цепочка[0])) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Цепочка[0] + "." + Цепочка[1]);
		Если ОбъектМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Если Таблицы.Найти(ПолноеИмя) = Неопределено Тогда
			ПроверитьПравоНаТаблицу(Аргументы, ОбъектМетаданных);
			Таблицы.Добавить(ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Возврат Таблицы;

КонецФункции

// Вызывает исключение, если у пользователя, задавшего вопрос, нет права читать объект.
//
// Параметры:
//  Аргументы        - Структура - контекст доступа
//  ОбъектМетаданных - ОбъектМетаданных
//
Процедура ПроверитьПравоНаТаблицу(Аргументы, ОбъектМетаданных)

	Если Не mcp_ДоступПользователей.ДоступноПользователю(Аргументы, ОбъектМетаданных) Тогда
		ВызватьИсключение СтрШаблон("У пользователя нет прав на %1: запрос к этим данным не выполняется",
			ОбъектМетаданных.ПолноеИмя());
	КонецЕсли;

КонецПроцедуры

// Имена классов таблиц запроса в верхнем регистре, русские и английские.
//
// Возвращаемое значение:
//  Соответствие - ключ: имя класса, значение: Истина
//
Функция КлассыТаблиц()

	Классы = Новый Соответствие;
	Имена = "СПРАВОЧНИК,ДОКУМЕНТ,ЖУРНАЛДОКУМЕНТОВ,ПЕРЕЧИСЛЕНИЕ,ПЛАНВИДОВХАРАКТЕРИСТИК,ПЛАНСЧЕТОВ,ПЛАНВИДОВРАСЧЕТА,"
		+ "РЕГИСТРСВЕДЕНИЙ,РЕГИСТРНАКОПЛЕНИЯ,РЕГИСТРБУХГАЛТЕРИИ,РЕГИСТРРАСЧЕТА,БИЗНЕСПРОЦЕСС,ЗАДАЧА,ПЛАНОБМЕНА,"
		+ "КОНСТАНТА,ПОСЛЕДОВАТЕЛЬНОСТЬ,ВНЕШНИЙИСТОЧНИКДАННЫХ,CATALOG,DOCUMENT,DOCUMENTJOURNAL,ENUM,"
		+ "CHARTOFCHARACTERISTICTYPES,CHARTOFACCOUNTS,CHARTOFCALCULATIONTYPES,INFORMATIONREGISTER,"
		+ "ACCUMULATIONREGISTER,ACCOUNTINGREGISTER,CALCULATIONREGISTER,BUSINESSPROCESS,TASK,EXCHANGEPLAN,"
		+ "CONSTANT,SEQUENCE,EXTERNALDATASOURCE";
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Классы.Вставить(Имя, Истина);
	КонецЦикла;

	Возврат Классы;

КонецФункции

// Собирает псевдонимы источников запроса: псевдоним - объекты метаданных, поля которых он дает. Псевдоним
// вложенного запроса и временной таблицы связывается с Неопределено: их поля по метаданным не проверить.
//
// Параметры:
//  ЗапросПакета - ЗапросВыбораСхемыЗапроса, ЗапросУничтоженияТаблицыСхемыЗапроса
//  Псевдонимы   - Соответствие - ключ: псевдоним в верхнем регистре, значение: Массив
//
Процедура СобратьПсевдонимы(ЗапросПакета, Псевдонимы)

	Если ТипЗнч(ЗапросПакета) <> Тип("ЗапросВыбораСхемыЗапроса") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Оператор Из ЗапросПакета.Операторы Цикл
		Для Каждого ИсточникОператора Из Оператор.Источники Цикл
			Источник = ИсточникОператора.Источник;
			Если ТипЗнч(Источник) = Тип("ТаблицаСхемыЗапроса") Тогда
				Владелец = ВладелецПолейТаблицы(Источник.ИмяТаблицы);
			ИначеЕсли ТипЗнч(Источник) = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
				Владелец = Неопределено;
				СобратьПсевдонимы(Источник.Запрос, Псевдонимы);
			Иначе
				// Временная таблица: ее поля по метаданным не проверить
				Владелец = Неопределено;
			КонецЕсли;
			ДобавитьВладельцаПсевдонима(Псевдонимы, Источник.Псевдоним, Владелец);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Добавляет владельца полей к псевдониму: один псевдоним в разных запросах пакета дает разные таблицы.
//
// Параметры:
//  Псевдонимы - Соответствие - см. СобратьПсевдонимы
//  Псевдоним  - Строка
//  Владелец   - ОбъектМетаданных, Неопределено
//
Процедура ДобавитьВладельцаПсевдонима(Псевдонимы, Псевдоним, Владелец)

	Ключ = ВРег(Псевдоним);
	Владельцы = Псевдонимы.Получить(Ключ);
	Если Владельцы = Неопределено Тогда
		Владельцы = Новый Массив;
		Псевдонимы.Вставить(Ключ, Владельцы);
	КонецЕсли;
	Владельцы.Добавить(Владелец);

КонецПроцедуры

// Объект метаданных, поля которого дает таблица запроса: сам объект, его табличная часть или регистр
// виртуальной таблицы (РегистрНакопления.ТоварыНаСкладах.Остатки).
//
// Параметры:
//  ИмяТаблицы - Строка
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено
//
Функция ВладелецПолейТаблицы(ИмяТаблицы)

	Части = СтрРазделить(ИмяТаблицы, ".");
	ЧастейИмениОбъекта = 2;
	Если Части.Количество() < ЧастейИмениОбъекта Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]);
	Если ОбъектМетаданных = Неопределено Или Части.Количество() = ЧастейИмениОбъекта Тогда
		Возврат ОбъектМетаданных;
	КонецЕсли;

	// Третья часть имени - табличная часть объекта или виртуальная таблица регистра
	Свойства = Новый Структура("ТабличныеЧасти");
	ЗаполнитьЗначенияСвойств(Свойства, ОбъектМетаданных);
	ТабличнаяЧасть = Неопределено;
	Если Свойства.ТабличныеЧасти <> Неопределено Тогда
		ТабличнаяЧасть = Свойства.ТабличныеЧасти.Найти(Части[ЧастейИмениОбъекта]);
	КонецЕсли;
	Если ТабличнаяЧасть <> Неопределено Тогда
		Возврат ТабличнаяЧасть;
	КонецЕсли;

	Возврат ОбъектМетаданных;

КонецФункции

// Проверяет обращения к полям через точку (Т.Контрагент.ИНН): чтобы прочитать поле ИНН, пользователь должен
// иметь право читать справочник, на который ссылается Контрагент. Цепочку, которую не удается разобрать по
// метаданным (поле вложенного запроса или временной таблицы), запрос не допускает.
//
// Параметры:
//  Цепочки    - Массив из Массив - см. ЦепочкиИмен
//  Псевдонимы - Соответствие - см. СобратьПсевдонимы
//  Аргументы  - Структура - контекст доступа
//
Процедура ПроверитьПоляЧерезТочку(Цепочки, Псевдонимы, Аргументы)

	МинимумЧастей = 3;
	Для Каждого Цепочка Из Цепочки Цикл
		Владельцы = Псевдонимы.Получить(ВРег(Цепочка[0]));
		Если Владельцы = Неопределено Или Цепочка.Количество() < МинимумЧастей Тогда
			Продолжить;
		КонецЕсли;

		ПоследнееПромежуточное = Цепочка.Количество() - 1;
		Для Номер = 1 По ПоследнееПромежуточное - 1 Цикл
			Владельцы = ВладельцыСледующегоПоля(Владельцы, Цепочка[Номер], Аргументы);
			Если Владельцы = Неопределено Тогда
				Поле = СтрСоединить(Цепочка, ".");
				ВызватьИсключение СтрШаблон("Не удалось проверить права на поле %1: обращение через точку "
					+ "разрешено только к полям таблиц базы. Соедините нужную таблицу явно или используйте ВЫРАЗИТЬ",
					Поле);
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Владельцы) Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Объекты метаданных, поля которых читаются после поля ИмяПоля. Проверяет право пользователя на каждый
// объект, на который ссылается поле.
//
// Параметры:
//  Владельцы - Массив из ОбъектМетаданных, Неопределено - объекты, у которых ищется поле
//  ИмяПоля   - Строка
//  Аргументы - Структура - контекст доступа
//
// Возвращаемое значение:
//  Массив из ОбъектМетаданных - пустой, если поле примитивного типа; Неопределено, если поле не найдено
//
Функция ВладельцыСледующегоПоля(Владельцы, ИмяПоля, Аргументы)

	Найдено = Ложь;
	Следующие = Новый Массив;
	Для Каждого Владелец Из Владельцы Цикл
		Поле = Неопределено;
		Если Владелец <> Неопределено Тогда
			Поле = ПолеОбъектаМетаданных(Владелец, ИмяПоля);
		КонецЕсли;
		Если Поле = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Найдено = Истина;

		Если Поле.ТабличнаяЧасть <> Неопределено Тогда
			Следующие.Добавить(Поле.ТабличнаяЧасть);
		Иначе
			ДобавитьОбъектыТипа(Следующие, Поле.Тип, Аргументы);
		КонецЕсли;
	КонецЦикла;

	Если Не Найдено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Следующие;

КонецФункции

// Добавляет объекты метаданных, на которые ссылается тип поля, проверяя право пользователя на каждый.
//
// Параметры:
//  Объекты   - Массив из ОбъектМетаданных
//  ТипПоля   - ОписаниеТипов
//  Аргументы - Структура - контекст доступа
//
Процедура ДобавитьОбъектыТипа(Объекты, ТипПоля, Аргументы)

	Для Каждого ТипСсылки Из ТипПоля.Типы() Цикл
		ОбъектТипа = Метаданные.НайтиПоТипу(ТипСсылки);
		Если ОбъектТипа <> Неопределено И Объекты.Найти(ОбъектТипа) = Неопределено Тогда
			ПроверитьПравоНаТаблицу(Аргументы, ОбъектТипа);
			Объекты.Добавить(ОбъектТипа);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Поле объекта метаданных по имени: реквизит, стандартный реквизит, измерение, ресурс или табличная часть.
//
// Параметры:
//  Владелец - ОбъектМетаданных
//  ИмяПоля  - Строка
//
// Возвращаемое значение:
//  Структура, Неопределено:
//   * Тип            - ОписаниеТипов, Неопределено - тип поля; Неопределено для табличной части
//   * ТабличнаяЧасть - ОбъектМетаданных, Неопределено - табличная часть, если имя - ее имя
//
Функция ПолеОбъектаМетаданных(Владелец, ИмяПоля)

	ИмяВРег = ВРег(ИмяПоля);
	ИменаКоллекций = "Реквизиты,СтандартныеРеквизиты,Измерения,Ресурсы,ТабличныеЧасти";
	Свойства = Новый Структура(ИменаКоллекций);
	ЗаполнитьЗначенияСвойств(Свойства, Владелец);

	Для Каждого Коллекция Из Свойства Цикл
		Если Коллекция.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Элемент Из Коллекция.Значение Цикл
			Если ВРег(Элемент.Имя) <> ИмяВРег Тогда
				Продолжить;
			ИначеЕсли Коллекция.Ключ = "ТабличныеЧасти" Тогда
				Возврат Новый Структура("Тип, ТабличнаяЧасть", Неопределено, Элемент);
			Иначе
				Возврат Новый Структура("Тип, ТабличнаяЧасть", Элемент.Тип, Неопределено);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#КонецОбласти
