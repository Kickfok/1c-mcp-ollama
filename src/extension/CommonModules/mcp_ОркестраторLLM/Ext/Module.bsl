
#Область ПрограммныйИнтерфейс

// Начинает обработку вопроса серверным оркестратором и сразу возвращает идентификатор запроса.
// Для вопроса выпускается токен текущего пользователя: с ним оркестратор вызывает инструменты MCP,
// и 1С проверяет права этого пользователя. Токен отзывается, когда СостояниеВопроса видит, что
// запрос завершен, или при отмене.
//
// Параметры:
//  Вопрос - Строка - текст вопроса пользователя
//
// Возвращаемое значение:
//  Структура:
//   * ИдентификаторЗапроса - Строка - пусто, если вопрос не принят
//   * ОписаниеОшибки       - Строка - причина, по которой вопрос не принят
//   * ОшибкаСоединения     - Булево - оркестратор не ответил
//
Функция НачатьВопрос(Вопрос) Экспорт

	Результат = Новый Структура("ИдентификаторЗапроса, ОписаниеОшибки, ОшибкаСоединения", "", "", Ложь);

	Подключение = ПодключениеКОркестратору(Результат);
	Если Подключение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор);
	Токен = mcp_ДоступПользователей.ВыпуститьТокенЗапроса(ИдентификаторЗапроса);

	ТаймаутОтправки = 30;
	Ответ = ВыполнитьЗапрос(Подключение, "POST", "/requests", ТаймаутОтправки, Результат,
		ТелоВопроса(Вопрос, ИдентификаторЗапроса, Токен));
	Если Ответ = Неопределено Или Ответ.КодСостояния <> 202 Тогда
		mcp_ДоступПользователей.ОтозватьТокенЗапроса(Токен);
		Если Ответ <> Неопределено Тогда
			Результат.ОписаниеОшибки = ОписаниеОтказа(Ответ);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Результат.ИдентификаторЗапроса = ИдентификаторЗапроса;
	Возврат Результат;

КонецФункции

// Читает новые события запроса и его состояние. Когда запрос завершен, возвращает ответ модели
// и отзывает токен вопроса.
//
// Параметры:
//  ИдентификаторЗапроса - Строка - идентификатор из НачатьВопрос
//  ПоследнийНомер       - Число - номер последнего события, которое форма уже получила
//
// Возвращаемое значение:
//  Структура:
//   * Связь     - Булево - оркестратор ответил
//   * Номер     - Число - номер последнего полученного события
//   * События   - Массив из Структура - новые события журнала в порядке появления
//   * Завершен  - Булево - модель закончила, ответ в поле Ответ
//   * Ответ     - Структура - ответ оркестратора, состав описан в ОтправитьВопрос
//
Функция СостояниеВопроса(ИдентификаторЗапроса, ПоследнийНомер) Экспорт

	СтруктураОтвета = НовыйОтвет();
	Подключение = ПодключениеКОркестратору(СтруктураОтвета);
	Результат = ПрочитатьСобытия(Подключение, ИдентификаторЗапроса, ПоследнийНомер);
	Результат.Вставить("Завершен", Ложь);
	Результат.Вставить("Ответ", СтруктураОтвета);
	Если Не Результат.Связь Тогда
		Возврат Результат;
	КонецЕсли;

	ТаймаутОпроса = 5;
	Ответ = ВыполнитьЗапрос(Подключение, "GET", "/requests/" + ИдентификаторЗапроса, ТаймаутОпроса, Результат.Ответ);
	Если Ответ = Неопределено Или Ответ.КодСостояния <> 200 Тогда
		Возврат Результат;
	КонецЕсли;

	Данные = mcp_ОбщегоНазначения.JSONВСтруктуру(Ответ.ПолучитьТелоКакСтроку());
	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("status") Или Данные.status = "running" Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Завершен = Истина;
	Если Данные.Свойство("response") Тогда
		ЗаполнитьОтвет(Результат.Ответ, Данные.response);
	КонецЕсли;
	mcp_ДоступПользователей.ОтозватьТокеныЗапроса(ИдентификаторЗапроса);

	Возврат Результат;

КонецФункции

// Просит оркестратор остановить запрос. Модель останавливается после текущего шага, токен вопроса
// отзывается сразу.
//
// Параметры:
//  ИдентификаторЗапроса - Строка - идентификатор из НачатьВопрос
//
Процедура ОтменитьВопрос(ИдентификаторЗапроса) Экспорт

	mcp_ДоступПользователей.ОтозватьТокеныЗапроса(ИдентификаторЗапроса);

	ОписаниеОшибки = НовыйОтвет();
	Подключение = ПодключениеКОркестратору(ОписаниеОшибки);
	Если Подключение <> Неопределено Тогда
		ТаймаутОтмены = 5;
		ВыполнитьЗапрос(Подключение, "POST", "/requests/" + ИдентификаторЗапроса + "/cancel", ТаймаутОтмены,
			ОписаниеОшибки);
	КонецЕсли;

КонецПроцедуры

// Отправляет вопрос серверному оркестратору и ждет итоговый ответ модели.
// Ход выполнения оркестратор отдает отдельно, по идентификатору запроса (см. СобытияЗапроса),
// поэтому форма показывает шаги модели, пока эта функция ждет ответа.
//
// Параметры:
//  Вопрос               - Строка - текст вопроса пользователя
//  ИдентификаторЗапроса - Строка - идентификатор, под которым оркестратор ведет журнал запроса;
//                                  от 16 до 64 символов: латиница, цифры и дефис
//
// Возвращаемое значение:
//  Структура - ответ оркестратора:
//   * Ответ            - Булево - Истина, если модель вернула успешный ответ
//   * Текст            - Строка - краткий ответ модели или описание ошибки
//   * Результат        - Произвольный - данные из поля Result ответа
//   * ОписаниеОшибки   - Строка - текст ошибки, когда Ответ = Ложь
//   * ОшибкаСоединения - Булево - оркестратор не ответил на запрос
//   * ХодВыполнения    - Массив из Структура - события журнала оркестратора по запросу
//
Функция ОтправитьВопрос(Вопрос, ИдентификаторЗапроса) Экспорт

	СтруктураОтвета = НовыйОтвет();

	Подключение = ПодключениеКОркестратору(СтруктураОтвета);
	Если Подключение = Неопределено Тогда
		Возврат СтруктураОтвета;
	КонецЕсли;

	Токен = mcp_ДоступПользователей.ВыпуститьТокенЗапроса(ИдентификаторЗапроса);
	Ответ = ВыполнитьЗапрос(Подключение, "POST", "/", Подключение.ТаймаутОтвета, СтруктураОтвета,
		ТелоВопроса(Вопрос, ИдентификаторЗапроса, Токен));
	mcp_ДоступПользователей.ОтозватьТокенЗапроса(Токен);
	Если Ответ = Неопределено Тогда
		Возврат СтруктураОтвета;
	КонецЕсли;

	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	Данные = mcp_ОбщегоНазначения.JSONВСтруктуру(ТелоОтвета);

	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("Trace") И ТипЗнч(Данные.Trace) = Тип("Массив") Тогда
		СтруктураОтвета.ХодВыполнения = Данные.Trace;
	КонецЕсли;

	Если Ответ.КодСостояния <> 200 Тогда
		СтруктураОтвета.ОписаниеОшибки = ОписаниеОтказа(Ответ);
		Возврат СтруктураОтвета;
	КонецЕсли;

	ЗаполнитьОтвет(СтруктураОтвета, Данные);
	Возврат СтруктураОтвета;

КонецФункции

// Тело фонового задания формы обработки АнализКонфигурацииMCP: отправляет вопрос оркестратору
// и помещает ответ во временное хранилище, откуда его забирает форма.
//
// Параметры:
//  Вопрос               - Строка - текст вопроса пользователя
//  ИдентификаторЗапроса - Строка - идентификатор запроса в журнале оркестратора
//  АдресРезультата      - Строка - адрес временного хранилища, созданного формой
//
Процедура ОтправитьВопросВФоне(Вопрос, ИдентификаторЗапроса, АдресРезультата) Экспорт

	ПоместитьВоВременноеХранилище(ОтправитьВопрос(Вопрос, ИдентификаторЗапроса), АдресРезультата);

КонецПроцедуры

// Читает из журнала оркестратора события запроса, появившиеся после указанного номера.
// Ошибки связи не прерывают работу формы: они возвращаются признаком Связь.
//
// Параметры:
//  ИдентификаторЗапроса - Строка - идентификатор запроса в журнале оркестратора
//  ПоследнийНомер       - Число - номер последнего события, которое форма уже получила
//
// Возвращаемое значение:
//  Структура:
//   * Связь   - Булево - оркестратор ответил
//   * Номер   - Число - номер последнего полученного события
//   * События - Массив из Структура - новые события журнала в порядке появления
//
Функция СобытияЗапроса(ИдентификаторЗапроса, ПоследнийНомер) Экспорт

	Возврат ПрочитатьСобытия(ПодключениеКОркестратору(НовыйОтвет()), ИдентификаторЗапроса, ПоследнийНомер);

КонецФункции

// Адрес страницы монитора серверного оркестратора: журнал всех запросов с шагами модели.
// Монитор спрашивает ключ администратора оркестратора.
//
// Возвращаемое значение:
//  Строка - URL монитора; пусто, если адрес оркестратора не задан
//
Функция АдресМонитора() Экспорт

	АдресОркестратора = mcp_НастройкиLLM.ДействующиеНастройки().АдресОркестратора;
	Если Не ЗначениеЗаполнено(АдресОркестратора) Тогда
		Возврат "";
	КонецЕсли;

	Пока СтрЗаканчиваетсяНа(АдресОркестратора, "/") Цикл
		АдресОркестратора = Лев(АдресОркестратора, СтрДлина(АдресОркестратора) - 1);
	КонецЦикла;
	Возврат АдресОркестратора + "/monitor";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры соединения с серверным оркестратором из настроек базы и его ключ.
//
// Параметры:
//  СтруктураОшибки - Структура - с полями ОписаниеОшибки и ОшибкаСоединения: заполняется, если
//                                соединиться нельзя
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если оркестратор не настроен:
//   * Хост                - Строка
//   * Порт                - Число
//   * Путь                - Строка - путь публикации оркестратора без завершающей косой черты
//   * Защищенное          - Булево - адрес начинается с https
//   * ПроверятьСертификат - Булево
//   * Ключ                - Строка - ключ клиента оркестратора
//   * ТаймаутОтвета       - Число - секунд ожидания ответа модели
//
Функция ПодключениеКОркестратору(СтруктураОшибки)

	// В безопасном режиме платформа запрещает исходящие HTTP-соединения, вопрос до оркестратора не дойдет
	Если БезопасныйРежим() <> Ложь Тогда
		СтруктураОшибки.ОписаниеОшибки = ОписаниеОшибкиБезопасногоРежима();
		Возврат Неопределено;
	КонецЕсли;

	Настройки = mcp_НастройкиLLM.ДействующиеНастройки();
	Если Настройки.Режим <> mcp_НастройкиLLM.РежимСерверный() Тогда
		СтруктураОшибки.ОписаниеОшибки = "Включен локальный режим: вопрос отправляет клиент 1С на этом компьютере, "
			+ "а не сервер.";
		Возврат Неопределено;
	КонецЕсли;
	Если Не Настройки.Настроено Тогда
		СтруктураОшибки.ОписаниеОшибки = "Серверный оркестратор не настроен: не задан адрес или ключ. "
			+ "Обратитесь к администратору.";
		Возврат Неопределено;
	КонецЕсли;

	Ключ = КлючСерверногоОркестратора();
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		СтруктураОшибки.ОписаниеОшибки = "Ключ серверного оркестратора не записан. Обратитесь к администратору.";
		Возврат Неопределено;
	КонецЕсли;

	ЧастиАдреса = mcp_ОбщегоНазначения.РазобратьURL(Настройки.АдресОркестратора);
	Путь = ЧастиАдреса.Путь;
	Пока СтрЗаканчиваетсяНа(Путь, "/") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;

	Подключение = Новый Структура;
	Подключение.Вставить("Хост",                ЧастиАдреса.Хост);
	Подключение.Вставить("Порт",                ЧастиАдреса.Порт);
	Подключение.Вставить("Путь",                Путь);
	Подключение.Вставить("Защищенное",          ЧастиАдреса.Схема = "https");
	Подключение.Вставить("ПроверятьСертификат", Настройки.ПроверятьСертификат);
	Подключение.Вставить("Ключ",                Ключ);
	Подключение.Вставить("ТаймаутОтвета",       Настройки.ТаймаутОтвета);

	Возврат Подключение;

КонецФункции

// Читает события запроса из журнала оркестратора.
//
// Параметры:
//  Подключение          - Структура, Неопределено - из ПодключениеКОркестратору
//  ИдентификаторЗапроса - Строка
//  ПоследнийНомер       - Число
//
// Возвращаемое значение:
//  Структура - состав описан в СобытияЗапроса
//
Функция ПрочитатьСобытия(Подключение, ИдентификаторЗапроса, ПоследнийНомер)

	Результат = Новый Структура("Связь, Номер, События", Ложь, ПоследнийНомер, Новый Массив);
	Если Подключение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	АдресРесурса = СтрШаблон("/events?request=%1&since=%2", ИдентификаторЗапроса, Формат(ПоследнийНомер, "ЧН=0; ЧГ="));
	ТаймаутОпроса = 3;
	Ответ = ВыполнитьЗапрос(Подключение, "GET", АдресРесурса, ТаймаутОпроса, НовыйОтвет());
	Если Ответ = Неопределено Или Ответ.КодСостояния <> 200 Тогда
		Возврат Результат;
	КонецЕсли;

	Данные = mcp_ОбщегоНазначения.JSONВСтруктуру(Ответ.ПолучитьТелоКакСтроку());
	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("events") Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Связь = Истина;
	Для Каждого Событие Из Данные.events Цикл
		Результат.События.Добавить(Событие);
		Результат.Номер = Макс(Результат.Номер, Событие.seq);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Выполняет HTTP-запрос к оркестратору с ключом клиента в заголовке Authorization.
//
// Параметры:
//  Подключение     - Структура - из ПодключениеКОркестратору
//  Метод           - Строка - GET или POST
//  АдресРесурса    - Строка - путь относительно адреса оркестратора, начинается с /
//  Таймаут         - Число - секунд
//  СтруктураОшибки - Структура - с полями ОписаниеОшибки и ОшибкаСоединения: заполняется при сбое связи
//  Тело            - Строка, Неопределено - тело запроса JSON
//
// Возвращаемое значение:
//  HTTPОтвет, Неопределено - Неопределено, если оркестратор не ответил
//
Функция ВыполнитьЗапрос(Подключение, Метод, АдресРесурса, Таймаут, СтруктураОшибки, Тело = Неопределено)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Подключение.Ключ);
	Если Тело <> Неопределено Тогда
		Заголовки.Вставить("Content-Type", "application/json");
	КонецЕсли;

	HTTPЗапрос = Новый HTTPЗапрос(Подключение.Путь + АдресРесурса, Заголовки);
	Если Тело <> Неопределено Тогда
		HTTPЗапрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Если Не Подключение.Защищенное Тогда
		ЗащищенноеСоединение = Неопределено;
	ИначеЕсли Подключение.ПроверятьСертификат Тогда
		ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение();
	Иначе
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;

	Попытка
		Соединение = Новый HTTPСоединение(Подключение.Хост, Подключение.Порт, , , , Таймаут, ЗащищенноеСоединение);
		Возврат Соединение.ВызватьHTTPМетод(Метод, HTTPЗапрос);
	Исключение
		СтруктураОшибки.ОшибкаСоединения = Истина;
		СтруктураОшибки.ОписаниеОшибки   = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Ключ клиента серверного оркестратора из безопасного хранилища. Функция не экспортная: ключ
// не возвращается ни клиенту, ни во внешнее соединение, он уходит только в заголовок запроса.
//
// Возвращаемое значение:
//  Строка - ключ; пусто, если не записан
//
Функция КлючСерверногоОркестратора()

	Расположение = mcp_НастройкиLLM.РасположениеКлючаОркестратора(mcp_НастройкиLLM.РежимСерверный());

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Ключ = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Расположение.Владелец, Расположение.Ключ);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если ТипЗнч(Ключ) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Возврат Ключ;

КонецФункции

// Тело вопроса для оркестратора: текст, идентификатор запроса, пользователь для журнала и токен,
// с которым оркестратор вызывает инструменты MCP.
//
// Параметры:
//  Вопрос               - Строка - текст вопроса
//  ИдентификаторЗапроса - Строка - идентификатор запроса в журнале оркестратора
//  Токен                - Строка - токен вопроса из mcp_ДоступПользователей.ВыпуститьТокенЗапроса
//
// Возвращаемое значение:
//  Строка - JSON
//
Функция ТелоВопроса(Вопрос, ИдентификаторЗапроса, Токен)

	ТелоСтруктура = Новый Структура;
	ТелоСтруктура.Вставить("text",       Вопрос);
	ТелоСтруктура.Вставить("request_id", ИдентификаторЗапроса);
	ТелоСтруктура.Вставить("user",       Строка(Пользователи.АвторизованныйПользователь()));
	ТелоСтруктура.Вставить("mcp_token",  Токен);

	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(ТелоСтруктура);

КонецФункции

// Переносит ответ оркестратора (поля Success, Text, Result) в структуру ответа формы.
//
// Параметры:
//  СтруктураОтвета - Структура - из НовыйОтвет
//  Данные          - Структура, Произвольный - разобранный JSON ответа
//
Процедура ЗаполнитьОтвет(СтруктураОтвета, Данные)

	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("Result") Тогда
		СтруктураОтвета.ОписаниеОшибки = "Пустой или некорректный JSON в ответе LLM";
		Возврат;
	КонецЕсли;

	СтруктураОтвета.Ответ     = Данные.Success;
	СтруктураОтвета.Текст     = Данные.Text;
	СтруктураОтвета.Результат = Данные.Result;
	Если Не СтруктураОтвета.Ответ Тогда
		СтруктураОтвета.ОписаниеОшибки = Данные.Text;
	КонецЕсли;

КонецПроцедуры

// Текст для пользователя по ответу оркестратора с кодом ошибки.
//
// Параметры:
//  Ответ - HTTPОтвет - ответ оркестратора
//
// Возвращаемое значение:
//  Строка
//
Функция ОписаниеОтказа(Ответ)

	Данные = mcp_ОбщегоНазначения.JSONВСтруктуру(Ответ.ПолучитьТелоКакСтроку());
	Сообщение = "";
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		ТекстОтвета = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "Text", "");
		Сообщение = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "message", ТекстОтвета);
	КонецЕсли;

	КодНеверногоКлюча = 401;
	Если Ответ.КодСостояния = КодНеверногоКлюча Тогда
		Возврат "Оркестратор не принял ключ: ключ в настройках 1С не совпадает с client_key оркестратора. "
			+ "Обратитесь к администратору.";
	КонецЕсли;

	Возврат СтрШаблон("Оркестратор отказал (код HTTP %1). %2", Ответ.КодСостояния, Сообщение);

КонецФункции

// Текст для пользователя, когда расширение подключено в безопасном режиме: HTTP-сервис MCP в этом
// режиме работает, а форма не может отправить вопрос оркестратору.
//
// Возвращаемое значение:
//  Строка
//
Функция ОписаниеОшибкиБезопасногоРежима()

	Возврат "Расширение MCP_Сервер подключено в безопасном режиме, а в нем платформа запрещает исходящие "
		+ "HTTP-запросы, поэтому вопрос не может уйти оркестратору. "
		+ "Снимите флажок ""Безопасный режим"" у расширения в разделе Администрирование - Печатные формы, "
		+ "отчеты и обработки - Расширения и перезапустите сеанс. HTTP-сервис MCP работает в обоих режимах.";

КонецФункции

// Пустой ответ оркестратора.
//
// Возвращаемое значение:
//  Структура - состав полей описан в ОтправитьВопрос
//
Функция НовыйОтвет()

	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("Ответ",            Ложь);
	СтруктураОтвета.Вставить("Текст",            "");
	СтруктураОтвета.Вставить("Результат",        Неопределено);
	СтруктураОтвета.Вставить("ОписаниеОшибки",   "");
	СтруктураОтвета.Вставить("ОшибкаСоединения", Ложь);
	СтруктураОтвета.Вставить("ХодВыполнения",    Новый Массив);

	Возврат СтруктураОтвета;

КонецФункции

#КонецОбласти
