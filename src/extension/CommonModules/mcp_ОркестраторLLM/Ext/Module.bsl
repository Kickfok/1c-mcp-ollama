
#Область ПрограммныйИнтерфейс

// Начинает обработку вопроса серверным оркестратором и сразу возвращает идентификатор запроса.
// Для вопроса выпускается токен текущего пользователя: с ним оркестратор вызывает инструменты MCP,
// и 1С проверяет права этого пользователя. Токен отзывается, когда СостояниеВопроса видит, что
// запрос завершен, или при отмене.
//
// Параметры:
//  Вопрос - Строка - текст вопроса пользователя
//
// Возвращаемое значение:
//  Структура:
//   * ИдентификаторЗапроса - Строка - пусто, если вопрос не принят
//   * ОписаниеОшибки       - Строка - причина, по которой вопрос не принят
//   * ОшибкаСоединения     - Булево - оркестратор не ответил
//
Функция НачатьВопрос(Вопрос) Экспорт

	Результат = Новый Структура("ИдентификаторЗапроса, ОписаниеОшибки, ОшибкаСоединения", "", "", Ложь);

	Подключение = ПодключениеКОркестратору(Результат);
	Если Подключение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор);
	Токен = mcp_ДоступПользователей.ВыпуститьТокенЗапроса(ИдентификаторЗапроса);

	ТаймаутОтправки = 30;
	Ответ = ВыполнитьЗапрос(Подключение, "POST", "/requests", ТаймаутОтправки, Результат,
		ТелоВопроса(Вопрос, ИдентификаторЗапроса, Токен));
	Если Ответ = Неопределено Или Ответ.КодСостояния <> КодПринято() Тогда
		mcp_ДоступПользователей.ОтозватьТокенЗапроса(Токен);
		Если Ответ <> Неопределено Тогда
			Результат.ОписаниеОшибки = ОписаниеОтказа(Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Результат.ИдентификаторЗапроса = ИдентификаторЗапроса;
	Возврат Результат;

КонецФункции

// Читает состояние запроса и новые события его журнала. Когда запрос завершен, возвращает ответ
// модели и отзывает токен вопроса.
//
// Параметры:
//  ИдентификаторЗапроса - Строка - идентификатор из НачатьВопрос
//  ПоследнийНомер       - Число - номер последнего события, которое форма уже получила
//
// Возвращаемое значение:
//  Структура:
//   * Связь     - Булево - оркестратор ответил
//   * Номер     - Число - номер последнего полученного события
//   * События   - Массив из Структура - новые события журнала в порядке появления
//   * Завершен  - Булево - модель закончила, ответ в поле Ответ
//   * Ответ     - Структура - ответ оркестратора, состав описан в ОтправитьВопрос
//
Функция СостояниеВопроса(ИдентификаторЗапроса, ПоследнийНомер) Экспорт

	СтруктураОтвета = НовыйОтвет();
	Подключение = ПодключениеКОркестратору(СтруктураОтвета);
	Если Подключение = Неопределено Тогда
		Возврат РазобратьСостояниеВопроса(ИдентификаторЗапроса, ПоследнийНомер, ОтветHTTP(Неопределено),
			ОтветHTTP(Неопределено));
	КонецЕсли;

	// Состояние читается раньше событий: если запрос уже завершен, в журнале есть все его события
	ТаймаутОпроса = 5;
	ОтветСостояния = ВыполнитьЗапрос(Подключение, "GET", "/requests/" + ИдентификаторЗапроса, ТаймаутОпроса,
		СтруктураОтвета);
	ОтветСобытий = ВыполнитьЗапрос(Подключение, "GET", АдресСобытий(ИдентификаторЗапроса, ПоследнийНомер),
		ТаймаутОпроса, СтруктураОтвета);

	Возврат РазобратьСостояниеВопроса(ИдентификаторЗапроса, ПоследнийНомер, ОтветHTTP(ОтветСостояния),
		ОтветHTTP(ОтветСобытий));

КонецФункции

// Просит оркестратор остановить запрос. Модель останавливается после текущего шага, токен вопроса
// отзывается сразу.
//
// Параметры:
//  ИдентификаторЗапроса - Строка - идентификатор из НачатьВопрос
//
Процедура ОтменитьВопрос(ИдентификаторЗапроса) Экспорт

	mcp_ДоступПользователей.ОтозватьТокеныЗапроса(ИдентификаторЗапроса);

	ОписаниеОшибки = НовыйОтвет();
	Подключение = ПодключениеКОркестратору(ОписаниеОшибки);
	Если Подключение <> Неопределено Тогда
		ТаймаутОтмены = 5;
		ВыполнитьЗапрос(Подключение, "POST", "/requests/" + ИдентификаторЗапроса + "/cancel", ТаймаутОтмены,
			ОписаниеОшибки);
	КонецЕсли;

КонецПроцедуры

// Отправляет вопрос серверному оркестратору и ждет итоговый ответ модели.
// Для интеграций, которым нужен ответ одним вызовом: форма вопроса работает через НачатьВопрос
// и СостояниеВопроса.
//
// Параметры:
//  Вопрос               - Строка - текст вопроса пользователя
//  ИдентификаторЗапроса - Строка - идентификатор, под которым оркестратор ведет журнал запроса;
//                                  от 16 до 64 символов: латиница, цифры и дефис
//
// Возвращаемое значение:
//  Структура - ответ оркестратора:
//   * Ответ            - Булево - Истина, если модель вернула успешный ответ
//   * Текст            - Строка - краткий ответ модели или описание ошибки
//   * Результат        - Произвольный - данные из поля Result ответа
//   * ОписаниеОшибки   - Строка - текст ошибки, когда Ответ = Ложь
//   * ОшибкаСоединения - Булево - оркестратор не ответил на запрос
//   * ХодВыполнения    - Массив из Структура - события журнала оркестратора по запросу
//
Функция ОтправитьВопрос(Вопрос, ИдентификаторЗапроса) Экспорт

	СтруктураОтвета = НовыйОтвет();

	Подключение = ПодключениеКОркестратору(СтруктураОтвета);
	Если Подключение = Неопределено Тогда
		Возврат СтруктураОтвета;
	КонецЕсли;

	Токен = mcp_ДоступПользователей.ВыпуститьТокенЗапроса(ИдентификаторЗапроса);
	Ответ = ВыполнитьЗапрос(Подключение, "POST", "/", Подключение.ТаймаутОтвета, СтруктураОтвета,
		ТелоВопроса(Вопрос, ИдентификаторЗапроса, Токен));
	mcp_ДоступПользователей.ОтозватьТокенЗапроса(Токен);
	Если Ответ = Неопределено Тогда
		Возврат СтруктураОтвета;
	КонецЕсли;

	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	Данные = mcp_ОбщегоНазначения.JSONВСтруктуру(ТелоОтвета);

	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("Trace") И ТипЗнч(Данные.Trace) = Тип("Массив") Тогда
		СтруктураОтвета.ХодВыполнения = Данные.Trace;
	КонецЕсли;

	Если Ответ.КодСостояния <> 200 Тогда
		СтруктураОтвета.ОписаниеОшибки = ОписаниеОтказа(Ответ.КодСостояния, ТелоОтвета);
		Возврат СтруктураОтвета;
	КонецЕсли;

	ЗаполнитьОтвет(СтруктураОтвета, Данные);
	Возврат СтруктураОтвета;

КонецФункции

// Готовность формы вопроса для текущего пользователя: режим, настроено ли подключение и, если
// вопрос задать нельзя, причина. Секретов не содержит, передается на клиент.
//
// Возвращаемое значение:
//  Структура:
//   * ЛокальныйРежим    - Булево - вопрос отправляет клиент 1С оркестратору на компьютере пользователя
//   * АдресОркестратора - Строка - адрес оркестратора действующего режима
//   * АдресМонитора     - Строка - страница монитора оркестратора; пусто, если адрес не задан
//   * Готов             - Булево - вопрос можно отправлять
//   * Причина           - Строка - почему вопрос отправить нельзя
//   * ФормаНастройки    - Строка - имя формы обработки, где пользователь исправит настройку; пусто,
//                                  если исправить может только администратор
//   * ЭтоАдминистратор  - Булево - пользователь может менять общие настройки
//   * Автозапуск        - Булево - запускать локальные Ollama и оркестратор, если они не отвечают
//   * ТаймаутОтвета     - Число - секунд ожидания ответа модели
//
Функция ГотовностьКВопросу() Экспорт

	Настройки = mcp_НастройкиLLM.ДействующиеНастройки();
	ЛокальныйРежим = Настройки.Режим = mcp_НастройкиLLM.РежимЛокальный();

	Результат = Новый Структура;
	Результат.Вставить("ЛокальныйРежим",    ЛокальныйРежим);
	Результат.Вставить("АдресОркестратора", Настройки.АдресОркестратора);
	Результат.Вставить("АдресМонитора",     АдресМонитора(Настройки.АдресОркестратора));
	Результат.Вставить("Готов",             Ложь);
	Результат.Вставить("Причина",           "");
	Результат.Вставить("ФормаНастройки",    "");
	Результат.Вставить("ЭтоАдминистратор",  Настройки.ЭтоАдминистратор);
	Результат.Вставить("Автозапуск",        Настройки.Автозапуск);
	Результат.Вставить("ТаймаутОтвета",     Настройки.ТаймаутОтвета);

	Если ЛокальныйРежим И Не Настройки.Настроено Тогда
		Результат.Причина = "Включен локальный режим, но не задан адрес локального оркестратора. "
			+ "Заполните его в личных настройках.";
		Результат.ФормаНастройки = "ФормаЛичныхНастроек";
	ИначеЕсли Не Настройки.Настроено И Настройки.ЭтоАдминистратор Тогда
		Результат.Причина = "Подключение к LLM не настроено: укажите адрес и ключ серверного оркестратора "
			+ "и проверьте подключение.";
		Результат.ФормаНастройки = "ФормаНастроек";
	ИначеЕсли Не Настройки.Настроено Тогда
		Результат.Причина = "Подключение к LLM не настроено. Обратитесь к администратору: первичную настройку "
			+ "выполняет пользователь с полными правами.";
	ИначеЕсли Не ЛокальныйРежим И БезопасныйРежим() <> Ложь Тогда
		Результат.Причина = ОписаниеОшибкиБезопасногоРежима();
	Иначе
		Результат.Готов = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Готовит вопрос локальному оркестратору: выпускает токен текущего пользователя и собирает тело
// запроса POST /requests. Отправляет вопрос клиент 1С (mcp_ОркестраторLLMКлиент.ВыполнитьЗапрос):
// оркестратор слушает 127.0.0.1 на компьютере пользователя, и сервер 1С до него не достает.
// Если отправить вопрос не удалось, токен отзывает ОтказЛокальногоВопроса.
//
// Параметры:
//  Вопрос - Строка - текст вопроса пользователя
//
// Возвращаемое значение:
//  Структура:
//   * ИдентификаторЗапроса - Строка - пусто, если вопрос задать нельзя
//   * Подключение          - Структура, Неопределено - см. ПодключениеКЛокальномуОркестратору
//   * Тело                 - Строка - тело POST /requests с токеном вопроса
//   * ОписаниеОшибки       - Строка - почему вопрос задать нельзя
//
Функция НачатьЛокальныйВопрос(Вопрос) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗапроса", "");
	Результат.Вставить("Подключение",          Неопределено);
	Результат.Вставить("Тело",                 "");
	Результат.Вставить("ОписаниеОшибки",       "");
	Подключение = ПодключениеКЛокальномуОркестратору(Результат);
	Если Подключение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор);
	Токен = mcp_ДоступПользователей.ВыпуститьТокенЗапроса(ИдентификаторЗапроса);

	Результат.ИдентификаторЗапроса = ИдентификаторЗапроса;
	Результат.Подключение          = Подключение;
	Результат.Тело                 = ТелоВопроса(Вопрос, ИдентификаторЗапроса, Токен);
	Возврат Результат;

КонецФункции

// Отзывает токен вопроса, который не удалось отправить локальному оркестратору, и описывает причину.
//
// Параметры:
//  ИдентификаторЗапроса - Строка - идентификатор из НачатьЛокальныйВопрос
//  ОтветОркестратора    - Структура - ответ на POST /requests, см. mcp_ОркестраторLLMКлиент.ВыполнитьЗапрос
//
// Возвращаемое значение:
//  Строка - текст для пользователя
//
Функция ОтказЛокальногоВопроса(ИдентификаторЗапроса, Знач ОтветОркестратора) Экспорт

	mcp_ДоступПользователей.ОтозватьТокеныЗапроса(ИдентификаторЗапроса);
	Если ОтветОркестратора.КодСостояния = 0 Тогда
		Возврат ОтветОркестратора.ОписаниеОшибки;
	КонецЕсли;
	Возврат ОписаниеОтказа(ОтветОркестратора.КодСостояния, ОтветОркестратора.Тело);

КонецФункции

// Разбирает ответы локального оркестратора на запросы состояния и событий, которые выполнил клиент.
// Когда запрос завершен, отзывает токен вопроса.
//
// Параметры:
//  ИдентификаторЗапроса - Строка - идентификатор из НачатьЛокальныйВопрос
//  ПоследнийНомер       - Число - номер последнего события, которое форма уже получила
//  ОтветСостояния       - Структура - ответ на GET /requests/<идентификатор>:
//   * КодСостояния - Число - 0, если оркестратор не ответил
//   * Тело         - Строка
//  ОтветСобытий         - Структура - ответ на GET по адресу из АдресСобытий, состав как у ОтветСостояния
//
// Возвращаемое значение:
//  Структура - см. СостояниеВопроса
//
Функция СостояниеЛокальногоВопроса(ИдентификаторЗапроса, ПоследнийНомер, Знач ОтветСостояния,
	Знач ОтветСобытий) Экспорт

	Возврат РазобратьСостояниеВопроса(ИдентификаторЗапроса, ПоследнийНомер, ОтветСостояния, ОтветСобытий);

КонецФункции

// Адрес журнала событий запроса относительно адреса оркестратора.
//
// Параметры:
//  ИдентификаторЗапроса - Строка
//  ПоследнийНомер       - Число - номер последнего полученного события
//
// Возвращаемое значение:
//  Строка - путь вида /events?request=...&since=...
//
Функция АдресСобытий(ИдентификаторЗапроса, ПоследнийНомер) Экспорт

	Возврат СтрШаблон("/events?request=%1&since=%2", ИдентификаторЗапроса, Формат(ПоследнийНомер, "ЧН=0; ЧГ="));

КонецФункции

// Файлы для запуска локального оркестратора на компьютере пользователя: скрипт из макета обработки
// и файл конфигурации с ключом локального оркестратора и адресом публикации MCP. Файлы помещаются
// во временное хранилище формы; записывает их на диск и запускает программы клиент после вопроса
// пользователю.
//
// Параметры:
//  ИдентификаторФормы - УникальныйИдентификатор - владелец временного хранилища
//
// Возвращаемое значение:
//  Структура:
//   * ОписаниеОшибки      - Строка - почему запустить оркестратор нельзя; остальных полей тогда нет
//   * ИмяСкрипта          - Строка
//   * АдресСкрипта        - Строка - адрес во временном хранилище
//   * ИмяКонфигурации     - Строка
//   * АдресКонфигурации   - Строка - адрес во временном хранилище
//   * КаталогОркестратора - Строка - каталог из личных настроек; пусто - временный каталог
//   * ПутьКOllama         - Строка - ollama.exe; пусто - команда ollama
//   * ПутьКPython         - Строка
//   * Хост                - Строка - адрес, на котором слушают оркестратор и Ollama
//
Функция ФайлыЛокальногоОркестратора(ИдентификаторФормы) Экспорт

	Результат = Новый Структура("ОписаниеОшибки", "");
	Настройки = mcp_НастройкиLLM.ДействующиеНастройки();
	АдресПубликации = mcp_НастройкиLLM.НастройкиБазы().АдресПубликацииMCP;

	Если Настройки.Режим <> mcp_НастройкиLLM.РежимЛокальный() Тогда
		Результат.ОписаниеОшибки = "Локальный режим не включен в личных настройках";
	ИначеЕсли Не ЗначениеЗаполнено(АдресПубликации) Тогда
		Результат.ОписаниеОшибки = "Администратор не указал адрес публикации MCP в настройках, без него "
			+ "оркестратор не получит инструменты 1С. Обратитесь к администратору.";
	ИначеЕсли Не СтрНачинаетсяС(НРег(Настройки.АдресОркестратора), "http://") Тогда
		Результат.ОписаниеОшибки = "Автозапуск работает с адресом вида http://127.0.0.1:порт. "
			+ "Оркестратор с HTTPS запускайте вручную.";
	Иначе
		ЗаполнитьФайлыЛокальногоОркестратора(Результат, Настройки, АдресПубликации,
			mcp_ОбщегоНазначения.РазобратьURL(Настройки.АдресОркестратора), ИдентификаторФормы);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Адрес страницы монитора оркестратора: журнал запросов с шагами модели. Монитор спрашивает ключ
// администратора оркестратора.
//
// Параметры:
//  АдресОркестратора - Строка - http(s)://хост:порт[/путь]
//
// Возвращаемое значение:
//  Строка - URL монитора; пусто, если адрес оркестратора не задан
//
Функция АдресМонитора(Знач АдресОркестратора) Экспорт

	Если Не ЗначениеЗаполнено(АдресОркестратора) Тогда
		Возврат "";
	КонецЕсли;

	Пока СтрЗаканчиваетсяНа(АдресОркестратора, "/") Цикл
		АдресОркестратора = Лев(АдресОркестратора, СтрДлина(АдресОркестратора) - 1);
	КонецЦикла;
	Возврат АдресОркестратора + "/monitor";

КонецФункции

// Запрос POST /diagnostics к серверному оркестратору: состояние Ollama, связь с MCP и сквозной вызов
// инструмента с токеном. Ответ не разбирается: это делает mcp_ДиагностикаLLM.
//
// Параметры:
//  Токен - Строка - токен вопроса текущего пользователя для сквозной проверки
//
// Возвращаемое значение:
//  Структура - см. НовыйОтветДиагностики
//
Функция ЗапросДиагностики(Токен) Экспорт

	Результат = НовыйОтветДиагностики();
	Подключение = ПодключениеКОркестратору(Результат);
	Если Подключение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Тело = mcp_ОбщегоНазначения.СтруктураВJSON(Новый Структура("mcp_token", Токен));
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Ответ = ВыполнитьЗапрос(Подключение, "POST", "/diagnostics", ТаймаутДиагностики(), Результат, Тело);
	Результат.Миллисекунд = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	Если Ответ <> Неопределено Тогда
		Результат.КодСостояния = Ответ.КодСостояния;
		Результат.Тело         = Ответ.ПолучитьТелоКакСтроку();
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Параметры соединения с локальным оркестратором текущего пользователя: запрос к нему выполняет
// клиент 1С на компьютере пользователя (оркестратор слушает 127.0.0.1). Ключ - личный ключ
// локального оркестратора пользователя, его же форма пишет в файл конфигурации оркестратора.
//
// Параметры:
//  СтруктураОшибки - Структура - с полем ОписаниеОшибки: заполняется, если локальный режим не включен
//
// Возвращаемое значение:
//  Структура, Неопределено - состав описан в ПодключениеКОркестратору
//
Функция ПодключениеКЛокальномуОркестратору(СтруктураОшибки) Экспорт

	Настройки = mcp_НастройкиLLM.ДействующиеНастройки();
	Если Настройки.Режим <> mcp_НастройкиLLM.РежимЛокальный() Тогда
		СтруктураОшибки.ОписаниеОшибки = "Локальный режим не включен в личных настройках";
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПараметрыПодключения(Настройки.АдресОркестратора, Настройки.ПроверятьСертификат,
		mcp_НастройкиLLM.КлючЛокальногоОркестратора(), Настройки.ТаймаутОтвета);

КонецФункции

// Пустой ответ на запрос диагностики оркестратора.
//
// Возвращаемое значение:
//  Структура:
//   * КодСостояния     - Число - код HTTP; 0, если оркестратор не ответил
//   * Тело             - Строка - JSON ответа
//   * Миллисекунд      - Число - время ответа
//   * ОписаниеОшибки   - Строка - причина, по которой запрос не выполнен
//   * ОшибкаСоединения - Булево
//
Функция НовыйОтветДиагностики() Экспорт

	Результат = Новый Структура("КодСостояния, Тело, Миллисекунд", 0, "", 0);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("ОшибкаСоединения", Ложь);
	Возврат Результат;

КонецФункции

// Сколько секунд ждать ответа на POST /diagnostics: оркестратор опрашивает Ollama и MCP.
//
// Возвращаемое значение:
//  Число
//
Функция ТаймаутДиагностики() Экспорт

	Возврат 90;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры соединения с серверным оркестратором из настроек базы и его ключ.
//
// Параметры:
//  СтруктураОшибки - Структура - с полями ОписаниеОшибки и ОшибкаСоединения: заполняется, если
//                                соединиться нельзя
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если оркестратор не настроен:
//   * Хост                - Строка
//   * Порт                - Число
//   * Путь                - Строка - путь публикации оркестратора без завершающей косой черты
//   * Защищенное          - Булево - адрес начинается с https
//   * ПроверятьСертификат - Булево
//   * Ключ                - Строка - ключ клиента оркестратора
//   * ТаймаутОтвета       - Число - секунд ожидания ответа модели
//
Функция ПодключениеКОркестратору(СтруктураОшибки)

	// В безопасном режиме платформа запрещает исходящие HTTP-соединения, вопрос до оркестратора не дойдет
	Если БезопасныйРежим() <> Ложь Тогда
		СтруктураОшибки.ОписаниеОшибки = ОписаниеОшибкиБезопасногоРежима();
		Возврат Неопределено;
	КонецЕсли;

	Настройки = mcp_НастройкиLLM.ДействующиеНастройки();
	Если Настройки.Режим <> mcp_НастройкиLLM.РежимСерверный() Тогда
		СтруктураОшибки.ОписаниеОшибки = "Включен локальный режим: вопрос отправляет клиент 1С на этом компьютере, "
			+ "а не сервер.";
		Возврат Неопределено;
	КонецЕсли;
	Если Не Настройки.Настроено Тогда
		СтруктураОшибки.ОписаниеОшибки = "Серверный оркестратор не настроен: не задан адрес или ключ. "
			+ "Обратитесь к администратору.";
		Возврат Неопределено;
	КонецЕсли;

	Ключ = КлючСерверногоОркестратора();
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		СтруктураОшибки.ОписаниеОшибки = "Ключ серверного оркестратора не записан. Обратитесь к администратору.";
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПараметрыПодключения(Настройки.АдресОркестратора, Настройки.ПроверятьСертификат, Ключ,
		Настройки.ТаймаутОтвета);

КонецФункции

// Параметры соединения по адресу оркестратора.
//
// Параметры:
//  АдресОркестратора   - Строка - http(s)://хост:порт[/путь]
//  ПроверятьСертификат - Булево
//  Ключ                - Строка - ключ клиента оркестратора
//  ТаймаутОтвета       - Число - секунд ожидания ответа модели
//
// Возвращаемое значение:
//  Структура - состав описан в ПодключениеКОркестратору
//
Функция ПараметрыПодключения(АдресОркестратора, ПроверятьСертификат, Ключ, ТаймаутОтвета)

	ЧастиАдреса = mcp_ОбщегоНазначения.РазобратьURL(АдресОркестратора);
	Путь = ЧастиАдреса.Путь;
	Пока СтрЗаканчиваетсяНа(Путь, "/") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;

	Подключение = Новый Структура;
	Подключение.Вставить("Хост",                ЧастиАдреса.Хост);
	Подключение.Вставить("Порт",                ЧастиАдреса.Порт);
	Подключение.Вставить("Путь",                Путь);
	Подключение.Вставить("Защищенное",          ЧастиАдреса.Схема = "https");
	Подключение.Вставить("ПроверятьСертификат", ПроверятьСертификат);
	Подключение.Вставить("Ключ",                Ключ);
	Подключение.Вставить("ТаймаутОтвета",       ТаймаутОтвета);

	Возврат Подключение;

КонецФункции

// Разбирает ответы оркестратора на запросы состояния вопроса и его событий. Когда запрос завершен,
// переносит ответ модели и отзывает токен вопроса.
//
// Параметры:
//  ИдентификаторЗапроса - Строка
//  ПоследнийНомер       - Число - номер последнего события, которое форма уже получила
//  ОтветСостояния       - Структура - см. ОтветHTTP
//  ОтветСобытий         - Структура - см. ОтветHTTP
//
// Возвращаемое значение:
//  Структура - см. СостояниеВопроса
//
Функция РазобратьСостояниеВопроса(ИдентификаторЗапроса, ПоследнийНомер, ОтветСостояния, ОтветСобытий)

	Результат = Новый Структура;
	Результат.Вставить("Связь",    Ложь);
	Результат.Вставить("Номер",    ПоследнийНомер);
	Результат.Вставить("События",  Новый Массив);
	Результат.Вставить("Завершен", Ложь);
	Результат.Вставить("Ответ",    НовыйОтвет());

	Если ОтветСобытий.КодСостояния = КодУспеха() Тогда
		Данные = mcp_ОбщегоНазначения.JSONВСтруктуру(ОтветСобытий.Тело);
		Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("events") И ТипЗнч(Данные.events) = Тип("Массив") Тогда
			Результат.Связь = Истина;
			Для Каждого Событие Из Данные.events Цикл
				Результат.События.Добавить(Событие);
				Результат.Номер = Макс(Результат.Номер, Событие.seq);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	КодЗапросНеНайден = 404;
	Если ОтветСостояния.КодСостояния = КодЗапросНеНайден Тогда
		Результат.Завершен = Истина;
		Результат.Ответ.ОписаниеОшибки = "Оркестратор не знает этот запрос: вероятно, оркестратор перезапускали, "
			+ "пока модель отвечала. Задайте вопрос еще раз.";
		mcp_ДоступПользователей.ОтозватьТокеныЗапроса(ИдентификаторЗапроса);
		Возврат Результат;
	КонецЕсли;
	Если ОтветСостояния.КодСостояния <> КодУспеха() Тогда
		Возврат Результат;
	КонецЕсли;

	Данные = mcp_ОбщегоНазначения.JSONВСтруктуру(ОтветСостояния.Тело);
	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("status") Или Данные.status = "running" Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Завершен = Истина;
	Если Данные.Свойство("response") Тогда
		ЗаполнитьОтвет(Результат.Ответ, Данные.response);
	КонецЕсли;
	mcp_ДоступПользователей.ОтозватьТокеныЗапроса(ИдентификаторЗапроса);

	Возврат Результат;

КонецФункции

// Код и тело HTTP-ответа оркестратора в виде, общем для запросов сервера и клиента.
//
// Параметры:
//  Ответ - HTTPОтвет, Неопределено - Неопределено, если оркестратор не ответил
//
// Возвращаемое значение:
//  Структура:
//   * КодСостояния - Число - 0, если оркестратор не ответил
//   * Тело         - Строка
//
Функция ОтветHTTP(Ответ)

	Результат = Новый Структура("КодСостояния, Тело", 0, "");
	Если Ответ <> Неопределено Тогда
		Результат.КодСостояния = Ответ.КодСостояния;
		Результат.Тело         = Ответ.ПолучитьТелоКакСтроку();
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Заполняет файлы для автозапуска локального оркестратора, см. ФайлыЛокальногоОркестратора.
// Модель Ollama в файл не пишется: оркестратор берет ее из переменной окружения OLLAMA_MODEL или
// использует свою по умолчанию. Адрес Ollama пишется с тем же хостом, что у оркестратора: имя localhost
// в Windows сначала разрешается в IPv6, и каждый запрос к Ollama на 127.0.0.1 теряет около двух секунд.
//
// Параметры:
//  Результат          - Структура - результат ФайлыЛокальногоОркестратора
//  Настройки          - Структура - см. mcp_НастройкиLLM.ДействующиеНастройки
//  АдресПубликации    - Строка - адрес HTTP-сервиса mcp_APIBackend с /hs/mcp
//  ЧастиАдреса        - Структура - разобранный адрес локального оркестратора, см. mcp_ОбщегоНазначения.РазобратьURL
//  ИдентификаторФормы - УникальныйИдентификатор - владелец временного хранилища
//
Процедура ЗаполнитьФайлыЛокальногоОркестратора(Результат, Настройки, АдресПубликации, ЧастиАдреса,
	ИдентификаторФормы)

	Ключ = mcp_НастройкиLLM.КлючЛокальногоОркестратора();
	Конфигурация = Новый Структура;
	Конфигурация.Вставить("ollama_url",     СтрШаблон("http://%1:11434/api/generate", ЧастиАдреса.Хост));
	Конфигурация.Вставить("mcp_url",        АдресПубликации);
	Конфигурация.Вставить("mcp_verify_ssl", Настройки.ПроверятьСертификат);
	Конфигурация.Вставить("host",           ЧастиАдреса.Хост);
	Конфигурация.Вставить("port",           ЧастиАдреса.Порт);
	Конфигурация.Вставить("client_key",     Ключ);
	Конфигурация.Вставить("admin_key",      Ключ);
	ДанныеКонфигурации = ПолучитьДвоичныеДанныеИзСтроки(mcp_ОбщегоНазначения.СтруктураВJSON(Конфигурация),
		КодировкаТекста.UTF8, Ложь);
	Скрипт = Обработки.АнализКонфигурацииMCP.ПолучитьМакет("LLM_Orchestrator");

	Результат.Вставить("ИмяСкрипта",          "LLM_Orchestrator.py");
	Результат.Вставить("АдресСкрипта",        ПоместитьВоВременноеХранилище(Скрипт, ИдентификаторФормы));
	Результат.Вставить("ИмяКонфигурации",     "LLM_Orchestrator.1c.config.json");
	Результат.Вставить("АдресКонфигурации",   ПоместитьВоВременноеХранилище(ДанныеКонфигурации, ИдентификаторФормы));
	Результат.Вставить("КаталогОркестратора", Настройки.КаталогОркестратора);
	Результат.Вставить("ПутьКOllama",         Настройки.ПутьКOllama);
	Результат.Вставить("ПутьКPython",         Настройки.ПутьКPython);
	Результат.Вставить("Хост",                ЧастиАдреса.Хост);

КонецПроцедуры

// Код HTTP успешного ответа.
//
// Возвращаемое значение:
//  Число
//
Функция КодУспеха()

	Возврат 200;

КонецФункции

// Код HTTP, которым оркестратор подтверждает, что принял вопрос в работу.
//
// Возвращаемое значение:
//  Число
//
Функция КодПринято()

	Возврат 202;

КонецФункции

// Выполняет HTTP-запрос к оркестратору с ключом клиента в заголовке Authorization.
//
// Параметры:
//  Подключение     - Структура - из ПодключениеКОркестратору
//  Метод           - Строка - GET или POST
//  АдресРесурса    - Строка - путь относительно адреса оркестратора, начинается с /
//  Таймаут         - Число - секунд
//  СтруктураОшибки - Структура - с полями ОписаниеОшибки и ОшибкаСоединения: заполняется при сбое связи
//  Тело            - Строка, Неопределено - тело запроса JSON
//
// Возвращаемое значение:
//  HTTPОтвет, Неопределено - Неопределено, если оркестратор не ответил
//
Функция ВыполнитьЗапрос(Подключение, Метод, АдресРесурса, Таймаут, СтруктураОшибки, Тело = Неопределено)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Подключение.Ключ);
	Если Тело <> Неопределено Тогда
		Заголовки.Вставить("Content-Type", "application/json");
	КонецЕсли;

	HTTPЗапрос = Новый HTTPЗапрос(Подключение.Путь + АдресРесурса, Заголовки);
	Если Тело <> Неопределено Тогда
		HTTPЗапрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Если Не Подключение.Защищенное Тогда
		ЗащищенноеСоединение = Неопределено;
	ИначеЕсли Подключение.ПроверятьСертификат Тогда
		ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение();
	Иначе
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;

	Попытка
		Соединение = Новый HTTPСоединение(Подключение.Хост, Подключение.Порт, , , , Таймаут, ЗащищенноеСоединение);
		Возврат Соединение.ВызватьHTTPМетод(Метод, HTTPЗапрос);
	Исключение
		СтруктураОшибки.ОшибкаСоединения = Истина;
		СтруктураОшибки.ОписаниеОшибки   = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Ключ клиента серверного оркестратора из безопасного хранилища. Функция не экспортная: ключ
// не возвращается ни клиенту, ни во внешнее соединение, он уходит только в заголовок запроса.
//
// Возвращаемое значение:
//  Строка - ключ; пусто, если не записан
//
Функция КлючСерверногоОркестратора()

	Расположение = mcp_НастройкиLLM.РасположениеКлючаОркестратора(mcp_НастройкиLLM.РежимСерверный());

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Ключ = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Расположение.Владелец, Расположение.Ключ);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если ТипЗнч(Ключ) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Возврат Ключ;

КонецФункции

// Тело вопроса для оркестратора: текст, идентификатор запроса, пользователь для журнала и токен,
// с которым оркестратор вызывает инструменты MCP.
//
// Параметры:
//  Вопрос               - Строка - текст вопроса
//  ИдентификаторЗапроса - Строка - идентификатор запроса в журнале оркестратора
//  Токен                - Строка - токен вопроса из mcp_ДоступПользователей.ВыпуститьТокенЗапроса
//
// Возвращаемое значение:
//  Строка - JSON
//
Функция ТелоВопроса(Вопрос, ИдентификаторЗапроса, Токен)

	ТелоСтруктура = Новый Структура;
	ТелоСтруктура.Вставить("text",       Вопрос);
	ТелоСтруктура.Вставить("request_id", ИдентификаторЗапроса);
	ТелоСтруктура.Вставить("user",       Строка(Пользователи.АвторизованныйПользователь()));
	ТелоСтруктура.Вставить("mcp_token",  Токен);

	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(ТелоСтруктура);

КонецФункции

// Переносит ответ оркестратора (поля Success, Text, Result) в структуру ответа формы.
//
// Параметры:
//  СтруктураОтвета - Структура - из НовыйОтвет
//  Данные          - Структура, Произвольный - разобранный JSON ответа
//
Процедура ЗаполнитьОтвет(СтруктураОтвета, Данные)

	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("Result") Тогда
		СтруктураОтвета.ОписаниеОшибки = "Пустой или некорректный JSON в ответе LLM";
		Возврат;
	КонецЕсли;

	СтруктураОтвета.Ответ     = Данные.Success;
	СтруктураОтвета.Текст     = Данные.Text;
	СтруктураОтвета.Результат = Данные.Result;
	Если Не СтруктураОтвета.Ответ Тогда
		СтруктураОтвета.ОписаниеОшибки = Данные.Text;
	КонецЕсли;

КонецПроцедуры

// Текст для пользователя по ответу оркестратора с кодом ошибки.
//
// Параметры:
//  КодСостояния - Число - код HTTP ответа
//  Тело         - Строка - JSON ответа
//
// Возвращаемое значение:
//  Строка
//
Функция ОписаниеОтказа(КодСостояния, Тело)

	Данные = mcp_ОбщегоНазначения.JSONВСтруктуру(Тело);
	Сообщение = "";
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		ТекстОтвета = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "Text", "");
		Сообщение = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "message", ТекстОтвета);
	КонецЕсли;

	КодНеверногоКлюча = 401;
	Если КодСостояния = КодНеверногоКлюча Тогда
		Возврат "Оркестратор не принял ключ: ключ в настройках 1С не совпадает с client_key в файле "
			+ "конфигурации оркестратора. Проверьте подключение кнопкой ""Проверить"" в настройках.";
	КонецЕсли;

	Возврат СтрШаблон("Оркестратор отказал (код HTTP %1). %2", КодСостояния, Сообщение);

КонецФункции

// Текст для пользователя, когда расширение подключено в безопасном режиме: HTTP-сервис MCP в этом
// режиме работает, а форма не может отправить вопрос оркестратору.
//
// Возвращаемое значение:
//  Строка
//
Функция ОписаниеОшибкиБезопасногоРежима()

	Возврат "Расширение MCP_Сервер подключено в безопасном режиме, а в нем платформа запрещает исходящие "
		+ "HTTP-запросы, поэтому вопрос не может уйти оркестратору. "
		+ "Снимите флажок ""Безопасный режим"" у расширения в разделе Администрирование - Печатные формы, "
		+ "отчеты и обработки - Расширения и перезапустите сеанс. HTTP-сервис MCP работает в обоих режимах.";

КонецФункции

// Пустой ответ оркестратора.
//
// Возвращаемое значение:
//  Структура - состав полей описан в ОтправитьВопрос
//
Функция НовыйОтвет()

	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("Ответ",            Ложь);
	СтруктураОтвета.Вставить("Текст",            "");
	СтруктураОтвета.Вставить("Результат",        Неопределено);
	СтруктураОтвета.Вставить("ОписаниеОшибки",   "");
	СтруктураОтвета.Вставить("ОшибкаСоединения", Ложь);
	СтруктураОтвета.Вставить("ХодВыполнения",    Новый Массив);

	Возврат СтруктураОтвета;

КонецФункции

#КонецОбласти
