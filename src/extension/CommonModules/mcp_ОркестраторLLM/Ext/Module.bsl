
#Область ПрограммныйИнтерфейс

// Отправляет вопрос LLM-оркестратору и ждет итоговый ответ модели.
// Ход выполнения оркестратор отдает отдельно, по идентификатору запроса (см. СобытияЗапроса),
// поэтому форма показывает шаги модели, пока эта функция ждет ответа.
//
// Параметры:
//  Вопрос               - Строка - текст вопроса пользователя
//  ИдентификаторЗапроса - Строка - идентификатор, под которым оркестратор ведет журнал запроса
//
// Возвращаемое значение:
//  Структура - ответ оркестратора:
//   * Ответ            - Булево - Истина, если модель вернула успешный ответ
//   * Текст            - Строка - краткий ответ модели или описание ошибки
//   * Результат        - Произвольный - данные из поля Result ответа
//   * ОписаниеОшибки   - Строка - текст ошибки, когда Ответ = Ложь
//   * ОшибкаСоединения - Булево - оркестратор не ответил на запрос
//   * ХодВыполнения    - Массив из Структура - события журнала оркестратора по запросу
//
Функция ОтправитьВопрос(Вопрос, ИдентификаторЗапроса) Экспорт

	СтруктураОтвета = НовыйОтвет();

	// В безопасном режиме платформа запрещает исходящие HTTP-соединения, вопрос до оркестратора не дойдет
	Если БезопасныйРежим() <> Ложь Тогда
		СтруктураОтвета.ОписаниеОшибки = ОписаниеОшибкиБезопасногоРежима();
		Возврат СтруктураОтвета;
	КонецЕсли;

	ТелоСтруктура = Новый Структура;
	ТелоСтруктура.Вставить("text", Вопрос);
	ТелоСтруктура.Вставить("request_id", ИдентификаторЗапроса);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");

	HTTPЗапрос = Новый HTTPЗапрос("/", Заголовки);
	HTTPЗапрос.УстановитьТелоИзСтроки(mcp_ОбщегоНазначения.СтруктураВJSON(ТелоСтруктура), КодировкаТекста.UTF8);

	Попытка
		// Таймаут равен таймауту LLM в оркестраторе (LLM_TIMEOUT)
		Соединение = Новый HTTPСоединение(АдресОркестратора(), ПортОркестратора(), , , , 1800);
		Ответ = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
		СтруктураОтвета.ОшибкаСоединения = Истина;
		СтруктураОтвета.ОписаниеОшибки   = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат СтруктураОтвета;
	КонецПопытки;

	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	Данные = mcp_ОбщегоНазначения.JSONВСтруктуру(ТелоОтвета);

	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("Trace") И ТипЗнч(Данные.Trace) = Тип("Массив") Тогда
		СтруктураОтвета.ХодВыполнения = Данные.Trace;
	КонецЕсли;

	Если Ответ.КодСостояния <> 200 Тогда
		СтруктураОтвета.ОписаниеОшибки = "Ошибка LLM. Код HTTP: " + Ответ.КодСостояния + Символы.ПС + ТелоОтвета;
		Возврат СтруктураОтвета;
	КонецЕсли;

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		СтруктураОтвета.ОписаниеОшибки = "Пустой или некорректный JSON в ответе LLM";
		Возврат СтруктураОтвета;
	КонецЕсли;

	Если Не Данные.Свойство("Result") Тогда
		СтруктураОтвета.ОписаниеОшибки = "Некорректный ответ от LLM";
		Возврат СтруктураОтвета;
	КонецЕсли;

	СтруктураОтвета.Ответ     = Данные.Success;
	СтруктураОтвета.Текст     = Данные.Text;
	СтруктураОтвета.Результат = Данные.Result;
	Если Не СтруктураОтвета.Ответ Тогда
		СтруктураОтвета.ОписаниеОшибки = Данные.Text;
	КонецЕсли;

	Возврат СтруктураОтвета;

КонецФункции

// Тело фонового задания формы обработки АнализКонфигурацииMCP: отправляет вопрос оркестратору
// и помещает ответ во временное хранилище, откуда его забирает форма.
//
// Параметры:
//  Вопрос               - Строка - текст вопроса пользователя
//  ИдентификаторЗапроса - Строка - идентификатор запроса в журнале оркестратора
//  АдресРезультата      - Строка - адрес временного хранилища, созданного формой
//
Процедура ОтправитьВопросВФоне(Вопрос, ИдентификаторЗапроса, АдресРезультата) Экспорт

	ПоместитьВоВременноеХранилище(ОтправитьВопрос(Вопрос, ИдентификаторЗапроса), АдресРезультата);

КонецПроцедуры

// Читает из журнала оркестратора события запроса, появившиеся после указанного номера.
// Ошибки связи не прерывают работу формы: они возвращаются признаком Связь.
//
// Параметры:
//  ИдентификаторЗапроса - Строка - идентификатор запроса в журнале оркестратора
//  ПоследнийНомер       - Число - номер последнего события, которое форма уже получила
//
// Возвращаемое значение:
//  Структура:
//   * Связь   - Булево - оркестратор ответил
//   * Номер   - Число - номер последнего полученного события
//   * События - Массив из Структура - новые события журнала в порядке появления
//
Функция СобытияЗапроса(ИдентификаторЗапроса, ПоследнийНомер) Экспорт

	Результат = Новый Структура("Связь, Номер, События", Ложь, ПоследнийНомер, Новый Массив);

	АдресРесурса = СтрШаблон("/events?request=%1&since=%2", ИдентификаторЗапроса, Формат(ПоследнийНомер, "ЧН=0; ЧГ="));
	Если БезопасныйРежим() <> Ложь Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Соединение = Новый HTTPСоединение(АдресОркестратора(), ПортОркестратора(), , , , 3);
		Ответ = Соединение.Получить(Новый HTTPЗапрос(АдресРесурса));
	Исключение
		Возврат Результат;
	КонецПопытки;

	Если Ответ.КодСостояния <> 200 Тогда
		Возврат Результат;
	КонецЕсли;

	Данные = mcp_ОбщегоНазначения.JSONВСтруктуру(Ответ.ПолучитьТелоКакСтроку());
	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("events") Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Связь = Истина;
	Для Каждого Событие Из Данные.events Цикл
		Результат.События.Добавить(Событие);
		Результат.Номер = Макс(Результат.Номер, Событие.seq);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Адрес страницы монитора оркестратора: журнал всех запросов с шагами модели.
//
// Возвращаемое значение:
//  Строка - URL монитора
//
Функция АдресМонитора() Экспорт

	Возврат СтрШаблон("http://%1:%2/monitor", АдресОркестратора(), Формат(ПортОркестратора(), "ЧГ="));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имя компьютера, на котором работает оркестратор. Оркестратор слушает только 127.0.0.1,
// поэтому он запускается на том же компьютере, где выполняется серверный код 1С.
Функция АдресОркестратора()

	Возврат "localhost";

КонецФункции

// Порт оркестратора: значение ORCHESTRATOR_PORT по умолчанию.
Функция ПортОркестратора()

	Возврат 9000;

КонецФункции

// Текст для пользователя, когда расширение подключено в безопасном режиме: HTTP-сервис MCP в этом
// режиме работает, а форма не может отправить вопрос оркестратору.
Функция ОписаниеОшибкиБезопасногоРежима()

	Возврат "Расширение MCP_Сервер подключено в безопасном режиме, а в нем платформа запрещает исходящие "
		+ "HTTP-запросы, поэтому форма не может передать вопрос оркестратору на localhost:9000. "
		+ "Снимите флажок ""Безопасный режим"" у расширения в разделе Администрирование - Печатные формы, "
		+ "отчеты и обработки - Расширения и перезапустите сеанс. HTTP-сервис MCP работает в обоих режимах.";

КонецФункции

// Пустой ответ оркестратора: состав полей описан в ОтправитьВопрос.
Функция НовыйОтвет()

	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("Ответ",            Ложь);
	СтруктураОтвета.Вставить("Текст",            "");
	СтруктураОтвета.Вставить("Результат",        Неопределено);
	СтруктураОтвета.Вставить("ОписаниеОшибки",   "");
	СтруктураОтвета.Вставить("ОшибкаСоединения", Ложь);
	СтруктураОтвета.Вставить("ХодВыполнения",    Новый Массив);

	Возврат СтруктураОтвета;

КонецФункции

#КонецОбласти
