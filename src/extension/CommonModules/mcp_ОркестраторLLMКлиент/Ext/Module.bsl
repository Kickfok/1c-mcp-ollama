#Область ПрограммныйИнтерфейс

// Выполняет HTTP-запрос к локальному оркестратору с компьютера пользователя: оркестратор слушает
// 127.0.0.1, поэтому сервер 1С до него не достает. В веб-клиенте исходящие HTTP-соединения
// недоступны - локальный режим работает в тонком клиенте.
//
// Параметры:
//  Подключение  - Структура - см. mcp_ОркестраторLLM.ПодключениеКЛокальномуОркестратору
//  Метод        - Строка - GET или POST
//  АдресРесурса - Строка - путь относительно адреса оркестратора, начинается с /
//  Тело         - Строка, Неопределено - тело запроса JSON
//  Таймаут      - Число - секунд
//
// Возвращаемое значение:
//  Структура - см. mcp_ОркестраторLLM.НовыйОтветДиагностики
//
Функция ВыполнитьЗапрос(Подключение, Метод, АдресРесурса, Тело, Таймаут) Экспорт

	Результат = Новый Структура("КодСостояния, Тело, Миллисекунд", 0, "", 0);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("ОшибкаСоединения", Ложь);

#Если ВебКлиент Тогда
	Результат.ОписаниеОшибки = "В веб-клиенте нет доступа к оркестратору на компьютере пользователя: "
		+ "для локального режима откройте базу в тонком клиенте";
	Результат.Вставить("ВебКлиент", Истина);
#Иначе
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Подключение.Ключ);
	Если Тело <> Неопределено Тогда
		Заголовки.Вставить("Content-Type", "application/json");
	КонецЕсли;

	HTTPЗапрос = Новый HTTPЗапрос(Подключение.Путь + АдресРесурса, Заголовки);
	Если Тело <> Неопределено Тогда
		HTTPЗапрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Если Не Подключение.Защищенное Тогда
		ЗащищенноеСоединение = Неопределено;
	ИначеЕсли Подключение.ПроверятьСертификат Тогда
		ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение();
	Иначе
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Соединение = Новый HTTPСоединение(Подключение.Хост, Подключение.Порт, , , , Таймаут, ЗащищенноеСоединение);
		Ответ = Соединение.ВызватьHTTPМетод(Метод, HTTPЗапрос);
		Результат.КодСостояния = Ответ.КодСостояния;
		Результат.Тело         = Ответ.ПолучитьТелоКакСтроку();
	Исключение
		Результат.ОшибкаСоединения = Истина;
		Результат.ОписаниеОшибки   = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Результат.Миллисекунд = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
#КонецЕсли

	Возврат Результат;

КонецФункции

#КонецОбласти
