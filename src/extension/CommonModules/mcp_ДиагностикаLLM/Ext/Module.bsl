#Область ПрограммныйИнтерфейс

// Начинает проверку настройки подключения к LLM для текущего пользователя в его режиме работы.
// Проверки 1-3 выполняются сразу. В серверном режиме сервер сам обращается к оркестратору
// (проверки 4-8), проверяет канал (9) и публикацию (10) - диагностика завершается в этом вызове.
// В локальном режиме оркестратор слушает компьютер пользователя: запрос к нему выполняет клиент
// по полю ЗапросКлиента, а итог собирает ЗавершитьДиагностику.
//
// Для сквозной проверки выпускается токен вопроса текущего пользователя; он отзывается в конце.
//
// Возвращаемое значение:
//  Структура:
//   * Режим                 - Строка - Серверный или Локальный
//   * Завершена             - Булево - все проверки выполнены, итог в поле HTML
//   * HTML                  - Строка - отчет о проверках
//   * Проверки              - Массив из Структура - см. НоваяПроверка; номера проставляются по порядку
//   * ИдентификаторПроверки - Строка - идентификатор токена сквозной проверки
//   * ЗапросКлиента         - Структура, Неопределено - для локального режима:
//      ** Подключение - Структура - см. mcp_ОркестраторLLM.ПодключениеКЛокальномуОркестратору
//      ** Тело        - Строка - тело POST /diagnostics
//      ** Таймаут     - Число - секунд ожидания ответа
//
Функция НачатьДиагностику() Экспорт

	Настройки = mcp_НастройкиLLM.ДействующиеНастройки();

	Состояние = Новый Структура;
	Состояние.Вставить("Режим",                 Настройки.Режим);
	Состояние.Вставить("Завершена",             Ложь);
	Состояние.Вставить("HTML",                  "");
	Состояние.Вставить("Проверки",              Новый Массив);
	Состояние.Вставить("ИдентификаторПроверки", "diagnostics-" + Строка(Новый УникальныйИдентификатор));
	Состояние.Вставить("ЗапросКлиента",         Неопределено);

	Проверки = Состояние.Проверки;
	Проверки.Добавить(ПроверкаПрав());
	Проверки.Добавить(ПроверкаБезопасногоРежима());
	Проверки.Добавить(ПроверкаКлюча(Настройки));

	ПричинаПропуска = ПричинаПропускаЗапроса(Настройки);
	Если ЗначениеЗаполнено(ПричинаПропуска) Тогда
		ДобавитьПропущенныеПроверкиОркестратора(Проверки, ПричинаПропуска);
		Проверки.Добавить(ПроверкаКанала(Настройки.АдресОркестратора));
		Проверки.Добавить(ПроверкаПубликации());
		ЗавершитьСостояние(Состояние);
		Возврат Состояние;
	КонецЕсли;

	Токен = mcp_ДоступПользователей.ВыпуститьТокенЗапроса(Состояние.ИдентификаторПроверки);
	Тело = mcp_ОбщегоНазначения.СтруктураВJSON(Новый Структура("mcp_token", Токен));

	Если Настройки.Режим = mcp_НастройкиLLM.РежимЛокальный() Тогда
		ОписаниеОшибки = Новый Структура("ОписаниеОшибки", "");
		Подключение = mcp_ОркестраторLLM.ПодключениеКЛокальномуОркестратору(ОписаниеОшибки);
		Состояние.ЗапросКлиента = Новый Структура("Подключение, Тело", Подключение, Тело);
		Состояние.ЗапросКлиента.Вставить("Таймаут", mcp_ОркестраторLLM.ТаймаутДиагностики());
		Возврат Состояние;
	КонецЕсли;

	Ответ = mcp_ОркестраторLLM.ЗапросДиагностики(Токен);
	Возврат ЗавершитьДиагностику(Состояние, Ответ);

КонецФункции

// Завершает диагностику по ответу оркестратора на POST /diagnostics: проверки 4-10, итоговый HTML,
// отзыв токена сквозной проверки.
//
// Параметры:
//  Состояние         - Структура - из НачатьДиагностику
//  ОтветОркестратора - Структура - см. mcp_ОркестраторLLM.НовыйОтветДиагностики
//
// Возвращаемое значение:
//  Структура - Состояние с заполненными Проверки и HTML
//
Функция ЗавершитьДиагностику(Знач Состояние, Знач ОтветОркестратора) Экспорт

	Состояние.ЗапросКлиента = Неопределено;
	Настройки = mcp_НастройкиLLM.ДействующиеНастройки();

	Отчет = mcp_ОбщегоНазначения.JSONВСтруктуру(ОтветОркестратора.Тело);
	Если ТипЗнч(Отчет) <> Тип("Структура") Тогда
		Отчет = Новый Структура;
	КонецЕсли;

	Проверки = Состояние.Проверки;
	Проверки.Добавить(ПроверкаДоступности(ОтветОркестратора, Состояние.Режим));
	Проверки.Добавить(ПроверкаОтветаНаКлюч(ОтветОркестратора, Состояние.Режим));
	Если ОтветОркестратора.КодСостояния = КодУспеха() Тогда
		Ollama = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Отчет, "ollama");
		MCP = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Отчет, "mcp");
		ВызовИнструмента = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Отчет, "tool_call");
		Проверки.Добавить(ПроверкаOllama(Ollama));
		Проверки.Добавить(ПроверкаMCP(MCP, Состояние.Режим));
		Проверки.Добавить(ПроверкаСквозная(ВызовИнструмента));
	Иначе
		Причина = "оркестратор не выполнил диагностику";
		Проверки.Добавить(ПроверкаПропущена("Ollama и модель", Причина));
		Проверки.Добавить(ПроверкаПропущена("Связь оркестратора с MCP-сервером 1С", Причина));
		Проверки.Добавить(ПроверкаПропущена("Сквозной вызов инструмента с токеном", Причина));
	КонецЕсли;
	Проверки.Добавить(ПроверкаКанала(Настройки.АдресОркестратора));
	Проверки.Добавить(ПроверкаПубликации());

	mcp_ДоступПользователей.ОтозватьТокеныЗапроса(Состояние.ИдентификаторПроверки);
	ЗавершитьСостояние(Состояние);

	Возврат Состояние;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Проверки

// Проверка 1: может ли текущий пользователь менять настройки базы.
//
// Возвращаемое значение:
//  Структура - см. НоваяПроверка
//
Функция ПроверкаПрав()

	Название = "Права на настройку";
	Если mcp_НастройкиLLM.ЭтоАдминистратор() Тогда
		Возврат ПроверкаПройдена(Название, "Полные права: доступны настройки базы, пользователи и токены");
	КонецЕсли;

	Возврат ПроверкаПропущена(Название, "Настройки базы меняет администратор; вам доступны личные настройки");

КонецФункции

// Проверка 2: безопасный режим расширения запрещает исходящие HTTP-соединения.
//
// Возвращаемое значение:
//  Структура - см. НоваяПроверка
//
Функция ПроверкаБезопасногоРежима()

	Название = "Безопасный режим расширения";
	Если БезопасныйРежим() = Ложь Тогда
		Возврат ПроверкаПройдена(Название, "Выключен: расширению доступны HTTP-соединения");
	КонецЕсли;

	Подсказка = "Снимите флажок ""Безопасный режим"" у расширения MCP_Сервер (Администрирование - Печатные формы, "
		+ "отчеты и обработки - Расширения) и перезапустите сеанс";
	Возврат ПроверкаСОшибкой(Название, "Включен: платформа запрещает расширению обращаться к оркестратору", Подсказка);

КонецФункции

// Проверка 3: адрес оркестратора задан и ключ записан в безопасное хранилище БСП.
//
// Параметры:
//  Настройки - Структура - см. mcp_НастройкиLLM.ДействующиеНастройки
//
// Возвращаемое значение:
//  Структура - см. НоваяПроверка
//
Функция ПроверкаКлюча(Настройки)

	Название = "Адрес и ключ оркестратора";
	Если Не ЗначениеЗаполнено(Настройки.АдресОркестратора) Тогда
		Подсказка = ПодсказкаНастройки(Настройки.Режим);
		Возврат ПроверкаСОшибкой(Название, "Адрес оркестратора не задан", Подсказка);
	КонецЕсли;

	Если Настройки.Режим = mcp_НастройкиLLM.РежимЛокальный() Тогда
		mcp_НастройкиLLM.КлючЛокальногоОркестратора();
		Возврат ПроверкаПройдена(Название, "Личный ключ локального оркестратора записан в безопасное хранилище БСП");
	КонецЕсли;

	Если Не Настройки.ЕстьКлюч Тогда
		Возврат ПроверкаСОшибкой(Название, "Ключ серверного оркестратора не записан",
			"Вставьте client_key из файла конфигурации оркестратора в поле ""Ключ"" и сохраните настройки");
	КонецЕсли;

	Возврат ПроверкаПройдена(Название, "Ключ записан в безопасное хранилище БСП");

КонецФункции

// Проверка 4: оркестратор ответил.
//
// Параметры:
//  Ответ - Структура - см. mcp_ОркестраторLLM.НовыйОтветДиагностики
//  Режим - Строка
//
// Возвращаемое значение:
//  Структура - см. НоваяПроверка
//
Функция ПроверкаДоступности(Ответ, Режим)

	Название = "Оркестратор доступен";
	Если Ответ.КодСостояния <> 0 Тогда
		Длительность = Формат(Ответ.Миллисекунд, "ЧН=0; ЧГ=");
		Текст = СтрШаблон("Ответил; диагностика вместе с опросом Ollama и MCP заняла %1 мс", Длительность);
		Возврат ПроверкаПройдена(Название, Текст);
	КонецЕсли;

	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Ответ, "ВебКлиент", Ложь) Тогда
		Подсказка = "Локальный режим работает в тонком клиенте; в веб-клиенте выключите его в личных настройках";
	ИначеЕсли Режим = mcp_НастройкиLLM.РежимЛокальный() Тогда
		Подсказка = "Запустите оркестратор на этом компьютере или включите автозапуск в личных настройках";
	Иначе
		Подсказка = "Проверьте, что оркестратор запущен, адрес и порт верны, брандмауэр пропускает "
			+ "соединения с сервера 1С";
	КонецЕсли;
	Возврат ПроверкаСОшибкой(Название, "Не отвечает: " + Ответ.ОписаниеОшибки, Подсказка);

КонецФункции

// Проверка 5: оркестратор принял ключ.
//
// Параметры:
//  Ответ - Структура - см. mcp_ОркестраторLLM.НовыйОтветДиагностики
//  Режим - Строка
//
// Возвращаемое значение:
//  Структура - см. НоваяПроверка
//
Функция ПроверкаОтветаНаКлюч(Ответ, Режим)

	Название = "Ключ принят оркестратором";
	КодНеверногоКлюча = 401;
	КодБлокировки = 429;
	ДлинаФрагментаОтвета = 200;

	Если Ответ.КодСостояния = 0 Тогда
		Проверка = ПроверкаПропущена(Название, "Оркестратор не ответил");
	ИначеЕсли Ответ.КодСостояния = КодУспеха() Тогда
		Проверка = ПроверкаПройдена(Название, "Ключ верный");
	ИначеЕсли Ответ.КодСостояния = КодНеверногоКлюча И Режим = mcp_НастройкиLLM.РежимЛокальный() Тогда
		Проверка = ПроверкаСОшибкой(Название, "Ключ не совпадает с client_key оркестратора",
			"Оркестратор запущен с другим ключом: перезапустите его из формы вопроса, форма запишет личный ключ "
				+ "в файл конфигурации");
	ИначеЕсли Ответ.КодСостояния = КодНеверногоКлюча Тогда
		Проверка = ПроверкаСОшибкой(Название, "Ключ не совпадает с client_key оркестратора",
			"Скопируйте client_key из файла конфигурации оркестратора в поле ""Ключ"" настроек");
	ИначеЕсли Ответ.КодСостояния = КодБлокировки Тогда
		Проверка = ПроверкаСОшибкой(Название,
			"Оркестратор временно отклоняет запросы с этого адреса: было много неверных ключей",
			"Исправьте ключ и повторите проверку через 5 минут");
	Иначе
		Текст = СтрШаблон("Неожиданный ответ, код HTTP %1: %2", Ответ.КодСостояния,
			Лев(Ответ.Тело, ДлинаФрагментаОтвета));
		Подсказка = "Возможно, по этому адресу работает не оркестратор: проверьте адрес и порт";
		Проверка = ПроверкаСОшибкой(Название, Текст, Подсказка);
	КонецЕсли;

	Возврат Проверка;

КонецФункции

// Проверка 6: Ollama доступна, модель скачана и загружена в память.
//
// Параметры:
//  Ollama - Структура, Неопределено - поле ollama ответа /diagnostics
//
// Возвращаемое значение:
//  Структура - см. НоваяПроверка
//
Функция ПроверкаOllama(Ollama)

	Название = "Ollama и модель";
	Если ТипЗнч(Ollama) <> Тип("Структура") Тогда
		Возврат ПроверкаСОшибкой(Название, "Оркестратор не прислал состояние Ollama");
	КонецЕсли;

	Модель = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Ollama, "model", "");
	Если Не ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Ollama, "available", Ложь) Тогда
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Ollama, "error", "");
		Проверка = ПроверкаСОшибкой(Название, "Ollama не отвечает: " + ТекстОшибки,
			"Запустите Ollama (ollama serve) на компьютере оркестратора и проверьте ollama_url");
	ИначеЕсли Не ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Ollama, "model_present", Ложь) Тогда
		Подсказка = СтрШаблон("Выполните ollama pull %1 или укажите в ollama_model скачанную модель", Модель);
		Проверка = ПроверкаСОшибкой(Название, СтрШаблон("Модель %1 не скачана", Модель), Подсказка);
	ИначеЕсли Не ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Ollama, "model_loaded", Ложь) Тогда
		Текст = СтрШаблон("Модель %1 есть, но еще не загружена в память", Модель);
		Подсказка = "Первый ответ будет дольше: модель загружается при первом вопросе";
		Проверка = ПроверкаСПредупреждением(Название, Текст, Подсказка);
	Иначе
		Проверка = ПроверкаПройдена(Название, СтрШаблон("Модель %1 загружена", Модель));
	КонецЕсли;

	Возврат Проверка;

КонецФункции

// Проверка 7: оркестратор получает список инструментов от HTTP-сервиса 1С.
//
// Параметры:
//  MCP   - Структура, Неопределено - поле mcp ответа /diagnostics
//  Режим - Строка
//
// Возвращаемое значение:
//  Структура - см. НоваяПроверка
//
Функция ПроверкаMCP(MCP, Режим)

	Название = "Связь оркестратора с MCP-сервером 1С";
	Если ТипЗнч(MCP) = Тип("Структура") И ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(MCP, "ok", Ложь) Тогда
		ЧислоИнструментов = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(MCP, "tools", 0);
		Возврат ПроверкаПройдена(Название, СтрШаблон("Инструментов: %1", ЧислоИнструментов));
	КонецЕсли;

	ТекстОшибки = "";
	Если ТипЗнч(MCP) = Тип("Структура") Тогда
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(MCP, "error", "");
	КонецЕсли;
	Подсказка = "Проверьте mcp_url в файле конфигурации оркестратора: адрес публикации базы с /hs/mcp";
	АдресПубликации = mcp_НастройкиLLM.НастройкиБазы().АдресПубликацииMCP;
	Если Режим = mcp_НастройкиLLM.РежимЛокальный() И ЗначениеЗаполнено(АдресПубликации) Тогда
		Подсказка = Подсказка + ". Адрес публикации из настроек базы: " + АдресПубликации;
	КонецЕсли;

	Возврат ПроверкаСОшибкой(Название, "Оркестратор не получил инструменты: " + ТекстОшибки, Подсказка);

КонецФункции

// Проверка 8: инструмент get_configuration_version выполнен через оркестратор с токеном пользователя.
//
// Параметры:
//  ВызовИнструмента - Структура, Неопределено - поле tool_call ответа /diagnostics
//
// Возвращаемое значение:
//  Структура - см. НоваяПроверка
//
Функция ПроверкаСквозная(ВызовИнструмента)

	Название = "Сквозной вызов инструмента с токеном";
	Если ТипЗнч(ВызовИнструмента) <> Тип("Структура") Тогда
		Возврат ПроверкаСОшибкой(Название, "Оркестратор не выполнил вызов");
	КонецЕсли;

	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВызовИнструмента, "ok", Ложь) Тогда
		ИмяПользователя = Строка(Пользователи.АвторизованныйПользователь());
		Возврат ПроверкаПройдена(Название, "get_configuration_version выполнен от имени " + ИмяПользователя);
	КонецЕсли;

	Текст = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВызовИнструмента, "text", "");
	Подсказка = "Проверьте, что оркестратор обращается к публикации этой базы и пользователю назначена роль "
		+ """Вопросы к LLM по данным базы (MCP)"" (в конфигурации на БСП - через профиль групп доступа)";
	Возврат ПроверкаСОшибкой(Название, Текст, Подсказка);

КонецФункции

// Проверка 9: ключ и вопросы не идут по сети открытым текстом.
//
// Параметры:
//  АдресОркестратора - Строка
//
// Возвращаемое значение:
//  Структура - см. НоваяПроверка
//
Функция ПроверкаКанала(АдресОркестратора)

	Название = "Защита канала";
	Если Не ЗначениеЗаполнено(АдресОркестратора) Тогда
		Проверка = ПроверкаПропущена(Название, "Адрес оркестратора не задан");
	ИначеЕсли СтрНачинаетсяС(НРег(АдресОркестратора), "https://") Тогда
		Проверка = ПроверкаПройдена(Название, "HTTPS: ключ и вопросы шифруются");
	ИначеЕсли mcp_НастройкиLLM.ЭтоЛокальныйАдрес(АдресОркестратора) Тогда
		Проверка = ПроверкаПройдена(Название, "Оркестратор на этом же компьютере, сеть не используется");
	Иначе
		Проверка = ПроверкаСПредупреждением(Название, "HTTP по сети: ключ оркестратора и вопросы идут открытым текстом",
			"Задайте tls_cert и tls_key в файле конфигурации оркестратора и укажите адрес с https://");
	КонецЕсли;

	Возврат Проверка;

КонецФункции

// Проверка 10: HTTP-сервис не работает под пользователем с полными правами, вызов без токена запрещен.
// Пользователь публикации определяется по активным сеансам HTTP-сервиса: сеанс остается после
// сквозной проверки. Список сеансов доступен только администратору.
//
// Возвращаемое значение:
//  Структура - см. НоваяПроверка
//
Функция ПроверкаПубликации()

	Название = "Публикация HTTP-сервиса";
	Если Не mcp_НастройкиLLM.ЭтоАдминистратор() Тогда
		Возврат ПроверкаПропущена(Название, "Проверяет администратор");
	КонецЕсли;

	ПолноправныеПользователи = Новый Массив;
	ПользователиПубликации = Новый Массив;
	Для Каждого Сеанс Из ПолучитьСеансыИнформационнойБазы() Цикл
		Если Сеанс.ИмяПриложения <> "HTTPServiceConnection" Или Сеанс.Пользователь = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИмяПользователя = Сеанс.Пользователь.Имя;
		Если ПользователиПубликации.Найти(ИмяПользователя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПользователиПубликации.Добавить(ИмяПользователя);
		Если Пользователи.ЭтоПолноправныйПользователь(Сеанс.Пользователь) Тогда
			ПолноправныеПользователи.Добавить(ИмяПользователя);
		КонецЕсли;
	КонецЦикла;
	СписокПолноправных = СтрСоединить(ПолноправныеПользователи, ", ");
	СписокПубликации = СтрСоединить(ПользователиПубликации, ", ");

	Если ЗначениеЗаполнено(ПолноправныеПользователи) Тогда
		Текст = "HTTP-сервис работает под пользователем с полными правами: " + СписокПолноправных;
		Проверка = ПроверкаСОшибкой(Название, Текст,
			"Создайте технического пользователя с ролями ""MCP-сервер: основная роль"" и ""Базовые права БСП"" "
				+ "и укажите его в публикации (default.vrd, атрибут ib: Usr и Pwd)");
	ИначеЕсли mcp_НастройкиLLM.НастройкиБазы().ДоступКИнструментамБезТокена Тогда
		Проверка = ПроверкаСПредупреждением(Название,
			"Вызов инструментов без токена разрешен: внешний клиент получает данные с правами пользователя "
				+ "публикации",
			"Снимите флажок ""Разрешить вызов инструментов без токена"", когда все клиенты получат токены");
	ИначеЕсли Не ЗначениеЗаполнено(ПользователиПубликации) Тогда
		Проверка = ПроверкаПропущена(Название,
			"Вызов без токена запрещен; пользователя публикации определить не удалось: нет сеансов HTTP-сервиса");
	Иначе
		Проверка = ПроверкаПройдена(Название, "Вызов без токена запрещен, пользователь публикации без полных прав: "
			+ СписокПубликации);
	КонецЕсли;

	Возврат Проверка;

КонецФункции

// Почему к оркестратору не обращаемся: безопасный режим, нет адреса или ключа.
//
// Параметры:
//  Настройки - Структура - см. mcp_НастройкиLLM.ДействующиеНастройки
//
// Возвращаемое значение:
//  Строка - пусто, если обращаться можно
//
Функция ПричинаПропускаЗапроса(Настройки)

	Если БезопасныйРежим() <> Ложь Тогда
		Причина = "включен безопасный режим расширения";
	ИначеЕсли Не ЗначениеЗаполнено(Настройки.АдресОркестратора) Тогда
		Причина = "не задан адрес оркестратора";
	ИначеЕсли Настройки.Режим = mcp_НастройкиLLM.РежимСерверный() И Не Настройки.ЕстьКлюч Тогда
		Причина = "не записан ключ оркестратора";
	Иначе
		Причина = "";
	КонецЕсли;

	Возврат Причина;

КонецФункции

// Добавляет проверки 4-8 как пропущенные.
//
// Параметры:
//  Проверки - Массив из Структура
//  Причина  - Строка
//
Процедура ДобавитьПропущенныеПроверкиОркестратора(Проверки, Причина)

	Названия = СтрРазделить("Оркестратор доступен;Ключ принят оркестратором;Ollama и модель;"
		+ "Связь оркестратора с MCP-сервером 1С;Сквозной вызов инструмента с токеном", ";");
	Текст = "Не выполнялась: " + Причина;
	Для Каждого Название Из Названия Цикл
		Проверка = ПроверкаПропущена(Название, Текст);
		Проверки.Добавить(Проверка);
	КонецЦикла;

КонецПроцедуры

// Подсказка, где задать адрес оркестратора.
//
// Параметры:
//  Режим - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ПодсказкаНастройки(Режим)

	Если Режим = mcp_НастройкиLLM.РежимЛокальный() Тогда
		Возврат "Укажите адрес локального оркестратора в личных настройках, например http://localhost:9000";
	КонецЕсли;
	Возврат "Укажите адрес серверного оркестратора в настройках базы";

КонецФункции

// Код HTTP успешного ответа оркестратора.
//
// Возвращаемое значение:
//  Число
//
Функция КодУспеха()

	Возврат 200;

КонецФункции

#КонецОбласти

#Область Отчет

// Результат одной проверки. Номер проставляет ЗавершитьСостояние по порядку проверок.
//
// Параметры:
//  Название  - Строка
//  Состояние - Строка - ok, warning, error или skip
//  Текст     - Строка - что обнаружено
//  Подсказка - Строка - что сделать
//
// Возвращаемое значение:
//  Структура - с полями Номер, Название, Состояние, Текст, Подсказка
//
Функция НоваяПроверка(Название, Состояние, Текст, Подсказка)

	Проверка = Новый Структура("Номер, Название, Состояние", 0, Название, Состояние);
	Проверка.Вставить("Текст", Текст);
	Проверка.Вставить("Подсказка", Подсказка);
	Возврат Проверка;

КонецФункции

// Пройденная проверка.
//
// Параметры:
//  Название - Строка
//  Текст    - Строка
//
// Возвращаемое значение:
//  Структура - см. НоваяПроверка
//
Функция ПроверкаПройдена(Название, Текст)

	Возврат НоваяПроверка(Название, "ok", Текст, "");

КонецФункции

// Проверка с риском: работает, но администратору стоит вмешаться.
//
// Параметры:
//  Название  - Строка
//  Текст     - Строка
//  Подсказка - Строка
//
// Возвращаемое значение:
//  Структура - см. НоваяПроверка
//
Функция ПроверкаСПредупреждением(Название, Текст, Подсказка)

	Возврат НоваяПроверка(Название, "warning", Текст, Подсказка);

КонецФункции

// Проверка с ошибкой: вопросы к LLM работать не будут.
//
// Параметры:
//  Название  - Строка
//  Текст     - Строка
//  Подсказка - Строка
//
// Возвращаемое значение:
//  Структура - см. НоваяПроверка
//
Функция ПроверкаСОшибкой(Название, Текст, Подсказка = "")

	Возврат НоваяПроверка(Название, "error", Текст, Подсказка);

КонецФункции

// Проверка, которая не выполнялась.
//
// Параметры:
//  Название - Строка
//  Текст    - Строка - причина
//
// Возвращаемое значение:
//  Структура - см. НоваяПроверка
//
Функция ПроверкаПропущена(Название, Текст)

	Возврат НоваяПроверка(Название, "skip", Текст, "");

КонецФункции

// Нумерует проверки по порядку, отмечает диагностику завершенной и строит HTML.
//
// Параметры:
//  Состояние - Структура - из НачатьДиагностику
//
Процедура ЗавершитьСостояние(Состояние)

	Номер = 0;
	Для Каждого Проверка Из Состояние.Проверки Цикл
		Номер = Номер + 1;
		Проверка.Номер = Номер;
	КонецЦикла;

	Состояние.Завершена = Истина;
	Состояние.HTML = HTMLОтчета(Состояние.Проверки, Состояние.Режим);

КонецПроцедуры

// HTML-отчет о проверках: итог и список с подсказками.
//
// Параметры:
//  Проверки - Массив из Структура - см. НоваяПроверка
//  Режим    - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция HTMLОтчета(Проверки, Режим)

	Ошибок = 0;
	Предупреждений = 0;
	Строки = Новый Массив;
	Для Каждого Проверка Из Проверки Цикл
		Если Проверка.Состояние = "error" Тогда
			Ошибок = Ошибок + 1;
		КонецЕсли;
		Если Проверка.Состояние = "warning" Тогда
			Предупреждений = Предупреждений + 1;
		КонецЕсли;
		СтрокаПроверки = СтрокаHTML(Проверка);
		Строки.Добавить(СтрокаПроверки);
	КонецЦикла;

	Если Ошибок > 0 Тогда
		Итог = СтрШаблон("Есть ошибки: %1. Исправьте их, вопросы к LLM работать не будут.", Ошибок);
		КлассИтога = "error";
	ИначеЕсли Предупреждений > 0 Тогда
		Итог = СтрШаблон("Работает, есть предупреждения: %1.", Предупреждений);
		КлассИтога = "warning";
	Иначе
		Итог = "Все проверки пройдены.";
		КлассИтога = "ok";
	КонецЕсли;

	Шаблон =
	"<!DOCTYPE html><html><head><meta charset=""utf-8""><style>
	|body{font-family:Segoe UI,Arial,sans-serif;font-size:13px;color:#1F2440;background:#FFFFFF;margin:12px}
	|.sum{padding:10px 12px;border-radius:8px;margin-bottom:10px;font-weight:600}
	|.sum.ok{background:#E8F7EF;color:#12864A}.sum.warning{background:#FFF4E0;color:#A65F00}
	|.sum.error{background:#FDECEC;color:#D23C3C}
	|.chk{display:flex;gap:10px;padding:8px 4px;border-bottom:1px solid #EEF0F8}
	|.mark{width:22px;height:22px;border-radius:11px;color:#fff;text-align:center;line-height:22px;flex:none}
	|.mark.ok{background:#12864A}.mark.warning{background:#E08A00}.mark.error{background:#D23C3C}
	|.mark.skip{background:#B4B9D3}.name{font-weight:600}.text{color:#3A4060}.hint{color:#6B7194;margin-top:2px}
	|.mode{color:#6B7194;margin-bottom:8px}
	|</style></head><body><div class=""mode"">Режим: %1</div><div class=""sum %2"">%3</div>%4</body></html>";

	РежимHTML = ЭкранироватьHTML(Режим);
	ИтогHTML = ЭкранироватьHTML(Итог);
	СписокHTML = СтрСоединить(Строки, "");
	Возврат СтрШаблон(Шаблон, РежимHTML, КлассИтога, ИтогHTML, СписокHTML);

КонецФункции

// Одна проверка в HTML.
//
// Параметры:
//  Проверка - Структура - см. НоваяПроверка
//
// Возвращаемое значение:
//  Строка
//
Функция СтрокаHTML(Проверка)

	Знаки = Новый Соответствие;
	Знаки.Вставить("ok", "&#10003;");
	Знаки.Вставить("warning", "!");
	Знаки.Вставить("error", "&#10007;");
	Знаки.Вставить("skip", "&#8211;");

	Подсказка = "";
	Если ЗначениеЗаполнено(Проверка.Подсказка) Тогда
		Подсказка = "<div class=""hint"">" + ЭкранироватьHTML(Проверка.Подсказка) + "</div>";
	КонецЕсли;

	Знак = Знаки.Получить(Проверка.Состояние);
	Название = ЭкранироватьHTML(Проверка.Название);
	Текст = ЭкранироватьHTML(Проверка.Текст);
	Возврат СтрШаблон("<div class=""chk""><div class=""mark %1"">%2</div><div><div class=""name"">%3. %4</div>"
		+ "<div class=""text"">%5</div>%6</div></div>", Проверка.Состояние, Знак, Проверка.Номер, Название, Текст,
		Подсказка);

КонецФункции

// Заменяет специальные символы HTML: текст ошибок приходит от оркестратора и HTTP-сервиса.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ЭкранироватьHTML(Знач Текст)

	Текст = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Возврат СтрЗаменить(Текст, """", "&quot;");

КонецФункции

#КонецОбласти

#КонецОбласти
